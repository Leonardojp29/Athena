---
import Icon from '../Icon.astro';
import {
  CLAVE_TOTAL,
  formatear,
  lideresDeFila,
  type EntidadComparada,
  type GrupoDeFilas,
} from '../../lib/comparar';

/*
 * El comparador: una columna por entidad, con su recorte elegible, y las filas debajo.
 *
 * El servidor dibuja todo con el ámbito que pide la URL y el guion solo **parcha** los valores
 * cuando alguien cambia un selector. Por eso hay una sola plantilla: si el navegador tuviera que
 * rearmar las filas habría dos versiones del mismo marcado y una envejecería.
 *
 * Los ámbitos de todas las entidades viajan en un `application/json` al final. Son unos pocos
 * kilobytes y evitan un viaje al servidor por cada cambio de temporada, que es el gesto que uno
 * repite mientras compara.
 */
interface Props {
  tipo: 'jugador' | 'equipo';
  entidades: EntidadComparada[];
  /** El ámbito elegido para cada entidad, en el mismo orden. */
  elegidos: string[];
  grupos: GrupoDeFilas[];
  /** La comparación sin cada entidad, en el mismo orden: quitar es un enlace, no un botón. */
  hrefQuitar: string[];
}

const { tipo, entidades, elegidos, grupos, hrefQuitar } = Astro.props;

const ambitoDe = (entidad: EntidadComparada, clave: string) =>
  entidad.ambitos.find((a) => a.clave === clave) ?? entidad.ambitos[0];

const numerosDe = (indice: number, clave: string): number | null =>
  ambitoDe(entidades[indice]!, elegidos[indice] ?? CLAVE_TOTAL)?.numeros[clave] ?? null;

const columnas = `repeat(${entidades.length}, minmax(0, 1fr))`;
/* La etiqueta a la izquierda y una columna por entidad: se lee de corrido, fila por fila. */
const columnasConEtiqueta = `minmax(5rem, 9rem) ${columnas}`;
const perfilDe = (slug: string) => (tipo === 'equipo' ? `/equipos/${slug}` : `/jugadores/${slug}`);
---

<div data-comparador-vistas class="grid gap-5">
  <!--
    Las cabeceras siempre a la vista mientras se recorren las filas: sin esto, a la tercera pantalla
    de números uno ya no sabe cuál columna es cuál.
  -->
  <div
    data-cabeceras
    class="sticky top-16 z-10 grid overflow-hidden rounded-lg border border-border bg-canvas/95 backdrop-blur-sm"
    style={`grid-template-columns:${columnasConEtiqueta}`}
  >
    {/*
      La misma grilla que las filas, con la primera celda donde ellas ponen la etiqueta: así cada
      club queda justo encima de sus propios números. Esa celda no se deja vacía —un hueco del
      tamaño de una columna se lee como un error— y se usa para lo único que no se ve solo: que las
      columnas se pueden arrastrar.
    */}
    <div
      style="order:-1"
      class="flex flex-col justify-center gap-1 bg-canvas-subtle/50 px-2.5 py-2.5 sm:px-3"
    >
      <p class="text-2xs font-semibold uppercase tracking-label text-ink">
        {entidades.length} {tipo === 'equipo' ? 'equipos' : 'jugadores'}
      </p>
      <p class="hidden items-center gap-1 text-[10px] leading-tight text-ink-muted sm:flex">
        <Icon name="arrastrar" size={11} class="shrink-0" />
        Arrastra para reordenar
      </p>
    </div>
    {
      entidades.map((entidad, i) => (
        <article
          data-columna={i}
          draggable="true"
          style={`order:${i}`}
          class="group/col grid min-w-0 cursor-grab content-start gap-2 border-l border-border px-2 py-2.5 transition-colors active:cursor-grabbing data-[arrastrando]:opacity-40 data-[encima]:bg-primary/10"
        >
          <div class="flex min-w-0 items-center gap-2">
            {/* El asa aparece al acercarse: el resto del tiempo no compite con el escudo. */}
            <Icon
              name="arrastrar"
              size={13}
              class="hidden shrink-0 text-ink-muted/40 transition-colors group-hover/col:text-ink-muted sm:block"
            />
            {entidad.fotoUrl ? (
              <img
                src={entidad.fotoUrl}
                alt=""
                width="40"
                height="40"
                loading="lazy"
                class="size-10 shrink-0 rounded-full bg-canvas-subtle object-cover"
              />
            ) : (
              <span class="grid size-10 shrink-0 place-items-center rounded-full bg-canvas-subtle">
                <Icon name={tipo === 'equipo' ? 'cuadro' : 'usuario'} size={17} class="text-ink-muted" />
              </span>
            )}
            <div class="min-w-0 flex-1">
              <a
                href={perfilDe(entidad.slug)}
                class="block truncate font-display text-sm font-semibold uppercase leading-tight tracking-tight hover:text-primary-ink sm:text-base"
              >
                {entidad.nombre}
              </a>
              {entidad.subtitulo && (
                <p class="flex items-center gap-1 truncate text-2xs text-ink-muted">
                  {entidad.escudoUrl && (
                    <img src={entidad.escudoUrl} alt="" width="12" height="12" loading="lazy" class="size-3 shrink-0" />
                  )}
                  <span class="truncate">{entidad.subtitulo}</span>
                </p>
              )}
            </div>
            <a
              href={hrefQuitar[i]}
              class="shrink-0 rounded p-1 text-ink-muted transition-colors hover:bg-canvas-subtle hover:text-ink"
              aria-label={`Quitar a ${entidad.nombre} de la comparación`}
            >
              <Icon name="cerrar" size={13} />
            </a>
          </div>

          {/*
            El recorte que se mira. Es un <select> nativo y no un menú propio: en el teléfono abre la
            rueda del sistema, se maneja con el teclado y no cuesta una línea de JavaScript de más.
          */}
          <label class="block">
            <span class="sr-only">Temporada de {entidad.nombre}</span>
            <select
              data-ambito={i}
              class="w-full cursor-pointer truncate rounded-md border border-border bg-surface px-2 py-1.5 text-2xs outline-none transition-colors focus:border-primary-ink"
            >
              {entidad.ambitos.map((ambito) => (
                <option value={ambito.clave} selected={ambito.clave === (elegidos[i] ?? CLAVE_TOTAL)}>
                  {ambito.etiqueta}
                </option>
              ))}
            </select>
          </label>
        </article>
      ))
    }
  </div>


  {
    grupos.map((grupo) => (
      <section>
        <h2 class="mb-2.5 text-center font-display text-sm font-semibold uppercase tracking-tight">
          {grupo.titulo}
        </h2>
        <div class="overflow-hidden rounded-lg border border-border bg-surface">
          {grupo.filas.map((fila) => {
            const valores = entidades.map((_, i) => numerosDe(i, fila.clave));
            const lideres = lideresDeFila(valores, fila);
            return (
              <div
                data-fila={fila.clave}
                class="grid items-stretch border-b border-border last:border-b-0"
                style={`grid-template-columns:${columnasConEtiqueta}`}
              >
                <p
                  style="order:-1"
                  class="flex items-center px-2.5 py-2 text-2xs font-semibold leading-tight text-ink sm:px-3"
                >
                  {fila.etiqueta}
                </p>
                {valores.map((valor, i) => (
                  <div
                    data-celda={i}
                    style={`order:${i}`}
                    class="flex items-center justify-center border-l border-border px-1.5 py-2"
                  >
                    {/*
                      Sin barras: el que gana la fila se marca con una pastilla. Una barra por cada
                      estadística convertía la tabla en un gráfico de veinte líneas donde ninguna se
                      leía, y el largo mentía en las filas donde menos es mejor.
                    */}
                    <span
                      data-texto
                      class:list={[
                        'rounded-full px-2 py-0.5 text-sm tabular transition-colors',
                        lideres.has(i)
                          ? 'bg-primary/12 font-semibold text-primary-ink'
                          : 'text-ink',
                      ]}
                    >
                      {formatear(valor, fila)}
                    </span>
                  </div>
                ))}
              </div>
            );
          })}
        </div>
      </section>
    ))
  }

  <script
    type="application/json"
    data-comparador-datos
    set:html={JSON.stringify({ entidades, grupos })}
  />
</div>

<script>
  import {
    CLAVE_TOTAL,
    formatear,
    lideresDeFila,
    type EntidadComparada,
    type GrupoDeFilas,
  } from '../../lib/comparar';

  const raiz = document.querySelector<HTMLElement>('[data-comparador-vistas]');
  const crudo = raiz?.querySelector<HTMLElement>('[data-comparador-datos]')?.textContent;
  if (raiz && crudo) {
    const { entidades, grupos } = JSON.parse(crudo) as {
      entidades: EntidadComparada[];
      grupos: GrupoDeFilas[];
    };
    const selectores = [...raiz.querySelectorAll<HTMLSelectElement>('[data-ambito]')];

    const numerosDe = (indice: number, clave: string): number | null => {
      const entidad = entidades[indice];
      const elegido = selectores[indice]?.value ?? CLAVE_TOTAL;
      const ambito = entidad?.ambitos.find((a) => a.clave === elegido) ?? entidad?.ambitos[0];
      return ambito?.numeros[clave] ?? null;
    };

    /* Se parchean los nodos que ya están, no se rearman: el marcado lo dibujó el servidor. */
    function repintar(): void {
      for (const grupo of grupos) {
        for (const fila of grupo.filas) {
          const nodo = raiz!.querySelector<HTMLElement>(`[data-fila="${fila.clave}"]`);
          if (!nodo) continue;
          const valores = entidades.map((_, i) => numerosDe(i, fila.clave));
          const lideres = lideresDeFila(valores, fila);

          for (const [i] of entidades.entries()) {
            const texto = nodo.querySelector<HTMLElement>(`[data-celda="${i}"] [data-texto]`);
            if (!texto) continue;
            texto.textContent = formatear(valores[i], fila);
            texto.classList.toggle('bg-primary/12', lideres.has(i));
            texto.classList.toggle('font-semibold', lideres.has(i));
            texto.classList.toggle('text-primary-ink', lideres.has(i));
            texto.classList.toggle('text-ink', !lideres.has(i));
          }
        }
      }
    }

    for (const selector of selectores) selector.addEventListener('change', repintar);

    /*
     * Reordenar arrastrando. No se mueve un solo nodo: cada columna y cada celda llevan su `order`
     * de CSS, así que cambiar el orden es reescribir N números y la grilla las acomoda sola. Mover
     * nodos obligaría a rehacer las filas una por una y a renumerar los `data-celda`.
     *
     * El orden nuevo va a la URL, que es de donde sale al recargar y lo que se comparte.
     */
    const cabeceras = raiz.querySelector<HTMLElement>('[data-cabeceras]');
    const columnas = [...raiz.querySelectorAll<HTMLElement>('[data-columna]')];
    let orden = entidades.map((_, i) => i);
    let arrastrado: number | null = null;

    const aplicarOrden = (): void => {
      for (const [posicion, indice] of orden.entries()) {
        const columna = columnas[indice];
        if (columna) columna.style.order = String(posicion);
        for (const celda of raiz.querySelectorAll<HTMLElement>(`[data-celda="${indice}"]`)) {
          celda.style.order = String(posicion);
        }
      }
      const url = new URL(location.href);
      url.searchParams.set('j', orden.map((i) => entidades[i]!.slug).join(','));
      history.replaceState(history.state, '', url);
    };

    for (const columna of columnas) {
      const indice = Number(columna.dataset.columna);

      columna.addEventListener('dragstart', (evento) => {
        arrastrado = indice;
        columna.dataset.arrastrando = '';
        evento.dataTransfer?.setData('text/plain', String(indice));
        if (evento.dataTransfer) evento.dataTransfer.effectAllowed = 'move';
      });

      columna.addEventListener('dragend', () => {
        arrastrado = null;
        delete columna.dataset.arrastrando;
        for (const otra of columnas) delete otra.dataset.encima;
      });

      /* Sin esto el navegador no considera la columna un destino válido y no dispara `drop`. */
      columna.addEventListener('dragover', (evento) => {
        if (arrastrado === null || arrastrado === indice) return;
        evento.preventDefault();
        if (evento.dataTransfer) evento.dataTransfer.dropEffect = 'move';
        columna.dataset.encima = '';
      });

      columna.addEventListener('dragleave', () => delete columna.dataset.encima);

      columna.addEventListener('drop', (evento) => {
        evento.preventDefault();
        delete columna.dataset.encima;
        if (arrastrado === null || arrastrado === indice) return;
        const desde = orden.indexOf(arrastrado);
        const hasta = orden.indexOf(indice);
        if (desde < 0 || hasta < 0) return;
        orden = orden.toSpliced(desde, 1).toSpliced(hasta, 0, arrastrado);
        aplicarOrden();
      });
    }

    /* El contenedor también acepta la soltada: si se suelta en el hueco, no se pierde el gesto. */
    cabeceras?.addEventListener('dragover', (evento) => {
      if (arrastrado !== null) evento.preventDefault();
    });
  }
</script>
