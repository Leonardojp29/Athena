---
import { nombreFase } from '../lib/paises';

/*
 * El control de fases de una temporada: Clausura, Apertura, Tabla anual.
 *
 * Son enlaces y no botones hidratados: la fase elegida queda en la URL, el enlace es compartible,
 * el botón atrás funciona y la página sigue costando 0 KB. La que está en juego viene primera del
 * API y es la que se abre por defecto, que es el punto de todo esto —antes la Liga 1 abría en el
 * Apertura, terminado en mayo, mientras se jugaba el Clausura—.
 *
 * Cuando la página ya trae todas las tablas en el HTML —`[data-tablas]` con un panel por fase—, el
 * clic cambia de panel en el momento y solo actualiza la URL: recargar para mover una tabla que ya
 * está en la página tiraba el scroll al principio en cada cambio. Sin JavaScript, el enlace navega
 * como siempre.
 */
interface Props {
  grupos: Array<{ label: string; current: boolean }>;
  /** Etiqueta de la fase abierta. */
  activo: string;
  /** Construye el enlace de cada fase; la página decide cómo la lleva en su URL. */
  href: (label: string) => string;
  class?: string;
}

const { grupos, activo, href, class: className } = Astro.props;
---

{
  /*
   * `w-fit` y no ancho completo: es un control segmentado y tiene que medir lo que miden sus
   * pestañas. Estirado al ancho de la tarjeta —358px en el riel para 216 de contenido— dejaba una
   * barra gris con las pastillas amontonadas a la izquierda y un hueco muerto a la derecha.
   */
  grupos.length > 1 && (
    <div
      class:list={[
        'flex w-fit max-w-full flex-wrap items-center gap-1 rounded-lg bg-canvas-subtle p-1',
        className,
      ]}
      role="group"
      aria-label="Fase de la temporada"
      data-selector-fase
    >
      <!--
        El estilo cuelga de `aria-current` y no de un ternario del servidor: cuando el clic cambia de
        panel sin navegar, el atributo es lo único que se mueve, y con las clases decididas en el
        servidor la pastilla se quedaba en la fase que había renderizado el servidor.
      -->
      {grupos.map((grupo) => (
          <a
            href={href(grupo.label)}
            data-fase={grupo.label}
            aria-current={grupo.label === activo ? 'true' : undefined}
            class="flex items-center gap-1.5 rounded-md px-2.5 py-1 text-2xs font-medium text-ink-muted transition-colors hover:bg-surface/60 hover:text-ink aria-[current]:bg-surface aria-[current]:text-ink aria-[current]:shadow-card"
          >
            {nombreFase(grupo.label)}
          </a>
      ))}
    </div>
  )
}

<script>
  /*
   * Cambio de fase sin navegar, cuando la página trae todas las tablas en el HTML. Es el mismo gesto
   * de las rondas: se muestra el panel, se marca el botón y la URL queda al día para que el enlace
   * siga siendo compartible. El scroll no se mueve, que era el punto.
   */
  const tablas = document.querySelector<HTMLElement>('[data-tablas]');
  if (tablas) {
    const paneles = [...tablas.querySelectorAll<HTMLElement>('[data-tabla-panel]')];

    const mostrar = (fase: string) => {
      const destino = paneles.find((p) => p.dataset.tablaPanel === fase);
      if (!destino) return false;
      for (const panel of paneles) panel.hidden = panel !== destino;
      for (const boton of document.querySelectorAll<HTMLElement>('[data-selector-fase] [data-fase]')) {
        if (boton.dataset.fase === fase) boton.setAttribute('aria-current', 'true');
        else boton.removeAttribute('aria-current');
      }
      return true;
    };

    for (const boton of document.querySelectorAll<HTMLAnchorElement>('[data-selector-fase] [data-fase]')) {
      boton.addEventListener('click', (evento) => {
        const fase = boton.dataset.fase;
        if (!fase || evento.metaKey || evento.ctrlKey || evento.shiftKey) return;
        if (!mostrar(fase)) return;
        evento.preventDefault();
        history.pushState({ fase }, '', boton.href);
      });
    }

    addEventListener('popstate', () => {
      const fase = new URL(location.href).searchParams.get('tabla');
      mostrar(fase ?? paneles[0]?.dataset.tablaPanel ?? '');
    });
  }
</script>
