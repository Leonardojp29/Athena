---
/*
 * Los marcadores al día sin recargar. Pide `/marcadores.json`, que son dos kilobytes con lo único
 * que cambia mientras se juega, y parchea las filas que ya están en la página.
 *
 * Nunca envuelve al encabezado de la página de partido: ese marcador lo pinta React y un parche
 * externo se perdería en el siguiente render.
 */
interface Props {
  segundos?: number;
}

const { segundos = 15 } = Astro.props;
---

<span data-refresco-marcadores data-cada={segundos} hidden></span>

<script>
  import { isLive, minutoEnVivo, statusLabel } from '../lib/format';

  interface Marcador {
    id: string;
    status: string;
    statusDetail: string | null;
    elapsedMinutes: number | null;
    homeScore: number | null;
    awayScore: number | null;
  }

  interface Marcadores {
    generadoEn: string;
    live: number;
    partidos: Marcador[];
  }

  const marca = document.querySelector<HTMLElement>('[data-refresco-marcadores]');
  if (marca) {
    const cada = Math.max(5, Number(marca.dataset.cada ?? '15')) * 1000;
    let ultimoGenerado = '';
    let temporizador: number | undefined;

    const escribirMarcador = (nodo: HTMLElement, m: Marcador): void => {
      if (m.homeScore === null || m.awayScore === null) return;
      const separador = nodo.textContent?.includes(' – ') ? ' – ' : '–';
      nodo.textContent = `${m.homeScore}${separador}${m.awayScore}`;
      nodo.classList.toggle('bg-live/15', isLive(m.status) && nodo.classList.contains('rounded'));
      nodo.classList.toggle('text-live-ink', isLive(m.status));
    };

    const escribirEstado = (nodo: HTMLElement, m: Marcador, vivo: boolean): void => {
      nodo.textContent = vivo
        ? minutoEnVivo(m.status, m.elapsedMinutes, m.statusDetail)
        : m.status === 'finished'
          ? 'Final'
          : statusLabel(m.status);
      nodo.classList.toggle('hidden', !vivo && nodo.dataset.soloEnVivo !== undefined);
      nodo.classList.toggle('text-live-ink', vivo);
      nodo.classList.toggle('font-medium', vivo);
      nodo.classList.toggle('text-ink-muted', !vivo);
    };

    const escribirPastilla = (live: number): void => {
      const pastilla = document.querySelector<HTMLElement>('[data-contador-vivo]');
      const texto = pastilla?.querySelector<HTMLElement>('[data-contador-vivo-texto]');
      if (!pastilla || !texto) return;
      texto.textContent = `${live} en vivo`;
      pastilla.hidden = live === 0;
    };

    const aplicar = (datos: Marcadores): void => {
      const porId = new Map(datos.partidos.map((m) => [m.id, m]));
      for (const fila of document.querySelectorAll<HTMLElement>('[data-partido]')) {
        const m = porId.get(fila.dataset.partido as string);
        if (!m) continue;
        const vivo = isLive(m.status);

        const marcador = fila.querySelector<HTMLElement>('[data-marcador]');
        if (marcador) escribirMarcador(marcador, m);

        for (const lado of fila.querySelectorAll<HTMLElement>('[data-marcador-lado]')) {
          const goles = lado.dataset.marcadorLado === '0' ? m.homeScore : m.awayScore;
          if (goles !== null) lado.textContent = String(goles);
        }

        const estado = fila.querySelector<HTMLElement>('[data-estado]');
        if (estado && m.status !== 'scheduled') escribirEstado(estado, m, vivo);

        fila.toggleAttribute('data-en-vivo', vivo);
      }
      escribirPastilla(datos.live);
    };

    const pedir = async (): Promise<void> => {
      try {
        const res = await fetch('/marcadores.json');
        if (res.ok) {
          const datos = (await res.json()) as Marcadores;
          /* El borde puede servir una respuesta más vieja que la que ya se pintó. */
          if (datos.generadoEn > ultimoGenerado) {
            ultimoGenerado = datos.generadoEn;
            aplicar(datos);
          }
        }
      } catch {
        /* Un fallo de red se reintenta en el próximo tic. */
      }
      programar();
    };

    function programar(): void {
      clearTimeout(temporizador);
      temporizador = window.setTimeout(
        () => (document.visibilityState === 'visible' ? void pedir() : programar()),
        cada,
      );
    }

    void pedir();
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible') void pedir();
    });
  }
</script>
