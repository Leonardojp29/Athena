---
import Icon from './Icon.astro';
import LogoMark from './brand/LogoMark.astro';

interface Props {
  titulo?: string;
  detalle?: string;
}

const {
  titulo = 'Esto no está en la cancha',
  detalle = 'La página no existe o el contenido ya no está disponible.',
} = Astro.props;
---

<div class="mx-auto max-w-md py-16 text-center sm:py-24">
  <LogoMark size={44} class="mx-auto text-ink-muted" detail="compact" />
  <p class="mt-6 font-display text-score font-semibold leading-none tabular text-border-strong">
    404
  </p>
  <h1 class="mt-2 font-display text-2xl font-semibold uppercase">{titulo}</h1>
  <p class="mt-2 text-sm text-ink-muted">{detalle}</p>

  <div class="mt-6 grid gap-2 sm:grid-cols-2">
    <a
      href="/"
      class="flex items-center justify-center gap-1.5 rounded-md bg-primary px-3 py-2 text-sm font-medium text-primary-contrast transition-opacity hover:opacity-90"
    >
      Partidos de hoy
    </a>
    <a
      href="/competencias"
      class="flex items-center justify-center gap-1.5 rounded-md border border-border px-3 py-2 text-sm transition-colors hover:border-border-strong"
    >
      Competencias
      <Icon name="chevron-derecha" size={14} />
    </a>
  </div>

  <p class="mt-6 text-2xs text-ink-muted">
    Si llegaste desde un enlace de Athena, algo está mal de nuestro lado.
  </p>
</div>
