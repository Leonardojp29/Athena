---
import type { MatchCard } from '../lib/api';
import { formatDate, formatKickoff, isLive, minutoEnVivo, statusLabel } from '../lib/format';
import { etiquetaDeRonda } from '../lib/rondas';

/*
 * Una fila de partido. El enlace estirado cubre toda la fila y los escudos van encima: anidar
 * un <a> dentro de otro es HTML inválido, y esta es la forma de que todo sea clickeable sin
 * romper el documento.
 *
 * Enfrentados a partir de `sm` y apilados debajo: en un teléfono, "Sporting Cristal" contra
 * "Sport Huancayo" a los costados del marcador dejaba "Sporting Cri…" y "Sport Huanc…", y un nombre
 * cortado no identifica a nadie. Apilados, cada uno tiene los 280px de la fila entera. Es la misma
 * grilla con distinta colocación, no dos bloques: duplicar el DOM duplicaría también los enlaces.
 */
interface Props {
  /* Sin la competencia: una fila no la usa, y así también sirve para un partido del cuadro de la copa. */
  match: Omit<MatchCard, 'season'>;
  showDate?: boolean;
  /**
   * A dónde lleva un equipo. En la home abre su vista simplificada en el mismo contenedor; en el
   * resto del sitio, su página. El valor por omisión es la página, que es lo correcto fuera de casa.
   */
  hrefEquipo?: (slug: string) => string;
  /** Resalta a un equipo: en su propia vista importa ver de qué lado jugó. */
  destacado?: string | null;
  /**
   * A dónde lleva la fila. Por omisión, la página del partido; en una copa, su detalle dentro de la
   * competencia, que es donde el partido tiene sentido.
   */
  hrefPartido?: (id: string) => string;
  /**
   * La ronda, en una pastilla al final de la fila. Va donde la lista mezcla rondas —el cómo va de la
   * home, los resultados de una copa—: sin ella, la final de la Copa del Rey se leía como un partido
   * cualquiera. Dentro de un panel de una sola ronda no va, porque el encabezado ya lo dice.
   */
  mostrarRonda?: boolean;
  /** Marca la fila a la que el contenedor lleva el scroll: el primer partido que falta jugar. */
  anclado?: boolean;
}

const {
  match,
  showDate = false,
  hrefEquipo = (slug: string) => `/equipos/${slug}`,
  destacado = null,
  hrefPartido = (id: string) => `/partidos/${id}`,
  mostrarRonda = false,
  anclado = false,
} = Astro.props;
const live = isLive(match.status);
const finished = match.status === 'finished';
const hasScore = match.homeScore !== null && match.awayScore !== null;

/* Con la fecha pedida, un partido terminado la muestra: el marcador ya dice que terminó. */
const ronda = mostrarRonda ? etiquetaDeRonda(match.round) : null;

const estado = live
  ? minutoEnVivo(match.status, match.elapsedMinutes, match.statusDetail)
  : showDate
    ? formatDate(match.kickoffUtc)
    : finished
      ? 'Final'
      : statusLabel(match.status);
---

<div
  data-partido={match.id}
  data-anclado={anclado ? '' : undefined}
  class:list={[
    'group relative grid grid-cols-[minmax(0,1fr)_auto] items-center gap-x-2 gap-y-0.5 rounded-md px-2 py-2 transition-colors hover:bg-canvas-subtle',
    mostrarRonda ? 'sm:grid-cols-[1fr_auto_1fr_auto]' : 'sm:grid-cols-[1fr_auto_1fr]',
  ]}
>
  <a
    href={hrefPartido(match.id)}
    data-astro-prefetch="viewport"
    class="absolute inset-0 rounded-md"
    aria-label={`${match.homeTeam.name} contra ${match.awayTeam.name}`}
  ></a>

  <!-- El escudo va primero en el documento y `order` lo manda al lado interno en escritorio. -->
  <span class="col-start-1 row-start-1 flex min-w-0 items-center gap-2 sm:justify-end sm:text-right">
    {
      match.homeTeam.logoUrl && (
        <img
          src={match.homeTeam.logoUrl}
          alt=""
          width="20"
          height="20"
          loading="lazy"
          class="shrink-0 sm:order-2"
        />
      )
    }
    <a
      href={hrefEquipo(match.homeTeam.slug)}
      class:list={[
        'relative truncate text-sm hover:text-primary-ink hover:underline sm:order-1',
        match.homeTeam.slug === destacado ? 'font-semibold' : '',
      ]}
    >
      {match.homeTeam.name}
    </a>
  </span>

  <!--
    Sin pointer-events-none el marcador se come el clic: `view-transition-name` lo promueve a
    su propia capa, y esa capa pinta encima del enlace estirado.
  -->
  <span class="pointer-events-none col-start-2 row-span-2 row-start-1 flex min-w-16 flex-col items-center sm:row-span-1">
    {
      hasScore ? (
        <span
          data-marcador
          class:list={[
            'font-display tabular text-base font-semibold px-2 py-0.5 rounded',
            live ? 'bg-live/15 text-live-ink' : '',
          ]}
          style={`view-transition-name: marcador-${match.id}`}
        >
          {match.homeScore} – {match.awayScore}
        </span>
      ) : (
        <span data-marcador class="tabular text-sm text-ink-muted">
          {formatKickoff(match.kickoffUtc)}
        </span>
      )
    }
    <span
      data-estado
      class:list={['text-2xs', live ? 'font-medium text-live-ink' : 'text-ink-muted']}
    >
      {estado}
    </span>
  </span>

  <span class="col-start-1 row-start-2 flex min-w-0 items-center gap-2 sm:col-start-3 sm:row-start-1">
    {
      match.awayTeam.logoUrl && (
        <img src={match.awayTeam.logoUrl} alt="" width="20" height="20" loading="lazy" class="shrink-0" />
      )
    }
    <a
      href={hrefEquipo(match.awayTeam.slug)}
      class:list={[
        'relative truncate text-sm hover:text-primary-ink hover:underline',
        match.awayTeam.slug === destacado ? 'font-semibold' : '',
      ]}
    >
      {match.awayTeam.name}
    </a>
  </span>

  <!--
    La ronda cierra la fila, en el borde: en la grilla apilada del teléfono ocupa su propia línea
    debajo de los dos equipos, y desde `sm` se alinea al final sin empujar los nombres.

    Con ancho fijo, porque cada fila es una grilla independiente: sin él, "Fase de grupos · fecha 6"
    corría el nombre del visitante y la fila de al lado, con "Octavos de final", quedaba en otro
    lugar. Se corta con puntos suspensivos antes que desalinear la lista entera.
  -->
  {
    mostrarRonda && (
      <span class="pointer-events-none col-span-2 col-start-1 row-start-3 flex sm:col-span-1 sm:col-start-4 sm:row-start-1 sm:w-[9.5rem] sm:justify-end">
        <span
          class="truncate rounded border border-border px-1.5 py-px text-[10px] font-medium uppercase tracking-label text-ink-muted empty:hidden"
          title={ronda ?? undefined}
        >
          {ronda}
        </span>
      </span>
    )
  }
</div>
