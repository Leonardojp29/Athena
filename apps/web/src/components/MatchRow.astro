---
import type { MatchCard } from '../lib/api';
import { formatDate, formatKickoff, isLive, statusLabel } from '../lib/format';

/*
 * Una fila de partido. El enlace estirado cubre toda la fila y los escudos van encima: anidar
 * un <a> dentro de otro es HTML inválido, y esta es la forma de que todo sea clickeable sin
 * romper el documento.
 */
interface Props {
  match: MatchCard;
  showDate?: boolean;
}

const { match, showDate = false } = Astro.props;
const live = isLive(match.status);
const finished = match.status === 'finished';
const hasScore = match.homeScore !== null && match.awayScore !== null;

const estado = live && match.elapsedMinutes !== null
  ? `${match.elapsedMinutes}'`
  : finished
    ? 'Final'
    : showDate
      ? formatDate(match.kickoffUtc)
      : statusLabel(match.status);
---

<div class="group relative grid grid-cols-[1fr_auto_1fr] items-center gap-2 rounded-md px-2 py-2 transition-colors hover:bg-canvas-subtle">
  <a
    href={`/partidos/${match.id}`}
    class="absolute inset-0 rounded-md"
    aria-label={`${match.homeTeam.name} contra ${match.awayTeam.name}`}
  ></a>

  <span class="flex min-w-0 items-center justify-end gap-2 text-right">
    <a
      href={`/equipos/${match.homeTeam.slug}`}
      class="relative truncate text-sm hover:text-primary-ink hover:underline"
    >
      {match.homeTeam.name}
    </a>
    {
      match.homeTeam.logoUrl && (
        <img src={match.homeTeam.logoUrl} alt="" width="20" height="20" loading="lazy" class="shrink-0" />
      )
    }
  </span>

  <!--
    Sin pointer-events-none el marcador se come el clic: `view-transition-name` lo promueve a
    su propia capa, y esa capa pinta encima del enlace estirado.
  -->
  <span class="pointer-events-none flex min-w-16 flex-col items-center">
    {
      hasScore ? (
        <span
          class:list={[
            'font-display tabular text-base font-semibold px-2 py-0.5 rounded',
            live ? 'bg-live/15 text-live' : '',
          ]}
          style={`view-transition-name: marcador-${match.id}`}
        >
          {match.homeScore} – {match.awayScore}
        </span>
      ) : (
        <span class="tabular text-sm text-ink-muted">{formatKickoff(match.kickoffUtc)}</span>
      )
    }
    <span class:list={['text-2xs', live ? 'font-medium text-live' : 'text-ink-muted']}>{estado}</span>
  </span>

  <span class="flex min-w-0 items-center gap-2">
    {
      match.awayTeam.logoUrl && (
        <img src={match.awayTeam.logoUrl} alt="" width="20" height="20" loading="lazy" class="shrink-0" />
      )
    }
    <a
      href={`/equipos/${match.awayTeam.slug}`}
      class="relative truncate text-sm hover:text-primary-ink hover:underline"
    >
      {match.awayTeam.name}
    </a>
  </span>
</div>
