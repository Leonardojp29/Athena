---
import type { StandingRow } from '../lib/api';

interface Props {
  rows: StandingRow[];
  label?: string;
  highlightTeamId?: string;
  /**
   * Alto máximo del cuerpo, p. ej. "16rem". Con esto la tabla scrollea por dentro y el encabezado
   * queda fijo: dieciocho equipos completos sin que la tarjeta se estire hasta el pie.
   */
  maxAlto?: string;
  /** A dónde lleva un equipo. La home lo abre en su propio contenedor, no en otra página. */
  hrefEquipo?: (slug: string) => string;
}

const {
  rows,
  label = '',
  highlightTeamId,
  maxAlto,
  hrefEquipo = (slug: string) => `/equipos/${slug}`,
} = Astro.props;

/*
 * El proveedor manda la forma en inglés ("WWDLW") y el más reciente primero. Se traduce y se
 * invierte para que se lea como el hincha la cuenta: de lo más viejo a lo último.
 */
const FORMA: Record<string, { letra: string; clase: string; titulo: string }> = {
  W: { letra: 'V', clase: 'bg-primary text-primary-contrast', titulo: 'Victoria' },
  D: { letra: 'E', clase: 'bg-border-strong text-ink', titulo: 'Empate' },
  L: { letra: 'D', clase: 'bg-card-red/85 text-chalk', titulo: 'Derrota' },
};

const ultimos = (form: string | null) =>
  form === null ? [] : [...form.slice(0, 5)].reverse().flatMap((c) => FORMA[c] ?? []);

/* Se arma como un solo string: dos expresiones JSX seguidas meten un espacio en el medio. */
const diferencia = (row: StandingRow) => {
  const dg = row.goalsFor - row.goalsAgainst;
  return dg > 0 ? `+${dg}` : String(dg);
};
---

{label && <h3 class="mb-2 text-sm font-semibold text-ink-muted">{label}</h3>}
<div class="overflow-auto" style={maxAlto ? `max-height:${maxAlto}` : undefined}>
  <table class="w-full text-sm">
    <thead class="sticky top-0 z-10 bg-surface">
      <tr class="border-b border-border text-2xs text-ink-muted uppercase tracking-label">
        <th scope="col" class="w-8 py-2 pr-2 text-left font-semibold">#</th>
        <th scope="col" class="py-2 text-left font-semibold">Equipo</th>
        <th scope="col" class="w-11 py-2 text-center font-semibold">PJ</th>
        <th scope="col" class="hidden w-9 py-2 text-center font-semibold sm:table-cell">G</th>
        <th scope="col" class="hidden w-9 py-2 text-center font-semibold sm:table-cell">E</th>
        <th scope="col" class="hidden w-9 py-2 text-center font-semibold sm:table-cell">P</th>
        <th scope="col" class="hidden w-11 py-2 text-center font-semibold md:table-cell">DG</th>
        <th scope="col" class="hidden w-28 py-2 text-left font-semibold lg:table-cell">Forma</th>
        <th scope="col" class="w-12 py-2 text-center font-semibold">Pts</th>
      </tr>
    </thead>
    <tbody>
      {
        rows.map((row) => (
          <tr
            class:list={[
              'border-b border-border/50 transition-colors hover:bg-canvas-subtle',
              row.team.id === highlightTeamId ? 'bg-primary/8' : '',
            ]}
          >
            <td class="py-2 pr-2 tabular text-ink-muted">{row.position}</td>
            <td class="py-2">
              <a
                href={hrefEquipo(row.team.slug)}
                class="flex items-center gap-2 transition-colors hover:text-primary-ink hover:underline"
              >
                {row.team.logoUrl && (
                  <img src={row.team.logoUrl} alt="" width="18" height="18" loading="lazy" />
                )}
                <span class="max-w-44 truncate sm:max-w-none">{row.team.name}</span>
              </a>
            </td>
            <td class="py-2 text-center tabular">{row.played}</td>
            <td class="hidden py-2 text-center tabular sm:table-cell">{row.won}</td>
            <td class="hidden py-2 text-center tabular sm:table-cell">{row.drawn}</td>
            <td class="hidden py-2 text-center tabular sm:table-cell">{row.lost}</td>
            <td class="hidden py-2 text-center tabular md:table-cell">{diferencia(row)}</td>
            <td class="hidden py-2 lg:table-cell">
              <span class="flex gap-0.5">
                {ultimos(row.form).map((r) => (
                  <span
                    class:list={[
                      'grid size-4 place-items-center rounded-[2px] text-[9px] font-bold',
                      r.clase,
                    ]}
                    title={r.titulo}
                  >
                    {r.letra}
                  </span>
                ))}
              </span>
            </td>
            <td class="py-2 text-center font-semibold tabular">{row.points}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
