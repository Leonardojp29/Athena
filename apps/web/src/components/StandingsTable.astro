---
import type { StandingRow } from '../lib/api';

interface Props {
  rows: StandingRow[];
  label?: string;
  highlightTeamId?: string;
  /**
   * Alto máximo del cuerpo, p. ej. "16rem". Con esto la tabla scrollea por dentro y el encabezado
   * queda fijo: dieciocho equipos completos sin que la tarjeta se estire hasta el pie.
   */
  maxAlto?: string;
  /** A dónde lleva un equipo. La home lo abre en su propio contenedor, no en otra página. */
  hrefEquipo?: (slug: string) => string;
  /**
   * Solo posición, equipo, jugados, diferencia y puntos. Para el riel de la home y los ocho grupos
   * de una copa: nueve columnas obligaban a mostrar una tabla por vez, o a 1200px de ancho.
   */
  compacto?: boolean;
  /**
   * La tabla como protagonista: filas más altas, escudos más grandes y números que se leen de lejos.
   * Es lo que va en una liga, donde la tabla no compite con un cuadro ni con una fase de grupos y
   * tiene la página entera para ella.
   */
  grande?: boolean;
}

const {
  rows,
  label = '',
  highlightTeamId,
  maxAlto,
  hrefEquipo = (slug: string) => `/equipos/${slug}`,
  compacto = false,
  grande = false,
} = Astro.props;

/* Un solo juego de medidas por tamaño: la tabla grande respira, la normal es la de siempre. */
const alto = grande ? 'py-3' : 'py-2';
const cifra = grande ? 'text-base' : '';
const escudo = grande ? 24 : 18;

/*
 * El proveedor manda la forma en inglés ("WWDLW") y el más reciente primero. Se traduce y se
 * invierte para que se lea como el hincha la cuenta: de lo más viejo a lo último.
 */
const FORMA: Record<string, { letra: string; clase: string; titulo: string }> = {
  W: { letra: 'V', clase: 'bg-primary text-primary-contrast', titulo: 'Victoria' },
  D: { letra: 'E', clase: 'bg-border-strong text-ink', titulo: 'Empate' },
  L: { letra: 'D', clase: 'bg-card-red/85 text-chalk', titulo: 'Derrota' },
};

const ultimos = (form: string | null, cuantos: number) =>
  form === null ? [] : [...form.slice(0, cuantos)].reverse().flatMap((c) => FORMA[c] ?? []);

/* Se arma como un solo string: dos expresiones JSX seguidas meten un espacio en el medio. */
const diferencia = (row: StandingRow) => {
  const dg = row.goalsFor - row.goalsAgainst;
  return dg > 0 ? `+${dg}` : String(dg);
};
---

{label && <h3 class="mb-2 text-sm font-semibold text-ink-muted">{label}</h3>}
<div class="barra-fina overflow-auto" style={maxAlto ? `max-height:${maxAlto}` : undefined}>
  <!--
    En la tabla grande los anchos van por porcentaje y con `table-fixed`: con anchos automáticos, el
    nombre del equipo se comía todo el sobrante y los números terminaban a mil píxeles del equipo al
    que pertenecen. Así la fila se lee de un vistazo aunque la página tenga 1840px.
  -->
  <table class:list={['w-full', grande ? 'table-fixed text-base' : 'text-sm']}>
    <thead class="sticky top-0 z-10 bg-surface">
      <tr class="border-b border-border text-2xs text-ink-muted uppercase tracking-label">
        <th scope="col" class:list={['pr-2 text-left font-semibold', alto, grande ? 'w-[4%]' : 'w-8']}>#</th>
        <th scope="col" class:list={['text-left font-semibold', alto, grande ? 'w-[32%]' : '']}>Equipo</th>
        <th scope="col" class:list={['text-center font-semibold', alto, grande ? 'w-[6%]' : 'w-11']}>PJ</th>
        {!compacto && (
          <>
            <th scope="col" class:list={['hidden text-center font-semibold sm:table-cell', alto, grande ? 'w-[6%]' : 'w-9']}>G</th>
            <th scope="col" class:list={['hidden text-center font-semibold sm:table-cell', alto, grande ? 'w-[6%]' : 'w-9']}>E</th>
            <th scope="col" class:list={['hidden text-center font-semibold sm:table-cell', alto, grande ? 'w-[6%]' : 'w-9']}>P</th>
            {grande && (
              <>
                <th scope="col" class:list={['hidden w-[6%] text-center font-semibold md:table-cell', alto]}>GF</th>
                <th scope="col" class:list={['hidden w-[6%] text-center font-semibold md:table-cell', alto]}>GC</th>
              </>
            )}
          </>
        )}
        <th
          scope="col"
          class:list={[
            'text-center font-semibold',
            alto,
            grande ? 'w-[6%]' : 'w-11',
            compacto ? '' : 'hidden md:table-cell',
          ]}
        >
          DG
        </th>
        {!compacto && (
          <th
            scope="col"
            class:list={['hidden font-semibold lg:table-cell', alto, grande ? 'w-[16%] text-center' : 'w-28 text-left']}
          >
            Forma
          </th>
        )}
        <th scope="col" class:list={['text-center font-semibold', alto, grande ? 'w-[7%]' : 'w-12']}>Pts</th>
      </tr>
    </thead>
    <tbody>
      {
        rows.map((row) => (
          <tr
            class:list={[
              'transition-colors hover:bg-canvas-subtle',
              /* El ojo se pierde de renglón entre el nombre y las cifras: una fila sí y una no, con
                 un tinte apenas visible, alcanza para seguir la línea sin ensuciar la tabla. */
              'even:bg-canvas-subtle/70',
              grande ? '' : 'border-b border-border/40',
              row.team.id === highlightTeamId ? 'bg-primary/8' : '',
            ]}
          >
            <td class:list={['pr-2 tabular text-ink-muted', alto, grande ? 'text-base' : '']}>
              {row.position}
            </td>
            <td class={alto}>
              <a
                href={hrefEquipo(row.team.slug)}
                class:list={[
                  'flex items-center transition-colors hover:text-primary-ink hover:underline',
                  grande ? 'gap-3 font-medium' : 'gap-2',
                ]}
              >
                {row.team.logoUrl && (
                  <img
                    src={row.team.logoUrl}
                    alt=""
                    width={escudo}
                    height={escudo}
                    loading="lazy"
                    style={`width:${escudo}px;height:${escudo}px`}
                    class="object-contain"
                  />
                )}
                <span class="max-w-44 truncate sm:max-w-none">{row.team.name}</span>
              </a>
            </td>
            <td class:list={['text-center tabular', alto, cifra]}>{row.played}</td>
            {!compacto && (
              <>
                <td class:list={['hidden text-center tabular sm:table-cell', alto, cifra]}>{row.won}</td>
                <td class:list={['hidden text-center tabular sm:table-cell', alto, cifra]}>{row.drawn}</td>
                <td class:list={['hidden text-center tabular sm:table-cell', alto, cifra]}>{row.lost}</td>
                {grande && (
                  <>
                    <td class:list={['hidden text-center tabular md:table-cell', alto, cifra]}>
                      {row.goalsFor}
                    </td>
                    <td class:list={['hidden text-center tabular text-ink-muted md:table-cell', alto, cifra]}>
                      {row.goalsAgainst}
                    </td>
                  </>
                )}
              </>
            )}
            <td
              class:list={[
                'text-center tabular',
                alto,
                cifra,
                compacto ? '' : 'hidden md:table-cell',
              ]}
            >
              {diferencia(row)}
            </td>
            {!compacto && (
              <>
                <td class:list={['hidden lg:table-cell', alto]}>
                  <span class:list={['flex', grande ? 'justify-center gap-1' : 'gap-0.5']}>
                    {ultimos(row.form, grande ? 8 : 5).map((r) => (
                      <span
                        class:list={[
                          'grid place-items-center rounded-[2px] font-bold',
                          grande ? 'size-6 rounded-[3px] text-[11px]' : 'size-4 text-[9px]',
                          r.clase,
                        ]}
                        title={r.titulo}
                      >
                        {r.letra}
                      </span>
                    ))}
                  </span>
                </td>
              </>
            )}
            <td
              class:list={[
                'text-center font-semibold tabular',
                alto,
                grande ? 'font-display text-lg' : '',
              ]}
            >
              {row.points}
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
