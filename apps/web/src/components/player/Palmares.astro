---
import type { Trofeo } from '../../lib/api';
import { agruparPalmares, contarPalmares } from '../../lib/mercado';
import EscudoTorneo from '../EscudoTorneo.astro';
import Icon from '../Icon.astro';
import { nombreTorneo, paisEnEspanol } from '../../lib/paises';

/*
 * El palmarés como una línea de tiempo.
 *
 * Una lista vertical cuenta qué ganó; una línea cuenta **cuándo** lo ganó, que es lo que hace que se
 * lea como una carrera y no como un inventario. Va a todo el ancho porque el eje necesita recorrido:
 * apretada en media columna, una temporada con cuatro títulos se apila y deja de ser una línea.
 *
 * De lo más nuevo a lo más viejo, como el resto del sitio: quien entra quiere saber qué ganó hace
 * poco, no en qué año debutó.
 *
 * El escudo del torneo sale de cruzar su nombre con las competencias que ya tenemos —resuelve el
 * 72%—; el resto se queda con la copa sola en lugar de un escudo inventado.
 */
interface Props {
  palmares: Trofeo[];
}

const { palmares } = Astro.props;
const grupos = agruparPalmares(palmares);
const { campeon, subcampeon } = contarPalmares(palmares);

/*
 * Las cifras se arman acá y no entre llaves: Astro se come el espacio que separa el número de su
 * palabra y quedaba "65títulos".
 */
const cuentas = [
  campeon > 0 ? { numero: campeon, palabra: campeon === 1 ? 'título' : 'títulos' } : null,
  subcampeon > 0
    ? { numero: subcampeon, palabra: subcampeon === 1 ? 'subcampeonato' : 'subcampeonatos' }
    : null,
].flatMap((c) => (c ? [c] : []));
---

{
  grupos.length > 0 && (
    <section class="min-w-0 rounded-lg border border-border bg-surface">
      <header class="flex flex-wrap items-baseline gap-x-4 gap-y-1 border-b border-border px-4 py-3">
        <h2 class="text-base font-semibold">Palmarés</h2>
        <p class="flex flex-wrap items-baseline gap-x-3 text-sm text-ink-muted">
          {cuentas.map(({ numero, palabra }) => (
            <span>
              <strong class="font-display text-lg font-semibold tabular text-ink">{numero}</strong>
              {` ${palabra}`}
            </span>
          ))}
        </p>
      </header>

      {/*
        El riel desplaza a lo ancho con la línea corriendo por debajo. Los bordes se desvanecen con
        una máscara: cortado a filo, el título de la punta parece un error de maquetado.
      */}
      <div class="palmares-riel overflow-x-auto px-4 pb-4 pt-5">
        <ol class="relative flex w-max items-start gap-7">
          {/* La línea del tiempo, detrás de todo y de punta a punta. */}
          <span aria-hidden="true" class="absolute inset-x-0 top-[1.375rem] h-px bg-border" />

          {grupos.map((grupo) => (
            <li class="relative flex shrink-0 flex-col items-center gap-2">
              <span
                class:list={[
                  'font-display text-xs font-semibold tabular',
                  grupo.temporada ? 'text-ink' : 'text-ink-muted',
                ]}
              >
                {grupo.temporada ?? 'Sin año'}
              </span>

              {/* La marca sobre la línea: el punto que ancla la temporada en el eje. */}
              <span
                aria-hidden="true"
                class="size-1.5 rounded-full bg-border-strong ring-4 ring-surface"
              />

              <ul class="flex items-start gap-3">
                {grupo.titulos.map((titulo) => (
                  <li class="flex w-[4.5rem] flex-col items-center gap-1.5 text-center">
                    <span class="relative">
                      <EscudoTorneo url={titulo.logoUrl} size={34} />
                      {/*
                        La copa se posa sobre el escudo y no al lado: dorada para lo ganado y en
                        contorno gris para el subcampeonato, que además lo dice con palabras abajo.
                      */}
                      <span
                        class:list={[
                          'absolute -bottom-1 -right-1 grid size-[1.125rem] place-items-center rounded-full ring-2 ring-surface',
                          titulo.puesto === 'campeon'
                            ? 'bg-card-yellow text-banda'
                            : 'bg-canvas-subtle text-ink-muted',
                        ]}
                      >
                        <Icon name="trofeo" size={11} />
                      </span>
                    </span>

                    <span class="text-2xs leading-tight text-ink" title={titulo.competencia}>
                      {nombreTorneo(titulo.competencia)}
                    </span>
                    <span class="text-[10px] leading-none text-ink-muted">
                      {titulo.puesto === 'subcampeon'
                        ? 'Subcampeón'
                        : (paisEnEspanol(titulo.pais) ?? titulo.pais ?? '')}
                    </span>
                  </li>
                ))}
              </ul>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )
}

<style>
  /* Cortado a filo, el título de la punta parece un error; desvanecido, se lee como que sigue. */
  .palmares-riel {
    mask-image: linear-gradient(to right, transparent, black 1.5rem, black calc(100% - 1.5rem), transparent);
  }
  @media (prefers-reduced-motion: reduce) {
    .palmares-riel {
      scroll-behavior: auto;
    }
  }
</style>
