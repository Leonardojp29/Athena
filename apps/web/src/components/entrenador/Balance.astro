---
import type { CoachView } from '../../lib/api';

/*
 * Lo que dejó el entrenador en el banco: dirigidos, resultados y goles.
 *
 * La barra de abajo no es decoración: un 60-20-20 y un 40-20-40 dan el mismo "20 ganados" en
 * números y se leen distinto de un vistazo. Es una proporción, no un progreso, así que se dibuja
 * con tres bloques y no con un porcentaje que se anime.
 */
interface Props {
  record: NonNullable<CoachView['record']>;
}

const { record } = Astro.props;
const { dirigidos, ganados, empatados, perdidos, golesAFavor, golesEnContra } = record;

const porcentaje = (cuantos: number) => (dirigidos === 0 ? 0 : (cuantos / dirigidos) * 100);
const efectividad = Math.round(porcentaje(ganados));

const CIFRAS = [
  { etiqueta: 'Dirigidos', valor: dirigidos },
  { etiqueta: 'Ganados', valor: ganados },
  { etiqueta: 'Empatados', valor: empatados },
  { etiqueta: 'Perdidos', valor: perdidos },
  { etiqueta: 'A favor', valor: golesAFavor },
  { etiqueta: 'En contra', valor: golesEnContra },
];

const TRAMOS = [
  { cuantos: ganados, clase: 'bg-win', titulo: 'Ganados' },
  { cuantos: empatados, clase: 'bg-border-strong', titulo: 'Empatados' },
  { cuantos: perdidos, clase: 'bg-card-red/85', titulo: 'Perdidos' },
];
---

<section class="rounded-lg border border-border bg-surface p-4">
  <div class="mb-3 flex items-baseline justify-between gap-3">
    <h2 class="text-base font-semibold">En el banco</h2>
    <p class="text-sm text-ink-muted">
      <span class="font-display text-xl font-semibold tabular text-ink">{efectividad}%</span>
      de victorias
    </p>
  </div>

  <dl class="grid grid-cols-3 gap-px overflow-hidden rounded-md bg-border sm:grid-cols-6">
    {
      CIFRAS.map((cifra) => (
        <div class="bg-surface px-2 py-2.5 text-center">
          <dt class="text-2xs tracking-label uppercase text-ink-muted">{cifra.etiqueta}</dt>
          <dd class="font-display text-xl font-semibold tabular">{cifra.valor}</dd>
        </div>
      ))
    }
  </dl>

  <div class="mt-3 flex h-1.5 overflow-hidden rounded-full bg-canvas-subtle">
    {
      TRAMOS.filter((tramo) => tramo.cuantos > 0).map((tramo) => (
        <span
          class:list={[tramo.clase]}
          style={`width:${porcentaje(tramo.cuantos)}%`}
          title={`${tramo.titulo}: ${tramo.cuantos}`}
        />
      ))
    }
  </div>
</section>
