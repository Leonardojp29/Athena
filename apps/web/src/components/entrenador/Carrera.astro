---
import type { CoachView } from '../../lib/api';

/*
 * La carrera tal como la publica el proveedor, con el balance de Athena encima cuando lo hay.
 *
 * Las dos cosas no se pisan: las fechas cuentan dónde estuvo —incluidas las ligas que no
 * cubrimos— y los números solo aparecen donde tenemos partidos suyos. Un club sin cifras no es un
 * error, es una etapa anterior a nuestra base.
 */
interface Props {
  etapas: CoachView['etapas'];
  porEtapa: CoachView['porEtapa'];
  actual: CoachView['actual'];
}

const { etapas, porEtapa, actual } = Astro.props;

const balances = new Map(porEtapa.map((fila) => [fila.etapa, fila]));

const anio = (fecha: string) => fecha.slice(0, 4);

/*
 * "Hoy" lo lleva una sola etapa. El proveedor deja abierta también la del club anterior cuando no
 * registró la salida —Mourinho figura a la vez en Fenerbahçe y en el Real Madrid—, y dos filas
 * diciendo "hoy" no es un dato, es una contradicción. Las otras abiertas dicen desde cuándo.
 */
const periodo = (etapa: CoachView['etapas'][number]) => {
  if (etapa.hasta !== null) return `${anio(etapa.desde)} — ${anio(etapa.hasta)}`;
  return etapa.id === actual?.id ? `${anio(etapa.desde)} — hoy` : `Desde ${anio(etapa.desde)}`;
};
---

{
  etapas.length > 0 && (
    <section class="flex flex-col rounded-lg border border-border bg-surface p-4">
      <h2 class="mb-3 shrink-0 text-base font-semibold">Carrera</h2>

      <ul class="min-h-0 flex-1 divide-y divide-border/50 overflow-y-auto pr-1">
        {etapas.map((etapa) => {
          const balance = balances.get(etapa.id);
          const nombre = etapa.teamName ?? etapa.teamNombre ?? 'Sin club';
          const contenido = (
            <span class="flex items-center gap-2.5">
              {etapa.teamLogo ? (
                <img src={etapa.teamLogo} alt="" width="22" height="22" loading="lazy" class="size-[22px] shrink-0 object-contain" />
              ) : (
                <span class="size-[22px] shrink-0 rounded-full bg-canvas-subtle" />
              )}
              <span class="min-w-0 flex-1">
                <span class="block truncate text-sm font-medium">{nombre}</span>
                <span class="block text-2xs tabular text-ink-muted">{periodo(etapa)}</span>
              </span>
              {balance && (
                <span class="shrink-0 text-right text-2xs text-ink-muted">
                  <span class="block tabular">
                    <span class="font-semibold text-ink">{balance.dirigidos}</span> PJ
                  </span>
                  <span class="block tabular">
                    {balance.ganados}V {balance.empatados}E {balance.perdidos}D
                  </span>
                </span>
              )}
            </span>
          );

          return (
            <li>
              {etapa.teamSlug ? (
                <a
                  href={`/equipos/${etapa.teamSlug}`}
                  class="block py-2 transition-colors hover:bg-canvas-subtle"
                >
                  {contenido}
                </a>
              ) : (
                <span class="block py-2">{contenido}</span>
              )}
            </li>
          );
        })}
      </ul>
    </section>
  )
}
