---
/*
 * Las marcas de la cancha, siempre dibujadas en el espacio 1050 × 680 (metros reales ×10).
 * Quien la use decide la orientación con un transform; acá no hay texto, así que rotar el
 * grupo no da vuelta ninguna palabra.
 */
const L = 1050;
const W = 680;
const FRANJAS = 6;
const franja = L / FRANJAS;

const AREA_GRANDE = { largo: 165, ancho: 403 };
const AREA_CHICA = { largo: 55, ancho: 183 };
const PENAL = 110;
const CIRCULO = 91.5;
/* Media cuerda del arco del área: √(91,5² − (16,5 − 11)²) ≈ 73. */
const ARCO = 73;
---

<rect width={L} height={W} fill="var(--a-color-pitch)" />
{
  Array.from({ length: FRANJAS }, (_, i) => i)
    .filter((i) => i % 2 === 1)
    .map((i) => <rect x={i * franja} y="0" width={franja} height={W} fill="var(--a-color-pitch-dark)" />)
}

<g
  fill="none"
  stroke="var(--a-color-chalk)"
  stroke-opacity="0.5"
  stroke-width="3"
  stroke-linejoin="round"
>
  <rect x="6" y="6" width={L - 12} height={W - 12} />
  <line x1={L / 2} y1="6" x2={L / 2} y2={W - 6} />
  <circle cx={L / 2} cy={W / 2} r={CIRCULO} />

  <rect x="6" y={(W - AREA_GRANDE.ancho) / 2} width={AREA_GRANDE.largo} height={AREA_GRANDE.ancho} />
  <rect x="6" y={(W - AREA_CHICA.ancho) / 2} width={AREA_CHICA.largo} height={AREA_CHICA.ancho} />
  <path
    d={`M ${6 + AREA_GRANDE.largo} ${W / 2 - ARCO} A ${CIRCULO} ${CIRCULO} 0 0 1 ${6 + AREA_GRANDE.largo} ${W / 2 + ARCO}`}
  />

  <rect
    x={L - 6 - AREA_GRANDE.largo}
    y={(W - AREA_GRANDE.ancho) / 2}
    width={AREA_GRANDE.largo}
    height={AREA_GRANDE.ancho}
  />
  <rect
    x={L - 6 - AREA_CHICA.largo}
    y={(W - AREA_CHICA.ancho) / 2}
    width={AREA_CHICA.largo}
    height={AREA_CHICA.ancho}
  />
  <path
    d={`M ${L - 6 - AREA_GRANDE.largo} ${W / 2 - ARCO} A ${CIRCULO} ${CIRCULO} 0 0 0 ${L - 6 - AREA_GRANDE.largo} ${W / 2 + ARCO}`}
  />
</g>

<g fill="var(--a-color-chalk)" fill-opacity="0.5">
  <circle cx={L / 2} cy={W / 2} r="5" />
  <circle cx={6 + PENAL} cy={W / 2} r="5" />
  <circle cx={L - 6 - PENAL} cy={W / 2} r="5" />
</g>
