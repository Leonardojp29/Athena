---
import Icon from '../Icon.astro';

/*
 * Ficha del jugador en un <dialog>: se rellena desde el data-ficha del imán, así que abrirla no
 * cuesta ni una llamada; el estado va al hash para que el enlace sea compartible.
 *
 * La ficha se dibuja **encima del bloque que la abrió** —la cancha, o la tabla de rendimiento de un
 * equipo— y solo ese bloque se difumina: el resto de la página queda a la vista, que es lo que uno
 * quiere mientras compara. Y por eso hay **una ficha por bloque**: se puede tener abierta la de un
 * equipo junto a la del otro, que es la comparación que la vista invita a hacer.
 *
 * Eso obliga a que las contenidas no sean modales: dos `showModal()` se vuelven inertes entre sí y la
 * primera deja de responder al clic. A cambio hay que devolver a mano lo que el navegador regalaba
 * —Escape, el foco de vuelta al imán y el cierre al tocar afuera—, que es lo que hace el guion de
 * abajo. Sin bloque anfitrión, o si es muy chico, sigue siendo un modal de pantalla completa.
 */
---

<dialog
  id="ficha-jugador"
  data-ficha-dialogo
  class="m-auto w-[min(21rem,calc(100vw-2rem))] overflow-hidden rounded-xl border border-border bg-surface-raised p-0 text-ink shadow-modal backdrop:bg-canvas/70 backdrop:backdrop-blur-sm"
  aria-labelledby="ficha-nombre"
>
  <header class="flex items-center gap-2.5 border-b border-border p-3">
    <span data-ficha-foto class="shrink-0 empty:hidden"></span>
    <div class="min-w-0 flex-1">
      <p class="flex items-center gap-1.5 text-[10px] text-ink-muted">
        <span data-ficha-escudo class="empty:hidden"></span>
        <span data-ficha-equipo class="truncate"></span>
        <span data-ficha-dorsal class="tabular"></span>
      </p>
      <h2
        id="ficha-nombre"
        data-ficha-nombre
        class="truncate font-display text-base font-semibold uppercase leading-tight"
      >
      </h2>
      <p data-ficha-posicion class="truncate text-[10px] capitalize text-ink-muted"></p>
    </div>
    <button
      type="button"
      data-ficha-cerrar
      class="shrink-0 cursor-pointer rounded-md p-1 text-ink-muted transition-colors hover:bg-canvas-subtle hover:text-ink"
      aria-label="Cerrar"
    >
      <Icon name="cerrar" size={16} />
    </button>
  </header>

  <!--
    Sin scroll: la ficha vive dentro de la cancha, y una ficha que hay que desplazar tapa el partido
    sin dejar ver nada. Las estadísticas van en dos columnas y las once filas entran de una.
  -->
  <div class="p-3">
    <div data-ficha-destacados class="mb-2.5 grid grid-cols-3 gap-1.5"></div>
    <dl data-ficha-detalle class="grid grid-cols-2 gap-x-3"></dl>
    <p data-ficha-vacio class="text-sm text-ink-muted" hidden>
      Todavía no hay estadísticas individuales de este partido.
    </p>
  </div>

  <footer class="border-t border-border">
    <a
      data-ficha-perfil-pie
      href="/"
      class="flex items-center gap-1.5 px-3 py-2 text-2xs text-primary-ink transition-colors hover:bg-canvas-subtle"
    >
      Ver su perfil completo
      <Icon name="chevron-derecha" size={12} />
    </a>
  </footer>
</dialog>

<script>
  /* Cada campo puede faltar: el payload viaja sin los nulos para no pesar de más. */
  interface FichaStats {
    minutesPlayed?: number | null;
    rating?: string | null;
    goals?: number | null;
    assists?: number | null;
    saves?: number | null;
    shotsTotal?: number | null;
    shotsOnTarget?: number | null;
    passesTotal?: number | null;
    passesKey?: number | null;
    passesAccurate?: number | null;
    tacklesTotal?: number | null;
    interceptions?: number | null;
    duelsTotal?: number | null;
    duelsWon?: number | null;
    dribblesTotal?: number | null;
    dribblesSuccess?: number | null;
    foulsCommitted?: number | null;
    foulsDrawn?: number | null;
    yellowCards?: number | null;
    redCards?: number | null;
    penaltyScored?: number | null;
    penaltyMissed?: number | null;
    penaltySaved?: number | null;
  }

  interface Ficha {
    playerId: string;
    slug: string | null;
    name: string;
    photoUrl: string | null;
    number: number | null;
    position: string | null;
    team: { name: string; slug: string; logoUrl: string | null };
    stats: FichaStats | null;
  }

  const original = document.getElementById('ficha-jugador') as HTMLDialogElement | null;
  if (original) {
    /* El molde se saca antes de rellenar nada: una copia limpia de la que salen las demás fichas. */
    const molde = original.cloneNode(true) as HTMLDialogElement;

    const num = (valor: number | null | undefined) =>
      valor === null || valor === undefined ? '–' : String(valor);

    const par = (label: string, valor: string) =>
      `<div class="flex items-baseline justify-between gap-2 border-b border-border/50 py-1">
         <dt class="truncate text-2xs text-ink-muted">${label}</dt>
         <dd class="shrink-0 text-2xs font-medium tabular">${valor}</dd>
       </div>`;

    const destacado = (label: string, valor: string) =>
      `<div class="rounded-md bg-canvas-subtle px-1.5 py-1 text-center">
         <p class="font-display text-base font-semibold tabular leading-none">${valor}</p>
         <p class="mt-0.5 text-[10px] text-ink-muted">${label}</p>
       </div>`;

    function pintarImagen(
      contenedor: HTMLElement | null,
      url: string | null | undefined,
      tamano: number,
      clases: string,
    ): void {
      if (!contenedor) return;
      contenedor.replaceChildren();
      if (!url) return;
      const img = document.createElement('img');
      img.src = url;
      img.alt = '';
      img.width = tamano;
      img.height = tamano;
      if (clases) img.className = clases;
      contenedor.append(img);
    }

    function pintar(dialogo: HTMLDialogElement, ficha: Ficha): void {
      const $ = <T extends Element>(sel: string) => dialogo.querySelector<T>(sel);
      const nombre = $<HTMLElement>('[data-ficha-nombre]');
      const equipo = $<HTMLElement>('[data-ficha-equipo]');
      const dorsal = $<HTMLElement>('[data-ficha-dorsal]');
      const posicion = $<HTMLElement>('[data-ficha-posicion]');
      const destacados = $<HTMLElement>('[data-ficha-destacados]');
      const detalle = $<HTMLElement>('[data-ficha-detalle]');
      const vacio = $<HTMLElement>('[data-ficha-vacio]');

      if (nombre) nombre.textContent = ficha.name;
      if (equipo) equipo.textContent = ficha.team.name;
      if (dorsal) dorsal.textContent = ficha.number !== null ? `· #${ficha.number}` : '';
      if (posicion) posicion.textContent = ficha.position ?? '';

      /*
       * Las imágenes se crean acá y no viven vacías en el HTML: una imagen sin origen es una
       * caja rota esperando que alguien le quite el `hidden`. Y se arman con createElement en
       * lugar de innerHTML porque la URL viene de un proveedor.
       */
      pintarImagen(
        $<HTMLElement>('[data-ficha-foto]'),
        ficha.photoUrl,
        40,
        'size-10 rounded-full bg-canvas-subtle object-cover',
      );
      pintarImagen($<HTMLElement>('[data-ficha-escudo]'), ficha.team.logoUrl, 14, '');
      for (const enlace of dialogo.querySelectorAll<HTMLAnchorElement>('[data-ficha-perfil-pie]')) {
        enlace.href = ficha.slug ? `/jugadores/${ficha.slug}` : `/equipos/${ficha.team.slug}`;
      }

      const s = ficha.stats;
      if (!s) {
        if (destacados) destacados.innerHTML = '';
        if (detalle) detalle.innerHTML = '';
        if (vacio) vacio.hidden = false;
        return;
      }
      if (vacio) vacio.hidden = true;

      if (destacados) {
        destacados.innerHTML = [
          destacado('Minutos', num(s.minutesPlayed)),
          destacado('Nota', s.rating ? Number(s.rating).toFixed(1) : '–'),
          destacado('Goles', num((s.goals ?? 0) + (s.penaltyScored ?? 0))),
        ].join('');
      }

      const filas: string[] = [];
      /*
       * Ausente es ausente, venga como null o sin la clave: el payload viaja sin los nulos —la mitad
       * de las veinticinco estadísticas lo son y con cien fichas en la página eran decenas de
       * kilobytes—, así que estas dos funciones tratan los dos casos igual. Con `!== null` solo,
       * la fila salía diciendo "undefined".
       */
      const falta = (valor: number | null | undefined) => valor === null || valor === undefined;
      const cifra = (valor: number | null | undefined) => (falta(valor) ? null : String(valor));

      const agregar = (label: string, valor: string | null) => {
        if (valor !== null) filas.push(par(label, valor));
      };
      const dos = (a: number | null | undefined, b: number | null | undefined) =>
        falta(a) && falta(b) ? null : `${num(a)}/${num(b)}`;

      agregar('Asistencias', cifra(s.assists));
      agregar('Remates (al arco)', dos(s.shotsOnTarget, s.shotsTotal));
      agregar('Pases (logrados)', dos(s.passesAccurate, s.passesTotal));
      agregar('Pases clave', cifra(s.passesKey));
      agregar('Duelos ganados', dos(s.duelsWon, s.duelsTotal));
      agregar('Regates', dos(s.dribblesSuccess, s.dribblesTotal));
      agregar('Quites', cifra(s.tacklesTotal));
      agregar('Intercepciones', cifra(s.interceptions));
      agregar('Atajadas', cifra(s.saves));
      agregar('Faltas cometidas', cifra(s.foulsCommitted));
      agregar('Faltas recibidas', cifra(s.foulsDrawn));
      if (s.yellowCards) agregar('Amarillas', String(s.yellowCards));
      if (s.redCards) agregar('Rojas', String(s.redCards));
      if (s.penaltyMissed) agregar('Penales errados', String(s.penaltyMissed));
      if (s.penaltySaved) agregar('Penales atajados', String(s.penaltySaved));

      /* Con filas impares, la última toma las dos columnas: un hueco al final se lee como un dato
         que falta. */
      if (filas.length % 2 === 1) {
        filas[filas.length - 1] = `<div class="col-span-2">${filas[filas.length - 1] as string}</div>`;
      }
      if (detalle) detalle.innerHTML = filas.join('');
    }

    /* Debajo de esto la ficha taparía el bloque entero y no habría nada que mirar detrás. */
    const MINIMO_ANCHO = 260;
    const MINIMO_ALTO = 300;

    interface Abierta {
      anfitrion: HTMLElement | null;
      disparador: HTMLElement;
    }

    const fichas: HTMLDialogElement[] = [original];
    const abiertas = new Map<HTMLDialogElement, Abierta>();

    const ubicar = (dialogo: HTMLDialogElement, anfitrion: HTMLElement) => {
      const caja = anfitrion.getBoundingClientRect();
      /*
       * Acotada a la parte visible del anfitrión: en un teléfono la cancha mide más que la pantalla y
       * la ficha, centrada en el bloque entero, quedaba con la mitad fuera de cuadro.
       */
      const arriba = Math.max(caja.top, 8);
      const abajo = Math.min(caja.bottom, window.innerHeight - 8);
      const d = dialogo.style;
      d.setProperty('--ficha-x', `${caja.left + caja.width / 2}px`);
      d.setProperty('--ficha-y', `${(arriba + abajo) / 2}px`);
      d.setProperty('--ficha-ancho', `${caja.width}px`);
      d.setProperty('--ficha-alto', `${Math.max(0, abajo - arriba)}px`);
    };

    /* Mientras hay alguna abierta, cada ficha sigue a su bloque: el diálogo es fijo a la pantalla. */
    const seguir = () => {
      for (const [dialogo, estado] of abiertas) {
        if (estado.anfitrion) ubicar(dialogo, estado.anfitrion);
      }
    };
    window.addEventListener('scroll', seguir, { passive: true });
    window.addEventListener('resize', seguir);

    const contenida = (dialogo: HTMLDialogElement) => dialogo.hasAttribute('data-contenida');
    const cerrarContenidas = () => {
      for (const dialogo of [...abiertas.keys()]) if (contenida(dialogo)) dialogo.close();
    };

    function preparar(dialogo: HTMLDialogElement): HTMLDialogElement {
      dialogo.querySelector('[data-ficha-cerrar]')?.addEventListener('click', () => dialogo.close());
      /* Clic en el backdrop del modal: el <dialog> es el objetivo solo cuando se toca afuera. */
      dialogo.addEventListener('click', (event) => {
        if (event.target === dialogo) dialogo.close();
      });
      dialogo.addEventListener('close', () => {
        const estado = abiertas.get(dialogo);
        abiertas.delete(dialogo);
        estado?.anfitrion?.removeAttribute('data-difuminada');
        /*
         * El foco vuelve al imán a mano: eso lo hacía el navegador mientras la ficha era modal, y sin
         * esto el teclado quedaba al principio de la página cada vez que se cierra una.
         */
        if (estado?.anfitrion && estado.disparador.isConnected) estado.disparador.focus();
        if (abiertas.size === 0 && location.hash.startsWith('#jugador-')) {
          history.replaceState(null, '', location.pathname + location.search);
        }
      });
      return dialogo;
    }

    /*
     * Una ficha por bloque: la del bloque si ya está abierta —así el clic en otro jugador de la misma
     * tabla la reemplaza en lugar de amontonar—, la primera libre, o una copia nueva. Las copias se
     * quedan en el documento para reusarse: son dos o tres y así la transición de cierre se ve entera.
     */
    function fichaDe(anfitrion: HTMLElement | null): HTMLDialogElement {
      for (const [dialogo, estado] of abiertas) {
        if (estado.anfitrion === anfitrion) return dialogo;
      }
      const libre = fichas.find((f) => !f.open);
      if (libre) return libre;

      const copia = molde.cloneNode(true) as HTMLDialogElement;
      copia.removeAttribute('id');
      const nombre = copia.querySelector('[data-ficha-nombre]');
      const id = `ficha-nombre-${fichas.length}`;
      if (nombre) {
        nombre.id = id;
        copia.setAttribute('aria-labelledby', id);
      }
      original!.parentElement?.append(copia);
      fichas.push(copia);
      return preparar(copia);
    }

    /*
     * El imán puede estar en el césped o en el banco, que vive fuera para no inventarle una casilla
     * a quien entró desde el banco. En los dos casos la ficha pertenece a esa cancha, y el ámbito es
     * lo que las une. Fuera de la cancha manda el anfitrión declarado más cercano: la tabla de
     * rendimiento del equipo al que se le hizo clic, y no la del rival.
     */
    function anfitrionDe(boton: HTMLElement): HTMLElement | null {
      const suyo =
        boton.closest<HTMLElement>('[data-cancha]') ??
        boton
          .closest<HTMLElement>('[data-cancha-ambito]')
          ?.querySelector<HTMLElement>('[data-cancha]') ??
        boton.closest<HTMLElement>('[data-ficha-anfitrion]');
      const caja = suyo?.getBoundingClientRect();
      if (!suyo || !caja || caja.width < MINIMO_ANCHO || caja.height < MINIMO_ALTO) return null;
      return suyo;
    }

    function abrir(boton: HTMLElement): void {
      const crudo = boton.dataset.ficha;
      if (!crudo) return;

      const anfitrion = anfitrionDe(boton);
      const dialogo = fichaDe(anfitrion);
      pintar(dialogo, JSON.parse(crudo) as Ficha);

      abiertas.get(dialogo)?.anfitrion?.removeAttribute('data-difuminada');
      abiertas.set(dialogo, { anfitrion, disparador: boton });

      if (anfitrion) {
        anfitrion.setAttribute('data-difuminada', '');
        dialogo.setAttribute('data-contenida', '');
        ubicar(dialogo, anfitrion);
        /* `show()` y no `showModal()`: dos modales se vuelven inertes entre sí. */
        if (!dialogo.open) dialogo.show();
      } else {
        dialogo.removeAttribute('data-contenida');
        if (!dialogo.open) dialogo.showModal();
      }

      const id = boton.dataset.jugador;
      if (id) history.replaceState(null, '', `#jugador-${id}`);
    }

    /* Delegación: sirve igual para los imanes del servidor y para los que reemplace la isla. */
    document.addEventListener('click', (event) => {
      const objetivo = event.target as HTMLElement | null;
      const boton = objetivo?.closest<HTMLElement>('[data-ficha]');
      if (boton) {
        abrir(boton);
        return;
      }
      /* Tocar afuera cierra: sin backdrop que reciba el clic, lo decide el documento. */
      if (abiertas.size > 0 && !objetivo?.closest('[data-ficha-dialogo]')) cerrarContenidas();
    });

    /* Escape: la contenida no es modal, así que el navegador ya no la cierra sola. */
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || abiertas.size === 0) return;
      const dentro = (event.target as HTMLElement | null)?.closest<HTMLDialogElement>(
        '[data-ficha-dialogo]',
      );
      if (dentro && contenida(dentro)) dentro.close();
      else if (!dentro) cerrarContenidas();
    });

    preparar(original);

    /* Enlace compartido: si el hash nombra a un jugador, se abre su ficha al cargar. */
    const desdeHash = () => {
      const match = /^#jugador-(.+)$/.exec(location.hash);
      if (!match) return;
      const boton = document.querySelector<HTMLElement>(`[data-jugador="${match[1]}"]`);
      if (boton) abrir(boton);
    };
    desdeHash();
    window.addEventListener('hashchange', desdeHash);
  }
</script>
