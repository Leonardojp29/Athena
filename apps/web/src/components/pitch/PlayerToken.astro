---
import EventIcon from '../EventIcon.astro';
import Icon from '../Icon.astro';
import type { LineupPlayer, MatchPlayerStats, TeamSummary } from '../../lib/api';
import { claseDeNota } from '../../lib/nota';

/*
 * El imán del pizarrón: foto, dorsal y apellido. Es un <button> y no un nodo del SVG a
 * propósito: foco visible, área táctil de 44px y un texto que escala si el usuario agranda la
 * tipografía.
 *
 * El payload del jugador viaja en data-ficha para que abrir el modal no cueste una llamada;
 * quien no está vinculado a una entidad de Athena no es clickeable y se muestra apagado.
 */
interface Props {
  player: LineupPlayer;
  team: TeamSummary;
  stats: MatchPlayerStats | null;
  /** Porcentaje a lo largo de la cancha, ya resuelto para la mitad del equipo. */
  largo: number;
  /** Porcentaje a lo ancho. */
  ancho: number;
  /** Índice de la línea: escalona la entrada de los imanes. */
  fila?: number;
  /** La mejor nota del partido lleva estrella. */
  figura?: boolean;
  /** El minuto en que lo cambiaron; null si jugó todo. */
  salioEn?: number | null;
}

const { player, team, stats, largo, ancho, fila = 0, figura = false, salioEn = null } = Astro.props;

/*
 * El nombre bueno es el de la entidad, no el de la alineación: el proveedor manda "D. Romero"
 * dentro del `startXI` y "Diego Romero" en /players, y el snapshot guarda el primero. Sin esto
 * la ficha abría con la inicial mientras el perfil mostraba el nombre entero.
 */
const nombre = stats?.player.name ?? player.name;
const apellido = nombre.split(' ').at(-1) ?? nombre;
const clickeable = player.playerId !== null;
const dorsal = player.number ?? stats?.shirtNumber ?? null;
/* La alineación trae la foto denormalizada; si falta, la de las estadísticas del partido. */
const foto = player.photoUrl ?? stats?.player.photoUrl ?? null;
const rating = stats?.rating !== null && stats?.rating !== undefined ? Number(stats.rating) : null;
const amarillas = stats?.yellowCards ?? 0;
const rojas = stats?.redCards ?? 0;
const goles = (stats?.goals ?? 0) + (stats?.penaltyScored ?? 0);

const ficha = clickeable
  ? JSON.stringify({
      playerId: player.playerId,
      slug: player.slug ?? stats?.player.slug ?? null,
      name: nombre,
      photoUrl: foto,
      number: dorsal,
      position: player.position,
      team: { name: team.name, slug: team.slug, logoUrl: team.logoUrl },
      stats,
    })
  : null;
---

<!--
  Las dos coordenadas viajan como variables y la orientación las intercambia en CSS: la
  cancha vertical no cuesta un segundo juego de veintidós fichas con su JSON.
-->
<div
  data-iman
  class="absolute flex -translate-x-1/2 -translate-y-1/2 flex-col items-center left-[var(--ancho)] top-[calc(100%-var(--largo))] sm:left-[var(--largo)] sm:top-[var(--ancho)]"
  style={`--largo:${largo}%;--ancho:${ancho}%;--fila:${fila}`}
>
  {
    (() => {
      const Etiqueta = clickeable ? 'button' : 'span';
      return (
        <Etiqueta
          type={clickeable ? 'button' : undefined}
          data-jugador={clickeable ? player.playerId : undefined}
          data-ficha={ficha}
          class:list={[
            'group grid min-h-11 min-w-11 place-items-center rounded-full outline-offset-2',
            clickeable ? 'cursor-pointer' : 'opacity-70',
          ]}
          aria-label={
            clickeable
              ? `${player.name}${dorsal !== null ? `, dorsal ${dorsal}` : ''} — ver rendimiento`
              : undefined
          }
          title={clickeable ? undefined : 'Jugador sin ficha en Athena'}
        >
          <span class="relative">
            {foto ? (
              <img
                src={foto}
                alt=""
                width="44"
                height="44"
                loading="lazy"
                class="size-9 rounded-full border-2 border-magnet bg-magnet object-cover shadow-magnet transition-transform group-hover:scale-110 sm:size-11"
              />
            ) : (
              /* Sin foto, el dorsal ocupa su lugar: nunca un círculo vacío. */
              <span class="grid size-9 place-items-center rounded-full border-2 border-magnet bg-magnet text-2xs font-semibold text-ink shadow-magnet transition-transform group-hover:scale-110 sm:size-11 sm:text-sm">
                {dorsal ?? apellido.slice(0, 2)}
              </span>
            )}

            {dorsal !== null && foto && (
              <span class="absolute -bottom-0.5 -left-1.5 grid size-4.5 place-items-center rounded-full bg-magnet text-[10px] font-bold text-ink shadow-magnet sm:size-5 sm:text-[11px]">
                {dorsal}
              </span>
            )}

            <!-- El número de goles y no un punto: el punto se leía como "figura del partido". -->
            {goles > 0 && (
              <span class="absolute -right-1 -top-1 grid size-4.5 place-items-center rounded-full bg-primary text-[10px] font-bold tabular text-primary-contrast sm:size-5">
                {goles}
              </span>
            )}
            <!-- Dorada, no del color del pizarrón: una estrella verde no se lee como estrella. -->
            {figura && (
              <span
                class="absolute -left-1 -top-1 grid size-4.5 place-items-center rounded-full bg-card-yellow text-board shadow-magnet sm:size-5"
                title="Figura del partido"
              >
                <Icon name="estrella" size={11} class="fill-current" />
                <span class="sr-only">Figura del partido</span>
              </span>
            )}
            {rojas > 0 ? (
              <span class="absolute -right-1 bottom-0 h-3 w-2 rounded-[1px] bg-card-red" />
            ) : amarillas > 0 ? (
              <span class="absolute -right-1 bottom-0 h-3 w-2 rounded-[1px] bg-card-yellow" />
            ) : null}

            <!-- Quién salió y cuándo: la cancha sola no lo decía y era lo que se venía a mirar. -->
            {typeof salioEn === 'number' && (
              <span class="absolute -right-2.5 bottom-1.5 flex items-center gap-px rounded-full bg-board px-1 text-[10px] font-bold tabular text-card-red ring-1 ring-card-red/40">
                <EventIcon kind="sub_out" size={9} detail={`minuto ${salioEn}`} />
                {salioEn}'
              </span>
            )}
          </span>

          <span class="mt-1 max-w-[9ch] truncate rounded bg-board/85 px-1.5 text-[10px] font-medium leading-tight text-chalk sm:max-w-[12ch] sm:text-xs">
            {apellido}
          </span>
        </Etiqueta>
      );
    })()
  }

  {
    rating !== null && (
      <span
        class:list={[
          'mt-0.5 rounded px-1.5 text-[10px] font-semibold tabular sm:text-xs',
          claseDeNota(rating),
        ]}
      >
        {rating.toFixed(1)}
      </span>
    )
  }
</div>
