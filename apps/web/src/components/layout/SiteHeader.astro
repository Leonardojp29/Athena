---
import Icon from '../Icon.astro';
import Logo from '../brand/Logo.astro';
import Container from './Container.astro';

interface Props {
  /* El juego se abre sin contador: ahí el header no compite con la carrera. */
  contador?: boolean;
}

const { contador = true } = Astro.props;
const apiUrl = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:3001';
---

<header class="sticky top-0 z-30 w-full border-b border-border bg-surface/72 backdrop-blur-xl">
  <!-- Hairline de marcador: el detalle que separa un header propio de uno genérico. -->
  <div class="h-px w-full bg-primary/30"></div>

  <Container width="wide">
    <div class="flex h-16 items-center gap-3 sm:gap-6">
      <a
        href="/"
        aria-label="Athena — inicio"
        class="shrink-0 text-ink transition-colors hover:text-primary-ink"
      >
        <Logo size={28} />
      </a>

      <!--
        El buscador va con el logo y no en el grupo de acciones: sin la navegación en el header,
        la mitad izquierda quedaba vacía y eso se lee como inacabado, no como limpio.
      -->
      <!--
        Ancho fijo y sin puntos suspensivos. Con `w-44` que crecía al enfocar, el campo se leía
        como recortado —y "Buscar…" parecía un texto cortado, no una invitación—. La tecla `/` es
        el atajo que espera cualquiera que use esto todos los días.
      -->
      <form method="get" action="/buscar" class="hidden items-center sm:flex">
        <label class="relative flex items-center">
          <Icon name="buscar" size={15} class="absolute left-2.5 text-ink-muted" />
          <input
            type="search"
            name="q"
            data-buscador
            placeholder="Buscar equipos o jugadores"
            aria-label="Buscar equipos, jugadores o competencias"
            class="w-72 rounded-md border border-border bg-canvas-subtle py-1.5 pl-8 pr-9 text-sm outline-none transition-colors focus:border-primary-ink"
          />
          <kbd
            aria-hidden="true"
            class="pointer-events-none absolute right-2 rounded border border-border bg-surface px-1.5 py-0.5 font-sans text-[10px] text-ink-muted"
          >
            /
          </kbd>
        </label>
      </form>

      <div class="ml-auto flex items-center gap-2 sm:gap-3">
        {
          contador && (
            <a
              href="/"
              data-contador-vivo
              hidden
              class="items-center gap-1.5 rounded-full bg-live/12 px-2.5 py-1 text-2xs font-medium text-live-ink transition-colors hover:bg-live/20 sm:flex"
            >
              <span data-live-dot class="size-1.5 rounded-full bg-live animate-live-pulse" />
              <span data-contador-vivo-texto />
            </a>
          )
        }

        <a
          href="/buscar"
          aria-label="Buscar"
          class="rounded-md p-1.5 text-ink-muted transition-colors hover:bg-canvas-subtle hover:text-ink sm:hidden"
        >
          <Icon name="buscar" size={18} />
        </a>

        <!--
          La entrada a los juegos. Va con el grupo de acciones porque es una sección propia y no un
          filtro del catálogo; en móvil queda el icono solo, que es lo que cabe en 16 de alto.
        -->
        <a
          href="/juegos"
          aria-label="Juegos"
          aria-current={Astro.url.pathname.startsWith('/juegos') ? 'page' : undefined}
          class="flex shrink-0 items-center gap-1.5 rounded-md px-1.5 py-1.5 text-ink-muted transition-colors hover:bg-canvas-subtle hover:text-ink aria-[current]:bg-primary/12 aria-[current]:text-primary-ink sm:px-2.5"
        >
          <Icon name="juego" size={18} />
          <span class="hidden text-sm font-medium sm:inline">Juegos</span>
        </a>

        <button
          id="paleta-toggle"
          type="button"
          class="cursor-pointer rounded-md p-1.5 text-ink-muted transition-colors hover:bg-canvas-subtle hover:text-ink"
          aria-label="Cambiar paleta"
        >
          <Icon name="paleta" size={18} />
        </button>

        <button
          id="theme-toggle"
          type="button"
          class="cursor-pointer rounded-md p-1.5 text-ink-muted transition-colors hover:bg-canvas-subtle hover:text-ink"
          aria-label="Cambiar tema"
        >
          <Icon name="tema" size={18} />
        </button>

      </div>
    </div>
  </Container>
</header>

<script>
  /* `/` enfoca el buscador, salvo cuando ya se está escribiendo en otro campo. */
  document.addEventListener('keydown', (evento) => {
    if (evento.key !== '/' || evento.metaKey || evento.ctrlKey) return;
    const activo = document.activeElement;
    if (activo instanceof HTMLInputElement || activo instanceof HTMLTextAreaElement) return;
    const buscador = document.querySelector<HTMLInputElement>('header [data-buscador]');
    if (!buscador) return;
    evento.preventDefault();
    buscador.focus();
  });
</script>

<!--
  El contador se llena desde el navegador y no en el servidor.

  Esperarlo dentro del componente encadenaba un segundo viaje al API después del de la página, y
  como el HTML se guarda cinco minutos en el borde, el número que traía ya venía viejo. Acá el dato
  es fresco en cada visita y no le cuesta un milisegundo al render.
-->
<script is:inline define:vars={{ apiUrl }}>
  const pastilla = document.querySelector('[data-contador-vivo]');
  if (pastilla) {
    fetch(`${apiUrl}/v1/views/en-vivo`)
      .then((r) => (r.ok ? r.json() : null))
      .then((datos) => {
        if (!datos?.live) return;
        pastilla.querySelector('[data-contador-vivo-texto]').textContent = `${datos.live} en vivo`;
        pastilla.hidden = false;
      })
      .catch(() => undefined);
  }
</script>
