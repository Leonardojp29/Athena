---
import Icon from '../Icon.astro';
import Logo from '../brand/Logo.astro';
import Container from './Container.astro';
import { getHomeView } from '../../lib/live';

interface Props {
  session: { user: { email: string | null } } | null;
}

const { session } = Astro.props;
const home = await getHomeView();
const liveCount = home?.live ?? 0;
---

<header class="sticky top-0 z-30 w-full border-b border-border bg-surface/72 backdrop-blur-xl">
  <!-- Hairline de marcador: el detalle que separa un header propio de uno genérico. -->
  <div class="h-px w-full bg-primary/30"></div>

  <Container width="wide">
    <div class="flex h-16 items-center gap-3 sm:gap-6">
      <a
        href="/"
        aria-label="Athena — inicio"
        class="shrink-0 text-ink transition-colors hover:text-primary-ink"
      >
        <Logo size={28} />
      </a>

      <!--
        El buscador va con el logo y no en el grupo de acciones: sin la navegación en el header,
        la mitad izquierda quedaba vacía y eso se lee como inacabado, no como limpio.
      -->
      <!--
        Ancho fijo y sin puntos suspensivos. Con `w-44` que crecía al enfocar, el campo se leía
        como recortado —y "Buscar…" parecía un texto cortado, no una invitación—. La tecla `/` es
        el atajo que espera cualquiera que use esto todos los días.
      -->
      <form method="get" action="/buscar" class="hidden items-center sm:flex">
        <label class="relative flex items-center">
          <Icon name="buscar" size={15} class="absolute left-2.5 text-ink-muted" />
          <input
            type="search"
            name="q"
            data-buscador
            placeholder="Buscar equipos o jugadores"
            aria-label="Buscar equipos, jugadores o competencias"
            class="w-72 rounded-md border border-border bg-canvas-subtle py-1.5 pl-8 pr-9 text-sm outline-none transition-colors focus:border-primary-ink"
          />
          <kbd
            aria-hidden="true"
            class="pointer-events-none absolute right-2 rounded border border-border bg-surface px-1.5 py-0.5 font-sans text-[10px] text-ink-muted"
          >
            /
          </kbd>
        </label>
      </form>

      <div class="ml-auto flex items-center gap-2 sm:gap-3">
        {
          liveCount > 0 && (
            <a
              href="/"
              class="hidden items-center gap-1.5 rounded-full bg-live/12 px-2.5 py-1 text-2xs font-medium text-live-ink transition-colors hover:bg-live/20 sm:flex"
            >
              <span data-live-dot class="size-1.5 rounded-full bg-live animate-live-pulse"></span>
              {liveCount} en vivo
            </a>
          )
        }

        <a
          href="/buscar"
          aria-label="Buscar"
          class="rounded-md p-1.5 text-ink-muted transition-colors hover:bg-canvas-subtle hover:text-ink sm:hidden"
        >
          <Icon name="buscar" size={18} />
        </a>

        <button
          id="theme-toggle"
          type="button"
          class="cursor-pointer rounded-md p-1.5 text-ink-muted transition-colors hover:bg-canvas-subtle hover:text-ink"
          aria-label="Cambiar tema"
        >
          <Icon name="tema" size={18} />
        </button>

        {
          session ? (
            <form method="post" action="/salir" class="shrink-0">
              <button
                type="submit"
                class="cursor-pointer rounded-md px-2 py-1.5 text-sm text-ink-muted transition-colors hover:bg-canvas-subtle hover:text-ink"
                title={session.user.email ?? 'Salir'}
              >
                Salir
              </button>
            </form>
          ) : (
            <a
              href="/entrar"
              class="shrink-0 rounded-md bg-primary px-3 py-1.5 text-sm font-medium text-primary-contrast transition-opacity hover:opacity-90"
            >
              Entrar
            </a>
          )
        }

      </div>
    </div>
  </Container>
</header>

<script>
  /* `/` enfoca el buscador, salvo cuando ya se está escribiendo en otro campo. */
  document.addEventListener('keydown', (evento) => {
    if (evento.key !== '/' || evento.metaKey || evento.ctrlKey) return;
    const activo = document.activeElement;
    if (activo instanceof HTMLInputElement || activo instanceof HTMLTextAreaElement) return;
    const buscador = document.querySelector<HTMLInputElement>('header [data-buscador]');
    if (!buscador) return;
    evento.preventDefault();
    buscador.focus();
  });
</script>
