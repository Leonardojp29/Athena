---
import Buscador from './Buscador.astro';
import Container from './Container.astro';
import Icon from '../Icon.astro';
import Logo from '../brand/Logo.astro';

interface Props {
  /* El juego se abre sin contador: ahí el header no compite con la carrera. */
  contador?: boolean;
}

const { contador = true } = Astro.props;
const apiUrl = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:3001';
---

<!--
  El header vive sobre la banda y no encima de ella.

  Eran dos barras apiladas —una blanca y una marina— y se leían como dos cosas pegadas. Compartiendo
  el fondo, el logo, el buscador y la tira de partidos forman una sola cabecera, como la de un
  diario. Sin `backdrop-blur`: sobre un fondo sólido no aporta nada y cuesta una capa de composición
  en cada scroll.
-->
<header class="sticky top-0 z-30 w-full border-b border-banda-edge bg-banda">

  <Container width="wide">
    <div class="flex h-16 items-center gap-3 sm:gap-6">
      <a
        href="/"
        aria-label="Athena — inicio"
        class="shrink-0 text-chalk transition-colors hover:text-primary"
      >
        <Logo size={28} />
      </a>

      <!--
        El buscador va con el logo y no en el grupo de acciones: sin la navegación en el header,
        la mitad izquierda quedaba vacía y eso se lee como inacabado, no como limpio.

        No es un campo sino la puerta al diálogo. Parece un campo porque eso es lo que la gente
        busca con la vista, pero escribir acá y escribir en el overlay serían dos cajas con el
        mismo texto; una sola evita el salto al enfocar y el estado duplicado.
      -->
      <button
        type="button"
        data-abrir-buscador
        aria-label="Buscar equipos, jugadores o competencias"
        class="hidden min-w-0 max-w-md flex-1 cursor-pointer items-center gap-2.5 rounded-lg border border-chalk/15 bg-chalk/8 py-2 pl-3 pr-2.5 text-left text-sm text-chalk-dim transition-colors hover:border-chalk/25 hover:bg-chalk/12 sm:flex"
      >
        <Icon name="buscar" size={15} class="shrink-0" />
        <span class="min-w-0 flex-1 truncate">Buscar equipos o jugadores</span>
        <kbd
          aria-hidden="true"
          class="shrink-0 rounded border border-chalk/20 px-1.5 py-0.5 font-sans text-[10px]"
        >
          /
        </kbd>
      </button>

      <div class="ml-auto flex shrink-0 items-center gap-2 sm:gap-3">
        {
          contador && (
            <a
              href="/"
              data-contador-vivo
              hidden
              class="items-center gap-1.5 rounded-full bg-live-board/15 px-2.5 py-1 text-2xs font-medium text-live-board transition-colors hover:bg-live-board/25 sm:flex"
            >
              <span data-live-dot class="size-1.5 rounded-full bg-live animate-live-pulse" />
              <span data-contador-vivo-texto />
            </a>
          )
        }

        <button
          type="button"
          data-abrir-buscador
          aria-label="Buscar"
          class="cursor-pointer rounded-md p-1.5 text-chalk-dim transition-colors hover:bg-chalk/10 hover:text-chalk sm:hidden"
        >
          <Icon name="buscar" size={18} />
        </button>

        <!--
          La calculadora va antes de Juegos. No lleva relleno de marca —dos pastillas `bg-primary`
          pegadas se pelean y la que manda es Juegos, que es una sección entera— pero tampoco un
          contorno: sobre la banda un borde se lee como un botón a medio terminar. Va con un relleno
          de tiza al ocho por ciento, y cuando es la página actual pasa a tiza sólida con tinta
          marina, que dice "estás acá" sin competir con el azul de al lado.

          El escudo va en su propio disco claro: el de la Liga 1 es granate sobre transparente y
          sobre azul marino se veía como una mancha.
        -->
        <a
          href="/calculadora"
          aria-label="Calculadora Liga 1"
          aria-current={Astro.url.pathname.startsWith('/calculadora') ? 'page' : undefined}
          class="group flex shrink-0 items-center gap-2 rounded-full bg-chalk/8 py-1 pl-1 pr-1 text-chalk transition-colors hover:bg-chalk/16 aria-[current]:bg-chalk aria-[current]:text-banda sm:pr-3.5"
        >
          <span class="grid size-7 shrink-0 place-items-center rounded-full bg-chalk">
            <img loading="lazy"
              src="/competencias/liga1.png"
              alt=""
              width="18"
              height="18"
              class="size-[18px] object-contain"
            />
          </span>
          <span class="hidden text-sm font-medium leading-none sm:inline">
            Calculadora
            <span class="text-chalk-dim group-aria-[current]:text-banda/75">Liga 1</span>
          </span>
        </a>

        <!--
          La entrada a los juegos. Va con el grupo de acciones porque es una sección propia y no un
          filtro del catálogo; en móvil queda el icono solo, que es lo que cabe en 16 de alto.
        -->
        <a
          href="/juegos"
          aria-label="Juegos"
          aria-current={Astro.url.pathname.startsWith('/juegos') ? 'page' : undefined}
          class="flex shrink-0 items-center gap-1.5 rounded-lg bg-primary px-2 py-1.5 font-medium text-primary-contrast transition-colors hover:brightness-110 aria-[current]:ring-2 aria-[current]:ring-chalk/40 sm:px-3"
        >
          <Icon name="juego" size={18} />
          <span class="hidden text-sm font-medium sm:inline">Juegos</span>
        </a>

        <button
          id="theme-toggle"
          type="button"
          class="cursor-pointer rounded-md p-1.5 text-chalk-dim transition-colors hover:bg-chalk/10 hover:text-chalk"
          aria-label="Cambiar tema"
        >
          <Icon name="tema" size={18} />
        </button>

      </div>
    </div>
  </Container>
</header>

<!--
  El contador se llena desde el navegador y no en el servidor.

  Esperarlo dentro del componente encadenaba un segundo viaje al API después del de la página, y
  como el HTML se guarda cinco minutos en el borde, el número que traía ya venía viejo. Acá el dato
  es fresco en cada visita y no le cuesta un milisegundo al render.
-->
<script is:inline define:vars={{ apiUrl }}>
  const pastilla = document.querySelector('[data-contador-vivo]');
  if (pastilla) {
    fetch(`${apiUrl}/v1/views/en-vivo`)
      .then((r) => (r.ok ? r.json() : null))
      .then((datos) => {
        if (!datos?.live) return;
        pastilla.querySelector('[data-contador-vivo-texto]').textContent = `${datos.live} en vivo`;
        pastilla.hidden = false;
      })
      .catch(() => undefined);
  }
</script>

<Buscador />
