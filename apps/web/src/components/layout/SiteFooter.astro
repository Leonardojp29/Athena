---
import LogoMark from '../brand/LogoMark.astro';
import Container from './Container.astro';

/*
 * Un pie de una línea.
 *
 * Tenía tres columnas con enlaces a competencias y medía 324px: en una vista que tiene que
 * entrar en una pantalla de 1080, eso solo garantiza scroll. Y desde que el catálogo completo
 * vive en el cajón del header, repetir seis ligas acá era ruido con costo.
 */
const anio = new Date().getFullYear();
---

<footer class="mt-10 w-full border-t border-border bg-canvas-subtle">
  <Container width="wide">
    <div class="flex flex-wrap items-center gap-x-5 gap-y-2 py-4 text-2xs text-ink-muted">
      <span class="flex items-center gap-1.5 text-ink">
        <LogoMark size={18} detail="compact" />
        <span class="font-display font-semibold tracking-tight uppercase">Athena</span>
      </span>

      <span class="hidden sm:inline">
        Cada cifra viene con su origen y cada análisis con la evidencia que lo sostiene.
      </span>

      <span class="ml-auto flex flex-wrap items-center gap-x-4 gap-y-1">
        <a href="/competencias" class="transition-colors hover:text-ink">Competencias</a>
        <a href="/partidos" class="transition-colors hover:text-ink">Calendario</a>
        <span>Datos por API-Football</span>
        <span>© {anio}</span>
      </span>
    </div>
  </Container>
</footer>
