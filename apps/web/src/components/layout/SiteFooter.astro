---
import ContinentIcon from '../ContinentIcon.astro';
import LogoMark from '../brand/LogoMark.astro';
import Container from './Container.astro';
import { getNavTree } from '../../lib/nav';
import { paisEnEspanol } from '../../lib/paises';

const tree = await getNavTree();
const anio = new Date().getFullYear();

/* En el pie no cabe el catálogo entero: un país por continente y sus torneos principales. */
const columnas = tree.slice(0, 3).map((continente) => ({
  ...continente,
  destacadas: continente.countries.flatMap((pais) =>
    pais.competitions.slice(0, 2).map((c) => ({ ...c, pais: pais.name })),
  ).slice(0, 6),
}));
---

<footer class="mt-16 w-full border-t border-border bg-canvas-subtle">
  <Container width="wide">
    <div class="grid gap-8 py-10 sm:grid-cols-2 lg:grid-cols-[1.2fr_repeat(3,1fr)]">
      <div class="max-w-[38ch]">
        <div class="flex items-center gap-2 text-ink">
          <LogoMark size={26} detail="compact" />
          <span class="font-display text-lg font-semibold tracking-tight uppercase">Athena</span>
        </div>
        <p class="mt-3 text-sm text-ink-muted">
          Inteligencia futbolística: cada cifra viene con su origen y cada análisis con la evidencia
          que lo sostiene.
        </p>
      </div>

      {
        columnas.map((continente) => (
          <nav aria-label={continente.label}>
            <p class="mb-2 flex items-center gap-1.5 text-2xs font-semibold tracking-label text-ink-muted uppercase">
              <ContinentIcon name={continente.continent} size={12} />
              {continente.label}
            </p>
            <ul class="grid gap-1">
              {continente.destacadas.map((competition) => (
                <li>
                  <a
                    href={`/competencias/${competition.slug}`}
                    class="text-sm text-ink-muted transition-colors hover:text-ink"
                    title={paisEnEspanol(competition.pais) ?? undefined}
                  >
                    {competition.name}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <div
      class="flex flex-wrap items-center justify-between gap-3 border-t border-border py-5 text-2xs text-ink-muted"
    >
      <span>© {anio} Athena</span>
      <div class="flex flex-wrap items-center gap-4">
        <a href="/competencias" class="transition-colors hover:text-ink">Competencias</a>
        <a href="/partidos" class="transition-colors hover:text-ink">Partidos</a>
        <span>Datos por API-Football</span>
      </div>
    </div>
  </Container>
</footer>
