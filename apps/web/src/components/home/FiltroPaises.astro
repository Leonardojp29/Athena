---
import type { GeographyContinent } from '../../lib/api';
import ContinentIcon from '../ContinentIcon.astro';
import CountryFlag from '../CountryFlag.astro';
import Icon from '../Icon.astro';
import { paisEnEspanol } from '../../lib/paises';

/*
 * El filtro vive en la página y no en el header, y filtra por URL (`?pais=PE`).
 *
 * Por URL y no con JavaScript: el estado es compartible, el botón atrás funciona, la página
 * sigue en 0 KB y —lo mejor— `@view-transition` anima el cambio de lista sin una línea de
 * script. Un filtro hidratado costaría un bundle para hacer lo mismo peor.
 */
interface Props {
  geography: GeographyContinent[];
  activo: string | null;
  /** Base de la URL: la home y el calendario comparten el componente. */
  base: string;
  /** Parámetros que hay que conservar al filtrar, como la fecha. */
  extra?: Record<string, string>;
}

const { geography, activo, base, extra = {} } = Astro.props;

const href = (pais: string | null) => {
  const params = new URLSearchParams(extra);
  if (pais) params.set('pais', pais);
  const query = params.toString();
  return query ? `${base}?${query}` : base;
};

const total = geography.reduce(
  (n, c) =>
    n + c.countries.reduce((m, p) => m + p.competitions.reduce((k, t) => k + t.matches.length, 0), 0),
  0,
);
---

<nav aria-label="Filtrar por país" class="grid gap-3">
  <a
    href={href(null)}
    aria-current={activo === null ? 'page' : undefined}
    class:list={[
      'flex items-center gap-2 rounded-lg border px-3 py-2 text-sm transition-colors',
      activo === null
        ? 'border-primary-ink bg-primary/10 font-medium text-ink'
        : 'border-border text-ink-muted hover:border-border-strong hover:text-ink',
    ]}
  >
    <Icon name="cancha" size={15} />
    Todos los países
    <span class="ml-auto tabular text-2xs text-ink-muted">{total}</span>
  </a>

  {
    geography.map((continente) => (
      <div>
        <p class="mb-1 flex items-center gap-1.5 px-1 text-2xs font-semibold tracking-label text-ink-muted uppercase">
          <ContinentIcon name={continente.continent} size={12} />
          {continente.label}
        </p>

        <ul class="grid gap-0.5">
          {continente.countries.map((pais) => {
            const clave = pais.code ?? 'internacional';
            const partidos = pais.competitions.reduce((n, t) => n + t.matches.length, 0);
            const vivos = pais.competitions.reduce(
              (n, t) => n + t.matches.filter((m) => m.status === 'in_play' || m.status === 'paused').length,
              0,
            );
            return (
              <li>
                <a
                  href={href(clave)}
                  aria-current={activo === clave ? 'page' : undefined}
                  class:list={[
                    'flex items-center gap-2 rounded-md px-2 py-1.5 text-sm transition-colors',
                    activo === clave
                      ? 'bg-primary/12 font-medium text-ink'
                      : 'text-ink-muted hover:bg-canvas-subtle hover:text-ink',
                  ]}
                >
                  <CountryFlag
                    url={pais.flagUrl}
                    code={pais.code}
                    name={paisEnEspanol(pais.name)}
                    size={17}
                  />
                  <span class="min-w-0 flex-1 truncate">
                    {paisEnEspanol(pais.name) ?? 'Internacional'}
                  </span>
                  {vivos > 0 ? (
                    <span class="flex items-center gap-1 text-2xs font-medium text-live">
                      <span class="size-1.5 rounded-full bg-live animate-live-pulse" />
                      {vivos}
                    </span>
                  ) : (
                    <span class="tabular text-2xs text-ink-muted">{partidos}</span>
                  )}
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    ))
  }
</nav>
