---
import Icon from '../Icon.astro';
import Pestanas from '../competencia/Pestanas.astro';
import SelectorFase from '../SelectorFase.astro';
import StandingsTable from '../StandingsTable.astro';
import type { CompetitionView, LlaveDeCuadro } from '../../lib/api';
import { formatDate } from '../../lib/format';
import { nombreFase } from '../../lib/paises';

/*
 * El "cómo va" de la competencia abierta, en el riel derecho de la home.
 *
 * En una liga es su tabla. En una copa son dos cosas y la que importa cambia con el calendario: con
 * los octavos en marcha, la tabla de la fase de grupos —cerrada en mayo— no dice nada, y con la fase
 * de grupos en marcha el cuadro todavía no existe. Así que hay dos pestañas y se abre la de la etapa
 * en juego; la otra queda a un clic y, si no tiene datos, dice por qué.
 *
 * En 24rem no entran nueve columnas ni una llave con sus dos partidos, así que la tabla va compacta y
 * el cuadro va como escalera: una ronda debajo de la otra con quién juega con quién.
 */
interface Props {
  view: CompetitionView;
  /** Etiqueta de la fase pedida por la URL; si no viene, se abre la que está en juego. */
  fase?: string | null;
  /** Qué pestaña pidió la URL: `cuadro` o `grupos`. */
  vista?: string | null;
}

const { view, fase = null, vista = null } = Astro.props;
const { competition, standingGroups, etapas, etapaEnJuego } = view;

/*
 * El API manda la fase en juego primero, así que el grupo por defecto es el primero y no hay que
 * volver a decidirlo acá. Antes se abría el Apertura —cerrado en mayo— mientras se jugaba el
 * Clausura, y la tabla mostraba una foto de otro torneo.
 */
const grupo = standingGroups.find((g) => g.label === fase) ?? standingGroups[0];

/* El cuadro del riel es el de la fase final: la previa se lee en la página de la copa. */
const cuadro = (etapas.find((f) => f.etapa === 'final')?.rondas ?? []).filter(
  (r) => r.ties.length > 0,
);
const esCopa = etapas.length > 0;
const hayCuadro = cuadro.length > 0;

/*
 * Una ronda por vez, con flechas. Una Copa del Rey en dieciseisavos son dieciséis llaves y todas las
 * rondas apiladas hacían un riel interminable; así se ve la que se está jugando y se puede ir atrás
 * —cómo llegó cada uno— o adelante. La que arranca visible es la del calendario.
 */
const rondaInicial = (() => {
  const enJuego = cuadro.findIndex((r) => r.enJuego);
  if (enJuego !== -1) return enJuego;
  /* Sin coincidencia, la última con algo jugado: es donde está el torneo. */
  const jugada = cuadro.map((r) => r.ties.some((t) => t.aggregate !== null)).lastIndexOf(true);
  return jugada === -1 ? 0 : jugada;
})();

const abierta = (() => {
  if (!esCopa) return 'grupos';
  if (vista === 'cuadro' && hayCuadro) return 'cuadro';
  if (vista === 'grupos' && grupo) return 'grupos';
  return etapaEnJuego === 'grupos' && grupo ? 'grupos' : hayCuadro ? 'cuadro' : 'grupos';
})();

const enlace = (id: string) => {
  const params = new URLSearchParams({ liga: competition.slug });
  if (id !== 'cuadro' && fase) params.set('tabla', fase);
  if (esCopa) params.set('vista', id);
  return `/?${params}`;
};

const pestanas = [
  {
    id: 'cuadro',
    label: 'Cuadro',
    vacia: hayCuadro ? null : 'El cuadro se define cuando termine la fase de grupos',
  },
  {
    id: 'grupos',
    label: standingGroups.length > 1 ? 'Grupos' : 'Tabla',
    vacia: grupo ? null : 'Todavía no hay tabla de esta competencia',
  },
];

const nombreCorto = (equipo: { name: string; shortName: string | null }) =>
  equipo.shortName ?? equipo.name;

const golesDe = (leg: LlaveDeCuadro['legs'][number], teamId: string): number | null => {
  if (leg.homeScore === null || leg.awayScore === null) return null;
  return leg.homeTeam.id === teamId ? leg.homeScore : leg.awayScore;
};
---

{
  (grupo || hayCuadro) && (
    <section class="overflow-hidden rounded-xl border border-border bg-surface">
      <header class="border-b border-border p-3 pb-0">
        <h2 class="mb-2 flex items-center gap-2 font-display text-sm font-semibold uppercase leading-none">
          {esCopa ? 'Cómo va la copa' : 'Tabla de posiciones'}
          {!esCopa && grupo && (
            <span class="font-sans text-2xs font-medium normal-case text-ink-muted">
              {standingGroups.length === 1 && grupo.label
                ? `${nombreFase(grupo.label)} · ${grupo.rows.length} equipos`
                : `${grupo.rows.length} equipos`}
            </span>
          )}
        </h2>
        {esCopa ? (
          <Pestanas
            pestanas={pestanas}
            activa={abierta}
            href={enlace}
            etiqueta="Cómo va la copa"
          />
        ) : (
          <div class="pb-3">
            <SelectorFase
              grupos={standingGroups}
              activo={grupo?.label ?? ''}
              href={(label) => `/?liga=${competition.slug}&tabla=${encodeURIComponent(label)}`}
            />
          </div>
        )}
      </header>

      {abierta === 'cuadro' ? (
        /*
         * Una ronda por vez: en 24rem una llave con sus dos marcadores no entra al lado de otra, y
         * apilar todas las rondas hacía un riel de tres pantallas.
         */
        <div data-rondas>
          {/* Con una sola ronda no hay a dónde ir: las flechas serían dos botones muertos. */}
          {cuadro.length > 1 && (
          <div class="flex items-center gap-1.5 border-b border-border px-2 py-1.5">
            <button
              type="button"
              data-ronda-anterior
              class="grid size-6 shrink-0 cursor-pointer place-items-center rounded text-ink-muted transition-colors hover:bg-canvas-subtle hover:text-ink disabled:cursor-default disabled:opacity-25"
              aria-label="Ronda anterior"
            >
              <Icon name="chevron-derecha" size={14} class="rotate-180" />
            </button>
            <span class="flex flex-1 items-center justify-center gap-1">
              {cuadro.map((ronda, i) => (
                <button
                  type="button"
                  data-ronda-punto={i}
                  aria-current={i === rondaInicial ? 'true' : undefined}
                  class="size-1.5 cursor-pointer rounded-full bg-border-strong transition-colors hover:bg-ink-muted aria-[current]:bg-primary-ink"
                  aria-label={ronda.label}
                  title={ronda.label}
                />
              ))}
            </span>
            <button
              type="button"
              data-ronda-siguiente
              class="grid size-6 shrink-0 cursor-pointer place-items-center rounded text-ink-muted transition-colors hover:bg-canvas-subtle hover:text-ink disabled:cursor-default disabled:opacity-25"
              aria-label="Ronda siguiente"
            >
              <Icon name="chevron-derecha" size={14} />
            </button>
          </div>
          )}

          {cuadro.map((ronda, i) => (
            <div data-ronda-panel hidden={i !== rondaInicial} class="p-2">
              <p class="mb-1 flex items-center gap-1.5 px-1 text-2xs font-semibold uppercase tracking-label text-ink-muted">
                <span class:list={[ronda.enJuego ? 'text-primary-ink' : '']}>{ronda.label}</span>
              </p>
              <!-- Con dieciséis llaves la ronda no entra en pantalla: scroll propio y listo. -->
              <ul class="grid max-h-[26rem] gap-1 overflow-y-auto overscroll-contain">
                  {ronda.ties.map((llave) => (
                    <li>
                      <a
                        href={`/competencias/${competition.slug}?partido=${(llave.legs.filter((l) => l.status === 'finished').at(-1) ?? llave.legs[0])?.id}`}
                        class="grid gap-0.5 rounded-md border border-border bg-canvas-subtle/40 px-2 py-1.5 transition-colors hover:border-border-strong"
                      >
                        {[llave.homeTeam, llave.awayTeam].map((equipo) => {
                          const paso = llave.advancedTeamId === equipo.id;
                          return (
                            <span class="flex items-center gap-1.5">
                              {equipo.logoUrl && (
                                <img
                                  src={equipo.logoUrl}
                                  alt=""
                                  width="14"
                                  height="14"
                                  loading="lazy"
                                  class="size-3.5 shrink-0 object-contain"
                                />
                              )}
                              <span
                                class:list={[
                                  'min-w-0 flex-1 truncate text-2xs',
                                  paso ? 'font-semibold' : 'text-ink-muted',
                                ]}
                              >
                                {nombreCorto(equipo)}
                              </span>
                              {llave.legs.map((leg) => (
                                <span class="w-3 shrink-0 text-center font-display text-2xs font-semibold tabular">
                                  {golesDe(leg, equipo.id) ?? '–'}
                                </span>
                              ))}
                            </span>
                          );
                        })}
                        {llave.legs[0] && llave.aggregate === null && (
                          <span class="text-[10px] text-ink-muted">
                            {formatDate(llave.legs[0].kickoffUtc)}
                          </span>
                        )}
                      </a>
                    </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      ) : (
        grupo && (
          <>
            {esCopa && standingGroups.length > 1 && (
              <div class="border-b border-border px-2 py-2">
                <SelectorFase
                  grupos={standingGroups}
                  activo={grupo.label}
                  href={(label) =>
                    `/?liga=${competition.slug}&vista=grupos&tabla=${encodeURIComponent(label)}`
                  }
                />
              </div>
            )}
            <div class="p-2">
              <StandingsTable
                rows={grupo.rows}
                compacto
                maxAlto="26rem"
                hrefEquipo={(slug) => `/?equipo=${slug}`}
              />
            </div>
          </>
        )
      )}

      <!-- El pie dice que hay más de lo que se ve y da la salida a la copa completa. -->
      <a
        href={`/competencias/${competition.slug}`}
        class="flex items-center justify-between gap-2 border-t border-border px-3 py-2 text-2xs text-ink-muted transition-colors hover:text-primary-ink"
      >
        {esCopa ? 'Ver el cuadro completo y la fase previa' : 'Tabla completa, con G-E-P y forma'}
        <Icon name="chevron-derecha" size={12} />
      </a>
    </section>
  )
}

<script>
  /*
   * Navegación de rondas del cuadro: cambia de panel al instante, sin navegar. El sentido va al
   * contenedor para que la animación entre desde el lado correcto, que es lo que hace que se lea como
   * un movimiento y no como un salto.
   */
  document.querySelectorAll<HTMLElement>('[data-rondas]').forEach((caja) => {
    const paneles = [...caja.querySelectorAll<HTMLElement>('[data-ronda-panel]')];
    if (paneles.length < 2) return;

    const anterior = caja.querySelector<HTMLButtonElement>('[data-ronda-anterior]');
    const siguiente = caja.querySelector<HTMLButtonElement>('[data-ronda-siguiente]');
    const puntos = [...caja.querySelectorAll<HTMLButtonElement>('[data-ronda-punto]')];
    let actual = paneles.findIndex((p) => !p.hidden);

    const mostrar = (indice: number) => {
      const destino = Math.min(paneles.length - 1, Math.max(0, indice));
      caja.dataset.sentido = destino > actual ? 'adelante' : 'atras';
      actual = destino;
      paneles.forEach((panel, i) => {
        panel.hidden = i !== actual;
      });
      puntos.forEach((punto, i) => {
        if (i === actual) punto.setAttribute('aria-current', 'true');
        else punto.removeAttribute('aria-current');
      });
      if (anterior) anterior.disabled = actual === 0;
      if (siguiente) siguiente.disabled = actual === paneles.length - 1;
    };

    anterior?.addEventListener('click', () => mostrar(actual - 1));
    siguiente?.addEventListener('click', () => mostrar(actual + 1));
    puntos.forEach((punto, i) => punto.addEventListener('click', () => mostrar(i)));
    mostrar(actual);
  });
</script>
