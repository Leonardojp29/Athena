---
import EscudoTorneo from '../EscudoTorneo.astro';
import BotonFavorito from '../BotonFavorito.astro';
import CountryFlag from '../CountryFlag.astro';
import Icon from '../Icon.astro';
import MatchRow from '../MatchRow.astro';
import PlantillaCompacta from './PlantillaCompacta.astro';
import TablaLideres from '../TablaLideres.astro';
import type { TeamView } from '../../lib/api';
import { mezclaRondas } from '../../lib/rondas';
import { temaEquipo } from '../../lib/color';
import { nombreFase, nombreTorneo, paisEnEspanol } from '../../lib/paises';

/*
 * El equipo abierto dentro de la home, igual que la liga: cómo va en cada torneo, lo que viene y lo
 * último, sin cambiar de página. Desde una tabla de posiciones, tocar un equipo abría otra pantalla
 * y perdías el día entero de vista.
 *
 * El orden es el mismo que en la liga: primero lo que se juega —a todo el ancho, una fila por
 * partido—, después quiénes lo definen y al final la plantilla. Con qué salió en su último partido
 * vive en el riel, sobre la cancha.
 */
interface Props {
  view: TeamView;
  conCuenta?: boolean;
}

const { view, conCuenta = false } = Astro.props;
const { team, standings, recent, upcoming, squad, scorers } = view;
const pais = paisEnEspanol(team.country);

/*
 * La camiseta como superficie de la cabecera, con la tinta elegida por luminancia. El lavado
 * tímido no funcionaba: el azul casi negro de Alianza al 28% sobre la pizarra era invisible.
 */
const tema = temaEquipo(team.primaryColor, team.secondaryColor);
const varsCabecera = tema
  ? `background-image:${tema.fondo};--tinta:${tema.tinta};--tinta-suave:${tema.tintaSuave};--tinta-tenue:${tema.tintaTenue};--linea:${tema.linea};--chip:${tema.chip}`
  : '--tinta:var(--color-chalk);--tinta-suave:var(--color-chalk-dim);--tinta-tenue:color-mix(in oklab, var(--color-chalk) 30%, transparent);--linea:color-mix(in oklab, var(--color-chalk) 16%, transparent);--chip:color-mix(in oklab, var(--color-chalk) 10%, transparent)';

/* La forma como la cuenta el hincha: del partido más viejo al último. */
const FORMA: Record<string, { letra: string; clase: string }> = {
  W: { letra: 'V', clase: 'bg-primary text-primary-contrast' },
  D: { letra: 'E', clase: 'bg-border-strong text-ink' },
  L: { letra: 'D', clase: 'bg-card-red/85 text-chalk' },
};
const ultimos = (form: string | null) =>
  form === null ? [] : [...form.slice(0, 5)].reverse().flatMap((c) => FORMA[c] ?? []);

/* El API manda la fase en juego primero: la primera fila es "cómo va hoy". */
const principal = standings[0] ?? null;

const bloques = [
  { titulo: 'Próximos partidos', icono: 'reloj' as const, partidos: upcoming.slice(0, 6) },
  { titulo: 'Últimos resultados', icono: 'cancha' as const, partidos: recent.slice(0, 6) },
].filter((bloque) => bloque.partidos.length > 0);
---

<section
  class="overflow-hidden rounded-xl border border-border bg-surface"
  style={`view-transition-name: equipo-${team.slug}`}
>
  {tema && <span class="block h-1 w-full" style={`background:${tema.franja}`} aria-hidden="true" />}
  <header
    class="relative flex flex-wrap items-center gap-x-3 gap-y-2 overflow-hidden border-b border-board-edge bg-board p-3"
    style={varsCabecera}
  >
    {
      team.logoUrl && (
        <img
          src={team.logoUrl}
          alt=""
          width="120"
          height="120"
          aria-hidden="true"
          class="pointer-events-none absolute -top-4 right-2 size-28 opacity-10"
          style="mask-image:linear-gradient(115deg, transparent 20%, black 85%)"
        />
      )
    }
    {
      team.logoUrl && (
        <span class="grid size-14 shrink-0 place-items-center rounded-xl bg-chalk shadow-card">
          <img src={team.logoUrl} alt="" width="40" height="40" class="size-10" />
        </span>
      )
    }
    <div class="relative min-w-0 flex-1 basis-40">
      <h2 class="truncate font-display text-2xl font-semibold uppercase leading-none text-(--tinta)">
        {team.name}
      </h2>
      <p class="mt-1 flex flex-wrap items-center gap-x-1.5 text-2xs text-(--tinta-suave)">
        <CountryFlag name={pais} size={14} />
        {pais ?? 'Internacional'}
        {
          team.founded !== null && (
            <>
              <span class="text-(--tinta-tenue)">·</span>
              desde {team.founded}
            </>
          )
        }
      </p>
    </div>

    <!-- En móvil los botones se van a su propia línea: en la misma, el título se comía a "PRI…". -->
    <div class="relative flex w-full shrink-0 items-center gap-2 sm:w-auto">
      <BotonFavorito
        tipo="equipo"
        id={team.id}
        slug={team.slug}
        nombre={team.name}
        logoUrl={team.logoUrl}
        pais={pais}
        variante="boton"
        conCuenta={conCuenta}
        onBoard
        class="!border-(--linea) !text-(--tinta) hover:!border-(--tinta-suave) aria-pressed:!border-(--tinta) aria-pressed:!bg-(--chip) aria-pressed:!text-(--tinta)"
      />
      <a
        href={`/equipos/${team.slug}`}
        class="flex items-center gap-1.5 rounded-md bg-primary px-3 py-1.5 text-2xs font-medium text-primary-contrast transition-opacity hover:opacity-90"
      >
        Ver el equipo completo
        <Icon name="chevron-derecha" size={12} />
      </a>
    </div>
  </header>

  {
    principal && (
      <div
        class="flex flex-wrap items-center gap-x-6 gap-y-3 border-b border-border p-3"
        style={tema ? `background:linear-gradient(180deg, ${tema.lavado(0.08)}, ${tema.lavado(0.02)})` : undefined}
      >
        <div>
          <p class="font-display text-2xl font-semibold leading-none tabular">{`${principal.position}º`}</p>
          <p class="mt-1 flex items-center gap-1 text-2xs text-ink-muted">
            <EscudoTorneo url={principal.season.competition.logoUrl} size={12} />
            <a
              href={`/?liga=${principal.season.competition.slug}`}
              class="truncate hover:text-primary-ink hover:underline"
            >
              {nombreTorneo(principal.season.competition.name)}
              {principal.groupLabel ? ` · ${nombreFase(principal.groupLabel)}` : ''}
            </a>
          </p>
        </div>

        {[
          { valor: principal.points, etiqueta: 'puntos' },
          { valor: principal.played, etiqueta: 'jugados' },
          { valor: `${principal.won}-${principal.drawn}-${principal.lost}`, etiqueta: 'G-E-P' },
          { valor: principal.goalsFor - principal.goalsAgainst, etiqueta: 'diferencia' },
        ].map((cifra) => (
          <div>
            <p class="font-display text-lg font-semibold leading-none tabular">{cifra.valor}</p>
            <p class="mt-1 text-2xs tracking-label text-ink-muted uppercase">{cifra.etiqueta}</p>
          </div>
        ))}

        {ultimos(principal.form).length > 0 && (
          <div>
            <span class="flex gap-0.5">
              {ultimos(principal.form).map((r) => (
                <span
                  class:list={[
                    'grid size-4 place-items-center rounded-[2px] text-[9px] font-bold',
                    r.clase,
                  ]}
                >
                  {r.letra}
                </span>
              ))}
            </span>
            <p class="mt-1 text-2xs tracking-label text-ink-muted uppercase">forma</p>
          </div>
        )}
      </div>
    )
  }

  {
    standings.length > 1 && (
      <div class="flex flex-wrap gap-x-4 gap-y-1 border-b border-border px-3 py-2 text-2xs">
        {standings
          .filter((fila) => fila !== principal)
          .map((fila) => (
            <a
              href={`/?liga=${fila.season.competition.slug}`}
              class="flex items-center gap-1.5 text-ink-muted transition-colors hover:text-ink"
            >
              <EscudoTorneo url={fila.season.competition.logoUrl} size={12} />
              <span class="truncate">
                {nombreTorneo(fila.season.competition.name)}
                {fila.groupLabel ? ` · ${nombreFase(fila.groupLabel)}` : ''}
              </span>
              <span class="font-medium tabular text-ink">{fila.position}º</span>
            </a>
          ))}
      </div>
    )
  }

  {
    bloques.length > 0 ? (
      bloques.map((bloque) => (
        <div class="border-b border-border p-3">
          <h3 class="mb-1 flex items-center gap-1.5 text-2xs font-semibold uppercase tracking-label text-ink-muted">
            <Icon name={bloque.icono} size={12} />
            {bloque.titulo}
            <span class="tabular">({bloque.partidos.length})</span>
          </h3>
          <!-- Con tope de ancho: los nombres quedaban flotando lejos del marcador. -->
          <ul class="mx-auto grid max-w-[42rem]">
            {bloque.partidos.map((match) => (
              <li>
                <MatchRow
                  match={match}
                  showDate
                  destacado={team.slug}
                  mostrarRonda={mezclaRondas(bloque.partidos)}
                  hrefEquipo={(slug) => `/?equipo=${slug}`}
                />
              </li>
            ))}
          </ul>
        </div>
      ))
    ) : (
      <p class="border-b border-border p-3 text-sm text-ink-muted">
        Todavía no hay partidos sincronizados de este equipo.
      </p>
    )
  }

  {
    scorers.length > 0 && (
      <div class="border-b border-border p-3">
        <TablaLideres
          titulo="Goleadores del equipo"
          lideres={scorers}
          metrica="goals"
          filas={5}
          hrefEquipo={(slug) => `/?equipo=${slug}`}
          hrefJugador={(slug) => `/?jugador=${slug}`}
        />
      </div>
    )
  }

  <div class="p-3">
    <PlantillaCompacta squad={squad} hrefJugador={(slug) => `/?jugador=${slug}`} />
  </div>
</section>
