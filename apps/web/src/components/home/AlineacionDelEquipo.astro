---
import CanchaOnce from '../pitch/CanchaOnce.astro';
import Icon from '../Icon.astro';
import EventIcon from '../EventIcon.astro';
import type { MatchPlayerStats, TeamSummary, UltimaAlineacion } from '../../lib/api';
import { fichaJson, type FichaOnce } from '../../lib/once';
import { formatDate } from '../../lib/format';
import { nombreTorneo } from '../../lib/paises';

/*
 * Con qué salió el equipo, sobre la cancha, con flechas para moverse entre fechas.
 *
 * Es la pregunta que se hace un hincha cuando abre a su equipo, y el dato estaba en la base sin que
 * ninguna vista fuera del partido lo mostrara. En el riel del equipo reemplaza a los goleadores del
 * mundo, que ahí no dicen nada: quien vino a ver a Alianza no vino a ver quién la rompe en Europa.
 *
 * Las cinco alineaciones vienen en el HTML y la flecha solo cambia de panel: el clic es instantáneo
 * y no cuesta una navegación. No encarece la entrada porque las fotos de los paneles ocultos no se
 * piden —un `loading="lazy"` dentro de un `display:none` nunca intersecta la pantalla— y el JSON de
 * las fichas comprime cerca de 5:1.
 *
 * Se dibuja con el `grid` del proveedor, así que las fichas quedan donde jugaron —un 4-1-3-2 se ve
 * como un 4-1-3-2— y cada una abre las estadísticas de ese partido, no el promedio de la temporada.
 */
interface Props {
  alineaciones: UltimaAlineacion[];
  equipo: TeamSummary;
  /** Id del partido pedido por la URL: decide qué panel arranca visible. */
  fechaPedida?: string | null;
}

const { alineaciones, equipo, fechaPedida = null } = Astro.props;

/*
 * En orden de calendario, del más viejo al último: así la flecha izquierda es el partido anterior y
 * la derecha el siguiente, que es lo que espera cualquiera. El API los manda del más reciente para
 * atrás porque es lo que se abre por omisión.
 */
const enOrden = [...alineaciones].reverse();
const pedido = enOrden.findIndex((a) => a.match.id === fechaPedida);
const indiceInicial = pedido === -1 ? enOrden.length - 1 : pedido;

/* El puesto sale de la nota del partido —`G`, `D`, `M`, `F`— y si no hay nota, del rótulo del
   proveedor en la alineación. Solo ordena las fichas: la casilla es la que las coloca. */
const PUESTO_POR_ROTULO: Record<string, string> = {
  arquero: 'G',
  defensor: 'D',
  mediocampista: 'M',
  delantero: 'F',
};

/* El mismo payload que la cancha del partido: el clic abre la ficha sin pedir nada al servidor. */
const ficha = (nota: MatchPlayerStats): string =>
  fichaJson({
    playerId: nota.player.id,
    slug: nota.player.slug,
    name: nota.player.name,
    photoUrl: nota.player.photoUrl,
    number: nota.shirtNumber,
    position: nota.position,
    team: { name: equipo.name, slug: equipo.slug, logoUrl: equipo.logoUrl },
    stats: nota,
  });

const apellido = (nombre: string) => nombre.split(' ').at(-1) ?? nombre;

const paneles = enOrden.map((alineacion) => {
  const { match, formation, coachName, startXi, substitutes, substitutions, stats } = alineacion;

  const rival = match.homeTeam.id === equipo.id ? match.awayTeam : match.homeTeam;
  const deLocal = match.homeTeam.id === equipo.id;
  const golesPropios = deLocal ? match.homeScore : match.awayScore;
  const golesRival = deLocal ? match.awayScore : match.homeScore;

  const resultado =
    golesPropios === null || golesRival === null
      ? null
      : golesPropios > golesRival
        ? { letra: 'V', clase: 'bg-primary text-primary-contrast', titulo: 'Victoria' }
        : golesPropios === golesRival
          ? { letra: 'E', clase: 'bg-border-strong text-ink', titulo: 'Empate' }
          : { letra: 'D', clase: 'bg-card-red/85 text-chalk', titulo: 'Derrota' };

  const notaPorJugador = new Map(stats.map((s) => [s.player.id, s]));
  const salidaPorJugador = new Map(
    substitutions.filter((c) => c.sale !== null).map((c) => [c.sale?.id as string, c.minute]),
  );
  const entradaPorJugador = new Map(
    substitutions.filter((c) => c.entra !== null).map((c) => [c.entra?.id as string, c]),
  );

  const jugadores: FichaOnce[] = startXi.map((titular) => {
    const nota = titular.playerId === null ? undefined : notaPorJugador.get(titular.playerId);
    return {
      puesto: nota?.position ?? PUESTO_POR_ROTULO[titular.position ?? ''] ?? 'M',
      nombre: nota?.player.name ?? titular.name,
      href: titular.slug ? `/?jugador=${titular.slug}` : `/partidos/${match.id}`,
      fotoUrl: titular.photoUrl ?? nota?.player.photoUrl ?? null,
      /* Sin equipo en la ficha: son todos del mismo y la cancha ya lo dice. */
      equipo: '',
      nota: nota?.rating ?? null,
      dorsal: titular.number ?? nota?.shirtNumber ?? null,
      goles: (nota?.goals ?? 0) + (nota?.penaltyScored ?? 0),
      grid: titular.grid,
      salioEn: titular.playerId === null ? null : (salidaPorJugador.get(titular.playerId) ?? null),
      ficha: nota ? ficha(nota) : null,
    };
  });

  /* El banco en dos grupos: primero los que entraron, con su minuto y a quién reemplazaron. */
  const banco = substitutes
    .map((suplente) => {
      const nota = suplente.playerId === null ? undefined : notaPorJugador.get(suplente.playerId);
      const cambio = suplente.playerId === null ? undefined : entradaPorJugador.get(suplente.playerId);
      return { suplente, nota, cambio };
    })
    .sort((a, b) => (a.cambio?.minute ?? 999) - (b.cambio?.minute ?? 999));

  return { match, formation, coachName, rival, deLocal, golesPropios, golesRival, resultado, jugadores, banco };
});
---

<section class="overflow-hidden rounded-xl border border-border bg-surface" data-alineaciones>
  <header class="flex items-center gap-2 border-b border-border p-3">
    <Icon name="formacion" size={14} class="shrink-0 text-primary-ink" />
    <h2 class="font-display text-sm font-semibold uppercase leading-none">Con qué salió</h2>

    {
      paneles.length > 1 && (
        <div class="ml-auto flex items-center gap-1.5">
          <!--
            Las flechas son botones y no enlaces porque no navegan: cambian de panel en el mismo
            documento. El estado igual queda en la URL, así que el enlace se puede compartir.

            Los puntos reemplazan al "1 de 5", que no decía de qué: son cinco partidos en orden de
            calendario y se puede saltar directo a cualquiera.
          -->
          <button
            type="button"
            data-alineacion-anterior
            class="grid size-6 cursor-pointer place-items-center rounded text-ink-muted transition-colors hover:bg-canvas-subtle hover:text-ink disabled:cursor-default disabled:opacity-25"
            aria-label="Partido anterior"
          >
            <Icon name="chevron-derecha" size={14} class="rotate-180" />
          </button>
          <span class="flex items-center gap-1">
            {paneles.map((panel, i) => (
              <button
                type="button"
                data-alineacion-punto={i}
                aria-current={i === indiceInicial ? 'true' : undefined}
                class="size-1.5 cursor-pointer rounded-full bg-border-strong transition-colors aria-[current]:bg-primary-ink hover:bg-ink-muted"
                aria-label={`${formatDate(panel.match.kickoffUtc)} contra ${panel.rival.shortName ?? panel.rival.name}`}
                title={`${formatDate(panel.match.kickoffUtc)} · ${panel.rival.shortName ?? panel.rival.name}`}
              />
            ))}
          </span>
          <button
            type="button"
            data-alineacion-siguiente
            class="grid size-6 cursor-pointer place-items-center rounded text-ink-muted transition-colors hover:bg-canvas-subtle hover:text-ink disabled:cursor-default disabled:opacity-25"
            aria-label="Partido siguiente"
          >
            <Icon name="chevron-derecha" size={14} />
          </button>
        </div>
      )
    }
  </header>

  {
    paneles.map((panel, i) => (
      <div data-panel={panel.match.id} data-cancha-ambito hidden={i !== indiceInicial}>
        <!-- El partido es el contexto: sin rival ni resultado, la cancha no dice de cuándo habla. -->
        <a
          href={`/partidos/${panel.match.id}`}
          class="flex items-center gap-2 border-b border-border px-3 py-2 transition-colors hover:bg-canvas-subtle"
        >
          {panel.resultado && (
            <span
              class:list={[
                'grid size-5 shrink-0 place-items-center rounded font-display text-2xs font-bold',
                panel.resultado.clase,
              ]}
              title={panel.resultado.titulo}
            >
              {panel.resultado.letra}
            </span>
          )}
          <span class="min-w-0 flex-1">
            <span class="flex items-center gap-1.5">
              <span class="text-2xs text-ink-muted">{panel.deLocal ? 'vs' : 'en'}</span>
              {panel.rival.logoUrl && (
                <img
                  src={panel.rival.logoUrl}
                  alt=""
                  width="16"
                  height="16"
                  loading="lazy"
                  class="shrink-0"
                />
              )}
              <span class="truncate text-sm font-medium">
                {panel.rival.shortName ?? panel.rival.name}
              </span>
              {panel.golesPropios !== null && (
                <span class="ml-auto shrink-0 font-display text-sm font-semibold tabular">
                  {panel.golesPropios}–{panel.golesRival}
                </span>
              )}
            </span>
            <span class="mt-0.5 flex items-center gap-1.5 text-2xs text-ink-muted">
              <span class="truncate">
                {formatDate(panel.match.kickoffUtc)} ·{' '}
                {nombreTorneo(panel.match.season.competition.name)}
              </span>
              {panel.formation && (
                <span class="ml-auto shrink-0 rounded bg-canvas-subtle px-1.5 font-display font-semibold tabular">
                  {panel.formation}
                </span>
              )}
            </span>
          </span>
        </a>

        <div class="p-2">
          <CanchaOnce jugadores={panel.jugadores} formacion={panel.formation} />
        </div>

        {/* El banco va fuera de la cancha: los suplentes no tienen casilla —el proveedor la manda
            vacía— y meterlos en el césped sería inventar dónde estuvieron. */}
        {panel.banco.length > 0 && (
          <div class="border-t border-border p-3">
            <h3 class="mb-1.5 text-2xs font-semibold uppercase tracking-label text-ink-muted">
              El banco
            </h3>
            <ul class="grid gap-0.5">
              {panel.banco.map(({ suplente, nota, cambio }) => {
                const Etiqueta = nota ? 'button' : suplente.slug ? 'a' : 'span';
                return (
                  <li>
                    <Etiqueta
                      type={nota ? 'button' : undefined}
                      href={nota || !suplente.slug ? undefined : `/?jugador=${suplente.slug}`}
                      data-ficha={nota ? ficha(nota) : undefined}
                      data-jugador={nota ? nota.player.id : undefined}
                      class:list={[
                        'flex w-full items-center gap-1.5 rounded px-1 py-1 text-left transition-colors',
                        nota || suplente.slug ? 'cursor-pointer hover:bg-canvas-subtle' : '',
                      ]}
                    >
                      {cambio ? (
                        <span class="flex shrink-0 items-center gap-0.5 text-2xs tabular text-primary-ink">
                          <EventIcon kind="sub_in" size={11} detail={`minuto ${cambio.minute}`} />
                          {cambio.minute}'
                        </span>
                      ) : (
                        <span class="w-7 shrink-0" />
                      )}
                      <span
                        class:list={[
                          'min-w-0 flex-1 truncate text-2xs',
                          cambio ? 'text-ink' : 'text-ink-muted',
                        ]}
                      >
                        {suplente.number !== null && (
                          <span class="mr-1 tabular text-ink-muted">{suplente.number}</span>
                        )}
                        {nota?.player.name ?? suplente.name}
                      </span>
                      {cambio && (cambio.saleNombre ?? cambio.sale?.name) && (
                        <span class="hidden shrink-0 text-2xs text-ink-muted sm:inline">
                          por {apellido((cambio.saleNombre ?? cambio.sale?.name) as string)}
                        </span>
                      )}
                      {nota?.rating && (
                        <span class="shrink-0 rounded bg-primary/15 px-1 font-display text-2xs font-semibold tabular text-primary-ink">
                          {Number(nota.rating).toFixed(1)}
                        </span>
                      )}
                    </Etiqueta>
                  </li>
                );
              })}
            </ul>
          </div>
        )}

        <p class="border-t border-border px-3 py-2 text-[11px] leading-snug text-ink-muted">
          {panel.coachName ? `Dirigió ${panel.coachName}. ` : ''}Tocá un jugador para ver su partido.
        </p>
      </div>
    ))
  }
</section>

<script>
  /*
   * Alternar paneles: lo único que no se puede hacer sin JavaScript si el cambio tiene que ser
   * instantáneo. La URL se actualiza con `replaceState` para que el enlace sea compartible sin
   * meter una entrada en el historial por cada flecha.
   */
  document.querySelectorAll<HTMLElement>('[data-alineaciones]').forEach((tarjeta) => {
    const paneles = [...tarjeta.querySelectorAll<HTMLElement>('[data-panel]')];
    if (paneles.length < 2) return;

    const anterior = tarjeta.querySelector<HTMLButtonElement>('[data-alineacion-anterior]');
    const siguiente = tarjeta.querySelector<HTMLButtonElement>('[data-alineacion-siguiente]');
    const puntos = [...tarjeta.querySelectorAll<HTMLButtonElement>('[data-alineacion-punto]')];
    let actual = paneles.findIndex((p) => !p.hidden);

    /* `enUrl` es falso al arrancar: escribir la fecha sin que nadie toque una flecha ensucia el
       enlace que se está compartiendo y hace ruido en el historial. */
    const mostrar = (indice: number, enUrl = false) => {
      actual = Math.min(paneles.length - 1, Math.max(0, indice));
      paneles.forEach((panel, i) => {
        panel.hidden = i !== actual;
      });
      puntos.forEach((punto, i) => {
        if (i === actual) punto.setAttribute('aria-current', 'true');
        else punto.removeAttribute('aria-current');
      });
      if (anterior) anterior.disabled = actual === 0;
      if (siguiente) siguiente.disabled = actual === paneles.length - 1;

      if (!enUrl) return;
      const url = new URL(location.href);
      const id = paneles[actual]?.dataset.panel;
      if (id) url.searchParams.set('fecha', id);
      history.replaceState(null, '', url);
    };

    anterior?.addEventListener('click', () => mostrar(actual - 1, true));
    siguiente?.addEventListener('click', () => mostrar(actual + 1, true));
    puntos.forEach((punto, i) => punto.addEventListener('click', () => mostrar(i, true)));
    mostrar(actual);
  });
</script>
