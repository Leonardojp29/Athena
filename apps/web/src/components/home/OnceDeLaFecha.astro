---
import EscudoTorneo from '../EscudoTorneo.astro';
import CanchaOnce from '../pitch/CanchaOnce.astro';
import ListaDelOnce from '../pitch/ListaDelOnce.astro';
import type { JugadorDelOnce, OnceDeLaFecha } from '../../lib/api';
import { fichaJson, formacionDe, LINEA, type FichaOnce } from '../../lib/once';
import { nombreFase } from '../../lib/paises';

/*
 * El once de la fecha de una competencia, sobre la cancha.
 *
 * Cuando alguien abre una liga, "lo mejor del día" de todo el mundo no le dice nada: quiere lo de su
 * liga. Y lo más futbolero que se arma con lo que hay —notas por jugador y su puesto— es el equipo
 * ideal de la última jornada, dibujado como se dibuja una alineación.
 */
interface Props {
  once: OnceDeLaFecha;
  logoUrl?: string | null;
  nombreLiga: string;
}

const { once, logoUrl = null, nombreLiga } = Astro.props;

/*
 * El mismo payload que la cancha del partido: el clic abre la ficha con las estadísticas del
 * encuentro por el que fue elegido figura, sin salir de la página ni pedir nada al servidor.
 */
const ficha = (j: JugadorDelOnce): string =>
  fichaJson({
    playerId: j.player_id,
    slug: j.player_slug,
    name: j.player_name,
    photoUrl: j.photo_url,
    number: j.shirt_number,
    position: LINEA[j.position] ?? j.position,
    team: { name: j.team_name, slug: j.team_slug, logoUrl: j.team_logo },
    stats: {
      minutesPlayed: j.minutes_played,
      rating: j.rating,
      goals: j.goals,
      assists: j.assists,
      saves: j.saves,
      shotsTotal: j.shots_total,
      shotsOnTarget: j.shots_on_target,
      passesTotal: j.passes_total,
      passesKey: j.passes_key,
      passesAccurate: j.passes_accurate,
      tacklesTotal: j.tackles_total,
      interceptions: j.interceptions,
      duelsTotal: j.duels_total,
      duelsWon: j.duels_won,
      dribblesTotal: j.dribbles_total,
      dribblesSuccess: j.dribbles_success,
      foulsCommitted: j.fouls_committed,
      foulsDrawn: j.fouls_drawn,
      yellowCards: j.yellow_cards,
      redCards: j.red_cards,
      penaltyScored: j.penalty_scored,
      penaltyMissed: j.penalty_missed,
      penaltySaved: j.penalty_saved,
    },
  });

const jugadores: FichaOnce[] = once.players.map((j) => ({
  puesto: j.position,
  nombre: j.player_name,
  href: `/?jugador=${j.player_slug}`,
  fotoUrl: j.photo_url,
  equipo: j.team_short ?? j.team_name,
  nota: j.rating,
  dorsal: j.shirt_number,
  goles: j.goals,
  ficha: ficha(j),
}));

const formacion = formacionDe(jugadores);

const jornada = (() => {
  if (!once.round) return null;
  const corte = once.round.lastIndexOf(' - ');
  if (corte === -1) return nombreFase(once.round);
  const cola = once.round.slice(corte + 3).trim();
  return /^\d+$/.test(cola)
    ? `${nombreFase(once.round.slice(0, corte))} · fecha ${cola}`
    : nombreFase(once.round);
})();
---

<section class="overflow-hidden rounded-xl border border-border bg-surface">
  <header class="flex items-center gap-2 border-b border-border p-3">
    <EscudoTorneo url={logoUrl} size={16} />
    <div class="min-w-0">
      <h2 class="truncate font-display text-sm font-semibold uppercase leading-none">
        El once de la fecha
      </h2>
      <p class="mt-0.5 truncate text-2xs text-ink-muted">
        {nombreLiga}
        {jornada && ` · ${jornada}`}
      </p>
    </div>
    {
      formacion && (
        <span class="ml-auto shrink-0 rounded bg-canvas-subtle px-1.5 py-0.5 font-display text-2xs font-semibold tabular">
          {formacion}
        </span>
      )
    }
  </header>

  <div class={formacion ? 'p-2' : 'p-3'}>
    {formacion ? <CanchaOnce jugadores={jugadores} /> : <ListaDelOnce jugadores={jugadores} />}
  </div>

  <p class="border-t border-border px-3 py-2 text-[11px] leading-snug text-ink-muted">
    El mejor calificado de cada puesto en la jornada, según la nota del proveedor de datos.
  </p>
</section>
