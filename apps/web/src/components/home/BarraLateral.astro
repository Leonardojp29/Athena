---
import EscudoTorneo from '../EscudoTorneo.astro';
import AvisoFavoritos from '../AvisoFavoritos.astro';
import BotonFavorito from '../BotonFavorito.astro';
import ContinentIcon from '../ContinentIcon.astro';
import CountryFlag from '../CountryFlag.astro';
import Icon from '../Icon.astro';
import type { GeographyContinent, NavContinent } from '../../lib/nav-types';
import { nombreTorneo, paisEnEspanol } from '../../lib/paises';

/*
 * La navegación de la home: Hoy, Favoritos y Competencias.
 *
 * El árbol se despliega con <details> anidados, así que no cuesta JavaScript: el navegador ya
 * sabe abrir y cerrar, recuerda el foco y funciona sin script. Lo único hidratado son los
 * favoritos, que necesitan el almacenamiento del navegador.
 *
 * Los partidos del día quedan a un clic (Hoy) y una liga o un equipo se abren en el mismo
 * contenedor de la derecha (`?liga=`, `?equipo=`), no en otra página: mirar la Liga 1 no debería
 * costar perder el contexto.
 */
interface Props {
  /** El árbol completo del catálogo: todas las competencias, jueguen hoy o no. */
  catalogo: NavContinent[];
  /** Los partidos de hoy, para los contadores de la sección Hoy. */
  geography: GeographyContinent[];
  /** Qué hay seleccionado: nada, un país, una liga o un equipo. */
  paisActivo: string | null;
  ligaActiva: string | null;
  equipoActivo?: string | null;
  conCuenta?: boolean;
}

const { catalogo, geography, paisActivo, ligaActiva, equipoActivo = null, conCuenta = false } =
  Astro.props;

const partidosPorPais = new Map(
  geography.flatMap((c) =>
    c.countries.map((p) => [
      p.code ?? 'internacional',
      p.competitions.reduce((n, t) => n + t.matches.length, 0),
    ]),
  ),
);
const totalHoy = [...partidosPorPais.values()].reduce((a, b) => a + b, 0);

const enJuegoPorPais = new Map(
  geography.flatMap((c) =>
    c.countries.map((p) => [
      p.code ?? 'internacional',
      p.competitions.reduce(
        (n, t) => n + t.matches.filter((m) => m.status === 'in_play' || m.status === 'paused').length,
        0,
      ),
    ]),
  ),
);

const seleccionVacia = paisActivo === null && ligaActiva === null && equipoActivo === null;

/* El árbol se abre por donde está la selección: nadie debería tener que buscar dónde está parado. */
const tieneSeleccion = (pais: NavContinent['countries'][number]): boolean =>
  (pais.code ?? 'internacional') === paisActivo ||
  (ligaActiva !== null && pais.competitions.some((c) => c.slug === ligaActiva));
---

<nav class="grid gap-1 text-sm" aria-label="Navegación de la home">
  <!-- Hoy -->
  <a
    href="/"
    aria-current={seleccionVacia ? 'page' : undefined}
    class:list={[
      'flex items-center gap-2 rounded-lg px-2.5 py-2 font-medium transition-colors',
      seleccionVacia
        ? 'bg-primary/12 text-ink'
        : 'text-ink-muted hover:bg-canvas-subtle hover:text-ink',
    ]}
  >
    <Icon name="cancha" size={16} class={seleccionVacia ? 'text-primary-ink' : ''} />
    Hoy
    <span class="ml-auto tabular text-2xs text-ink-muted">{totalHoy}</span>
  </a>

  <!--
    Favoritos: el servidor manda el molde vacío porque la lista vive en el navegador. Se agrupa
    por país en el cliente, con el escudo de cada competencia o equipo.
  -->
  <div class="grid gap-1">
    <p class="flex items-center gap-2 px-2.5 pt-2 text-2xs font-semibold tracking-label text-ink-muted uppercase">
      <Icon name="estrella" size={13} />
      Favoritos
      <span data-favoritos-cuenta class="ml-auto tabular"></span>
    </p>
    <div data-favoritos-lista class="grid gap-2 pt-0.5"></div>
    <p data-favoritos-vacio class="px-2.5 pb-1 text-2xs leading-snug text-ink-muted">
      Marcá una liga o un equipo con la estrella y aparecen acá.
    </p>
  </div>

  <!-- Competencias: continente → país → ligas, todo con <details> -->
  <p class="flex items-center gap-2 px-2.5 pt-3 text-2xs font-semibold tracking-label text-ink-muted uppercase">
    <Icon name="formacion" size={13} />
    Competencias
  </p>

  {
    catalogo.map((continente) => (
      <details
        class="group/cont"
        data-rama={`cont:${continente.continent}`}
        open={
          continente.countries.some(tieneSeleccion) ||
          (seleccionVacia && continente.continent === 'sudamerica')
        }
      >
        <summary
          class="flex cursor-pointer list-none items-center gap-2 rounded-md px-2.5 py-1.5 text-ink-muted transition-colors hover:bg-canvas-subtle hover:text-ink"
        >
          <ContinentIcon name={continente.continent} size={16} />
          <span class="truncate">{continente.label}</span>
          <Icon
            name="chevron-derecha"
            size={12}
            class="ml-auto shrink-0 transition-transform group-open/cont:rotate-90"
          />
        </summary>

        <div class="ml-2 grid gap-0.5 border-l border-border pl-1.5">
          {continente.countries.map((pais) => {
            const clave = pais.code ?? 'internacional';
            const hoy = partidosPorPais.get(clave) ?? 0;
            const vivos = enJuegoPorPais.get(clave) ?? 0;
            const paisSeleccionado = tieneSeleccion(pais);
            const nombrePais = paisEnEspanol(pais.name) ?? 'Internacional';
            return (
              <details class="group/pais" data-rama={`pais:${clave}`} open={paisSeleccionado}>
                <summary
                  class:list={[
                    'flex cursor-pointer list-none items-center gap-2 rounded-md px-2 py-1.5 transition-colors',
                    paisSeleccionado
                      ? 'bg-primary/12 font-medium text-ink'
                      : 'text-ink-muted hover:bg-canvas-subtle hover:text-ink',
                  ]}
                >
                  <CountryFlag url={pais.flagUrl} code={pais.code} name={nombrePais} size={16} />
                  <span class="min-w-0 flex-1 truncate">{nombrePais}</span>
                  {vivos > 0 ? (
                    <span class="flex items-center gap-1 text-2xs font-medium text-live">
                      <span class="size-1.5 rounded-full bg-live animate-live-pulse" />
                      {vivos}
                    </span>
                  ) : hoy > 0 ? (
                    /*
                     * Cerrado, el número es la única forma de ver que hoy se juega. Abierto, es la
                     * suma de lo que ya está a la vista y se repetía tres veces en el mismo bloque:
                     * el del país, el de la liga y el del enlace. Queda el del enlace.
                     */
                    <span class="tabular text-2xs text-primary-ink group-open/pais:hidden">{hoy}</span>
                  ) : null}
                  <Icon
                    name="chevron-derecha"
                    size={11}
                    class="shrink-0 transition-transform group-open/pais:rotate-90"
                  />
                </summary>

                <ul class="ml-2 grid gap-0.5 border-l border-border py-0.5 pl-1.5">
                  {pais.competitions.map((competition) => (
                    <li class="group/liga flex items-center gap-1">
                      <a
                        href={`/?liga=${competition.slug}`}
                        aria-current={ligaActiva === competition.slug ? 'page' : undefined}
                        class:list={[
                          'flex min-w-0 flex-1 items-center gap-1.5 truncate rounded px-1.5 py-1 text-2xs transition-colors',
                          ligaActiva === competition.slug
                            ? 'bg-primary/12 font-medium text-ink'
                            : 'text-ink-muted hover:bg-canvas-subtle hover:text-ink',
                        ]}
                      >
                        <EscudoTorneo url={competition.logoUrl} size={13} />
                        <span class="truncate">{nombreTorneo(competition.name)}</span>
                      </a>

                      <BotonFavorito
                        tipo="liga"
                        id={competition.id}
                        slug={competition.slug}
                        nombre={nombreTorneo(competition.name)}
                        logoUrl={competition.logoUrl}
                        pais={nombrePais}
                        banderaUrl={pais.flagUrl}
                        conCuenta={conCuenta}
                        class="opacity-0 focus-visible:opacity-100 group-hover/liga:opacity-100 aria-pressed:opacity-100"
                      />
                    </li>
                  ))}

                  <!--
                    Al final y en gris: es una salida, no el contenido. Arriba competía con las
                    ligas, que es lo que la gente viene a buscar.
                  -->
                  <li>
                    <a
                      href={`/?pais=${clave}`}
                      class:list={[
                        'mt-0.5 flex items-center gap-1 rounded px-1.5 py-1 text-[11px] text-ink-muted transition-colors hover:bg-canvas-subtle hover:text-ink',
                        paisActivo === clave ? 'font-medium text-ink' : '',
                      ]}
                    >
                      Ver los partidos de hoy
                      {hoy > 0 && <span class="tabular">({hoy})</span>}
                    </a>
                  </li>
                </ul>
              </details>
            );
          })}
        </div>
      </details>
    ))
  }
</nav>

<AvisoFavoritos class="mt-3" />

<script>
  import { claveFavorito, EVENTO_FAVORITOS, leerFavoritos, type Favorito } from '../../lib/favoritos';

  /*
   * La lista de favoritos se pinta en el cliente porque el servidor no puede conocerla. Se agrupa
   * por país: con una liga de Perú y un equipo de Argentina, una lista plana no dice de dónde es
   * cada cosa.
   */
  const lista = document.querySelector<HTMLElement>('[data-favoritos-lista]');
  const vacio = document.querySelector<HTMLElement>('[data-favoritos-vacio]');
  const cuenta = document.querySelector<HTMLElement>('[data-favoritos-cuenta]');

  const escudo = (url: string | null, alt: string): HTMLElement => {
    if (!url) {
      const hueco = document.createElement('span');
      hueco.className = 'size-3.5 shrink-0';
      return hueco;
    }
    const img = document.createElement('img');
    img.src = url;
    img.alt = alt;
    img.width = 14;
    img.height = 14;
    img.loading = 'lazy';
    img.className = 'shrink-0';
    return img;
  };

  function fila(favorito: Favorito): HTMLElement {
    const a = document.createElement('a');
    a.href = favorito.tipo === 'liga' ? `/?liga=${favorito.slug}` : `/?equipo=${favorito.slug}`;
    a.className =
      'flex items-center gap-1.5 rounded px-1.5 py-1 text-2xs text-ink-muted transition-colors hover:bg-canvas-subtle hover:text-ink';
    a.append(escudo(favorito.logoUrl, ''));
    const nombre = document.createElement('span');
    nombre.className = 'truncate';
    nombre.textContent = favorito.nombre;
    a.append(nombre);
    const li = document.createElement('li');
    li.append(a);
    return li;
  }

  function grupo(pais: string, favoritos: Favorito[]): HTMLElement {
    const caja = document.createElement('div');

    if (pais !== '') {
      const titulo = document.createElement('p');
      titulo.className = 'flex items-center gap-1.5 px-2.5 pb-0.5 text-[10px] tracking-label text-ink-muted uppercase';
      const bandera = favoritos.find((f) => f.banderaUrl)?.banderaUrl ?? null;
      if (bandera) {
        const img = document.createElement('img');
        img.src = bandera;
        img.alt = '';
        img.width = 12;
        img.height = 8;
        img.className = 'shrink-0 rounded-[2px] border border-border/60 object-cover';
        titulo.append(img);
      }
      titulo.append(document.createTextNode(pais));
      caja.append(titulo);
    }

    const ul = document.createElement('ul');
    ul.className = 'ml-2 grid gap-0.5 border-l border-border pl-1.5';
    ul.append(...favoritos.map(fila));
    caja.append(ul);
    return caja;
  }

  function pintar(): void {
    const favoritos = leerFavoritos();
    if (cuenta) cuenta.textContent = favoritos.length > 0 ? String(favoritos.length) : '';
    if (vacio) vacio.hidden = favoritos.length > 0;
    if (!lista) return;

    const porPais = new Map<string, Favorito[]>();
    for (const favorito of favoritos) {
      const clave = favorito.pais ?? '';
      porPais.set(clave, [...(porPais.get(clave) ?? []), favorito]);
    }

    /* Los que no saben de qué país son van al final, sin encabezado. */
    const grupos = [...porPais.entries()].sort(([a], [b]) =>
      a === '' ? 1 : b === '' ? -1 : a.localeCompare(b, 'es'),
    );
    lista.replaceChildren(...grupos.map(([pais, suyos]) => grupo(pais, suyos)));
  }

  window.addEventListener(EVENTO_FAVORITOS, pintar);
  pintar();

  /*
   * El árbol y el scroll se recuerdan entre navegaciones.
   *
   * Abrir un equipo o una liga es una navegación de verdad —la página se rearma en el servidor— y
   * eso reiniciaba la barra: los países que habías desplegado se cerraban y el scroll volvía
   * arriba, como si hubieras entrado de nuevo. Con esto, de una vista a otra solo cambia el
   * contenedor de la derecha, que es lo que uno espera.
   *
   * La rama que contiene lo que estás viendo la abre el servidor y acá no se cierra nunca: perder
   * de vista dónde estás parado sería peor que el problema original.
   */
  const CLAVE_RAMAS = 'athena:ramas';

  const ramas = document.querySelectorAll<HTMLDetailsElement>('[data-rama]');
  const riel = document.querySelector<HTMLElement>('[data-riel]');

  const leerRamas = (): Set<string> => {
    try {
      const raw = sessionStorage.getItem(CLAVE_RAMAS);
      const lista = raw ? (JSON.parse(raw) as string[]) : [];
      return new Set(Array.isArray(lista) ? lista : []);
    } catch {
      return new Set();
    }
  };

  const guardarRamas = () => {
    const abiertas = [...ramas].filter((r) => r.open).map((r) => r.dataset.rama as string);
    try {
      sessionStorage.setItem(CLAVE_RAMAS, JSON.stringify(abiertas));
    } catch {
      /* Modo privado: la barra sigue funcionando, solo no recuerda. */
    }
  };

  const recordadas = leerRamas();
  if (recordadas.size > 0) {
    for (const rama of ramas) {
      /* Lo que el servidor abrió por la selección se respeta; el resto sale de lo recordado. */
      if (!rama.open) rama.open = recordadas.has(rama.dataset.rama as string);
    }
  }
  for (const rama of ramas) rama.addEventListener('toggle', guardarRamas);
  guardarRamas();

  if (riel) {
    const CLAVE_SCROLL = 'athena:riel';
    const guardado = Number(sessionStorage.getItem(CLAVE_SCROLL) ?? '0');
    if (guardado > 0) riel.scrollTop = guardado;

    let pendiente = 0;
    riel.addEventListener(
      'scroll',
      () => {
        clearTimeout(pendiente);
        pendiente = window.setTimeout(() => {
          try {
            sessionStorage.setItem(CLAVE_SCROLL, String(riel.scrollTop));
          } catch {
            /* ídem */
          }
        }, 120);
      },
      { passive: true },
    );
  }

  /* Marca la liga o el equipo abierto si además es favorito: el estado se lee de un vistazo. */
  const abierta = new URL(location.href).searchParams;
  const activo = abierta.get('liga')
    ? claveFavorito('liga', abierta.get('liga') as string)
    : abierta.get('equipo')
      ? claveFavorito('equipo', abierta.get('equipo') as string)
      : null;
  if (activo) {
    for (const a of lista?.querySelectorAll('a') ?? []) {
      const esActivo = a.getAttribute('href')?.endsWith(activo.split(':')[1] as string);
      if (esActivo) a.classList.add('bg-primary/12', 'text-ink');
    }
  }
</script>
