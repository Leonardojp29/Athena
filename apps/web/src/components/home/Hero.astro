---
import type { MatchCard } from '../../lib/api';
import { formatKickoff, isLive } from '../../lib/format';
import Icon from '../Icon.astro';
import Container from '../layout/Container.astro';

/*
 * Una tira, no un hero.
 *
 * Tuvo título grande, bajada, cifras y tarjetas de los partidos que arrancaban. Nada de eso es por
 * lo que alguien abre una web de fútbol: entra a ver partidos, equipos y jugadores, y todo eso
 * empieza más abajo. Queda lo que sirve —qué día es, cuántos partidos hay, cuántos se están
 * jugando— en una línea de 44px.
 *
 * El h1 se queda porque la página necesita uno, pero al tamaño de una etiqueta: nombra lo que
 * estás mirando, no es un cartel.
 */
interface Props {
  live: MatchCard[];
  total: number;
  destacado: { titular: string; matchId: string } | null;
}

const { live, total, destacado } = Astro.props;
const enJuego = live.filter((m) => isLive(m.status));
const jugando = enJuego.length;

/*
 * La marquesina muestra lo que está pasando y, si no hay nada en juego, lo que viene. Ordenada por
 * hora: el zócalo de un partido de ayer no le sirve a nadie.
 */
const porEmpezar = live
  .filter((m) => m.status === 'scheduled')
  .sort((a, b) => a.kickoffUtc.localeCompare(b.kickoffUtc));
const cartelera = [...enJuego, ...porEmpezar].slice(0, 12);

const fecha = new Intl.DateTimeFormat('es-PE', {
  timeZone: 'America/Lima',
  weekday: 'long',
  day: 'numeric',
  month: 'long',
}).format(new Date());
---

<section class="w-full border-b border-board-edge bg-board">
  <Container width="wide">
    <div class="flex h-11 items-center gap-x-3 overflow-hidden">
      <h1 class="shrink-0 font-display text-base font-semibold uppercase leading-none text-chalk">
        Partidos de hoy
      </h1>

      <p class="flex min-w-0 items-center gap-x-2 text-2xs tracking-label text-chalk-dim uppercase">
        <span class="hidden shrink-0 text-chalk/25 sm:inline">·</span>
        <span class="hidden truncate sm:inline">{fecha}</span>
        <span class="shrink-0 text-chalk/25">·</span>
        <span class="shrink-0 tabular">{total} {total === 1 ? 'partido' : 'partidos'}</span>
        {
          jugando > 0 && (
            <>
              <span class="shrink-0 text-chalk/25">·</span>
              <span class="flex shrink-0 items-center gap-1.5 font-medium text-live-board">
                <span class="size-1.5 rounded-full bg-live-board animate-live-pulse" />
                {jugando} en juego
              </span>
            </>
          )
        }
      </p>

      <!--
        La marquesina: los partidos del día pasando como en el zócalo de la tele. Es CSS puro —dos
        copias de la lista y un `translateX` al infinito—, así que no cuesta JavaScript, se detiene
        al pasar el cursor y con `prefers-reduced-motion` se queda quieta y se puede arrastrar.
      -->
      {
        cartelera.length > 0 && (
          <div data-marquesina class="ml-auto hidden min-w-0 flex-1 overflow-hidden md:block">
            <div
              class="flex w-max items-center gap-5"
              style={`--partidos:${cartelera.length}`}
            >
              {[...cartelera, ...cartelera].map((match) => (
                <a
                  href={`/partidos/${match.id}`}
                  class="flex shrink-0 items-center gap-1.5 text-2xs text-chalk-dim transition-colors hover:text-chalk"
                >
                  {isLive(match.status) && (
                    <span class="size-1.5 shrink-0 rounded-full bg-live-board animate-live-pulse" />
                  )}
                  {match.homeTeam.logoUrl && (
                    <img src={match.homeTeam.logoUrl} alt="" width="14" height="14" />
                  )}
                  <span class="text-chalk">{match.homeTeam.shortName ?? match.homeTeam.name}</span>
                  <span
                    class:list={[
                      'font-display font-semibold tabular',
                      isLive(match.status) ? 'text-live-board' : 'text-chalk',
                    ]}
                  >
                    {match.status === 'scheduled'
                      ? formatKickoff(match.kickoffUtc)
                      : `${match.homeScore ?? 0}–${match.awayScore ?? 0}`}
                  </span>
                  <span class="text-chalk">{match.awayTeam.shortName ?? match.awayTeam.name}</span>
                  {match.awayTeam.logoUrl && (
                    <img src={match.awayTeam.logoUrl} alt="" width="14" height="14" />
                  )}
                  {isLive(match.status) && match.elapsedMinutes !== null && (
                    <span class="tabular text-live-board">{match.elapsedMinutes}'</span>
                  )}
                </a>
              ))}
            </div>
          </div>
        )
      }

      {
        destacado && (
          <a
            href={`/partidos/${destacado.matchId}?vista=analisis`}
            class="ml-auto hidden min-w-0 items-center gap-1.5 text-2xs text-chalk-dim transition-colors hover:text-chalk xl:flex xl:max-w-[22rem]"
          >
            <Icon name="destello" size={12} class="shrink-0 text-data" />
            <span class="truncate">{destacado.titular}</span>
          </a>
        )
      }
    </div>
  </Container>
</section>
