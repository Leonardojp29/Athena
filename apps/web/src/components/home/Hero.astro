---
import type { MatchCard } from '../../lib/api';
import { formatKickoff, isLive } from '../../lib/format';
import Icon from '../Icon.astro';
import Container from '../layout/Container.astro';

/*
 * El primer viewport. Antes era un h1 y una lista: ahora es la pizarra a sangre con lo que
 * está pasando ahora mismo, que es la razón por la que alguien abre una web de fútbol.
 */
interface Props {
  live: MatchCard[];
  total: number;
  destacado: { titular: string; matchId: string } | null;
}

const { live, total, destacado } = Astro.props;
const enJuego = live.filter((m) => isLive(m.status)).slice(0, 4);

/*
 * Sin partidos en juego el hero se compacta en una fila. Antes mantenía dos columnas con la
 * derecha vacía, y media pizarra en blanco no es respirar: es un hueco.
 */
const partido = enJuego.length > 0 || destacado !== null;
---

<section class="w-full border-b border-board-edge bg-board">
  <Container width="wide">
    <div
      class:list={[
        'grid gap-6 py-5',
        partido ? 'lg:grid-cols-2 lg:items-center lg:py-6' : 'lg:py-4',
      ]}
    >
      <div class:list={[partido ? 'max-w-[46ch]' : 'flex flex-wrap items-baseline gap-x-4']}>
        <h1
          class:list={[
            'font-display font-semibold uppercase leading-[0.95] text-chalk',
            partido ? 'text-3xl sm:text-4xl' : 'text-2xl sm:text-3xl',
          ]}
        >
          Los partidos de hoy,
          <span class="text-primary">explicados</span>
        </h1>
        <p class:list={['text-sm text-chalk-dim', partido ? 'mt-2' : 'max-w-[52ch]']}>
          {total > 0 ? `${total} partidos hoy. ` : ''}Marcadores, alineaciones sobre la cancha y
          análisis con la evidencia a la vista. Todo dato lleva su origen.
        </p>

        {
          destacado && (
            <a
              href={`/partidos/${destacado.matchId}?vista=analisis`}
              class="mt-4 flex max-w-[44ch] items-start gap-2 rounded-lg border border-data/30 bg-chalk/5 p-3 transition-colors hover:border-data/60"
            >
              <Icon name="destello" size={14} class="mt-0.5 shrink-0 text-data" />
              <span>
                <span class="block text-sm font-medium text-chalk">{destacado.titular}</span>
                <span class="mt-0.5 block text-2xs text-chalk-dim">Análisis Athena · leer</span>
              </span>
            </a>
          )
        }
      </div>

      {
        enJuego.length > 0 && (
          <div>
            <p class="mb-2 flex items-center gap-1.5 text-2xs font-medium tracking-label text-live-board uppercase">
              <span class="size-1.5 rounded-full bg-live-board animate-live-pulse" />
              En juego ahora
            </p>
            <div class="grid gap-2 sm:grid-cols-2">
              {enJuego.map((match) => (
                <a
                  href={`/partidos/${match.id}`}
                  class="group rounded-lg border border-chalk/12 bg-chalk/6 px-3 py-2.5 transition-colors hover:border-primary/40"
                >
                  {[match.homeTeam, match.awayTeam].map((team, i) => (
                    <span class="flex items-center gap-2 py-0.5">
                      {team.logoUrl && (
                        <img src={team.logoUrl} alt="" width="16" height="16" class="shrink-0" />
                      )}
                      <span class="min-w-0 flex-1 truncate text-sm text-chalk">
                        {team.shortName ?? team.name}
                      </span>
                      <span class="font-display text-base font-semibold tabular text-chalk">
                        {(i === 0 ? match.homeScore : match.awayScore) ?? 0}
                      </span>
                    </span>
                  ))}
                  <span class="mt-1 flex items-center gap-1.5 border-t border-chalk/10 pt-1 text-2xs text-live-board">
                    {match.elapsedMinutes !== null
                      ? `${match.elapsedMinutes}'`
                      : formatKickoff(match.kickoffUtc)}
                    <span class="truncate text-chalk-dim">· {match.season.competition.name}</span>
                  </span>
                </a>
              ))}
            </div>
          </div>
        )
      }
    </div>
  </Container>
</section>
