---
import type { GeographyContinent } from '../../lib/api';
import { isLive } from '../../lib/format';
import EscudoTorneo from '../EscudoTorneo.astro';
import ContinentIcon from '../ContinentIcon.astro';
import CountryFlag from '../CountryFlag.astro';
import Icon from '../Icon.astro';
import MatchRow from '../MatchRow.astro';
import { nombreTorneo, paisEnEspanol } from '../../lib/paises';

/*
 * Los partidos del día en UNA columna, agrupados continente → país → torneo.
 *
 * Antes eran N tarjetas en tres columnas, una por liga: con sesenta competencias eso obliga a
 * barrer la página en zigzag buscando su país. En una sola columna el hincha baja y encuentra;
 * el orden es el mismo del menú, así que no hay que reaprenderlo.
 */
interface Props {
  geography: GeographyContinent[];
  /** Los continentes que arrancan abiertos; el resto se despliega. */
  abiertos?: string[];
  /** Con un país elegido no hay nada que colapsar: se abre todo. */
  filtrado?: boolean;
  /** Se pasa tal cual a cada fila: la home abre el equipo sin cambiar de página. */
  hrefEquipo?: (slug: string) => string;
  /** A dónde lleva el nombre de la liga; en la home, a su vista dentro de la home. */
  hrefLiga?: (slug: string) => string;
  /** De qué día son estos partidos, para los encabezados: "Europa — partidos de hoy". */
  cuando?: string;
}

const {
  geography,
  abiertos = ['sudamerica'],
  filtrado = false,
  hrefEquipo,
  hrefLiga = (slug: string) => `/competencias/${slug}`,
  cuando = 'hoy',
} = Astro.props;

/*
 * El apellido invisible de cada encabezado.
 *
 * "Europa" y "España" solos no dicen nada fuera de su página, y un modelo que cita un fragmento
 * suelto no tiene el contexto de arriba. El texto visible no cambia —la columna vive de ser
 * corta— y el que lee la estructura recibe el encabezado entero.
 */
const contexto = `partidos de ${cuando}`;

const contarPartidos = (continente: GeographyContinent) =>
  continente.countries.reduce(
    (n, pais) => n + pais.competitions.reduce((m, t) => m + t.matches.length, 0),
    0,
  );

const contarVivos = (continente: GeographyContinent) =>
  continente.countries.reduce(
    (n, pais) =>
      n + pais.competitions.reduce((m, t) => m + t.matches.filter((x) => isLive(x.status)).length, 0),
    0,
  );
---

<div class="grid gap-3" data-geografia>
  {
    geography.map((continente) => {
      const total = contarPartidos(continente);
      const vivos = contarVivos(continente);
      return (
        <details
          id={`c-${continente.continent}`}
          open={filtrado || abiertos.includes(continente.continent) || vivos > 0}
          class="group scroll-mt-24"
          style={`view-transition-name: continente-${continente.continent}`}
        >
          <summary
            class="flex cursor-pointer list-none items-center gap-2 rounded-lg border border-border bg-surface px-3 py-2.5 transition-colors hover:bg-canvas-subtle"
          >
            <ContinentIcon name={continente.continent} size={17} class="text-primary-ink" />
            <h3 class="font-display text-base font-semibold uppercase">
              {continente.label}
              <span class="sr-only"> — {contexto}</span>
            </h3>
            {vivos > 0 && (
              <span class="flex items-center gap-1 rounded-full bg-live/12 px-2 py-0.5 text-2xs font-medium text-live-ink">
                <span class="size-1.5 rounded-full bg-live animate-live-pulse" />
                {vivos}
              </span>
            )}
            <span class="ml-auto tabular text-2xs text-ink-muted">{total}</span>
            <Icon
              name="chevron-derecha"
              size={14}
              class="text-ink-muted transition-transform group-open:rotate-90"
            />
          </summary>

          <!--
            Los países en pistas de 30rem y no en una columna: a mil doscientos píxeles una fila de
            partido manda los dos equipos a los bordes y deja el marcador solo en el medio. Con
            `auto-fill` la grilla se acomoda sola —dos columnas en un escritorio ancho, una en el
            riel de la home— sin que el componente tenga que saber dónde lo pusieron.
          -->
          <div class="mt-2 grid items-start gap-3 [grid-template-columns:repeat(auto-fill,minmax(min(100%,30rem),1fr))] sm:pl-3">
            {continente.countries.map((pais, orden) => (
              <section
                data-grupo
                data-pais
                class="rounded-lg border border-border bg-surface"
                style={`--orden:${orden}`}
              >
                <div class="flex items-center gap-2 border-b border-border px-3 py-2">
                  <CountryFlag
                    url={pais.flagUrl}
                    code={pais.code}
                    name={paisEnEspanol(pais.name)}
                    size={20}
                  />
                  <h4 class="text-sm font-semibold">
                    {paisEnEspanol(pais.name) ?? 'Internacional'}
                    <span class="sr-only"> — {contexto}</span>
                  </h4>
                  <span class="ml-auto tabular text-2xs text-ink-muted">
                    {pais.competitions.reduce((n, t) => n + t.matches.length, 0)}
                  </span>
                </div>

                <div class="grid gap-1 p-1">
                  {pais.competitions.map(({ competition, matches }) => (
                    <div data-competencia>
                      <a
                        href={hrefLiga(competition.slug)}
                        class="flex items-center gap-1.5 rounded px-2 py-1 text-2xs text-ink-muted transition-colors hover:bg-canvas-subtle hover:text-ink"
                      >
                        <EscudoTorneo url={competition.logoUrl} size={13} />
                        <span class="truncate font-medium tracking-label uppercase">
                          {nombreTorneo(competition.name)}
                        </span>
                      </a>
                      {matches.map((match) => (
                        <MatchRow match={match} showDate hrefEquipo={hrefEquipo} />
                      ))}
                    </div>
                  ))}
                </div>
              </section>
            ))}
          </div>
        </details>
      );
    })
  }
</div>
