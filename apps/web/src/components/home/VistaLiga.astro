---
import EscudoTorneo from '../EscudoTorneo.astro';
import BotonFavorito from '../BotonFavorito.astro';
import CountryFlag from '../CountryFlag.astro';
import Icon from '../Icon.astro';
import MatchRow from '../MatchRow.astro';
import TablaLideres from '../TablaLideres.astro';
import type { CompetitionView } from '../../lib/api';
import { paletaCompetencia } from '../../lib/coloresCompetencia';
import { nombreTorneo, paisEnEspanol } from '../../lib/paises';
import { etiquetaDeRonda, mezclaRondas } from '../../lib/rondas';

/*
 * La liga abierta dentro de la home, sin salir de la página.
 *
 * Cuenta **qué pasa**: lo que se juega, lo que se jugó y quiénes deciden. La tabla —el "cómo va"—
 * vive en el riel derecho, porque para llegar a la fecha de hoy había que pasar por dieciocho filas
 * y nueve columnas. Quien quiera todo tiene el botón que lleva a la competencia.
 *
 * Los partidos van en una sola columna a todo el ancho con la fila ancha del sitio: los nombres se
 * juntan alrededor del marcador en el centro en lugar de estirarse hasta los bordes, y entran ocho
 * de cada lado en el alto que antes ocupaban tres.
 */
interface Props {
  view: CompetitionView;
  /** La bandera sale del catálogo: la vista de competencia solo trae el nombre del país. */
  banderaUrl?: string | null;
}

const { view, banderaUrl = null } = Astro.props;
const { competition, season, recent, upcoming, scorers, assisters } = view;

const pais = paisEnEspanol(competition.country);
const nombre = nombreTorneo(competition.name);

/* La jornada viene traducida del API; para una liga queda el nombre de la fase. */
const jornada =
  view.estado === 'terminado'
    ? 'Torneo terminado'
    : (view.roundLabel ?? etiquetaDeRonda(view.round));

const bloques = [
  { titulo: 'Próximos partidos', partidos: upcoming.slice(0, 8), icono: 'reloj' as const },
  { titulo: 'Últimos resultados', partidos: recent.slice(0, 8), icono: 'cancha' as const },
].filter((bloque) => bloque.partidos.length > 0);

/*
 * La ronda se decide para las dos listas juntas, no bloque por bloque: los próximos suelen ser todos
 * de la misma ronda y los últimos no, así que una lista quedaba con pastilla y la otra sin ella, con
 * los nombres corridos entre una y otra.
 */
const conRonda = mezclaRondas(bloques.flatMap((bloque) => bloque.partidos));

/* Una copa internacional trae sus colores también acá: abrirla en la home ya se siente distinta. */
const paleta = paletaCompetencia(competition.slug);
const cabecera = paleta
  ? [
      `radial-gradient(110% 190% at 100% -40%, ${paleta.acento.suave(0.35)}, transparent 55%)`,
      `linear-gradient(115deg, color-mix(in oklab, ${paleta.base.base} 68%, #06060a) 0%, ${paleta.base.base} 82%)`,
    ].join(',')
  : null;

---

<section
  class="overflow-hidden rounded-xl border border-border bg-surface"
  style={`view-transition-name: liga-${competition.slug}`}
>
  <!--
    La cabecera va sobre la pizarra: separa la liga abierta del resto de la página de un golpe de
    vista, y le da al escudo un fondo parejo sin importar de qué color venga.
  -->
  <header
    class="relative flex flex-wrap items-center gap-x-3 gap-y-2 overflow-hidden border-b border-board-edge bg-board p-3"
    style={cabecera ? `background-image:${cabecera}` : undefined}
  >
    {
      paleta && competition.logoUrl && (
        <img
          src={competition.logoUrl}
          alt=""
          width="120"
          height="120"
          aria-hidden="true"
          class="pointer-events-none absolute -top-5 right-2 size-28 opacity-15"
          style="mask-image:linear-gradient(115deg, transparent 20%, black 85%);filter:saturate(0) brightness(3)"
        />
      )
    }
    <EscudoTorneo
      url={competition.logoUrl}
      size={paleta ? 38 : 30}
      class:list={['!rounded-lg', paleta ? '!p-2 shadow-card' : '!p-1.5']}
    />
    <div class="relative min-w-0 flex-1 basis-40">
      {
        paleta && (
          <p
            class="mb-0.5 text-[9px] font-semibold uppercase tracking-label"
            style={`color:${paleta.acento.base}`}
          >
            {paleta.tono}
          </p>
        )
      }
      <h2 class="truncate font-display text-xl font-semibold uppercase leading-none text-chalk">
        {nombre}
      </h2>
      <p class="mt-1 flex flex-wrap items-center gap-x-1.5 text-2xs text-chalk-dim">
        <CountryFlag url={banderaUrl} name={pais} size={14} />
        {pais ?? 'Internacional'}
        <span class="text-chalk/30">·</span>
        {season.year}
        {
          jornada && (
            <>
              <span class="text-chalk/30">·</span>
              <span class="font-medium text-chalk">{jornada}</span>
            </>
          )
        }
      </p>
    </div>

    <!-- En móvil los botones se van a su propia línea: en la misma, el título se comía a "PRI…". -->
    <div class="flex w-full shrink-0 items-center gap-2 sm:w-auto">
      <BotonFavorito
        tipo="liga"
        id={competition.id}
        slug={competition.slug}
        nombre={nombre}
        logoUrl={competition.logoUrl}
        pais={pais}
        banderaUrl={banderaUrl}
        variante="boton"
        onBoard
      />
      <a
        href={`/competencias/${competition.slug}`}
        class="flex items-center gap-1.5 rounded-md bg-primary px-3 py-1.5 text-2xs font-medium text-primary-contrast transition-opacity hover:opacity-90"
      >
        Ver la liga completa
        <Icon name="chevron-derecha" size={12} />
      </a>
    </div>
  </header>

  {
    bloques.length > 0 ? (
      bloques.map((bloque) => (
        <div class="border-b border-border p-3 last:border-0">
          <h3 class="mb-1 flex items-center gap-1.5 text-2xs font-semibold uppercase tracking-label text-ink-muted">
            <Icon name={bloque.icono} size={12} />
            {bloque.titulo}
            <span class="tabular">({bloque.partidos.length})</span>
          </h3>
          <!-- Con tope de ancho: a 830px los nombres quedaban flotando lejos del marcador. -->
          <ul class="mx-auto grid max-w-[42rem]">
            {bloque.partidos.map((match) => (
              <li>
                <MatchRow
                  match={match}
                  showDate
                  mostrarRonda={conRonda}
                  hrefEquipo={(slug) => `/?equipo=${slug}`}
                />
              </li>
            ))}
          </ul>
        </div>
      ))
    ) : (
      <p class="border-b border-border p-3 text-sm text-ink-muted last:border-0">
        Todavía no hay partidos sincronizados de esta competencia.
      </p>
    )
  }

  {
    (scorers.length > 0 || assisters.length > 0) && (
      <!-- Sin cabecera de sección: los títulos de las dos tablas ya dicen qué es esto. -->
      <div class="p-3">
        <div class="grid gap-x-5 gap-y-3 sm:grid-cols-2">
          <TablaLideres
            titulo="Goleadores"
            lideres={scorers}
            metrica="goals"
            filas={5}
            hrefEquipo={(slug) => `/?equipo=${slug}`}
            hrefJugador={(slug) => `/?jugador=${slug}`}
          />
          <TablaLideres
            titulo="Asistencias"
            lideres={assisters}
            metrica="assists"
            filas={5}
            hrefEquipo={(slug) => `/?equipo=${slug}`}
            hrefJugador={(slug) => `/?jugador=${slug}`}
          />
        </div>
      </div>
    )
  }
</section>
