---
import EscudoTorneo from '../EscudoTorneo.astro';
import BotonFavorito from '../BotonFavorito.astro';
import CountryFlag from '../CountryFlag.astro';
import Icon from '../Icon.astro';
import ListaPartidosCompacta from './ListaPartidosCompacta.astro';
import SelectorFase from '../SelectorFase.astro';
import StandingsTable from '../StandingsTable.astro';
import TablaLideres from '../TablaLideres.astro';
import type { CompetitionView } from '../../lib/api';
import { nombreFase, nombreTorneo, paisEnEspanol } from '../../lib/paises';

/*
 * La liga abierta dentro de la home, sin salir de la página.
 *
 * Es un resumen, no la página completa: la tabla de la fase en juego —con scroll propio, así que
 * entran los dieciocho equipos sin estirar la tarjeta— y las dos columnas de partidos abajo.
 * Quien quiera todo tiene el botón que lleva a la competencia. La idea es poder mirar la Liga 1
 * sin perder de vista el resto del día.
 */
interface Props {
  view: CompetitionView;
  /** La bandera sale del catálogo: la vista de competencia solo trae el nombre del país. */
  banderaUrl?: string | null;
  /** Etiqueta de la fase pedida por la URL; si no viene, se abre la que está en juego. */
  fase?: string | null;
  conCuenta?: boolean;
}

const { view, banderaUrl = null, fase = null, conCuenta = false } = Astro.props;
const { competition, season, standingGroups, recent, upcoming, scorers, assisters } = view;

/*
 * El API manda la fase en juego primero, así que el grupo por defecto es el primero y no hay que
 * volver a decidirlo acá. Antes se abría el Apertura —cerrado en mayo— mientras se jugaba el
 * Clausura, y la tabla mostraba una foto de otro torneo.
 */
const grupo = standingGroups.find((g) => g.label === fase) ?? standingGroups[0];
const pais = paisEnEspanol(competition.country);
const nombre = nombreTorneo(competition.name);

/* "Clausura - 4" → "Clausura · fecha 4": decir en qué fecha va evita la confusión de raíz. */
const jornada = (() => {
  if (!view.round) return null;
  const corte = view.round.lastIndexOf(' - ');
  if (corte === -1) return nombreFase(view.round);
  const cola = view.round.slice(corte + 3).trim();
  const cabeza = nombreFase(view.round.slice(0, corte));
  return /^\d+$/.test(cola) ? `${cabeza} · fecha ${cola}` : nombreFase(view.round);
})();

const bloques = [
  { titulo: 'Próximos', partidos: upcoming.slice(0, 3), icono: 'reloj' as const },
  { titulo: 'Últimos resultados', partidos: recent.slice(0, 3), icono: 'cancha' as const },
].filter((bloque) => bloque.partidos.length > 0);

---

<section
  class="overflow-hidden rounded-xl border border-border bg-surface"
  style={`view-transition-name: liga-${competition.slug}`}
>
  <!--
    La cabecera va sobre la pizarra: separa la liga abierta del resto de la página de un golpe de
    vista, y le da al escudo un fondo parejo sin importar de qué color venga.
  -->
  <header class="flex flex-wrap items-center gap-x-3 gap-y-2 border-b border-board-edge bg-board p-3">
    <EscudoTorneo url={competition.logoUrl} size={30} class="!rounded-lg !p-1.5" />
    <div class="min-w-0 flex-1 basis-40">
      <h2 class="truncate font-display text-xl font-semibold uppercase leading-none text-chalk">
        {nombre}
      </h2>
      <p class="mt-1 flex flex-wrap items-center gap-x-1.5 text-2xs text-chalk-dim">
        <CountryFlag url={banderaUrl} name={pais} size={14} />
        {pais ?? 'Internacional'}
        <span class="text-chalk/30">·</span>
        {season.year}
        {
          jornada && (
            <>
              <span class="text-chalk/30">·</span>
              <span class="font-medium text-chalk">{jornada}</span>
            </>
          )
        }
      </p>
    </div>

    <!-- En móvil los botones se van a su propia línea: en la misma, el título se comía a "PRI…". -->
    <div class="flex w-full shrink-0 items-center gap-2 sm:w-auto">
      <BotonFavorito
        tipo="liga"
        id={competition.id}
        slug={competition.slug}
        nombre={nombre}
        logoUrl={competition.logoUrl}
        pais={pais}
        banderaUrl={banderaUrl}
        variante="boton"
        conCuenta={conCuenta}
        onBoard
      />
      <a
        href={`/competencias/${competition.slug}`}
        class="flex items-center gap-1.5 rounded-md bg-primary px-3 py-1.5 text-2xs font-medium text-primary-contrast transition-opacity hover:opacity-90"
      >
        Ver la liga completa
        <Icon name="chevron-derecha" size={12} />
      </a>
    </div>
  </header>

  {
    grupo && (
      <div class="border-b border-border p-3">
        <div class="mb-2 flex flex-wrap items-center justify-between gap-2">
          <h3 class="text-2xs font-semibold tracking-label text-ink-muted uppercase">
            Tabla{standingGroups.length === 1 && grupo.label ? ` · ${nombreFase(grupo.label)}` : ''}
          </h3>
          <SelectorFase
            grupos={standingGroups}
            activo={grupo.label}
            href={(label) => `/?liga=${competition.slug}&tabla=${encodeURIComponent(label)}`}
          />
        </div>

        <StandingsTable
          rows={grupo.rows}
          maxAlto="15.5rem"
          hrefEquipo={(slug) => `/?equipo=${slug}`}
        />
      </div>
    )
  }

  {
    (scorers.length > 0 || assisters.length > 0) && (
      <div class="grid gap-x-5 gap-y-3 border-b border-border p-3 sm:grid-cols-2">
        <TablaLideres
          titulo="Goleadores"
          lideres={scorers}
          metrica="goals"
          filas={3}
          hrefEquipo={(slug) => `/?equipo=${slug}`}
        />
        <TablaLideres
          titulo="Asistencias"
          lideres={assisters}
          metrica="assists"
          filas={3}
          hrefEquipo={(slug) => `/?equipo=${slug}`}
        />
      </div>
    )
  }

  {
    bloques.length > 0 ? (
      <div class="grid gap-x-4 gap-y-3 p-3 sm:grid-cols-2">
        {bloques.map((bloque) => (
          <ListaPartidosCompacta
            titulo={bloque.titulo}
            icono={bloque.icono}
            partidos={bloque.partidos}
          />
        ))}
      </div>
    ) : (
      <p class="p-3 text-sm text-ink-muted">
        Todavía no hay partidos sincronizados de esta competencia.
      </p>
    )
  }
</section>
