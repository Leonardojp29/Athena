---
import type { TopPerformer, TopPerformers } from '../../lib/api';
import Icon from '../Icon.astro';

/*
 * Lo mejor del día por nota.
 *
 * Es la respuesta a "para qué sirve el espacio que sobra": no un banner ni una lista de enlaces,
 * sino el dato que Athena tiene y que ninguna otra web muestra para la Liga 1 o la Liga
 * Profesional —quién jugó mejor hoy, con su nota y lo que hizo—. Sale de una consulta a nuestra
 * propia base, no de una llamada al proveedor.
 *
 * El podio es de tres porque un top-10 en un riel es una lista; tres es una decisión.
 */
interface Props {
  top: TopPerformers;
}

const { top } = Astro.props;
const [primero, ...resto] = top.players;

/* Decir de qué día es en lugar de dejar el hueco: a media mañana nada de hoy terminó. */
const cuando = top.esDeHoy
  ? 'Lo mejor de hoy'
  : `Lo mejor del ${new Intl.DateTimeFormat('es-PE', {
      timeZone: 'America/Lima',
      weekday: 'long',
      day: 'numeric',
    }).format(new Date(`${top.date}T12:00:00-05:00`))}`;

const nota = (valor: string | null) => (valor === null ? 0 : Number(valor));
const goles = (p: TopPerformer) => (p.goals ?? 0) + (p.penaltyScored ?? 0);
---

{
  primero && (
    <section class="rounded-lg border border-border bg-surface">
      <h2 class="flex items-center gap-1.5 border-b border-border px-3 py-2.5 text-2xs font-semibold tracking-label text-ink-muted uppercase">
        <Icon name="destello" size={13} class="text-primary-ink" />
        {cuando}
      </h2>

      <!-- El primero grande: el podio no se lee si los tres pesan igual. -->
      <a
        href={`/jugadores/${primero.player.slug}`}
        class="group block border-b border-border p-3 transition-colors hover:bg-canvas-subtle"
      >
        <div class="flex items-start gap-3">
          <span class="relative shrink-0">
            {primero.player.photoUrl ? (
              <img
                src={primero.player.photoUrl}
                alt=""
                width="56"
                height="56"
                loading="lazy"
                class="size-14 rounded-full bg-canvas-subtle object-cover"
              />
            ) : (
              <span class="grid size-14 place-items-center rounded-full bg-canvas-subtle">
                <Icon name="usuario" size={22} class="text-ink-muted" />
              </span>
            )}
            <span class="absolute -bottom-1 -right-1 rounded bg-primary px-1.5 py-0.5 font-display text-sm font-bold tabular text-primary-contrast">
              {nota(primero.rating).toFixed(1)}
            </span>
          </span>

          <div class="min-w-0 flex-1">
            <p class="truncate font-display text-lg font-semibold uppercase leading-tight group-hover:text-primary-ink">
              {primero.player.name}
            </p>
            <p class="flex items-center gap-1.5 text-2xs text-ink-muted">
              {primero.team.logoUrl && (
                <img src={primero.team.logoUrl} alt="" width="13" height="13" loading="lazy" />
              )}
              <span class="truncate">{primero.team.shortName ?? primero.team.name}</span>
            </p>

            <p class="mt-1.5 flex flex-wrap items-center gap-1.5 text-2xs">
              <span class="rounded bg-canvas-subtle px-1.5 py-0.5 tabular">
                {primero.minutesPlayed ?? 0}′
              </span>
              {goles(primero) > 0 && (
                <span class="rounded bg-primary px-1.5 py-0.5 font-semibold tabular text-primary-contrast">
                  {goles(primero)} {goles(primero) === 1 ? 'gol' : 'goles'}
                </span>
              )}
              {(primero.assists ?? 0) > 0 && (
                <span class="rounded bg-canvas-subtle px-1.5 py-0.5 tabular">
                  {primero.assists} {primero.assists === 1 ? 'asistencia' : 'asistencias'}
                </span>
              )}
            </p>
          </div>
        </div>

        <p class="mt-2 truncate text-2xs text-ink-muted">
          {primero.match.homeTeam.shortName ?? primero.match.homeTeam.name}
          {' '}
          <span class="tabular">
            {primero.match.homeScore ?? '–'}–{primero.match.awayScore ?? '–'}
          </span>
          {' '}
          {primero.match.awayTeam.shortName ?? primero.match.awayTeam.name}
          {' · '}
          {primero.match.season.competition.name}
        </p>
      </a>

      <ul class="grid gap-0">
        {resto.map((p, i) => (
          <li class="border-b border-border/50 last:border-0">
            <a
              href={`/jugadores/${p.player.slug}`}
              class="flex items-center gap-2.5 px-3 py-2 transition-colors hover:bg-canvas-subtle"
            >
              <span class="w-3 shrink-0 tabular text-2xs text-ink-muted">{i + 2}</span>
              {p.player.photoUrl ? (
                <img
                  src={p.player.photoUrl}
                  alt=""
                  width="26"
                  height="26"
                  loading="lazy"
                  class="size-6.5 shrink-0 rounded-full bg-canvas-subtle object-cover"
                />
              ) : (
                <span class="grid size-6.5 shrink-0 place-items-center rounded-full bg-canvas-subtle">
                  <Icon name="usuario" size={12} class="text-ink-muted" />
                </span>
              )}
              <span class="min-w-0 flex-1">
                <span class="block truncate text-sm">{p.player.name}</span>
                <span class="block truncate text-2xs text-ink-muted">
                  {p.team.shortName ?? p.team.name}
                </span>
              </span>
              <span
                class:list={[
                  'shrink-0 rounded px-1.5 py-0.5 text-2xs font-semibold tabular',
                  nota(p.rating) >= 7.5
                    ? 'bg-primary text-primary-contrast'
                    : 'bg-canvas-subtle text-ink',
                ]}
              >
                {nota(p.rating).toFixed(1)}
              </span>
            </a>
          </li>
        ))}
      </ul>

      <p class="border-t border-border px-3 py-2 text-[10px] text-ink-muted">
        Nota del proveedor de datos sobre partidos ya terminados, no una calificación de Athena.
      </p>
    </section>
  )
}
