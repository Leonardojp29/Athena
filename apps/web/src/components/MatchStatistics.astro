---
import type { TeamStatistics, TeamSummary } from '../lib/api';
import { filasDeEstadisticas } from '../lib/estadisticas';

interface Props {
  statistics: TeamStatistics[];
  homeTeam: TeamSummary;
  awayTeam: TeamSummary;
  /**
   * La tarjeta como protagonista, para cuando tiene media pantalla en lugar de una pista de 22rem:
   * cifras en tipografía de marcador y barras más altas. Una tarjeta chica estirada al doble de
   * ancho no dice nada nuevo, solo alarga las barras.
   */
  grande?: boolean;
}

const { statistics, homeTeam, awayTeam, grande = false } = Astro.props;
const rows = filasDeEstadisticas(statistics, homeTeam, awayTeam);

/*
 * Lima para el local y pizarra para el visitante. Antes las dos barras eran lima con distinta
 * opacidad y a 1,5px de alto no se distinguía cuál era cuál, que es lo único que una
 * comparación tiene que dejar claro. El dominio no es "bueno" ni "malo": ningún rojo ni verde.
 */
const share = (a: number | null, b: number | null): number => {
  const total = (a ?? 0) + (b ?? 0);
  return total === 0 ? 50 : Math.round(((a ?? 0) / total) * 100);
};
---

{
  rows.length > 0 && (
    <section class="rounded-lg border border-border bg-surface p-4">
      <!-- Grilla y no `justify-between`: con nombres de largo distinto el título quedaba corrido. -->
      <div class="mb-4 grid grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] items-center gap-3">
        <span class="flex min-w-0 items-center gap-2">
          <span class="size-2.5 shrink-0 rounded-sm bg-primary" />
          {homeTeam.logoUrl && <img loading="lazy" src={homeTeam.logoUrl} alt="" width="18" height="18" />}
          <span class="truncate text-sm font-medium">{homeTeam.shortName ?? homeTeam.name}</span>
        </span>

        <h2 class:list={['shrink-0 font-semibold', grande ? 'font-display text-base uppercase' : 'text-base']}>
          Estadísticas
        </h2>

        <span class="flex min-w-0 items-center justify-end gap-2">
          <span class="truncate text-sm font-medium">{awayTeam.shortName ?? awayTeam.name}</span>
          {awayTeam.logoUrl && <img loading="lazy" src={awayTeam.logoUrl} alt="" width="18" height="18" />}
          <span class="size-2.5 shrink-0 rounded-sm bg-ink-muted" />
        </span>
      </div>

      <div class:list={['grid', grande ? 'gap-5' : 'gap-3.5']}>
        {rows.map((row) => {
          const homeShare = share(row.homeValue, row.awayValue);
          const suffix = row.isPercent ? '%' : '';
          return (
            <div>
              <div class:list={['mb-1 flex items-baseline justify-between', grande ? '' : 'text-sm']}>
                <span
                  class:list={[
                    'tabular',
                    grande ? 'w-16 font-display text-2xl font-semibold leading-none' : 'w-12 text-sm font-medium',
                  ]}
                >
                  {row.homeValue ?? '–'}
                  {row.homeValue !== null ? suffix : ''}
                </span>
                <span
                  class:list={[
                    'text-ink-muted',
                    grande ? 'text-2xs uppercase tracking-label' : 'text-2xs',
                  ]}
                >
                  {row.label}
                </span>
                <span
                  class:list={[
                    'text-right tabular',
                    grande ? 'w-16 font-display text-2xl font-semibold leading-none' : 'w-12 text-sm font-medium',
                  ]}
                >
                  {row.awayValue ?? '–'}
                  {row.awayValue !== null ? suffix : ''}
                </span>
              </div>

              <div class:list={['flex gap-0.5', grande ? 'mt-1.5 h-2.5' : 'h-2']} role="presentation">
                <div class="flex flex-1 justify-end overflow-hidden rounded-l-full bg-canvas-subtle">
                  <div
                    class="h-full origin-right rounded-l-full bg-primary animate-bar-fill"
                    style={`width:${homeShare}%`}
                  />
                </div>
                <div class="flex-1 overflow-hidden rounded-r-full bg-canvas-subtle">
                  <div
                    class="h-full origin-left rounded-r-full bg-ink-muted animate-bar-fill"
                    style={`width:${100 - homeShare}%`}
                  />
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </section>
  )
}
