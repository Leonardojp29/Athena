---
import Icon from '../Icon.astro';

/*
 * La semana, a todo el ancho de la página.
 *
 * Eran siete cajitas de sesenta píxeles apretadas contra el borde derecho: elegir el sábado o el
 * martes costaba lo mismo aunque uno tenga cuarenta partidos y el otro tres, y sobraba media
 * página en blanco al lado. Ahora ocupa la línea entera y cada día se reparte lo que hay, así que
 * la semana se lee de un golpe y el día grande salta a la vista antes de tocarlo.
 *
 * Es una fila de siete, no un carrusel: en un teléfono se estrecha hasta el mínimo legible y recién
 * ahí se deja arrastrar.
 */
export interface Dia {
  iso: string;
  diaCorto: string;
  numero: string;
  mes: string;
  total: number;
  vivos: number;
  esHoy: boolean;
  activo: boolean;
}

interface Props {
  dias: Dia[];
  anterior: string;
  siguiente: string;
  /** Qué eje está abierto, para no perderlo al cambiar de día. */
  ver: string;
}

const { dias, anterior, siguiente, ver } = Astro.props;
/* El mes solo donde cambia: repetirlo siete veces es ruido y esconde justo el día del salto. */
const conMes = dias.map((d, i) => ({ ...d, muestraMes: i === 0 || d.mes !== dias[i - 1]?.mes }));
const cola = ver === 'lugar' ? '&ver=lugar' : '';
const pico = Math.max(...dias.map((d) => d.total), 1);
const salto = (iso: string) => `/partidos?fecha=${iso}${cola}`;

/* La barra en porcentaje y no en píxeles: el alto de la caja cambia con el ancho de la pantalla. */
const alturaDe = (total: number) => (total === 0 ? 3 : Math.max(8, Math.round((total / pico) * 100)));
---

<nav
  class="-mx-4 flex items-stretch gap-1.5 overflow-x-auto px-4 pb-1 sm:mx-0 sm:gap-2 sm:overflow-visible sm:px-0"
  aria-label="Elegir el día"
>
  <a
    href={salto(anterior)}
    aria-label="Día anterior"
    class="group grid shrink-0 place-items-center rounded-xl border border-border px-2 text-ink-muted transition-[colors,transform] duration-200 hover:border-primary-ink hover:bg-canvas-subtle hover:text-ink sm:px-3"
  >
    <Icon name="flecha-izquierda" size={18} class="transition-transform duration-200 group-hover:-translate-x-0.5" />
  </a>

  {
    conMes.map((d) => (
      <a
        href={salto(d.iso)}
        aria-current={d.activo ? 'page' : undefined}
        aria-label={`${d.diaCorto} ${d.numero} de ${d.mes}, ${d.total} ${d.total === 1 ? 'partido' : 'partidos'}`}
        class:list={[
          'group relative flex min-w-[4.25rem] flex-1 flex-col items-center gap-1 overflow-hidden rounded-xl border px-2 pt-2.5 pb-2 transition-[colors,transform] duration-200',
          d.activo
            ? 'border-primary-ink bg-primary/10 text-ink'
            : 'border-border text-ink-muted hover:-translate-y-0.5 hover:border-border-strong hover:bg-canvas-subtle hover:text-ink',
        ]}
      >
        {/* Hoy se marca con una línea arriba, que no compite con el borde del día elegido. */}
        {d.esHoy && !d.activo && (
          <span class="absolute inset-x-0 top-0 h-0.5 bg-primary-ink" aria-hidden="true" />
        )}

        <span class="text-2xs uppercase tracking-label">{d.diaCorto}</span>
        <span
          class:list={[
            'font-display text-2xl font-semibold leading-none tabular sm:text-3xl',
            d.activo ? 'text-ink' : d.esHoy ? 'text-primary-ink' : 'text-ink',
          ]}
        >
          {d.numero}
        </span>
        {/* Alto fijo aunque esté vacío, para que los siete días midan lo mismo. */}
        <span class="h-3 text-2xs uppercase leading-none tracking-label text-ink-muted">
          {d.muestraMes ? d.mes.slice(0, 3) : ''}
        </span>

        {/*
          El número dice cuántos; la barra deja comparar los siete días sin leer siete cifras.
          El riel va casi transparente y la barra en tinta: `border-strong` sobre `canvas-subtle`
          son el mismo tono en claro y la barra no se veía.
        */}
        <span class="mt-1.5 flex h-6 w-full items-end justify-center rounded-sm bg-ink/[0.06] sm:h-7">
          <span
            aria-hidden="true"
            class:list={[
              'w-full rounded-sm transition-[height,background-color] duration-300',
              d.total === 0
                ? 'bg-ink/15'
                : d.activo
                  ? 'bg-primary'
                  : 'bg-ink/30 group-hover:bg-primary-ink/60',
            ]}
            style={`height:${alturaDe(d.total)}%`}
          />
        </span>

        <span class="flex items-center gap-1 text-2xs font-medium tabular leading-none">
          {d.vivos > 0 && <span class="size-1.5 rounded-full bg-live animate-live-pulse" />}
          <span class={d.total === 0 ? 'text-ink-muted/60' : 'text-ink'}>{d.total}</span>
        </span>
      </a>
    ))
  }

  <a
    href={salto(siguiente)}
    aria-label="Día siguiente"
    class="group grid shrink-0 place-items-center rounded-xl border border-border px-2 text-ink-muted transition-[colors,transform] duration-200 hover:border-primary-ink hover:bg-canvas-subtle hover:text-ink sm:px-3"
  >
    <Icon name="chevron-derecha" size={18} class="transition-transform duration-200 group-hover:translate-x-0.5" />
  </a>
</nav>
