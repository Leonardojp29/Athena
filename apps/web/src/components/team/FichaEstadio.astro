---
import Icon from '../Icon.astro';
import type { VenueSummary } from '../../lib/api';
import { aforo, superficieEnEspanol } from '../../lib/estadio';

/*
 * La casa del club, en el riel.
 *
 * La foto ocupa el ancho de la tarjeta y el nombre se apoya sobre ella, pero nunca sobre el píxel
 * crudo: entre los dos hay un velo con el color del club, el mismo de la cabecera, así que el
 * contraste está garantizado con cualquier imagen que mande el proveedor —y manda de todo, desde
 * tribunas al sol hasta cielos blancos—.
 *
 * La escalera de degradación es la de siempre: sin foto queda la banda de color con el icono marcado,
 * y sin estadio la tarjeta no se dibuja. Un hueco con "sin datos" anuncia el vacío más fuerte que el
 * vacío mismo.
 */
interface Props {
  venue: VenueSummary;
  /** Las variables de tinta del club, las mismas que arma la cabecera. */
  vars: string;
}

const { venue, vars } = Astro.props;

const capacidad = aforo(venue.capacity);
const superficie = superficieEnEspanol(venue.surface);
const foto = venue.imageUrl;

/* Solo lo que existe: una fila con huecos se lee como un formulario a medio llenar. */
const datos = [
  capacidad ? { valor: capacidad, rotulo: 'de aforo' } : null,
  superficie ? { valor: superficie, rotulo: 'campo' } : null,
].filter((d) => d !== null);
---

<section
  class="overflow-hidden rounded-xl border border-border bg-surface"
  aria-label={`Estadio de local: ${venue.name}`}
>
  <div class="relative h-28 bg-board" style={vars}>
    {
      foto ? (
        <img
          src={foto}
          alt=""
          width="640"
          height="360"
          loading="lazy"
          decoding="async"
          aria-hidden="true"
          class="absolute inset-0 h-full w-full object-cover"
        />
      ) : (
        <span
          class="absolute -right-4 top-1/2 -translate-y-1/2 text-(--tinta-tenue)"
          aria-hidden="true"
        >
          <Icon name="estadio" size={110} />
        </span>
      )
    }

    <!-- El velo del club: el texto se apoya en su propio color y no en la foto. -->
    <span
      class="pointer-events-none absolute inset-0"
      style="background:linear-gradient(0deg, var(--fondo-solido) 0%, color-mix(in oklab, var(--fondo-solido) 82%, transparent) 42%, transparent 72%)"
      aria-hidden="true"
    ></span>

    <div class="absolute inset-x-0 bottom-0 p-3">
      <p class="flex items-center gap-1.5 text-[10px] font-semibold uppercase tracking-label text-(--tinta-suave)">
        <Icon name="estadio" size={11} />
        La casa
      </p>
      <h2 class="mt-0.5 font-display text-base font-semibold uppercase leading-tight text-(--tinta)">
        {venue.name}
      </h2>
    </div>
  </div>

  <div class="grid gap-2 p-3">
    {
      datos.length > 0 && (
        <dl class="flex flex-wrap items-end gap-x-6 gap-y-2">
          {datos.map((dato) => (
            <div>
              <dd class="font-display text-lg font-semibold leading-none tabular">{dato.valor}</dd>
              <dt class="mt-1 text-2xs uppercase tracking-label text-ink-muted">{dato.rotulo}</dt>
            </div>
          ))}
        </dl>
      )
    }
    {venue.city && <p class="text-2xs text-ink-muted">{venue.city}</p>}
    <!-- Cada cifra lleva su origen, también cuando el origen a veces se equivoca de ciudad. -->
    <p class="text-[10px] text-ink-muted/70">dato del proveedor</p>
  </div>
</section>
