---
import Icon from '../Icon.astro';
import type { VenueSummary } from '../../lib/api';
import { aforo, fotoDeEstadio, superficieEnEspanol } from '../../lib/estadio';

/*
 * La casa del club, en el riel.
 *
 * La foto va **entera**: recortada al ancho de la tarjeta se perdía media tribuna y el estadio dejaba
 * de reconocerse, que es lo único que una foto de estadio tiene que lograr. Va sin cortar dentro de
 * una caja apaisada —más baja que la proporción de la foto, para que la tarjeta no se coma el riel— y
 * lo que sobra lo pinta el color del club.
 *
 * El nombre va debajo de la foto y no encima: con la imagen completa, cualquier texto superpuesto
 * tapa justo lo que se vino a ver.
 *
 * La escalera de degradación es la de siempre: sin foto queda la banda de color con el icono marcado,
 * y sin estadio la tarjeta no se dibuja.
 */
interface Props {
  venue: VenueSummary;
  /** Las variables de tinta del club, las mismas que arma la cabecera. */
  vars: string;
}

const { venue, vars } = Astro.props;

const capacidad = aforo(venue.capacity);
const superficie = superficieEnEspanol(venue.surface);
const foto = fotoDeEstadio(venue);

/* Solo lo que existe: una fila con huecos se lee como un formulario a medio llenar. */
const datos = [
  capacidad ? { valor: capacidad, rotulo: 'de aforo' } : null,
  superficie ? { valor: superficie, rotulo: 'campo' } : null,
].filter((d) => d !== null);
---

<section
  class="overflow-hidden rounded-xl border border-border bg-surface"
  aria-label={`Estadio de local: ${venue.name}`}
>
  <div class="relative bg-board" style={vars}>
    {
      foto ? (
        <img
          src={foto.url}
          alt={`Estadio ${venue.name}`}
          width="640"
          height="480"
          loading="lazy"
          decoding="async"
          class="aspect-[16/10] w-full object-contain"
        />
      ) : (
        <span class="grid h-28 place-items-center text-(--tinta-tenue)" aria-hidden="true">
          <Icon name="estadio" size={72} />
        </span>
      )
    }

    <div class="border-t border-(--linea) px-3 py-2.5">
      <p class="flex items-center gap-1.5 text-[10px] font-semibold uppercase tracking-label text-(--tinta-suave)">
        <Icon name="estadio" size={11} />
        La casa
      </p>
      <h2 class="mt-0.5 font-display text-base font-semibold uppercase leading-tight text-(--tinta)">
        {venue.name}
      </h2>
    </div>
  </div>

  <div class="grid gap-2 p-3">
    {
      datos.length > 0 && (
        <dl class="flex flex-wrap items-end gap-x-6 gap-y-2">
          {datos.map((dato) => (
            <div>
              <dd class="font-display text-lg font-semibold leading-none tabular">{dato.valor}</dd>
              <dt class="mt-1 text-2xs uppercase tracking-label text-ink-muted">{dato.rotulo}</dt>
            </div>
          ))}
        </dl>
      )
    }
    {venue.city && <p class="text-2xs text-ink-muted">{venue.city}</p>}

    <!--
      Cada cosa dice de dónde salió: los datos son del proveedor —que a veces se equivoca de ciudad—
      y la foto propia lleva el crédito que su licencia exige.
    -->
    <p class="text-[10px] leading-relaxed text-ink-muted/70">
      {foto?.credito ? `${foto.credito} · datos del proveedor` : 'dato del proveedor'}
    </p>
  </div>
</section>
