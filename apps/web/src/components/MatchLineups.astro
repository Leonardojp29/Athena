---
import type { LineupPlayer, TeamLineup, TeamSummary } from '../lib/api';
import Icon from './Icon.astro';

/*
 * Las listas debajo de la cancha. Cada nombre vinculado lleva a su perfil: la cancha ofrece
 * la ficha del partido y acá se llega a la carrera del jugador.
 */
interface Props {
  lineups: TeamLineup[];
  homeTeam: TeamSummary;
  awayTeam: TeamSummary;
}

const { lineups, homeTeam, awayTeam } = Astro.props;
const ordered = [homeTeam, awayTeam]
  .map((team) => ({ team, lineup: lineups.find((l) => l.teamId === team.id) }))
  .filter(
    (entry): entry is { team: TeamSummary; lineup: TeamLineup } => entry.lineup !== undefined,
  );
---

{
  ordered.length > 0 && (
    <section class="mt-4 rounded-lg border border-border bg-surface p-4">
      <h2 class="mb-4 text-base font-semibold">Alineaciones</h2>
      <div class="grid gap-6 sm:grid-cols-2">
        {ordered.map(({ team, lineup }) => (
          <div>
            <a
              href={`/equipos/${team.slug}`}
              class="mb-1 flex items-center gap-2 transition-colors hover:text-primary-ink"
            >
              {team.logoUrl && (
                <img src={team.logoUrl} alt="" width="20" height="20" loading="lazy" />
              )}
              <span class="truncate text-sm font-medium">{team.name}</span>
              {lineup.formation && (
                <span class="ml-auto shrink-0 tabular text-2xs text-ink-muted">
                  {lineup.formation}
                </span>
              )}
            </a>
            {lineup.coachName && (
              <p class="mb-2 flex items-center gap-1.5 text-2xs text-ink-muted">
                <Icon name="formacion" size={12} />
                {lineup.coachName}
              </p>
            )}

            <ul class="grid gap-0">
              {lineup.startXi.map((player: LineupPlayer) => (
                <li>
                  {player.slug ? (
                    <a
                      href={`/jugadores/${player.slug}`}
                      class="flex items-center gap-2 rounded-md px-1 py-1 text-sm transition-colors hover:bg-canvas-subtle hover:text-primary-ink"
                    >
                      <span class="w-6 shrink-0 text-right tabular text-2xs text-ink-muted">
                        {player.number ?? '–'}
                      </span>
                      <span class="truncate">{player.name}</span>
                    </a>
                  ) : (
                    <span class="flex items-center gap-2 px-1 py-1 text-sm">
                      <span class="w-6 shrink-0 text-right tabular text-2xs text-ink-muted">
                        {player.number ?? '–'}
                      </span>
                      <span class="truncate text-ink-muted">{player.name}</span>
                    </span>
                  )}
                </li>
              ))}
            </ul>

            {lineup.substitutes.length > 0 && (
              <details class="group mt-3">
                <summary class="flex cursor-pointer list-none items-center gap-1.5 text-2xs text-ink-muted transition-colors hover:text-ink">
                  <Icon
                    name="chevron-derecha"
                    size={12}
                    class="transition-transform group-open:rotate-90"
                  />
                  Suplentes ({lineup.substitutes.length})
                </summary>
                <ul class="mt-1 grid gap-0">
                  {lineup.substitutes.map((player: LineupPlayer) => (
                    <li>
                      {player.slug ? (
                        <a
                          href={`/jugadores/${player.slug}`}
                          class="flex items-center gap-2 rounded-md px-1 py-0.5 text-2xs text-ink-muted transition-colors hover:bg-canvas-subtle hover:text-ink"
                        >
                          <span class="w-6 shrink-0 text-right tabular">
                            {player.number ?? '–'}
                          </span>
                          <span class="truncate">{player.name}</span>
                        </a>
                      ) : (
                        <span class="flex items-center gap-2 px-1 py-0.5 text-2xs text-ink-muted">
                          <span class="w-6 shrink-0 text-right tabular">
                            {player.number ?? '–'}
                          </span>
                          <span class="truncate">{player.name}</span>
                        </span>
                      )}
                    </li>
                  ))}
                </ul>
              </details>
            )}
          </div>
        ))}
      </div>
    </section>
  )
}
