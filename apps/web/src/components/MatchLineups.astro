---
import type { LineupPlayer, TeamLineup, TeamSummary } from '../lib/api';

interface Props {
  lineups: TeamLineup[];
  homeTeam: TeamSummary;
  awayTeam: TeamSummary;
}

const { lineups, homeTeam, awayTeam } = Astro.props;
const ordered = [homeTeam, awayTeam]
  .map((team) => ({ team, lineup: lineups.find((l) => l.teamId === team.id) }))
  .filter((entry): entry is { team: TeamSummary; lineup: TeamLineup } => entry.lineup !== undefined);

const playerLine = (player: LineupPlayer) =>
  `${player.number !== null ? `${player.number}. ` : ''}${player.name}`;
---

{
  ordered.length > 0 && (
    <section class="bg-surface border border-border rounded-lg p-4 mt-4">
      <h2 class="text-base font-semibold mb-4">Alineaciones</h2>
      <div class="grid sm:grid-cols-2 gap-6">
        {ordered.map(({ team, lineup }) => (
          <div>
            <div class="flex items-center gap-2 mb-1">
              {team.logoUrl && <img src={team.logoUrl} alt="" width="20" height="20" loading="lazy" />}
              <span class="text-sm font-medium truncate">{team.name}</span>
              {lineup.formation && (
                <span class="text-xs text-ink-muted tabular ml-auto shrink-0">{lineup.formation}</span>
              )}
            </div>
            {lineup.coachName && (
              <p class="text-xs text-ink-muted mb-2">DT: {lineup.coachName}</p>
            )}

            <ul class="grid gap-1 text-sm">
              {lineup.startXi.map((player) => (
                <li class="flex gap-2">
                  <span class="tabular text-ink-muted w-6 shrink-0 text-right">{player.number ?? '–'}</span>
                  {player.playerId ? (
                    <span class="truncate">{player.name}</span>
                  ) : (
                    <span class="truncate text-ink">{player.name}</span>
                  )}
                </li>
              ))}
            </ul>

            {lineup.substitutes.length > 0 && (
              <details class="mt-3">
                <summary class="text-xs text-ink-muted cursor-pointer hover:text-ink transition-colors">
                  Suplentes ({lineup.substitutes.length})
                </summary>
                <ul class="grid gap-0.5 mt-2 text-xs text-ink-muted">
                  {lineup.substitutes.map((player) => <li>{playerLine(player)}</li>)}
                </ul>
              </details>
            )}
          </div>
        ))}
      </div>
    </section>
  )
}
