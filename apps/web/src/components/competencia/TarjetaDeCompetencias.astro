---
import EscudoTorneo from '../EscudoTorneo.astro';
import CountryFlag from '../CountryFlag.astro';
import Icon from '../Icon.astro';
import type { NavCompetition } from '../../lib/nav-types';
import { nombreTorneo } from '../../lib/paises';

/*
 * Una tarjeta del índice: un grupo de torneos con su cabecera.
 *
 * Sirve para los tres grupos que tiene el catálogo —el país, las copas de la confederación y las
 * selecciones— porque los tres se leen igual: un título con su emblema y la lista de torneos.
 *
 * La cabecera es una banda con el emblema grande. Antes era una línea de veintidós píxeles donde la
 * bandera valía lo mismo que el contador, y en una grilla de doce tarjetas eso deja doce cajas que
 * hay que leer para distinguir. Con el emblema a treinta y seis, el país se reconoce sin leer.
 */
interface Props {
  titulo: string;
  /** El emblema de la cabecera: la bandera del país o el escudo del torneo que representa al grupo. */
  flagUrl?: string | null;
  code?: string | null;
  logoUrl?: string | null;
  competitions: NavCompetition[];
}

const { titulo, flagUrl = null, code = null, logoUrl = null, competitions } = Astro.props;
---

<section
  class="group/tarjeta flex h-full flex-col overflow-hidden rounded-xl border border-border bg-surface transition-[border-color,transform] duration-200 hover:-translate-y-0.5 hover:border-border-strong"
>
  <header class="flex items-center gap-3 border-b border-border bg-canvas-subtle/60 px-4 py-3">
    <span class="grid size-9 shrink-0 place-items-center overflow-hidden rounded-lg bg-surface ring-1 ring-border">
      {
        logoUrl ? (
          <EscudoTorneo url={logoUrl} size={24} />
        ) : (
          <CountryFlag url={flagUrl} code={code} name={titulo} size={24} />
        )
      }
    </span>
    <h3 class="min-w-0 flex-1 truncate font-display text-base font-semibold uppercase leading-tight tracking-label">
      {titulo}
    </h3>
    <span
      class="shrink-0 rounded-full bg-ink/[0.06] px-2 py-0.5 tabular text-2xs font-medium text-ink-muted"
    >
      {competitions.length}
    </span>
  </header>

  <ul class="grid flex-1 content-start gap-0.5 p-2">
    {
      competitions.map((competition) => (
        <li>
          <a
            href={`/competencias/${competition.slug}`}
            class="group flex items-center gap-3 rounded-lg px-2 py-2 transition-colors hover:bg-canvas-subtle"
          >
            <span class="grid size-8 shrink-0 place-items-center rounded-md bg-canvas-subtle transition-transform duration-200 group-hover:scale-105">
              {competition.logoUrl ? (
                <EscudoTorneo url={competition.logoUrl} size={20} />
              ) : (
                <Icon name="estadio" size={15} class="text-ink-muted" />
              )}
            </span>
            <span class="min-w-0 flex-1 truncate text-sm font-medium">
              {nombreTorneo(competition.name)}
            </span>
            {competition.format === 'cup' && (
              <span class="shrink-0 text-2xs uppercase tracking-label text-ink-muted">copa</span>
            )}
            <Icon
              name="chevron-derecha"
              size={15}
              class="shrink-0 text-ink-muted transition-transform duration-200 group-hover:translate-x-0.5 group-hover:text-primary-ink"
            />
          </a>
        </li>
      ))
    }
  </ul>
</section>
