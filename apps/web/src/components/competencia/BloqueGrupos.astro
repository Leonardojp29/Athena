---
import Icon from '../Icon.astro';
import PartidoDeGrupo from './PartidoDeGrupo.astro';
import StandingsTable from '../StandingsTable.astro';
import type { RondaDeGrupos, StandingRow } from '../../lib/api';
import { nombreFase } from '../../lib/paises';

/*
 * La fase de grupos, grupo por grupo.
 *
 * Antes era una grilla de cuatro columnas con tablas chiquitas y, colgando de cada una, un `<details>`
 * con sus partidos: ocho grupos de Libertadores eran una pared de números sin un solo partido a la
 * vista, y había que abrirlos uno por uno. Una tabla dice cómo quedó el grupo; no dice contra quién
 * ni con qué goles, que es justo lo que se busca al abrir un grupo.
 *
 * Ahora la grilla es la puerta y el detalle ocupa el mismo contenedor en **dos columnas iguales**: la
 * tabla completa a la izquierda y, a la derecha, los partidos de una fecha con sus goleadores debajo
 * de cada equipo. Las pestañas saltan de un grupo a otro sin volver a la grilla.
 *
 * Todos los paneles se dibujan en el servidor y el guion solo los muestra: son noventa y seis
 * partidos en una Libertadores, y a cambio la página tiene su contenido sin depender de JavaScript.
 * El estado va a la URL —`?grupo=` y `?fecha=`— así que el enlace es compartible.
 */
interface Props {
  grupos: Array<{ label: string; rows: StandingRow[]; current: boolean }>;
  /** Las fechas de la fase de grupos, cada una partida por grupo. */
  rondas?: RondaDeGrupos[];
  /** El grupo pedido por la URL; sin él, la grilla. */
  abierto?: string | null;
  /** La fecha pedida por la URL, 1 en adelante. */
  fechaPedida?: number | null;
  hrefGrupo: (label: string | null) => string;
  hrefEquipo: (slug: string) => string;
  hrefPartido?: (id: string) => string;
}

const {
  grupos,
  rondas = [],
  abierto = null,
  fechaPedida = null,
  hrefGrupo,
  hrefEquipo,
  hrefPartido,
} = Astro.props;

/*
 * La tabla que el proveedor llama "Group Stage" junto a doce grupos no es la fase de grupos: es el
 * ranking de los que salieron terceros, que en un Mundial de 48 decide ocho clasificados. Se lo
 * comprueba —todos son terceros de su grupo— antes de ponerle el nombre, y no abre detalle porque
 * no es un grupo: no tiene partidos propios.
 */
const esDeTerceros = (label: string, rows: StandingRow[]) =>
  grupos.length > 1 &&
  rows.length > 2 &&
  rows.every((fila) =>
    grupos.some(
      (g) => g.label !== label && g.rows.some((r) => r.team.id === fila.team.id && r.position === 3),
    ),
  );

/* "Fase de grupos · fecha 6" → "fecha 6": el bloque ya se llama Fase de grupos. */
const soloLaFecha = (label: string) => label.split('·').at(-1)?.trim() ?? label;

const fechasDe = (label: string) =>
  rondas
    .map((ronda) => ({
      label: soloLaFecha(ronda.label),
      enJuego: ronda.enJuego,
      partidos: ronda.bloques.find((b) => b.titulo === label)?.partidos ?? [],
    }))
    .filter((f) => f.partidos.length > 0);

/* La que se juega; si el grupo terminó, la última con algo jugado, que es donde quedó. */
const fechaInicial = (fechas: ReturnType<typeof fechasDe>) => {
  if (fechaPedida !== null && fechaPedida >= 1 && fechaPedida <= fechas.length) return fechaPedida - 1;
  const enJuego = fechas.findIndex((f) => f.enJuego);
  if (enJuego !== -1) return enJuego;
  const jugada = fechas.map((f) => f.partidos.some((p) => p.status === 'finished')).lastIndexOf(true);
  return jugada === -1 ? 0 : jugada;
};

const conDetalle = grupos
  .map((g) => ({ ...g, fechas: fechasDe(g.label), terceros: esDeTerceros(g.label, g.rows) }))
  .map((g) => ({ ...g, abrible: !g.terceros && g.fechas.length > 0 }));

/*
 * Ocho por página: dos filas de cuatro, que es lo que entra sin que la fase de grupos se coma la
 * pantalla. Los trece del Mundial pasan a dos páginas con su navegación, y la altura del bloque deja
 * de depender de cuántos grupos tenga el torneo —ni de si hay un grupo abierto—.
 */
const POR_PAGINA = 8;
const paginas = Array.from({ length: Math.ceil(conDetalle.length / POR_PAGINA) }, (_, i) =>
  conDetalle.slice(i * POR_PAGINA, (i + 1) * POR_PAGINA),
);

/* Con uno o dos grupos no hay grilla que valga: se abre el detalle, que es lo que hay que mostrar. */
const soloUno = conDetalle.filter((g) => g.abrible).length <= 2;
const activo =
  conDetalle.find((g) => g.abrible && g.label === abierto) ??
  (soloUno ? conDetalle.find((g) => g.abrible) : undefined);
const tituloDe = (g: (typeof conDetalle)[number]) =>
  g.terceros ? 'Mejores terceros' : nombreFase(g.label);
---

{
  grupos.length > 0 && (
    <section class="rounded-xl border border-border bg-surface" data-grupos>
      <header class="flex flex-wrap items-center justify-between gap-2 border-b border-border p-3">
        <h2 class="flex items-center gap-2 font-display text-base font-semibold uppercase">
          Fase de grupos
          <span class="font-sans text-2xs font-medium normal-case text-ink-muted">
            {grupos.length > 1 ? `${grupos.length} grupos` : nombreFase(grupos[0]?.label ?? '')}
          </span>
        </h2>
      </header>

      <!--
        El cuerpo mide siempre lo mismo: el alto de dos filas de grupos. Antes la grilla medía 557px
        y el detalle 532, así que abrir un grupo encogía el bloque y la página daba un salto. Los dos
        estados viven acá adentro y lo llenan; lo que sobra desplaza por dentro.
      -->
      <div class="lg:h-[34rem]">
      <div data-panel-grilla hidden={activo !== undefined} class="flex h-full flex-col p-3">
        {paginas.length > 1 && (
          <div class="mb-2 flex items-center gap-1.5">
            <button
              type="button"
              data-pagina-anterior
              class="grid size-6 shrink-0 cursor-pointer place-items-center rounded text-ink-muted transition-colors hover:bg-canvas-subtle hover:text-ink disabled:cursor-default disabled:opacity-25"
              aria-label="Grupos anteriores"
            >
              <Icon name="chevron-derecha" size={14} class="rotate-180" />
            </button>
            <p data-pagina-titulo class="text-2xs font-medium text-ink-muted">
              Grupos 1 a {Math.min(POR_PAGINA, conDetalle.length)}
            </p>
            <button
              type="button"
              data-pagina-siguiente
              class="grid size-6 shrink-0 cursor-pointer place-items-center rounded text-ink-muted transition-colors hover:bg-canvas-subtle hover:text-ink disabled:cursor-default disabled:opacity-25"
              aria-label="Más grupos"
            >
              <Icon name="chevron-derecha" size={14} />
            </button>
            <span class="ml-auto text-2xs text-ink-muted">
              {conDetalle.length} grupos
            </span>
          </div>
        )}

        {paginas.map((pagina, i) => (
          <div
            data-pagina-grupos={i}
            data-pagina-rotulo={`Grupos ${i * POR_PAGINA + 1} a ${i * POR_PAGINA + pagina.length}`}
            hidden={i !== 0}
            class="barra-fina grid min-h-0 flex-1 content-start gap-x-6 gap-y-5 sm:grid-cols-2 lg:grid-cols-4 lg:overflow-y-auto"
          >
        {pagina.map((g) => (
          <div class="grid content-start gap-1">
            <p class="font-display text-sm font-semibold uppercase leading-none">{tituloDe(g)}</p>
            <!--
              La de mejores terceros trae doce filas y rompía el ritmo de dos filas de grupos: se
              queda con el alto de un grupo y desplaza por dentro, que es mejor que empujar la
              grilla o que cortarse a la mitad.
            -->
            <StandingsTable
              rows={g.rows}
              compacto
              maxAlto={g.rows.length > 6 ? '10.5rem' : undefined}
              hrefEquipo={hrefEquipo}
            />
            {g.abrible && (
              <a
                href={hrefGrupo(g.label)}
                data-abrir-grupo={g.label}
                class="group/abrir flex items-center gap-1 rounded-md px-1.5 py-1 text-2xs font-medium text-primary-ink transition-colors hover:bg-canvas-subtle"
              >
                Ver el grupo
                <span class="tabular text-ink-muted">
                  {`· ${g.fechas.length} ${g.fechas.length === 1 ? 'fecha' : 'fechas'}`}
                </span>
                <Icon
                  name="chevron-derecha"
                  size={12}
                  class="ml-auto shrink-0 transition-transform group-hover/abrir:translate-x-0.5"
                />
              </a>
            )}
          </div>
        ))}
          </div>
        ))}
      </div>

      <!-- Un panel por grupo: tabla y partidos, en dos columnas iguales y del mismo alto. -->
      {conDetalle
        .filter((g) => g.abrible)
        .map((g) => (
          <div
            data-panel-grupo={g.label}
            hidden={activo?.label !== g.label}
            class="flex h-full flex-col"
          >
            <div class="flex flex-wrap items-center gap-x-3 gap-y-2 border-b border-border px-3 py-2">
              {!soloUno && (
                <a
                  href={hrefGrupo(null)}
                  data-cerrar-grupo
                  class="flex items-center gap-1 rounded-md px-1.5 py-1 text-2xs font-medium text-ink-muted transition-colors hover:bg-canvas-subtle hover:text-ink"
                >
                  <Icon name="flecha-izquierda" size={12} />
                  Todos los grupos
                </a>
              )}

              {!soloUno && (
                <div class="flex flex-wrap items-center gap-1" role="group" aria-label="Grupos">
                  {conDetalle
                    .filter((otro) => otro.abrible)
                    .map((otro) => (
                      <a
                        href={hrefGrupo(otro.label)}
                        data-abrir-grupo={otro.label}
                        aria-current={otro.label === g.label ? 'true' : undefined}
                        class="rounded-md px-2 py-1 text-2xs font-medium text-ink-muted transition-colors hover:bg-canvas-subtle hover:text-ink aria-[current]:bg-primary/12 aria-[current]:text-ink"
                      >
                        {tituloDe(otro).replace(/^Grupo\s+/i, '')}
                      </a>
                    ))}
                </div>
              )}
            </div>

            <div class="grid min-h-0 flex-1 gap-4 p-3 lg:grid-cols-2">
              <div class="barra-fina min-w-0 lg:overflow-y-auto">
                <p class="mb-1.5 font-display text-sm font-semibold uppercase leading-none">
                  {tituloDe(g)}
                </p>
                <StandingsTable rows={g.rows} hrefEquipo={hrefEquipo} />
              </div>

              <!-- La fecha, con las flechas del carrusel de rondas: mismo gesto en toda la página. -->
              <div class="barra-fina flex min-w-0 flex-col lg:overflow-y-auto" data-fechas>
                <div class="mb-1.5 flex items-center gap-1.5">
                  <button
                    type="button"
                    data-fecha-anterior
                    class="grid size-6 shrink-0 cursor-pointer place-items-center rounded text-ink-muted transition-colors hover:bg-canvas-subtle hover:text-ink disabled:cursor-default disabled:opacity-25"
                    aria-label="Fecha anterior"
                  >
                    <Icon name="chevron-derecha" size={14} class="rotate-180" />
                  </button>
                  <p data-fecha-titulo class="font-display text-sm font-semibold uppercase leading-none">
                    {g.fechas[fechaInicial(g.fechas)]?.label ?? ''}
                  </p>
                  <button
                    type="button"
                    data-fecha-siguiente
                    class="grid size-6 shrink-0 cursor-pointer place-items-center rounded text-ink-muted transition-colors hover:bg-canvas-subtle hover:text-ink disabled:cursor-default disabled:opacity-25"
                    aria-label="Fecha siguiente"
                  >
                    <Icon name="chevron-derecha" size={14} />
                  </button>
                  <span class="ml-auto flex items-center gap-1">
                    {g.fechas.map((_, i) => (
                      <button
                        type="button"
                        data-fecha-punto={i}
                        aria-current={i === fechaInicial(g.fechas) ? 'true' : undefined}
                        aria-label={`Fecha ${i + 1}`}
                        class="size-1.5 cursor-pointer rounded-full bg-border-strong transition-colors hover:bg-ink-muted aria-[current]:bg-primary-ink"
                      />
                    ))}
                  </span>
                </div>

                {g.fechas.map((fecha, i) => (
                  <!-- `content-center`: con dos partidos y el alto de dos filas de grupos, pegarlos
                       arriba dejaba media tarjeta vacía; centrados se leen contra la tabla. -->
                  <div
                    data-fecha-panel={i}
                    data-fecha-rotulo={fecha.label}
                    hidden={i !== fechaInicial(g.fechas)}
                    class="grid min-h-0 flex-1 content-center gap-2"
                  >
                    {fecha.partidos.map((partido) => (
                      <PartidoDeGrupo
                        partido={partido}
                        hrefPartido={hrefPartido}
                        hrefEquipo={hrefEquipo}
                      />
                    ))}
                  </div>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>
  )
}

<script>
  /*
   * Abrir un grupo y moverse por sus fechas sin navegar: los paneles ya están en la página y acá solo
   * se muestran. La URL se actualiza igual —`?grupo=` y `?fecha=`— para que el enlace siga siendo
   * compartible y el botón de atrás haga lo que promete.
   */
  const caja = document.querySelector<HTMLElement>('[data-grupos]');
  if (caja) {
    const grilla = caja.querySelector<HTMLElement>('[data-panel-grilla]');
    const paneles = [...caja.querySelectorAll<HTMLElement>('[data-panel-grupo]')];

    const url = (grupo: string | null, fecha: number | null) => {
      const u = new URL(location.href);
      if (grupo) u.searchParams.set('grupo', grupo);
      else u.searchParams.delete('grupo');
      if (fecha) u.searchParams.set('fecha', String(fecha));
      else u.searchParams.delete('fecha');
      return u;
    };

    const mostrarGrupo = (label: string | null): void => {
      if (grilla) grilla.hidden = label !== null;
      for (const panel of paneles) panel.hidden = panel.dataset.panelGrupo !== label;
    };

    for (const boton of caja.querySelectorAll<HTMLAnchorElement>('[data-abrir-grupo]')) {
      boton.addEventListener('click', (evento) => {
        if (evento.metaKey || evento.ctrlKey || evento.shiftKey) return;
        evento.preventDefault();
        const label = boton.dataset.abrirGrupo as string;
        mostrarGrupo(label);
        history.pushState({ grupo: label }, '', url(label, null));
      });
    }

    for (const boton of caja.querySelectorAll<HTMLAnchorElement>('[data-cerrar-grupo]')) {
      boton.addEventListener('click', (evento) => {
        if (evento.metaKey || evento.ctrlKey || evento.shiftKey) return;
        evento.preventDefault();
        mostrarGrupo(null);
        history.pushState({ grupo: null }, '', url(null, null));
      });
    }

    /*
     * Las páginas de la grilla: ocho grupos por vez. Con trece grupos, la segunda página no puede
     * ser un scroll infinito hacia abajo —el bloque tiene que medir siempre lo mismo—.
     */
    const paginas = [...caja.querySelectorAll<HTMLElement>('[data-pagina-grupos]')];
    if (paginas.length > 1) {
      const rotulo = caja.querySelector<HTMLElement>('[data-pagina-titulo]');
      const atras = caja.querySelector<HTMLButtonElement>('[data-pagina-anterior]');
      const adelante = caja.querySelector<HTMLButtonElement>('[data-pagina-siguiente]');
      let pagina = 0;

      const verPagina = (indice: number): void => {
        pagina = Math.min(paginas.length - 1, Math.max(0, indice));
        paginas.forEach((p, i) => {
          p.hidden = i !== pagina;
        });
        if (rotulo) rotulo.textContent = paginas[pagina]?.dataset.paginaRotulo ?? '';
        if (atras) atras.disabled = pagina === 0;
        if (adelante) adelante.disabled = pagina === paginas.length - 1;
      };

      atras?.addEventListener('click', () => verPagina(pagina - 1));
      adelante?.addEventListener('click', () => verPagina(pagina + 1));
      verPagina(0);
    }

    /* Las fechas de cada grupo, cada una con su propio carrusel. */
    for (const zona of caja.querySelectorAll<HTMLElement>('[data-fechas]')) {
      const fechas = [...zona.querySelectorAll<HTMLElement>('[data-fecha-panel]')];
      if (fechas.length === 0) continue;
      const titulo = zona.querySelector<HTMLElement>('[data-fecha-titulo]');
      const anterior = zona.querySelector<HTMLButtonElement>('[data-fecha-anterior]');
      const siguiente = zona.querySelector<HTMLButtonElement>('[data-fecha-siguiente]');
      const puntos = [...zona.querySelectorAll<HTMLButtonElement>('[data-fecha-punto]')];
      /* El rótulo de cada fecha ya está escrito en el servidor: acá solo se copia al encabezado. */
      const rotulos = fechas.map((p) => p.dataset.fechaRotulo ?? titulo?.textContent ?? '');
      let actual = Math.max(
        0,
        fechas.findIndex((p) => !p.hidden),
      );

      const mostrar = (indice: number): void => {
        actual = Math.min(fechas.length - 1, Math.max(0, indice));
        fechas.forEach((panel, i) => {
          panel.hidden = i !== actual;
        });
        puntos.forEach((punto, i) => {
          if (i === actual) punto.setAttribute('aria-current', 'true');
          else punto.removeAttribute('aria-current');
        });
        if (titulo && rotulos[actual]) titulo.textContent = rotulos[actual] as string;
        if (anterior) anterior.disabled = actual === 0;
        if (siguiente) siguiente.disabled = actual === fechas.length - 1;

        const grupo = zona.closest<HTMLElement>('[data-panel-grupo]')?.dataset.panelGrupo ?? null;
        if (grupo && !zona.closest('[hidden]')) {
          history.replaceState({ grupo }, '', url(grupo, actual + 1));
        }
      };

      anterior?.addEventListener('click', () => mostrar(actual - 1));
      siguiente?.addEventListener('click', () => mostrar(actual + 1));
      puntos.forEach((punto, i) => punto.addEventListener('click', () => mostrar(i)));
      mostrar(actual);
    }

    addEventListener('popstate', () => {
      mostrarGrupo(new URL(location.href).searchParams.get('grupo'));
    });
  }
</script>
