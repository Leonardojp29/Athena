---
import SelectorFase from '../SelectorFase.astro';
import StandingsTable from '../StandingsTable.astro';
import type { StandingRow } from '../../lib/api';
import { nombreFase } from '../../lib/paises';

/*
 * La fase de grupos de una copa.
 *
 * Con ocho grupos de cuatro equipos, el selector mostraba un grupo por vez y dejaba el resto de la
 * columna vacío: en una copa se quiere leer la fase entera de un golpe. Con dos o menos —una fase
 * liga, dos conferencias— vuelve el selector y la tabla completa, que ahí sí tiene qué mostrar.
 */
interface Props {
  grupos: Array<{ label: string; rows: StandingRow[]; current: boolean }>;
  abierto: { label: string; rows: StandingRow[] } | undefined;
  juntos: boolean;
  enJuego: boolean;
  hrefFase: (label: string) => string;
  hrefEquipo: (slug: string) => string;
}

const { grupos, abierto, juntos, enJuego, hrefFase, hrefEquipo } = Astro.props;
---

{
  grupos.length > 0 && (
    <section class="rounded-xl border border-border bg-surface">
      <header class="flex flex-wrap items-center justify-between gap-2 border-b border-border p-3">
        <h2 class="flex items-center gap-2 font-display text-base font-semibold uppercase">
          Fase de grupos
          <span class="font-sans text-2xs font-medium normal-case text-ink-muted">
            {grupos.length > 1 ? `${grupos.length} grupos` : nombreFase(grupos[0]?.label ?? '')}
          </span>
        </h2>
        {!juntos && abierto && (
          <SelectorFase grupos={grupos} activo={abierto.label} href={hrefFase} />
        )}
      </header>

      {juntos ? (
        <!-- A todo el ancho entran cuatro grupos por fila: en dos, la tabla de cuatro equipos se
             estiraba y el nombre quedaba lejos de los puntos. -->
        <div class="grid gap-x-6 gap-y-5 p-3 sm:grid-cols-2 xl:grid-cols-3 2xl:grid-cols-4">
          {grupos.map((g) => (
            <div>
              <p class="mb-1 font-display text-sm font-semibold uppercase leading-none">
                {nombreFase(g.label)}
              </p>
              <StandingsTable rows={g.rows} compacto hrefEquipo={hrefEquipo} />
            </div>
          ))}
        </div>
      ) : (
        abierto && (
          <div class="p-3">
            <StandingsTable rows={abierto.rows} hrefEquipo={hrefEquipo} />
          </div>
        )
      )}
    </section>
  )
}
