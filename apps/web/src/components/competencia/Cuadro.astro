---
import Icon from '../Icon.astro';
import type { LlaveDeCuadro, RondaDeCuadro } from '../../lib/api';
import type { PaletaCompetencia } from '../../lib/coloresCompetencia';
import { formatDate, formatKickoff, isLive } from '../../lib/format';

/*
 * El cuadro de una copa: las rondas en columnas, de la más lejana a la final.
 *
 * Es la pregunta que trae a alguien a la página de la Libertadores —quién juega con quién y cómo
 * sigue— y hasta ahora la respuesta era una lista de resultados sueltos. Cada llave muestra sus
 * partidos, el global y quién pasó; quién pasó lo dice la ronda siguiente y no el resultado, así que
 * las llaves definidas por penales quedan bien resueltas sin que el proveedor publique la tanda.
 *
 * No se dibujan las líneas que unen una llave con la siguiente: el cuadro real tiene fases previas,
 * grupos y equipos que entran más tarde, así que cualquier línea prometería un árbol perfecto que no
 * existe. Lo que sí se dice es cuántos equipos deja cada ronda y quién sigue vivo.
 */
interface Props {
  rondas: RondaDeCuadro[];
  paleta: PaletaCompetencia | null;
  /** La jornada en curso según el calendario, para marcar la columna que se está jugando. */
  rondaActual: string | null;
}

const { rondas, paleta, rondaActual } = Astro.props;

const acento = paleta?.acento.base ?? 'var(--color-primary-ink)';
const halo = paleta?.acento.suave(0.14) ?? 'color-mix(in oklab, var(--color-primary) 14%, transparent)';

/* El nombre completo, recortado por CSS: el `shortName` del proveedor son tres letras —"STR", "TAC"—
   y una llave escrita así no se entiende. */
const nombreCorto = (equipo: { name: string; shortName: string | null }) => equipo.name;

/* El campeón: el que pasó la última ronda, que es la final cuando el cuadro está completo. */
const final = rondas.at(-1);
const campeon =
  final && final.ties.length === 1 && final.ties[0]?.advancedTeamId
    ? [final.ties[0].homeTeam, final.ties[0].awayTeam].find(
        (t) => t.id === final.ties[0]?.advancedTeamId,
      )
    : null;

/** Los goles de un equipo en un partido, sin importar de qué lado jugó. */
const golesDe = (leg: LlaveDeCuadro['legs'][number], teamId: string): number | null => {
  if (leg.homeScore === null || leg.awayScore === null) return null;
  return leg.homeTeam.id === teamId ? leg.homeScore : leg.awayScore;
};

const proximo = (llave: LlaveDeCuadro) =>
  llave.legs.find((l) => l.status !== 'finished') ?? null;
---

<section class="overflow-hidden rounded-xl border border-border bg-surface">
  <header class="flex flex-wrap items-center gap-x-3 gap-y-1 border-b border-border p-3">
    <span style={`color:${acento}`}><Icon name="cuadro" size={16} /></span>
    <h2 class="font-display text-base font-semibold uppercase leading-none">Camino al título</h2>
    {
      campeon && (
        <span
          class="flex items-center gap-1.5 rounded-full px-2 py-0.5 text-2xs font-semibold"
          style={`background:${halo};color:${acento}`}
        >
          <Icon name="trofeo" size={12} />
          Campeón: {campeon.name}
        </span>
      )
    }
    <span class="ml-auto text-2xs text-ink-muted">{rondas.length} rondas</span>
  </header>

  <!-- Las rondas en fila y con desplazamiento propio: una copa africana tiene seis, y apiladas la
       página se vuelve un scroll infinito donde se pierde el sentido de avance. -->
  <div class="overflow-x-auto overscroll-x-contain p-3">
    <ol class="flex min-w-max snap-x snap-mandatory gap-3">
      {
        rondas.map((ronda) => {
          const enJuego = rondaActual !== null && ronda.round === rondaActual;
          const equipos = new Set(ronda.ties.flatMap((t) => [t.homeTeam.id, t.awayTeam.id]));
          return (
            <li class="w-[15.5rem] shrink-0 snap-start">
              <div
                class="mb-2 border-b-2 px-1 pb-1.5"
                style={enJuego ? `border-color:${acento}` : 'border-color:var(--color-border-strong)'}
              >
                <p
                  class="flex items-center gap-1.5 font-display text-sm font-semibold uppercase leading-none"
                  style={enJuego ? `color:${acento}` : undefined}
                >
                  {ronda.label}
                  {enJuego && (
                    <span class="text-2xs font-medium normal-case" style={`color:${acento}`}>
                      en juego
                    </span>
                  )}
                </p>
                <p class="mt-0.5 text-2xs text-ink-muted">
                  {equipos.size} equipos · {ronda.ties.length}{' '}
                  {ronda.ties.length === 1 ? 'llave' : 'llaves'}
                </p>
              </div>

              <ol class="grid gap-1.5">
                {ronda.ties.map((llave) => {
                  const pendiente = proximo(llave);
                  const doble = llave.legs.length > 1;
                  const ganador = [llave.homeTeam, llave.awayTeam].find(
                    (t) => t.id === llave.advancedTeamId,
                  );
                  return (
                    <li class="rounded-lg border border-border bg-canvas-subtle/40">
                      {[llave.homeTeam, llave.awayTeam].map((equipo) => {
                        const paso = llave.advancedTeamId === equipo.id;
                        return (
                          <div
                            class="flex items-center gap-1.5 border-b border-border/60 px-2 py-1.5 last:border-b-0"
                            style={paso ? `box-shadow:inset 2px 0 0 ${acento}` : undefined}
                          >
                            <a
                              href={`/equipos/${equipo.slug}`}
                              class="flex min-w-0 flex-1 items-center gap-1.5 transition-colors hover:text-primary-ink"
                            >
                              {equipo.logoUrl ? (
                                <img
                                  src={equipo.logoUrl}
                                  alt=""
                                  width="18"
                                  height="18"
                                  loading="lazy"
                                  class="size-[18px] shrink-0 rounded-sm bg-surface object-contain p-px"
                                />
                              ) : (
                                <span class="size-[18px] shrink-0 rounded-sm bg-surface" />
                              )}
                              <span
                                class:list={[
                                  'truncate text-xs',
                                  paso ? 'font-semibold' : 'text-ink-muted',
                                ]}
                              >
                                {nombreCorto(equipo)}
                              </span>
                            </a>

                            <!-- Un casillero por partido: la ida y la vuelta se leen en columna. -->
                            {llave.legs.map((leg) => {
                              const goles = golesDe(leg, equipo.id);
                              return (
                                <a
                                  href={`/partidos/${leg.id}`}
                                  title={`${formatDate(leg.kickoffUtc)} · ${formatKickoff(leg.kickoffUtc)}`}
                                  class:list={[
                                    'w-5 shrink-0 rounded text-center font-display text-xs font-semibold tabular transition-colors hover:bg-canvas-subtle',
                                    goles === null ? 'text-ink-muted/50' : paso ? '' : 'text-ink-muted',
                                    isLive(leg.status) ? 'text-live' : '',
                                  ]}
                                >
                                  {goles ?? '–'}
                                </a>
                              );
                            })}
                            <span class="w-3 shrink-0">
                              {paso && (
                                <span style={`color:${acento}`}>
                                  <Icon name="check" size={12} />
                                </span>
                              )}
                            </span>
                          </div>
                        );
                      })}

                      <p class="flex items-center gap-1.5 border-t border-border/60 px-2 py-1 text-[10px] leading-none text-ink-muted">
                        {
                          pendiente ? (
                            <>
                              <Icon name="reloj" size={10} />
                              {doble && (
                                <span class="font-medium">
                                  {llave.legs.indexOf(pendiente) === 0 ? 'Ida' : 'Vuelta'}
                                </span>
                              )}
                              {formatDate(pendiente.kickoffUtc)} · {formatKickoff(pendiente.kickoffUtc)}
                            </>
                          ) : doble && llave.aggregate ? (
                            <>
                              Global{' '}
                              <span class="font-display font-semibold tabular text-ink">
                                {llave.aggregate.local}-{llave.aggregate.visita}
                              </span>
                              {llave.aggregate.local === llave.aggregate.visita && ganador && (
                                <span>· pasó {nombreCorto(ganador)}</span>
                              )}
                            </>
                          ) : (
                            <>Llave cerrada</>
                          )
                        }
                      </p>
                    </li>
                  );
                })}
              </ol>
            </li>
          );
        })
      }
    </ol>
  </div>
</section>
