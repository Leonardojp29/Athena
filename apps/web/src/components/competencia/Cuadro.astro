---
import Icon from '../Icon.astro';
import type { LlaveDeCuadro, RondaDeCuadro } from '../../lib/api';
import type { PaletaCompetencia } from '../../lib/coloresCompetencia';
import { formatDate, formatKickoff, isLive } from '../../lib/format';

/*
 * El cuadro de una etapa: sus rondas en columnas, de la más lejana a la final.
 *
 * Es la pregunta que trae a alguien a la página de la Libertadores —quién juega con quién y cómo
 * sigue—. Dibuja **una sola etapa**: la fase previa y la fase final no son rondas comparables y
 * mostrarlas en fila decía que después de la fase previa 3 vienen los octavos, cuando en el medio
 * está la fase de grupos.
 *
 * Cada llave muestra sus partidos, el global y quién pasó; quién pasó lo dice la ronda siguiente y no
 * el resultado, así que las llaves definidas por penales quedan bien resueltas sin que el proveedor
 * publique la tanda.
 *
 * No se dibujan líneas entre llaves: el cuadro real tiene equipos que entran más tarde y cualquier
 * línea prometería un árbol perfecto que no existe. Lo que sí se dice es cuántos equipos deja cada
 * ronda, cuál se está jugando y cuáles faltan sortear.
 */
interface Props {
  rondas: RondaDeCuadro[];
  paleta: PaletaCompetencia | null;
  titulo: string;
  /** A dónde lleva una llave y a dónde un equipo; la página decide cómo los abre. */
  hrefPartido: (id: string) => string;
  hrefEquipo: (slug: string) => string;
}

const { rondas, paleta, titulo, hrefPartido, hrefEquipo } = Astro.props;

/*
 * Con más llaves que un octavos, la columna lleva su propio scroll: la primera ronda de la Copa del Rey
 * son 56 llaves y una columna de 56 hacía una página de cinco pantallas donde la final quedaba perdida
 * arriba. Ocho o menos se leen de un golpe y no se toca nada.
 */
const MAX_SIN_SCROLL = 8;
const alto = 'max-h-[34rem] overflow-y-auto overscroll-contain barra-fina pr-1';

/*
 * Las columnas se reparten el ancho que hay. Con cuatro rondas —una Libertadores en octavos— crecen y
 * los nombres largos dejan de cortarse; con ocho —una Copa del Rey desde los 128avos— se angostan para
 * que el camino completo entre en pantalla en lugar de terminar cortado en la final.
 */
const anchoColumna =
  rondas.length > 7 ? 'basis-[13.75rem] max-w-[17rem]' : 'basis-[15.5rem] max-w-[26rem]';

const acento = paleta?.acento.base ?? 'var(--color-primary-ink)';
const halo = paleta?.acento.suave(0.14) ?? 'color-mix(in oklab, var(--color-primary) 14%, transparent)';

/* El campeón: el que pasó la última ronda, que es la final cuando el cuadro está completo. */
const final = rondas.at(-1);
const campeon =
  final && final.ties.length === 1 && final.ties[0]?.advancedTeamId
    ? [final.ties[0].homeTeam, final.ties[0].awayTeam].find(
        (t) => t.id === final.ties[0]?.advancedTeamId,
      )
    : null;

/** Los goles de un equipo en un partido, sin importar de qué lado jugó. */
const golesDe = (leg: LlaveDeCuadro['legs'][number], teamId: string): number | null => {
  if (leg.homeScore === null || leg.awayScore === null) return null;
  return leg.homeTeam.id === teamId ? leg.homeScore : leg.awayScore;
};

const proximo = (llave: LlaveDeCuadro) => llave.legs.find((l) => l.status !== 'finished') ?? null;

/* El partido que abre la llave: la vuelta si se jugó, y si no la ida, que es la que viene. */
const partidoDeLaLlave = (llave: LlaveDeCuadro) =>
  (llave.legs.filter((l) => l.status === 'finished').at(-1) ?? llave.legs[0])?.id ?? null;
---

<section class="overflow-hidden rounded-xl border border-border bg-surface">
  <header class="flex flex-wrap items-center gap-x-3 gap-y-1 border-b border-border p-3">
    <span style={`color:${acento}`}><Icon name="cuadro" size={16} /></span>
    <h2 class="font-display text-base font-semibold uppercase leading-none">{titulo}</h2>
    {
      campeon && (
        <span
          class="flex items-center gap-1.5 rounded-full px-2 py-0.5 text-2xs font-semibold"
          style={`background:${halo};color:${acento}`}
        >
          <Icon name="trofeo" size={12} />
          Campeón: {campeon.name}
        </span>
      )
    }
    <span class="ml-auto text-2xs text-ink-muted">{rondas.length} rondas</span>
  </header>

  <!-- Las rondas en fila y con desplazamiento propio: apiladas se pierde el sentido de avance. -->
  <div class="overflow-x-auto overscroll-x-contain p-3">
    <ol class="flex snap-x snap-mandatory gap-3">
      {
        rondas.map((ronda) => {
          const enJuego = ronda.enJuego;
          const llaves = ronda.porDefinir ?? ronda.ties.length;
          const equipos = new Set(ronda.ties.flatMap((t) => [t.homeTeam.id, t.awayTeam.id]));
          return (
            <li class:list={['shrink-0 grow snap-start', anchoColumna]}>
              <div
                class="mb-2 border-b-2 px-1 pb-1.5"
                style={enJuego ? `border-color:${acento}` : 'border-color:var(--color-border-strong)'}
              >
                <p
                  class="flex items-center gap-1.5 font-display text-sm font-semibold uppercase leading-none"
                  style={enJuego ? `color:${acento}` : undefined}
                >
                  {ronda.label}
                  {enJuego && (
                    <span class="text-2xs font-medium normal-case" style={`color:${acento}`}>
                      en juego
                    </span>
                  )}
                </p>
                <p class="mt-0.5 text-2xs text-ink-muted">
                  {ronda.porDefinir
                    ? `${ronda.porDefinir} ${ronda.porDefinir === 1 ? 'llave' : 'llaves'} por definir`
                    : `${equipos.size} equipos · ${ronda.ties.length} ${ronda.ties.length === 1 ? 'llave' : 'llaves'}`}
                </p>
              </div>

              {/* La ronda que todavía no se sorteó: se sabe cuántas llaves va a tener, no quiénes. */}
              {ronda.porDefinir ? (
                <ol class:list={['grid gap-1.5', llaves > MAX_SIN_SCROLL ? alto : '']}>
                  {Array.from({ length: ronda.porDefinir }).map(() => (
                    <li class="grid h-[4.4rem] place-items-center rounded-lg border border-dashed border-border text-2xs text-ink-muted">
                      Por definir
                    </li>
                  ))}
                </ol>
              ) : (
                <ol class:list={['grid gap-1.5', llaves > MAX_SIN_SCROLL ? alto : '']}>
                  {ronda.ties.map((llave) => {
                    const pendiente = proximo(llave);
                    const doble = llave.legs.length > 1;
                    const ganador = [llave.homeTeam, llave.awayTeam].find(
                      (t) => t.id === llave.advancedTeamId,
                    );
                    const partido = partidoDeLaLlave(llave);
                    return (
                      <li class="group relative rounded-lg border border-border bg-canvas-subtle/40 transition-colors hover:border-border-strong">
                        {/*
                          La llave entera abre el partido: antes el único enlace eran los veinte
                          píxeles del casillero del marcador. Enlace estirado con los de equipo
                          encima, que es como se hace sin anidar un <a> dentro de otro.
                        */}
                        {partido && (
                          <a
                            href={hrefPartido(partido)}
                            class="absolute inset-0 rounded-lg"
                            aria-label={`${llave.homeTeam.name} contra ${llave.awayTeam.name}`}
                          />
                        )}

                        {[llave.homeTeam, llave.awayTeam].map((equipo) => {
                          const paso = llave.advancedTeamId === equipo.id;
                          return (
                            <div
                              class="flex items-center gap-1.5 border-b border-border/60 px-2 py-1.5 last:border-b-0"
                              style={paso ? `box-shadow:inset 2px 0 0 ${acento}` : undefined}
                            >
                              <a
                                href={hrefEquipo(equipo.slug)}
                                class="relative flex min-w-0 flex-1 items-center gap-1.5 transition-colors hover:text-primary-ink"
                              >
                                {equipo.logoUrl ? (
                                  <img
                                    src={equipo.logoUrl}
                                    alt=""
                                    width="18"
                                    height="18"
                                    loading="lazy"
                                    class="size-[18px] shrink-0 rounded-sm bg-surface object-contain p-px"
                                  />
                                ) : (
                                  <span class="size-[18px] shrink-0 rounded-sm bg-surface" />
                                )}
                                <span
                                  class:list={[
                                    'truncate text-xs',
                                    paso ? 'font-semibold' : 'text-ink-muted',
                                  ]}
                                >
                                  {equipo.name}
                                </span>
                              </a>

                              <!-- Un casillero por partido: la ida y la vuelta se leen en columna. -->
                              {llave.legs.map((leg) => {
                                const goles = golesDe(leg, equipo.id);
                                return (
                                  <span
                                    class:list={[
                                      'w-5 shrink-0 text-center font-display text-xs font-semibold tabular',
                                      goles === null ? 'text-ink-muted/50' : paso ? '' : 'text-ink-muted',
                                      isLive(leg.status) ? 'text-live' : '',
                                    ]}
                                  >
                                    {goles ?? '–'}
                                  </span>
                                );
                              })}
                              <span class="w-3 shrink-0">
                                {paso && (
                                  <span style={`color:${acento}`}>
                                    <Icon name="check" size={12} />
                                  </span>
                                )}
                              </span>
                            </div>
                          );
                        })}

                        <p class="flex items-center gap-1.5 border-t border-border/60 px-2 py-1 text-[10px] leading-none text-ink-muted">
                          {
                            pendiente ? (
                              <>
                                <Icon name="reloj" size={10} />
                                {doble && (
                                  <span class="font-medium">
                                    {llave.legs.indexOf(pendiente) === 0 ? 'Ida' : 'Vuelta'}
                                  </span>
                                )}
                                {formatDate(pendiente.kickoffUtc)} · {formatKickoff(pendiente.kickoffUtc)}
                              </>
                            ) : doble && llave.aggregate ? (
                              <>
                                Global{' '}
                                <span class="font-display font-semibold tabular text-ink">
                                  {llave.aggregate.local}-{llave.aggregate.visita}
                                </span>
                                {llave.aggregate.local === llave.aggregate.visita && ganador && (
                                  <span>· pasó {ganador.shortName ?? ganador.name}</span>
                                )}
                              </>
                            ) : (
                              /* La fecha en que se jugó: "Llave cerrada" repetido en cada llave de
                                 una copa terminada no dice nada que no diga ya el marcador. */
                              <>
                                <Icon name="check" size={10} />
                                {formatDate((llave.legs.at(-1) ?? llave.legs[0])!.kickoffUtc)}
                              </>
                            )
                          }
                        </p>
                      </li>
                    );
                  })}
                </ol>
              )}
            </li>
          );
        })
      }
    </ol>
  </div>
</section>
