---
import Icon from '../Icon.astro';

/*
 * Pestañas de sección, con enlaces reales.
 *
 * `MatchTabs` tenía el look pero armaba el enlace suponiendo que la base no lleva query, y
 * `SelectorFase` tenía la API correcta con el look de píldora. Esto junta las dos cosas: quien llama
 * construye el enlace, así que la pestaña puede convivir con `?temporada=` y `?tabla=` sin pisarlos.
 *
 * Una pestaña sin datos no se esconde: se muestra apagada con el motivo, porque saber que el cuadro
 * todavía no existe es parte de entender en qué anda el torneo.
 */
export interface Pestana {
  id: string;
  label: string;
  /** Motivo por el que no se puede abrir; cuando viene, la pestaña no es un enlace. */
  vacia?: string | null;
}

interface Props {
  pestanas: Pestana[];
  activa: string;
  href: (id: string) => string;
  etiqueta: string;
  class?: string;
}

const { pestanas, activa, href, etiqueta, class: className } = Astro.props;
---

{
  pestanas.length > 1 && (
    <div
      class:list={['flex items-center gap-1 overflow-x-auto', className]}
      role="tablist"
      aria-label={etiqueta}
    >
      {pestanas.map((pestana) => {
        const abierta = pestana.id === activa;
        if (pestana.vacia) {
          return (
            <span
              class="flex shrink-0 cursor-default items-center gap-1 border-b-2 border-transparent px-1.5 pb-1.5 text-2xs font-medium text-ink-muted/50"
              title={pestana.vacia}
            >
              {pestana.label}
              <Icon name="info" size={11} />
            </span>
          );
        }
        return (
          <a
            href={href(pestana.id)}
            aria-current={abierta ? 'page' : undefined}
            class:list={[
              'shrink-0 border-b-2 px-1.5 pb-1.5 text-2xs font-medium transition-colors',
              abierta
                ? 'border-primary text-ink'
                : 'border-transparent text-ink-muted hover:border-border-strong hover:text-ink',
            ]}
          >
            {pestana.label}
          </a>
        );
      })}
    </div>
  )
}
