---
import LogoMark from './LogoMark.astro';

/*
 * El logotipo va en trazados y no en fuente: así el header es correcto en el primer
 * pintado, antes de que Oswald llegue. La altura de mayúsculas es el 62% de la marca y
 * la línea base se alinea al centro óptico de los ojos, no al del escudo.
 */
interface Props {
  variant?: 'lockup' | 'mark';
  size?: number;
  class?: string;
}

const { variant = 'lockup', size = 28, class: className } = Astro.props;
---

{
  variant === 'mark' ? (
    <LogoMark size={size} class={className} />
  ) : (
    <span class:list={['inline-flex items-center gap-2.5', className]}>
      <LogoMark size={size} />
      <svg
        viewBox="0 0 118 18"
        height={Math.round(size * 0.5)}
        fill="currentColor"
        aria-hidden="true"
        focusable="false"
      >
        <path d="M0 18 L7.4 0 H11.6 L19 18 H14.7 L13.2 14.1 H5.8 L4.3 18 Z M7.1 10.7 H11.9 L9.5 4.4 Z" />
        <path d="M22 18 V3.6 H17.2 V0 H31.2 V3.6 H26.4 V18 Z" />
        <path d="M34 18 V0 H38.4 V7.1 H45.4 V0 H49.8 V18 H45.4 V10.7 H38.4 V18 Z" />
        <path d="M53.6 18 V0 H66.8 V3.6 H58 V7.1 H65.6 V10.6 H58 V14.4 H67 V18 Z" />
        <path d="M70.6 18 V0 H75.1 L82.4 11.4 V0 H86.6 V18 H82.2 L74.8 6.5 V18 Z" />
        <path d="M89.6 18 L97 0 H101.2 L108.6 18 H104.3 L102.8 14.1 H95.4 L93.9 18 Z M96.7 10.7 H101.5 L99.1 4.4 Z" />
      </svg>
    </span>
  )
}
