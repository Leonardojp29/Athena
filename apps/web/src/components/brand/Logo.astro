---
import LogoMark from './LogoMark.astro';

/*
 * El logotipo: la marca a la izquierda y el nombre a la derecha.
 *
 * El nombre va en trazados y no en fuente por dos razones: el encabezado es correcto en el primer
 * pintado, antes de que Oswald llegue, y la A sin travesaño no existe en ninguna fuente del sitio.
 *
 * Se dibuja con trazo y no con contornos rellenos: son doce líneas rectas contra seis contornos con
 * treinta nodos, y a 14px de alto un contorno fino se emborrona mientras que un trazo no.
 */
interface Props {
  variant?: 'lockup' | 'mark';
  size?: number;
  class?: string;
}

const { variant = 'lockup', size = 28, class: className } = Astro.props;

/*
 * Una celda de 13 con 9 de aire: el original respira mucho entre letras y sin ese aire el nombre se
 * lee como una palabra apretada en lugar de como una marca.
 */
const x = (i: number) => i * 22;
const ALTO = 18;
const ANCHO = 13;

const A = (i: number) =>
  `M${x(i)} ${ALTO} L${x(i) + ANCHO / 2} 0 L${x(i) + ANCHO} ${ALTO}`;
const T = (i: number) =>
  `M${x(i)} 0 H${x(i) + ANCHO} M${x(i) + ANCHO / 2} 0 V${ALTO}`;
const H = (i: number) =>
  `M${x(i)} 0 V${ALTO} M${x(i) + ANCHO} 0 V${ALTO} M${x(i)} 9 H${x(i) + ANCHO}`;
const E = (i: number) =>
  `M${x(i)} 0 V${ALTO} M${x(i)} 0 H${x(i) + ANCHO} M${x(i)} 9 H${x(i) + ANCHO - 2.5} M${x(i)} ${ALTO} H${x(i) + ANCHO}`;
const N = (i: number) =>
  `M${x(i)} ${ALTO} V0 L${x(i) + ANCHO} ${ALTO} V0`;

const NOMBRE = [A(0), T(1), H(2), E(3), N(4), A(5)].join(' ');
---

{
  variant === 'mark' ? (
    <LogoMark size={size} class={className} />
  ) : (
    <span class:list={['inline-flex items-center gap-1.5', className]}>
      <LogoMark size={size} />
      <svg
        viewBox="-0.9 -0.9 124.8 19.8"
        height={Math.round(size * 0.46)}
        fill="none"
        stroke="currentColor"
        stroke-width="1.7"
        stroke-linecap="square"
        stroke-linejoin="miter"
        aria-hidden="true"
        focusable="false"
      >
        <path d={NOMBRE} />
      </svg>
    </span>
  )
}
