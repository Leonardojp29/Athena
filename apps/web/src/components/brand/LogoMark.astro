---
/*
 * Marca de Athena: búho geométrico contenido en un escudo.
 *
 * La muesca superior del escudo se lee a la vez como las dos orejas del búho y como el
 * jefe de un escudo de club. El pico triangular hace de vértice de una "A". La barra de
 * la ceja es el único elemento en lima: si todo fuera acento, nada lo sería.
 *
 * `detail="compact"` quita las facetas hexagonales de las pupilas, que a 24px se
 * convierten en ruido. El favicon vive aparte porque a 16px los trazos desaparecen.
 */
interface Props {
  size?: number;
  detail?: 'full' | 'compact';
  monochrome?: boolean;
  class?: string;
}

const { size = 32, detail = 'full', monochrome = false, class: className } = Astro.props;
const browColor = monochrome ? 'currentColor' : 'var(--a-color-primary)';
const eyeStroke = detail === 'full' ? 2.2 : 2.4;
---

<svg
  viewBox="0 0 32 32"
  width={size}
  height={size}
  fill="none"
  aria-hidden="true"
  focusable="false"
  class={className}
>
  <path
    d="M4 9 A5 5 0 0 1 9 4 H13.6 L16 7.2 L18.4 4 H23 A5 5 0 0 1 28 9 V15.4 C28 22 22.6 26.6 16 29 C9.4 26.6 4 22 4 15.4 Z"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linejoin="round"
  />

  <rect x="8" y="8.6" width="16" height="2" rx="1" fill={browColor} />

  <circle cx="11.2" cy="14" r="4.2" stroke="currentColor" stroke-width={eyeStroke} />
  <circle cx="20.8" cy="14" r="4.2" stroke="currentColor" stroke-width={eyeStroke} />

  {
    detail === 'full' ? (
      <Fragment>
        <path d="M11.2 12.3 L12.67 13.15 L12.67 14.85 L11.2 15.7 L9.73 14.85 L9.73 13.15 Z" fill="currentColor" />
        <path d="M20.8 12.3 L22.27 13.15 L22.27 14.85 L20.8 15.7 L19.33 14.85 L19.33 13.15 Z" fill="currentColor" />
      </Fragment>
    ) : (
      <Fragment>
        <circle cx="11.2" cy="14" r="1.7" fill="currentColor" />
        <circle cx="20.8" cy="14" r="1.7" fill="currentColor" />
      </Fragment>
    )
  }

  <path d="M14.3 13 L17.7 13 L16 18.6 Z" fill="currentColor" />
</svg>
