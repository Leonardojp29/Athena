---
/*
 * Marca de Athena: una pelota facetada con una órbita que la cruza.
 *
 * Los canales que separan las caras se recortan con una máscara y no se pintan encima: pintados
 * habría que elegirles un color, y la marca vive sobre el lienzo claro, sobre el oscuro y sobre la
 * pizarra azul de la banda. Recortados son hueco, y el hueco siempre es del color que haya detrás.
 *
 * La esfera va en `currentColor` y la órbita en el oro de la marca. La órbita es lo único con color
 * fijo: un logotipo que cambia de color con el tema deja de reconocerse, y es el único elemento que
 * puede permitírselo porque nunca lleva texto encima.
 *
 * `detail="compact"` deja la esfera lisa: por debajo de 20px los canales caen bajo el píxel y la
 * pelota se ve sucia en lugar de facetada.
 */
interface Props {
  size?: number;
  detail?: 'full' | 'compact';
  /** Sin el oro: para el pie, donde la marca acompaña y no encabeza. */
  monochrome?: boolean;
  class?: string;
}

const { size = 32, detail = 'full', monochrome = false, class: className } = Astro.props;
const orbita = monochrome ? 'currentColor' : 'var(--a-color-marca-oro)';

/* La marca aparece más de una vez en la misma página y dos máscaras no pueden compartir `id`. */
const mascara = `marca-${Math.random().toString(36).slice(2, 9)}`;

/* Pentágono con un vértice arriba, algo por encima del centro óptico de la esfera. */
const PENTAGONO = 'M15 8.9 L20.6 13 L18.5 19.6 L11.5 19.6 L9.4 13 Z';
/* Los cinco meridianos: de cada vértice del pentágono al borde, curvados como la superficie. */
const MERIDIANOS = [
  'M15 8.9 Q15.3 6.4 15.4 4.9',
  'M20.6 13 Q23.1 12.4 24.9 12',
  'M18.5 19.6 Q20.2 21.8 21.3 23.2',
  'M11.5 19.6 Q9.8 21.8 8.7 23.2',
  'M9.4 13 Q6.9 12.4 5.1 12',
];
---

<svg
  viewBox="0 0 32 32"
  width={size}
  height={size}
  fill="none"
  aria-hidden="true"
  focusable="false"
  class={className}
>
  {
    detail === 'full' && (
      <mask id={mascara}>
        {/* Blanco es lo que se ve; negro es el canal que se abre. */}
        <circle cx="15" cy="16" r="11" fill="white" />
        <g
          stroke="black"
          stroke-width="2.1"
          stroke-linecap="round"
          stroke-linejoin="round"
          fill="none"
        >
          <path d={PENTAGONO} />
          {MERIDIANOS.map((d) => (
            <path d={d} />
          ))}
        </g>
      </mask>
    )
  }

  <circle
    cx="15"
    cy="16"
    r="11"
    fill="currentColor"
    mask={detail === 'full' ? `url(#${mascara})` : undefined}
  />

  {/*
    La órbita cruza por delante de la esfera, de abajo a la izquierda hacia arriba a la derecha, y
    termina en su punto. Curva hacia abajo y no hacia arriba: hacia arriba se lee como un sombrero
    apoyado encima en lugar de como una órbita que la rodea.

    Es un solo arco y no un anillo completo: el tramo de atrás, a este tamaño, se confunde con el
    borde de la esfera.
  */}
  <path
    d="M3.4 20.6 A15 15 0 0 0 25.6 7.4"
    stroke={orbita}
    stroke-width="1.9"
    stroke-linecap="round"
  />
  <circle cx="27.3" cy="5.9" r="2.9" fill={orbita} />
</svg>
