---
/*
 * Comparar jugadores de este partido, con lo que hicieron en este partido.
 *
 * No pide nada al servidor: cada imán de la cancha, cada fila del banco y cada fila de la tabla de
 * rendimiento ya llevan su `data-ficha` con las estadísticas completas, que es lo mismo que usa la
 * ficha emergente. Acá se leen de la página, se dibuja el selector y se comparan.
 *
 * Se llega de dos maneras y las dos tienen que funcionar solas: desde la ficha de un jugador, con su
 * botón Comparar, o entrando a la pestaña y eligiendo de la lista. Por eso el selector vive acá
 * adentro y no solo en la cancha.
 *
 * La selección vive en la URL (`?vista=comparar&j=a,b`) para que la comparación sea compartible y
 * para que el botón de atrás la deshaga, igual que las pestañas.
 */
---

<div data-comparador class="grid gap-4">
  <section data-comparador-tabla class="rounded-lg border border-border bg-surface" hidden>
    <header class="border-b border-border p-3">
      <div data-comparador-fichas class="grid gap-2"></div>
    </header>
    <div data-comparador-filas class="p-3"></div>
    <footer class="flex items-center justify-between gap-3 border-t border-border px-3 py-2">
      <p data-comparador-pie class="text-2xs text-ink-muted"></p>
      <button
        type="button"
        data-comparador-limpiar
        class="cursor-pointer text-2xs text-primary-ink transition-colors hover:underline"
      >
        Vaciar
      </button>
    </footer>
  </section>

  <!--
    El selector siempre a la vista mientras quepa otro. Es la respuesta a "¿y ahora qué?": con un
    jugador elegido, acá está la lista para elegir al segundo sin volver a la cancha.
  -->
  <section data-comparador-selector class="rounded-lg border border-border bg-surface">
    <header
      class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1 border-b border-border px-3 py-2"
    >
      <h3 data-comparador-titulo class="text-2xs font-semibold uppercase tracking-label">
        Elige a dos jugadores
      </h3>
      <p class="text-2xs text-ink-muted">
        Hasta cuatro, incluso del mismo equipo. También con el botón Comparar de cada ficha.
      </p>
    </header>
    <div data-comparador-listas class="grid gap-3 p-3 sm:grid-cols-2"></div>
  </section>

  <p data-comparador-vacio class="text-sm text-ink-muted" hidden>
    Este partido todavía no tiene jugadores cargados.
  </p>
</div>

<script>
  import { filasDeComparacion, type FichaDeJugador } from '../../lib/comparar-partido';
  import { claseDeNota } from '../../lib/nota';

  const raiz = document.querySelector<HTMLElement>('[data-comparador]');
  const centro = document.querySelector<HTMLElement>('[data-centro-del-partido]');
  if (raiz && centro) {
    const tabla = raiz.querySelector<HTMLElement>('[data-comparador-tabla]')!;
    const cabecera = raiz.querySelector<HTMLElement>('[data-comparador-fichas]')!;
    const cuerpo = raiz.querySelector<HTMLElement>('[data-comparador-filas]')!;
    const pie = raiz.querySelector<HTMLElement>('[data-comparador-pie]')!;
    const selector = raiz.querySelector<HTMLElement>('[data-comparador-selector]')!;
    const titulo = raiz.querySelector<HTMLElement>('[data-comparador-titulo]')!;
    const listas = raiz.querySelector<HTMLElement>('[data-comparador-listas]')!;
    const vacio = raiz.querySelector<HTMLElement>('[data-comparador-vacio]')!;
    const MAXIMO = 4;

    /* Todas las fichas de la página, por id: la cancha, el banco y la tabla de rendimiento. */
    const fichasDeLaPagina = (): Map<string, FichaDeJugador> => {
      const mapa = new Map<string, FichaDeJugador>();
      for (const nodo of document.querySelectorAll<HTMLElement>('[data-ficha]')) {
        try {
          const ficha = JSON.parse(nodo.dataset.ficha as string) as FichaDeJugador;
          if (ficha.playerId && !mapa.has(ficha.playerId)) mapa.set(ficha.playerId, ficha);
        } catch {
          /* Un payload roto no puede tumbar la pestaña entera. */
        }
      }
      return mapa;
    };

    const elegidos = (): string[] => {
      const crudo = new URL(location.href).searchParams.get('j') ?? '';
      return crudo.split(',').filter(Boolean).slice(0, MAXIMO);
    };

    const guardar = (ids: string[]): void => {
      const url = new URL(location.href);
      if (ids.length > 0) url.searchParams.set('j', ids.join(','));
      else url.searchParams.delete('j');
      history.replaceState(history.state, '', url);
      pintar();
    };

    const escapar = (texto: string): string =>
      texto.replace(
        /[&<>"]/g,
        (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c] as string,
      );

    const retrato = (url: string | null, tamano: string): string =>
      url
        ? `<img src="${escapar(url)}" alt="" width="36" height="36" loading="lazy" class="${tamano} shrink-0 rounded-full bg-canvas-subtle object-cover">`
        : `<span class="${tamano} shrink-0 rounded-full bg-canvas-subtle"></span>`;

    const chipDeNota = (nota: string | null | undefined): string =>
      nota && Number(nota) > 0
        ? `<span class="shrink-0 rounded px-1.5 py-0.5 text-2xs font-semibold tabular ${claseDeNota(Number(nota))}">${Number(nota).toFixed(1)}</span>`
        : '';

    const tarjeta = (ficha: FichaDeJugador): string => {
      const escudo = ficha.team?.logoUrl
        ? `<img src="${escapar(ficha.team.logoUrl)}" alt="" width="14" height="14" class="size-3.5 shrink-0" loading="lazy">`
        : '';
      return `<div class="flex min-w-0 items-center gap-2.5 rounded-lg border border-border bg-canvas-subtle/40 p-2.5">
          ${retrato(ficha.photoUrl, 'size-10')}
          <div class="min-w-0 flex-1">
            <p class="truncate text-sm font-semibold leading-tight">${escapar(ficha.name)}</p>
            <p class="flex items-center gap-1 truncate text-2xs text-ink-muted">
              ${escudo}<span class="truncate">${escapar(ficha.team?.name ?? '')}</span>
            </p>
          </div>
          ${chipDeNota(ficha.stats?.rating)}
          <button type="button" data-quitar="${escapar(ficha.playerId)}"
            class="shrink-0 cursor-pointer rounded p-1 text-ink-muted transition-colors hover:bg-canvas-subtle hover:text-ink"
            aria-label="Quitar a ${escapar(ficha.name)} de la comparación">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
          </button>
        </div>`;
    };

    /* Un jugador del selector: quién es, cuánto rindió y si ya está puesto. */
    const opcion = (ficha: FichaDeJugador, puesto: boolean, lleno: boolean): string => {
      const minutos = ficha.stats?.minutesPlayed;
      return `<li>
          <button type="button" data-sumar="${escapar(ficha.playerId)}" ${puesto || lleno ? 'disabled' : ''}
            class="flex w-full items-center gap-2 rounded-md px-1.5 py-1 text-left transition-colors enabled:cursor-pointer enabled:hover:bg-canvas-subtle disabled:opacity-45">
            ${retrato(ficha.photoUrl, 'size-7')}
            <span class="min-w-0 flex-1 truncate text-xs">${escapar(ficha.name)}</span>
            ${minutos ? `<span class="shrink-0 text-2xs tabular text-ink-muted">${minutos}'</span>` : ''}
            ${chipDeNota(ficha.stats?.rating)}
            ${puesto ? '<span class="shrink-0 text-2xs text-primary-ink">puesto</span>' : ''}
          </button>
        </li>`;
    };

    function pintarSelector(disponibles: Map<string, FichaDeJugador>, puestos: string[]): void {
      const porEquipo = new Map<string, FichaDeJugador[]>();
      for (const ficha of disponibles.values()) {
        const equipo = ficha.team?.name ?? 'Sin equipo';
        porEquipo.set(equipo, [...(porEquipo.get(equipo) ?? []), ficha]);
      }

      const lleno = puestos.length >= MAXIMO;
      titulo.textContent =
        puestos.length === 0
          ? 'Elige a dos jugadores'
          : lleno
            ? 'Ya son cuatro: quita a uno para sumar otro'
            : 'Suma a otro para comparar';

      listas.innerHTML = [...porEquipo.entries()]
        .map(
          ([equipo, fichas]) => `<section class="min-w-0">
            <h4 class="mb-1 flex items-center gap-1.5 truncate text-2xs font-medium uppercase tracking-label text-ink-muted">
              ${fichas[0]?.team?.logoUrl ? `<img src="${escapar(fichas[0].team.logoUrl)}" alt="" width="13" height="13" class="size-3.5 shrink-0" loading="lazy">` : ''}
              <span class="truncate">${escapar(equipo)}</span>
            </h4>
            <ul class="grid">
              ${fichas
                .sort((a, b) => (b.stats?.minutesPlayed ?? 0) - (a.stats?.minutesPlayed ?? 0))
                .map((f) => opcion(f, puestos.includes(f.playerId), lleno))
                .join('')}
            </ul>
          </section>`,
        )
        .join('');
    }

    function pintar(): void {
      const disponibles = fichasDeLaPagina();
      vacio.hidden = disponibles.size > 0;
      selector.hidden = disponibles.size === 0;

      const puestos = elegidos().filter((id) => disponibles.has(id));
      const fichas = puestos.map((id) => disponibles.get(id) as FichaDeJugador);

      pintarSelector(disponibles, puestos);

      /* Desde uno ya se muestra: el elegido se ve, y al lado la lista para sumar al segundo. */
      tabla.hidden = fichas.length === 0;
      if (fichas.length === 0) return;

      cabecera.style.gridTemplateColumns = `repeat(${fichas.length}, minmax(0, 1fr))`;
      cabecera.innerHTML = fichas.map(tarjeta).join('');
      pie.textContent =
        fichas.length === 1
          ? 'Suma a otro para ver la comparación.'
          : 'Solo lo que hicieron en este partido.';

      /* La etiqueta a la izquierda y una columna por jugador, igual que el comparador de /comparar. */
      const columnas = `minmax(5rem, 9rem) repeat(${fichas.length}, minmax(0, 1fr))`;
      cuerpo.innerHTML = filasDeComparacion(fichas)
        .map(
          (grupo) => `
          <section class="mb-4 last:mb-0">
            <h3 class="mb-2 text-center font-display text-sm font-semibold uppercase tracking-tight">${grupo.titulo}</h3>
            <div class="overflow-hidden rounded-lg border border-border">
              ${grupo.filas
                .map((fila) => {
                  const lider = fila.hayLider ? Math.max(...fila.valores.map((v) => v.orden)) : -1;
                  return `<div class="grid items-stretch border-b border-border last:border-b-0" style="grid-template-columns:${columnas}">
                      <p class="flex items-center px-2.5 py-2 text-2xs leading-tight text-ink-muted sm:px-3">${fila.label}</p>
                      ${fila.valores
                        .map((v) => {
                          const gana = fichas.length > 1 && v.orden === lider && lider > 0;
                          return `<div class="flex items-center justify-center border-l border-border px-1.5 py-2">
                              <span class="rounded-full px-2 py-0.5 text-sm tabular ${gana ? 'bg-primary/12 font-semibold text-primary-ink' : 'text-ink'}">${v.texto}</span>
                            </div>`;
                        })
                        .join('')}
                    </div>`;
                })
                .join('')}
            </div>
          </section>`,
        )
        .join('');
    }

    function agregar(id: string): void {
      const ya = elegidos();
      if (ya.includes(id) || ya.length >= MAXIMO) return;
      guardar([...ya, id]);
    }

    raiz.addEventListener('click', (evento) => {
      const objetivo = evento.target as HTMLElement;
      const quitar = objetivo.closest<HTMLElement>('[data-quitar]');
      if (quitar) {
        guardar(elegidos().filter((id) => id !== quitar.dataset.quitar));
        return;
      }
      const sumar = objetivo.closest<HTMLElement>('[data-sumar]');
      if (sumar?.dataset.sumar) {
        agregar(sumar.dataset.sumar);
        return;
      }
      if (objetivo.closest('[data-comparador-limpiar]')) guardar([]);
    });

    /*
     * El puente con la ficha emergente. Lleva a la pestaña **siempre**, no solo con el segundo: si
     * el primer clic no mueve nada visible, uno cree que el botón no hizo nada y abandona.
     */
    addEventListener('athena:comparar', (evento) => {
      const id = (evento as CustomEvent<{ playerId: string }>).detail?.playerId;
      if (!id) return;
      agregar(id);
      document.querySelector<HTMLAnchorElement>('[data-vista-tab="comparar"]')?.click();
      raiz.scrollIntoView({ block: 'start', behavior: 'smooth' });
    });

    addEventListener('popstate', () => pintar());
    pintar();
  }
</script>
