---
/*
 * Pestañas con enlaces reales. Un panel por URL cuesta 0 KB, es indexable y se comparte;
 * lo mismo con JavaScript costaría un bundle y rompería el botón de atrás.
 *
 * El enlace lo arma quien llama: la página del partido cuelga la vista de `?vista=`, pero dentro de
 * una competencia el partido ya ocupa la consulta y hay que sumar `&vista=`. Componer la URL acá
 * adentro obligaba a adivinar cuál de las dos.
 */
export interface Tab {
  id: string;
  label: string;
  disabled?: boolean;
}

interface Props {
  tabs: Tab[];
  active: string;
  enlace: (id: string) => string;
}

const { tabs, active, enlace } = Astro.props;
---

<nav
  class="-mx-4 flex gap-1 overflow-x-auto border-b border-border px-4 [scrollbar-width:none] sm:mx-0 sm:px-0 [&::-webkit-scrollbar]:hidden"
  aria-label="Secciones del partido"
>
  {
    tabs.map((tab) =>
      tab.disabled ? (
        /*
         * Un `<button disabled>` y no un `<span>` gris: es un control apagado y así lo entienden el
         * lector de pantalla y la auditoría de contraste, que a un texto gris suelto le exige 4,5:1
         * y a un control inactivo no —porque no hay nada que leer ahí—.
         */
        <button
          type="button"
          disabled
          class="shrink-0 cursor-not-allowed border-b-2 border-transparent px-3 py-2.5 text-sm text-ink-muted/50"
          title="Sin datos para este partido"
        >
          {tab.label}
        </button>
      ) : (
        <a
          href={enlace(tab.id)}
          aria-current={tab.id === active ? 'page' : undefined}
          class:list={[
            'shrink-0 border-b-2 px-3 py-2.5 text-sm whitespace-nowrap transition-colors',
            tab.id === active
              ? 'border-primary-ink font-medium text-ink'
              : 'border-transparent text-ink-muted hover:border-border-strong hover:text-ink',
          ]}
        >
          {tab.label}
        </a>
      ),
    )
  }
</nav>
