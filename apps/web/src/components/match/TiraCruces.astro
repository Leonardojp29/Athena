---
import type { CruceHistorial, TeamSummary } from '../../lib/api';
import { resultadoDeCruce, type Resultado } from '../../lib/historial';

/*
 * Los últimos cruces como una tira de V/E/D, del más viejo al más nuevo.
 *
 * Es la misma forma que la columna "forma" de la tabla de posiciones —el chip con la letra adentro,
 * porque el color nunca es el único canal— y sirve de índice visual de la lista que va debajo: se lee
 * de un golpe si el cara a cara viene parejo o si alguien ganó las últimas cuatro.
 *
 * Mirado siempre desde el local de hoy, igual que la balanza.
 */
interface Props {
  cruces: CruceHistorial[];
  homeTeam: TeamSummary;
  awayTeam: TeamSummary;
  limite?: number;
  class?: string;
}

const { cruces, homeTeam, awayTeam, limite = 8, class: className } = Astro.props;

const CHIP: Record<Resultado, { letra: string; clase: string; titulo: (a: string, b: string) => string }> = {
  local: { letra: 'V', clase: 'bg-primary text-primary-contrast', titulo: (a) => `Ganó ${a}` },
  empate: { letra: 'E', clase: 'bg-border-strong text-ink', titulo: () => 'Empataron' },
  visita: { letra: 'D', clase: 'bg-ink-muted text-surface', titulo: (_a, b) => `Ganó ${b}` },
};

const nombre = (equipo: TeamSummary) => equipo.shortName ?? equipo.name;

/* Del más viejo al más nuevo: el orden en que se cuenta una racha. */
const tira = [...cruces]
  .slice(0, limite)
  .reverse()
  .map((cruce) => ({ cruce, chip: CHIP[resultadoDeCruce(cruce, homeTeam.slug)] }));
---

<span class:list={['flex flex-wrap gap-1', className]}>
  {
    tira.map(({ cruce, chip }) => (
      <a
        href={`/partidos/${cruce.id}`}
        title={`${chip.titulo(nombre(homeTeam), nombre(awayTeam))} · ${cruce.home_score}–${cruce.away_score}`}
        class:list={[
          'grid size-5 place-items-center rounded-[3px] text-[10px] font-bold transition-transform hover:scale-110',
          chip.clase,
        ]}
      >
        {chip.letra}
      </a>
    ))
  }
</span>
