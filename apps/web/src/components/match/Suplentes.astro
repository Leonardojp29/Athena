---
import EventIcon from '../EventIcon.astro';
import PlayerName from '../player/PlayerName.astro';
import type { MatchEventView, MatchPlayerStats, TeamLineup, TeamSummary } from '../../lib/api';
import { coloresDeClub, temaEquipo } from '../../lib/color';
import { claseDeNota } from '../../lib/nota';

/*
 * El banco de cada equipo: quién entró, en qué minuto y por quién.
 *
 * Estaba plegado dentro de un `<details>` cerrado y solo listaba nombres, así que la vista de
 * alineaciones —la que se abre justamente para ver los cambios— no decía ni quién entró ni cuándo.
 * La home ya lo resolvía mejor que la página del partido.
 *
 * El dato no viene en la alineación: sale de los eventos, donde `player` es el que sale y
 * `relatedPlayer` el que entra. Los que entraron van primero y por minuto; los que se quedaron
 * sentados, en gris al final.
 */
interface Props {
  lineups: TeamLineup[];
  homeTeam: TeamSummary;
  awayTeam: TeamSummary;
  cambios: MatchEventView[];
  playerStatistics: MatchPlayerStats[];
}

const { lineups, homeTeam, awayTeam, cambios, playerStatistics } = Astro.props;

/** Quién entró en qué minuto y en lugar de quién. */
const entradas = new Map<string, { minuto: number; porQuien: string | null }>();
for (const cambio of cambios) {
  const id = cambio.relatedPlayer?.id;
  if (!id) continue;
  const sale = cambio.player?.name ?? cambio.detail?.playerName ?? null;
  entradas.set(id, { minuto: cambio.minute, porQuien: sale });
}

const notas = new Map(playerStatistics.map((s) => [s.player.id, s]));
const apellido = (nombre: string) => nombre.split(' ').at(-1) ?? nombre;

/*
 * Las filas se reparten el alto que les deja la cancha, pero con techo: un banco de doce reparte
 * 37px cada uno y uno de tres se estiraría a 148, que se lee como un error de maquetado. El tope
 * por fila lo corta antes; el sobrante queda abajo, como antes.
 */
const ALTO_MAXIMO_DE_FILA = 4;

const lados = [homeTeam, awayTeam]
  .map((team) => ({ team, lineup: lineups.find((l) => l.teamId === team.id) }))
  .filter((e): e is { team: TeamSummary; lineup: TeamLineup } => e.lineup !== undefined)
  .map(({ team, lineup }) => ({
    team,
    lineup,
    /*
     * La cabecera del banco con los colores del club, que es lo que hace que de un vistazo se sepa
     * cuál es cuál sin leer el nombre. `coloresDeClub` descarta los que no dicen nada —blanco, negro
     * y gris son un tercio de los equipos con dato— y `temaEquipo` elige la tinta por luminancia,
     * así un crema como el de Universitario no se lleva texto blanco encima.
     */
    tema: temaEquipo(...coloresDeClub(team.slug, team.primaryColor, team.secondaryColor)),
    banco: [...lineup.substitutes]
      .map((jugador) => {
        const stats = jugador.playerId ? (notas.get(jugador.playerId) ?? null) : null;
        return {
          jugador,
          entrada: jugador.playerId ? (entradas.get(jugador.playerId) ?? null) : null,
          nota: stats?.rating ?? null,
          /* El mismo payload que el imán de la cancha: la ficha ya sabe pintarlo, y sale gratis. */
          ficha: jugador.playerId
            ? JSON.stringify({
                playerId: jugador.playerId,
                slug: jugador.slug ?? stats?.player.slug ?? null,
                name: stats?.player.name ?? jugador.name,
                photoUrl: jugador.photoUrl ?? stats?.player.photoUrl ?? null,
                number: jugador.number ?? stats?.shirtNumber ?? null,
                position: jugador.position,
                team: { name: team.name, slug: team.slug, logoUrl: team.logoUrl },
                stats,
              })
            : null,
        };
      })
      /* Los que jugaron primero y por minuto: el que entró a los 60 importa más que el que miró. */
      .sort((a, b) => (a.entrada?.minuto ?? 999) - (b.entrada?.minuto ?? 999)),
  }));
---

{
  lados.length > 0 && (
    <div class="grid items-stretch gap-3 sm:grid-cols-2">
      {lados.map(({ team, lineup, banco, tema }) => (
        /* Anfitrión de la ficha: el popup se dibuja sobre el banco del equipo al que se le hizo clic. */
        <section
          data-ficha-anfitrion
          class="relative flex flex-col overflow-hidden rounded-lg border border-border bg-surface"
        >
          {/* La franja de identidad, primario a secundario: los dos colores del club en un hilo. */}
          {tema && <span class="block h-1" style={`background:${tema.franja}`} aria-hidden="true" />}
          <header
            class="flex flex-wrap items-center gap-x-2 gap-y-1 border-b border-border px-3 py-2"
            style={
              tema
                ? `background:${tema.fondo};color:${tema.tinta};border-color:${tema.linea}`
                : undefined
            }
          >
            {team.logoUrl && <img src={team.logoUrl} alt="" width="16" height="16" loading="lazy" />}
            <h3 class="truncate text-2xs font-semibold uppercase tracking-label">El banco</h3>
            {lineup.coachName && (
              <span
                class:list={['truncate text-2xs', !tema && 'text-ink-muted']}
                style={tema ? `color:${tema.tintaSuave}` : undefined}
              >
                DT {lineup.coachName}
              </span>
            )}
            <span
              class:list={['ml-auto shrink-0 text-2xs', !tema && 'text-ink-muted']}
              style={tema ? `color:${tema.tintaSuave}` : undefined}
            >
              {`${banco.filter((b) => b.entrada).length} de ${banco.length} entraron`}
            </span>
          </header>

          <ul
            class="grid flex-1 gap-0 px-1.5 py-1 [grid-auto-rows:minmax(0,1fr)]"
            style={`max-height:${banco.length * ALTO_MAXIMO_DE_FILA}rem`}
          >
            {banco.map(({ jugador, entrada, nota, ficha }) => (
              <li>
                <button
                  type="button"
                  data-ficha={ficha ?? undefined}
                  disabled={ficha === null}
                  class="flex h-full w-full items-center gap-2 rounded px-1.5 text-left transition-colors enabled:cursor-pointer enabled:hover:bg-canvas-subtle"
                >
                  {entrada ? (
                    <span class="flex w-10 shrink-0 items-center gap-0.5 text-xs font-medium tabular text-live-ink">
                      <EventIcon kind="sub_in" size={12} detail={`minuto ${entrada.minuto}`} />
                      {entrada.minuto}'
                    </span>
                  ) : (
                    <span class="w-10 shrink-0" />
                  )}

                  <PlayerName
                    name={jugador.name}
                    slug={jugador.slug}
                    photoUrl={jugador.photoUrl}
                    number={jugador.number}
                    enlazar={false}
                    size="md"
                    class:list={['min-w-0 flex-1 text-xs', entrada ? '' : 'text-ink-muted']}
                  />

                  {entrada?.porQuien && (
                    <span class="hidden shrink-0 text-xs text-ink-muted lg:inline">
                      por {apellido(entrada.porQuien)}
                    </span>
                  )}

                  {/* Un suplente que no entró llega con nota 0, y pintarlo en rojo dice "jugó mal"
                      en lugar de "no jugó". Sin chip, la fila en gris ya lo dice. */}
                  {nota !== null && Number(nota) > 0 && (
                    <span
                      class:list={[
                        'shrink-0 rounded px-1.5 py-0.5 text-2xs font-semibold tabular',
                        claseDeNota(Number(nota)),
                      ]}
                    >
                      {Number(nota).toFixed(1)}
                    </span>
                  )}
                </button>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  )
}
