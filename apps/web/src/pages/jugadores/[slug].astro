---
import Base from '../../layouts/Base.astro';
import Card from '../../components/Card.astro';
import Container from '../../components/layout/Container.astro';
import FavoriteButton from '../../components/FavoriteButton.astro';
import RecentPerformances from '../../components/player/RecentPerformances.astro';
import SeasonTable from '../../components/player/SeasonTable.astro';
import { api, type FavoriteEntity, ApiError, POSITION_LABEL, type PlayerView } from '../../lib/api';
import { getSession } from '../../lib/supabase';
import { paisEnEspanol } from '../../lib/paises';
import { formatDate } from '../../lib/format';

const { slug } = Astro.params;
let view: PlayerView;
try {
  view = await api<PlayerView>(`/views/player/${slug}`);
} catch (error) {
  if (error instanceof ApiError && error.status === 404) return Astro.redirect('/404');
  throw error;
}

const { player, teams, events, seasons, totals, recentPerformances, shirtNumber } = view;
const position = player.position ? POSITION_LABEL[player.position] : null;
const goals = events.filter((e) => e.kind.includes('goal') && e.kind !== 'missed_penalty').length;
const cards = events.filter((e) => e.kind.endsWith('_card')).length;

const EVENT_LABEL: Record<string, string> = {
  goal: 'Gol',
  own_goal: 'Autogol',
  penalty_goal: 'Gol de penal',
  missed_penalty: 'Penal errado',
  yellow_card: 'Amarilla',
  red_card: 'Roja',
  substitution: 'Cambio',
  var: 'VAR',
};

const session = await getSession(Astro);
let following = false;
if (session?.accessToken) {
  try {
    const favorites = await api<FavoriteEntity[]>('/me/favorites', session.accessToken);
    following = favorites.some((f) => f.entityType === 'player' && f.entityId === player.id);
  } catch {
    following = false;
  }
}

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: player.name,
  ...(player.nationality ? { nationality: player.nationality } : {}),
  ...(player.birthDate ? { birthDate: player.birthDate.slice(0, 10) } : {}),
  ...(player.photoUrl ? { image: player.photoUrl } : {}),
  ...(teams[0] ? { memberOf: { '@type': 'SportsTeam', name: teams[0].name } } : {}),
};
---

<Base
  title={`${player.name} — Perfil, equipos y estadísticas | Athena`}
  description={`Perfil de ${player.name}${position ? `, ${position.toLowerCase()}` : ''}${player.nationality ? ` de ${player.nationality}` : ''}: equipos, goles y participaciones recientes.`}
  ogImage={player.photoUrl}
  jsonLd={jsonLd}
  width="bleed"
  liveBar={false}
>
  <section class="w-full border-b border-board-edge bg-board">
    <Container width="wide">
  <div class="flex items-center gap-4 py-6">
    {player.photoUrl && <img src={player.photoUrl} alt="" width="64" height="64" class="rounded-full" />}
    <div>
      <h1 class="font-display text-3xl font-semibold uppercase text-chalk sm:text-4xl">
        {shirtNumber !== null && <span class="tabular text-chalk-dim">{shirtNumber} </span>}
        {player.name}
      </h1>
      <p class="text-sm text-chalk-dim">
        {[
          position,
          paisEnEspanol(player.nationality),
          player.heightCm ? `${player.heightCm} cm` : null,
          player.fullName && player.fullName !== player.name ? player.fullName : null,
        ]
          .filter(Boolean)
          .join(' · ')}
      </p>
    </div>

    <div class="ml-auto shrink-0">
      <FavoriteButton
        entityType="player"
        entityId={player.id}
        following={following}
        signedIn={session !== null}
        label="jugador"
        onBoard
      />
    </div>
  </div>
    </Container>
  </section>

  <Container width="wide" class="py-6">
  <SeasonTable seasons={seasons} totals={totals} />

  <div class="mt-4 grid gap-4 items-start lg:grid-cols-2">
    <div class="grid gap-4">
      <RecentPerformances performances={recentPerformances} />

      <Card title="Equipos">
        {teams.length > 0 ? (
          <ul class="grid gap-2">
            {teams.map((team) => (
              <li>
                <a href={`/equipos/${team.slug}`} class="flex items-center gap-2 text-sm hover:text-primary-ink transition-colors">
                  {team.logoUrl && <img src={team.logoUrl} alt="" width="20" height="20" loading="lazy" />}
                  {team.name}
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="text-sm text-ink-muted">Sin equipos registrados todavía.</p>
        )}
      </Card>

      {events.length > 0 && (
        <Card title="En los partidos registrados">
          <div class="flex gap-6">
            <span class="text-sm"><span class="text-xl font-semibold tabular">{goals}</span> <span class="text-ink-muted">goles</span></span>
            <span class="text-sm"><span class="text-xl font-semibold tabular">{cards}</span> <span class="text-ink-muted">tarjetas</span></span>
          </div>
          <p class="text-[11px] text-ink-muted mt-2">
            Conteo sobre los partidos ya sincronizados en Athena, no un total de carrera.
          </p>
        </Card>
      )}
    </div>

    <Card title="Participaciones recientes">
      {events.length > 0 ? (
        <ul class="divide-y divide-border/40">
          {events.map((event) => (
            <li class="py-2">
              <a href={`/partidos/${event.match.id}`} class="block hover:text-primary-ink transition-colors">
                <span class="text-sm">
                  {EVENT_LABEL[event.kind] ?? event.kind} · <span class="tabular">{event.minute}'</span>
                </span>
                <span class="block text-xs text-ink-muted">
                  {event.match.homeTeam.name} {event.match.homeScore ?? 0}-{event.match.awayScore ?? 0}{' '}
                  {event.match.awayTeam.name} · {formatDate(event.match.kickoffUtc)}
                </span>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="text-sm text-ink-muted">Aún no hay eventos registrados de este jugador.</p>
      )}
    </Card>
  </div>
  </Container>
</Base>
