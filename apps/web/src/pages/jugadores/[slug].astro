---
import Base from '../../layouts/Base.astro';
import { cachear } from '../../lib/cache';
import Card from '../../components/Card.astro';
import Icon from '../../components/Icon.astro';
import Container from '../../components/layout/Container.astro';
import BotonFavorito from '../../components/BotonFavorito.astro';
import RecentPerformances from '../../components/player/RecentPerformances.astro';
import SeasonTable from '../../components/player/SeasonTable.astro';
import Palmares from '../../components/player/Palmares.astro';
import { api, ApiError, POSITION_LABEL, type PlayerView } from '../../lib/api';
import { paisEnEspanol } from '../../lib/paises';
import { formatDate } from '../../lib/format';
import { enlaceDePartido } from '../../lib/partido';
import { absoluta, identidad, migas, nodoEquipo } from '../../lib/seo';
import RielDeAnuncios from '../../components/anuncios/RielDeAnuncios.astro';

const { slug } = Astro.params;

/* Los dos pedidos arrancan juntos: la sesión no depende del jugador. */
const pedidoVista = api<PlayerView>(`/views/player/${slug}`);

let view: PlayerView;
try {
  view = await pedidoVista;
} catch (error) {
  if (error instanceof ApiError && error.status === 404) {
    /* El slug cambió: se redirige al nuevo en lugar de decir que no existe. */
    const mudado = error.body?.movedTo;
    return mudado ? Astro.redirect(`/jugadores/${mudado}`, 301) : Astro.rewrite('/404');
  }
  throw error;
}

cachear(Astro.response, 'jugador');

const { player, teams, events, seasons, totals, recentPerformances, shirtNumber, palmares } = view;
const position = player.position ? POSITION_LABEL[player.position] : null;

/* Un cambio no dice nada de un jugador; los goles y las tarjetas sí. */
const destacados = events.filter((e) => e.kind !== 'substitution' && e.kind !== 'var');

const EVENT_LABEL: Record<string, string> = {
  goal: 'Gol',
  own_goal: 'Autogol',
  penalty_goal: 'Gol de penal',
  missed_penalty: 'Penal errado',
  yellow_card: 'Amarilla',
  red_card: 'Roja',
  substitution: 'Cambio',
  var: 'VAR',
};


const rutaJugador = `/jugadores/${player.slug}`;
const urlJugador = absoluta(rutaJugador, Astro.site);
const nacionalidad = player.nationality ? paisEnEspanol(player.nationality) : null;
const clubActual = teams[0] ?? null;

/*
 * Con miles de fichas, la descripción tiene que decir algo de este jugador y no de la plantilla:
 * el club y el país lo distinguen de los otros seis "Luis Ramírez" del catálogo.
 */
const descripcionJugador = [
  `${player.name}`,
  position ? `, ${position.toLowerCase()}` : '',
  nacionalidad ? ` de ${nacionalidad}` : '',
  clubActual ? `, juega en ${clubActual.name}` : '',
  '. Goles, tarjetas, minutos y sus últimos partidos.',
].join('');

const jsonLd = [
  {
    /* Las dos cosas a la vez: es una persona y compite. `Athlete` solo pierde los campos de Person. */
    '@type': ['Person', 'Athlete'],
    '@id': identidad(urlJugador, 'jugador'),
    url: urlJugador,
    name: player.name,
    ...(position ? { jobTitle: position } : {}),
    ...(nacionalidad ? { nationality: { '@type': 'Country', name: nacionalidad } } : {}),
    ...(player.birthDate ? { birthDate: player.birthDate.slice(0, 10) } : {}),
    ...(player.heightCm ? { height: { '@type': 'QuantitativeValue', value: player.heightCm, unitCode: 'CMT' } } : {}),
    ...(player.photoUrl ? { image: player.photoUrl } : {}),
    ...(clubActual ? { memberOf: nodoEquipo(clubActual, Astro.site) } : {}),
  },
  migas(
    clubActual
      ? [
          { nombre: clubActual.name, ruta: `/equipos/${clubActual.slug}` },
          { nombre: player.name, ruta: rutaJugador },
        ]
      : [{ nombre: player.name, ruta: rutaJugador }],
    Astro.site,
    urlJugador,
  ),
];
---

<Base
  title={`${player.name}${clubActual ? ` — ${clubActual.name}` : ''} — Perfil y estadísticas | Athena`}
  description={descripcionJugador}
  canonical={urlJugador}
  ogType="profile"
  ogImage={player.photoUrl}
  jsonLd={jsonLd}
  width="bleed"
  liveBar={false}
>
  <section class="w-full border-b-[3px] border-b-primary bg-banda">
    <Container width="content">
  <div class="flex items-center gap-4 py-6">
    {
      player.photoUrl && (
        <img
          src={player.photoUrl}
          alt={`Foto de ${player.name}`}
          width="64"
          height="64"
          fetchpriority="high"
          class="rounded-full"
        />
      )
    }
    <div>
      <h1 class="font-display text-3xl font-semibold uppercase text-chalk sm:text-4xl">
        {shirtNumber !== null && <span class="tabular text-chalk-dim">{shirtNumber} </span>}
        {player.name}
      </h1>
      <p class="text-sm text-chalk-dim">
        {[
          position,
          paisEnEspanol(player.nationality),
          player.heightCm ? `${player.heightCm} cm` : null,
          player.fullName && player.fullName !== player.name ? player.fullName : null,
        ]
          .filter(Boolean)
          .join(' · ')}
      </p>
    </div>

    <div class="ml-auto shrink-0">
      <a
        href={`/comparar?tipo=jugador&a=${player.slug}`}
        class="flex items-center gap-1.5 whitespace-nowrap rounded-md border border-chalk/30 px-2.5 py-1.5 text-2xs font-medium text-chalk transition-colors hover:border-primary hover:text-primary"
      >
        <Icon name="formacion" size={13} />
        Comparar
      </a>
      <BotonFavorito
        tipo="jugador"
        id={player.id}
        slug={player.slug}
        nombre={player.name}
        logoUrl={player.photoUrl}
        pais={paisEnEspanol(player.nationality)}
        variante="boton"
        onBoard
      />
    </div>
  </div>
    </Container>
  </section>

  <Container width="content" class="pt-7 pb-6">
  <SeasonTable seasons={seasons} totals={totals} />

  <div class="mt-4 grid gap-7 items-start lg:grid-cols-2 3xl:grid-cols-[minmax(0,1fr)_minmax(0,1fr)_19rem]">
    <div class="grid gap-4">
      <RecentPerformances performances={recentPerformances} />

      <Card title="Equipos">
        {teams.length > 0 ? (
          <ul class="grid gap-2">
            {teams.map((team) => (
              <li>
                <a href={`/equipos/${team.slug}`} class="flex items-center gap-2 text-sm hover:text-primary-ink transition-colors">
                  {team.logoUrl && <img src={team.logoUrl} alt="" width="20" height="20" loading="lazy" />}
                  {team.name}
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="text-sm text-ink-muted">Sin equipos registrados todavía.</p>
        )}
      </Card>

      <Palmares palmares={palmares} />
    </div>

    <Card title="Goles y tarjetas">
      {destacados.length > 0 ? (
        <ul class="divide-y divide-border/40">
          {destacados.map((event) => (
            <li class="py-2">
              <a href={enlaceDePartido(event.match)} class="block hover:text-primary-ink transition-colors">
                <span class="text-sm">
                  {EVENT_LABEL[event.kind] ?? event.kind} · <span class="tabular">{event.minute}'</span>
                </span>
                <span class="block text-xs text-ink-muted">
                  {event.match.homeTeam.name} {event.match.homeScore ?? 0}-{event.match.awayScore ?? 0}{' '}
                  {event.match.awayTeam.name} · {formatDate(event.match.kickoffUtc)}
                </span>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="text-sm text-ink-muted">
          Sin goles ni tarjetas en los partidos que Athena tiene sincronizados.
        </p>
      )}
    </Card>

    <RielDeAnuncios ubicacion="jugador-riel" />
  </div>
  </Container>
</Base>
