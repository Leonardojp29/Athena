---
import Base from '../layouts/Base.astro';
import { cachear } from '../lib/cache';
import Container from '../components/layout/Container.astro';
import Icon from '../components/Icon.astro';
import Comparador from '../components/comparar/Comparador.astro';
import { api, ApiError, POSITION_LABEL, type PlayerView, type SearchHit, type TeamView } from '../lib/api';
import {
  CLAVE_TOTAL,
  FILAS_DE_EQUIPO,
  FILAS_DE_JUGADOR,
  MAXIMO_A_COMPARAR,
  type AmbitoComparado,
  type EntidadComparada,
} from '../lib/comparar';
import { nombreFase, paisEnEspanol } from '../lib/paises';

/*
 * Comparar jugadores o equipos, hasta cinco a la vez.
 *
 * Todo va por la URL —`?tipo=&j=slug,slug`— así que la comparación es un enlace que se manda por
 * WhatsApp. Con uno solo ya se muestran sus números: antes había que elegir dos para ver algo, y
 * quedaba una página con un buscador y nada más, que no explicaba para qué servía.
 *
 * Los enlaces viejos traían `a` y `b`; se siguen leyendo y se pasan a la lista.
 */
const params = Astro.url.searchParams;
const tipo = params.get('tipo') === 'equipo' ? 'equipo' : 'jugador';
const q = (params.get('q') ?? '').trim();

const SLUG = /^[a-z0-9-]{2,80}$/;
const ruta = tipo === 'equipo' ? 'team' : 'player';

const pedidos = [
  ...(params.get('j') ?? '').split(','),
  params.get('a') ?? '',
  params.get('b') ?? '',
]
  .map((s) => s.trim())
  .filter((s) => SLUG.test(s));
const slugs = [...new Set(pedidos)].slice(0, MAXIMO_A_COMPARAR);

/*
 * Un slug que cambió no puede vaciar la comparación: se reintenta una vez con el nuevo, que el API
 * manda en el 404. Es el mismo enlace viejo que en la ficha se redirige.
 */
async function traer(slug: string): Promise<PlayerView | TeamView | null> {
  try {
    return await api<PlayerView | TeamView>(`/views/${ruta}/${slug}`);
  } catch (error) {
    if (!(error instanceof ApiError)) throw error;
    const mudado = error.body?.movedTo;
    if (!mudado || !SLUG.test(mudado)) return null;
    return await api<PlayerView | TeamView>(`/views/${ruta}/${mudado}`).catch(() => null);
  }
}

const [vistas, candidatos] = await Promise.all([
  Promise.all(slugs.map(traer)),
  q.length >= 2
    ? api<{ results: SearchHit[] }>(`/search?q=${encodeURIComponent(q)}`)
        .then((r) => r.results.filter((hit) => hit.type === (tipo === 'equipo' ? 'team' : 'player')))
        .catch(() => [] as SearchHit[])
    : Promise.resolve([] as SearchHit[]),
]);

cachear(Astro.response, tipo === 'equipo' ? 'equipo' : 'jugador');

const esJugador = (v: PlayerView | TeamView): v is PlayerView => 'player' in v;
const num = (valor: number | null | undefined): number => valor ?? 0;

/* Sin partidos no hay promedio: un cero diría que jugó y anduvo mal. */
const porPartido = (total: number, partidos: number): number | null =>
  partidos > 0 ? total / partidos : null;

function ambitosDeJugador(v: PlayerView): AmbitoComparado[] {
  const deUnaTemporada = (s: PlayerView['seasons'][number]): AmbitoComparado => ({
    clave: `${s.season.year}-${s.season.competition.slug}`,
    etiqueta: `${s.season.competition.name} ${s.season.year}`,
    logoUrl: s.season.competition.logoUrl,
    numeros: {
      appearances: s.appearances,
      lineups: s.lineups,
      minutesPlayed: s.minutesPlayed,
      rating: s.rating === null ? null : Number(s.rating),
      goals: s.goals,
      assists: s.assists,
      golesCada90: porPartido(num(s.goals) * 90, num(s.minutesPlayed)),
      shotsTotal: s.shotsTotal,
      shotsOnTarget: s.shotsOnTarget,
      penaltyScored: s.penaltyScored,
      passesTotal: s.passesTotal,
      passesKey: s.passesKey,
      passesAccuracyPercent: s.passesAccuracyPercent,
      dribblesSuccess: s.dribblesSuccess,
      duelsWon: s.duelsWon,
      yellowCards: s.yellowCards,
      redCards: s.redCards,
    },
  });

  const suma = (campo: keyof PlayerView['seasons'][number]): number =>
    v.seasons.reduce((total, s) => total + num(s[campo] as number | null), 0);

  /* La nota de carrera no existe en el proveedor: es el promedio de las temporadas que sí la tienen. */
  const notas = v.seasons
    .map((s) => (s.rating === null ? null : Number(s.rating)))
    .filter((n): n is number => n !== null);

  const minutos = suma('minutesPlayed');
  const pases = suma('passesTotal');
  const total: AmbitoComparado = {
    clave: CLAVE_TOTAL,
    etiqueta: 'Todas las temporadas',
    logoUrl: null,
    numeros: {
      appearances: suma('appearances'),
      lineups: suma('lineups'),
      minutesPlayed: minutos,
      rating: notas.length === 0 ? null : notas.reduce((a, b) => a + b, 0) / notas.length,
      goals: suma('goals'),
      assists: suma('assists'),
      golesCada90: porPartido(suma('goals') * 90, minutos),
      shotsTotal: suma('shotsTotal'),
      shotsOnTarget: suma('shotsOnTarget'),
      penaltyScored: suma('penaltyScored'),
      passesTotal: pases,
      passesKey: suma('passesKey'),
      /* Un promedio de porcentajes miente: se rehace sobre el total de pases de todas las temporadas. */
      passesAccuracyPercent: porPartido(
        v.seasons.reduce((t, s) => t + (num(s.passesTotal) * num(s.passesAccuracyPercent)) / 100, 0) * 100,
        pases,
      ),
      dribblesSuccess: suma('dribblesSuccess'),
      duelsWon: suma('duelsWon'),
      yellowCards: suma('yellowCards'),
      redCards: suma('redCards'),
    },
  };

  return [total, ...v.seasons.map(deUnaTemporada)];
}

/*
 * La fase va en la clave y en la etiqueta: un club puede tener tres tablas del mismo torneo y del
 * mismo año —Apertura, Clausura y la anual— y sin ella el selector mostraba tres veces lo mismo.
 */
function ambitosDeEquipo(v: TeamView): AmbitoComparado[] {
  return v.standings.map((s) => ({
    clave: `${s.season.year}-${s.season.competition.slug}-${s.groupLabel ?? ''}`,
    etiqueta: `${s.season.competition.name} ${s.season.year}${s.groupLabel ? ` · ${nombreFase(s.groupLabel)}` : ''}`,
    logoUrl: s.season.competition.logoUrl,
    numeros: {
      position: s.position,
      points: s.points,
      played: s.played,
      puntosPorPartido: porPartido(s.points, s.played),
      won: s.won,
      drawn: s.drawn,
      lost: s.lost,
      goalsFor: s.goalsFor,
      goalsAgainst: s.goalsAgainst,
      diferencia: s.goalsFor - s.goalsAgainst,
      golesPorPartido: porPartido(s.goalsFor, s.played),
    },
  }));
}

const entidades: EntidadComparada[] = vistas
  .filter((v): v is PlayerView | TeamView => v !== null)
  .map((v) =>
    esJugador(v)
      ? {
          slug: v.player.slug,
          nombre: v.player.name,
          fotoUrl: v.player.photoUrl,
          subtitulo: [
            v.player.position ? POSITION_LABEL[v.player.position] ?? v.player.position : null,
            v.player.nationality ? paisEnEspanol(v.player.nationality) : null,
          ]
            .filter(Boolean)
            .join(' · '),
          escudoUrl: v.teams[0]?.logoUrl ?? null,
          ambitos: ambitosDeJugador(v),
        }
      : {
          slug: v.team.slug,
          nombre: v.team.name,
          fotoUrl: v.team.logoUrl,
          subtitulo: v.team.country ? paisEnEspanol(v.team.country) : null,
          escudoUrl: null,
          ambitos: ambitosDeEquipo(v),
        },
  )
  /* Sin un solo número no hay nada que comparar, y una columna vacía confunde más que faltar. */
  .filter((e) => e.ambitos.length > 0);

const elegidos = entidades.map((e) => {
  const pedido = params.get(`t-${e.slug}`);
  return pedido && e.ambitos.some((a) => a.clave === pedido) ? pedido : e.ambitos[0]!.clave;
});

const conSlugs = (lista: string[]) =>
  `/comparar?tipo=${tipo}${lista.length > 0 ? `&j=${lista.join(',')}` : ''}`;

const hrefSumar = `${conSlugs(entidades.map((e) => e.slug))}&sumar=1`;
const hrefQuitar = entidades.map((e) => conSlugs(entidades.filter((o) => o !== e).map((o) => o.slug)));
const sumando = params.has('sumar') || entidades.length === 0;
const puedeSumar = entidades.length < MAXIMO_A_COMPARAR;

const titulo =
  entidades.length >= 2
    ? entidades.map((e) => e.nombre).join(' vs ')
    : tipo === 'equipo'
      ? 'Comparar equipos'
      : 'Comparar jugadores';

const queBusca = tipo === 'equipo' ? 'un equipo' : 'un jugador';

/*
 * Nunca al índice: cada combinación de entidades es una URL y con miles de jugadores el espacio es
 * N⁵. Ninguna de esas páginas dice algo que las fichas no digan mejor. Se rastrea, no se guarda.
 */
---

<Base
  title={`${titulo} | Athena`}
  description="Compara hasta cinco jugadores o equipos, temporada por temporada."
  noindex
  width="bleed"
  liveBar={false}
>
  <section class="w-full border-b-[3px] border-b-primary bg-banda">
    <Container width="content">
      <div class="flex flex-wrap items-center gap-x-4 gap-y-2 py-4">
        <h1 class="min-w-0 truncate font-display text-2xl font-semibold uppercase leading-none text-chalk sm:text-3xl">
          {titulo}
        </h1>
        <div class="flex items-center gap-1 rounded-lg bg-chalk/10 p-1">
          {
            (['jugador', 'equipo'] as const).map((clave) => (
              <a
                href={`/comparar?tipo=${clave}`}
                aria-current={clave === tipo ? 'true' : undefined}
                class:list={[
                  'rounded-md px-2.5 py-1 text-2xs font-medium transition-colors',
                  clave === tipo ? 'bg-chalk text-board' : 'text-chalk-dim hover:text-chalk',
                ]}
              >
                {clave === 'equipo' ? 'Equipos' : 'Jugadores'}
              </a>
            ))
          }
        </div>
      </div>
    </Container>
  </section>

  <Container width="content" class="pb-6 pt-6">
    {/*
      El buscador arriba, que es donde se empieza. Con algo ya elegido se repliega en un botón y
      vuelve al tocarlo: mientras se leen los números no hace falta y ocupa el lugar de una fila.
    */}
    {
      puedeSumar && (
        <div class="mx-auto mb-6 w-full max-w-[36rem]">
          {entidades.length > 0 && (
            <a
              href={hrefSumar}
              data-comparar-abrir
              hidden={sumando}
              class="flex items-center justify-center gap-2 rounded-lg border border-dashed border-border py-2.5 text-2xs font-medium text-ink-muted transition-colors hover:border-primary-ink hover:text-primary-ink"
            >
              <Icon name="buscar" size={13} />
              Sumar a otro {tipo === 'equipo' ? 'equipo' : 'jugador'}
            </a>
          )}

          <div data-comparar-caja hidden={entidades.length > 0 && !sumando}>
            {entidades.length > 0 && (
              <p class="mb-2 text-sm text-ink-muted">
                Busca a quién sumar. Puedes comparar hasta {MAXIMO_A_COMPARAR}.
              </p>
            )}

            <form method="get" action="/comparar" class="grid gap-2">
            <input type="hidden" name="tipo" value={tipo} />
            {entidades.length > 0 && (
              <input type="hidden" name="j" value={entidades.map((e) => e.slug).join(',')} />
            )}
            <input type="hidden" name="sumar" value="1" />
            <label class="relative flex items-center">
              <Icon name="buscar" size={16} class="absolute left-3 text-ink-muted" />
              <input
                type="search"
                name="q"
                value={q}
                autofocus
                placeholder={`Buscar ${queBusca}`}
                aria-label={`Buscar ${queBusca}`}
                class="w-full rounded-md border border-border bg-surface py-2 pl-9 pr-3 text-sm outline-none transition-colors focus:border-primary-ink"
              />
            </label>
            {/*
              Sin JavaScript el botón es la única forma de buscar, así que existe siempre; con
              JavaScript los resultados salen mientras se escribe y el botón sobra.
            */}
            <button
              type="submit"
              data-comparar-enviar
              class="cursor-pointer justify-self-start rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-contrast transition-opacity hover:opacity-90"
            >
              Buscar
            </button>
          </form>

          <ul data-comparar-sugerencias class="mt-4 grid gap-0.5 empty:hidden"></ul>
          <p data-comparar-aviso class="mt-4 text-sm text-ink-muted" hidden></p>

          {q.length >= 2 && (
            <ul data-comparar-servidor class="mt-4 grid gap-0.5">
              {candidatos.length === 0 && (
                <li class="text-sm text-ink-muted">Sin resultados para “{q}”.</li>
              )}
              {candidatos.map((hit) => (
                <li>
                  <a
                    href={conSlugs([...entidades.map((e) => e.slug), hit.slug].slice(0, MAXIMO_A_COMPARAR))}
                    class="flex items-center gap-3 rounded-lg border border-border bg-surface p-2.5 transition-colors hover:border-primary-ink"
                  >
                    {hit.imageUrl ? (
                      <img
                        src={hit.imageUrl}
                        alt=""
                        width="28"
                        height="28"
                        loading="lazy"
                        class="size-7 shrink-0 rounded-full bg-canvas-subtle object-cover"
                      />
                    ) : (
                      <span class="grid size-7 shrink-0 place-items-center rounded-full bg-canvas-subtle">
                        <Icon name="usuario" size={13} class="text-ink-muted" />
                      </span>
                    )}
                    <span class="min-w-0 flex-1">
                      <span class="block truncate text-sm">{hit.name}</span>
                      {hit.subtitle && (
                        <span class="block truncate text-2xs text-ink-muted">
                          {paisEnEspanol(hit.subtitle)}
                        </span>
                      )}
                    </span>
                    <Icon name="chevron-derecha" size={14} class="shrink-0 text-ink-muted" />
                  </a>
                </li>
              ))}
            </ul>
          )}

            {entidades.length === 0 && q.length < 2 && (
              <p class="mt-4 text-sm text-ink-muted">
                Elige hasta {MAXIMO_A_COMPARAR} {tipo === 'equipo' ? 'equipos' : 'jugadores'} y sus
                números quedan uno al lado del otro, temporada por temporada. También se llega desde
                cualquier perfil, con el botón de comparar.
              </p>
            )}
          </div>
        </div>
      )
    }

    {
      entidades.length > 0 && (
        <Comparador
          tipo={tipo}
          entidades={entidades}
          elegidos={elegidos}
          grupos={tipo === 'equipo' ? FILAS_DE_EQUIPO : FILAS_DE_JUGADOR}
          hrefQuitar={hrefQuitar}
        />
      )
    }
  </Container>
</Base>

<script>
  import { API_URL } from '../lib/entorno';

  /*
   * Los resultados salen mientras se escribe, como en el buscador del encabezado. El formulario
   * sigue existiendo y funcionando: sin JavaScript, el botón busca y el servidor pinta la lista.
   *
   * Se pide a `sugerencias` y no a `search`: es la vía del teclado, devuelve ocho en milisegundos y
   * nunca calcula un embedding, que es lo que hace lenta a la otra.
   */
  const formulario = document.querySelector<HTMLFormElement>('form[action="/comparar"]');
  const campo = formulario?.querySelector<HTMLInputElement>('input[name="q"]');
  const lista = document.querySelector<HTMLElement>('[data-comparar-sugerencias]');
  const aviso = document.querySelector<HTMLElement>('[data-comparar-aviso]');

  if (formulario && campo && lista && aviso) {
    const tipo = formulario.querySelector<HTMLInputElement>('input[name="tipo"]')?.value ?? 'jugador';
    const puestos = formulario.querySelector<HTMLInputElement>('input[name="j"]')?.value ?? '';
    const quiero = tipo === 'equipo' ? 'team' : 'player';
    const MINIMO = 2;
    const ESPERA_MS = 180;

    /* La lista del servidor deja de tener sentido apenas el guion toma el mando. */
    document.querySelector('[data-comparar-servidor]')?.remove();
    formulario.querySelector('[data-comparar-enviar]')?.setAttribute('hidden', '');

    /*
     * "Sumar a otro" se convierte en el buscador ahí mismo, sin recargar. Sin JavaScript el mismo
     * enlace lleva a la página con el formulario abierto, así que el gesto es el mismo.
     */
    const abrir = document.querySelector<HTMLElement>('[data-comparar-abrir]');
    const caja = document.querySelector<HTMLElement>('[data-comparar-caja]');
    abrir?.addEventListener('click', (evento) => {
      if (evento.metaKey || evento.ctrlKey || evento.shiftKey || !caja) return;
      evento.preventDefault();
      abrir.hidden = true;
      caja.hidden = false;
      campo.focus();
    });

    interface Sugerencia {
      type: string;
      slug: string;
      name: string;
      subtitle: string | null;
      imageUrl: string | null;
    }

    const escapar = (texto: string): string =>
      texto.replace(
        /[&<>"]/g,
        (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c] as string,
      );

    const destino = (slug: string): string => {
      const lista = [...puestos.split(',').filter(Boolean), slug].slice(0, 5);
      return `/comparar?tipo=${tipo}&j=${lista.join(',')}`;
    };

    const pintar = (resultados: Sugerencia[]): void => {
      lista.innerHTML = resultados
        .map(
          (hit) => `<li>
            <a href="${escapar(destino(hit.slug))}"
              class="flex items-center gap-3 rounded-lg border border-border bg-surface p-2.5 transition-colors hover:border-primary-ink">
              ${
                hit.imageUrl
                  ? `<img src="${escapar(hit.imageUrl)}" alt="" width="28" height="28" loading="lazy" class="size-7 shrink-0 rounded-full bg-canvas-subtle object-cover">`
                  : '<span class="size-7 shrink-0 rounded-full bg-canvas-subtle"></span>'
              }
              <span class="min-w-0 flex-1">
                <span class="block truncate text-sm">${escapar(hit.name)}</span>
                ${hit.subtitle ? `<span class="block truncate text-2xs text-ink-muted">${escapar(hit.subtitle)}</span>` : ''}
              </span>
            </a>
          </li>`,
        )
        .join('');
    };

    let enVuelo: AbortController | undefined;
    let temporizador: number | undefined;

    const buscar = async (consulta: string): Promise<void> => {
      enVuelo?.abort();
      const corte = new AbortController();
      enVuelo = corte;
      try {
        const r = await fetch(
          `${API_URL}/v1/search/sugerencias?q=${encodeURIComponent(consulta)}&limit=10`,
          { signal: corte.signal },
        );
        if (!r.ok) throw new Error(String(r.status));
        const datos = (await r.json()) as { results?: Sugerencia[] };
        const suyos = (datos.results ?? []).filter((hit) => hit.type === quiero);
        pintar(suyos);
        aviso.hidden = suyos.length > 0;
        aviso.textContent = `Sin resultados para «${consulta}».`;
      } catch (error) {
        if (corte.signal.aborted) return;
        lista.innerHTML = '';
        aviso.hidden = false;
        aviso.textContent = 'La búsqueda no está disponible en este momento.';
      }
    };

    campo.addEventListener('input', () => {
      const consulta = campo.value.trim();
      clearTimeout(temporizador);
      if (consulta.length < MINIMO) {
        enVuelo?.abort();
        lista.innerHTML = '';
        aviso.hidden = true;
        return;
      }
      temporizador = window.setTimeout(() => void buscar(consulta), ESPERA_MS);
    });

    /* Lo que ya venía escrito en la URL se busca al cargar, sin esperar a que alguien teclee. */
    if (campo.value.trim().length >= MINIMO) void buscar(campo.value.trim());
  }
</script>
