---
import Base from '../layouts/Base.astro';
import { cachear } from '../lib/cache';
import Container from '../components/layout/Container.astro';
import Icon from '../components/Icon.astro';
import TarjetaComparacion from '../components/comparar/TarjetaComparacion.astro';
import {
  api,
  ApiError,
  type PlayerView,
  type SearchHit,
  type TeamView,
} from '../lib/api';
import { paisEnEspanol } from '../lib/paises';

/*
 * Comparar dos jugadores o dos equipos.
 *
 * Los acumulados ya estaban en la base y no había forma de ponerlos uno al lado del otro, que es
 * media conversación de fútbol. Todo va por la URL —`?tipo=&a=&b=`— así que la comparación es un
 * enlace que se puede mandar por WhatsApp, y la página cuesta 0 KB.
 *
 * Con solo `a`, la página se convierte en el buscador del segundo: sin eso haría falta un
 * autocompletado hidratado para elegir, y esto resuelve lo mismo con un formulario GET.
 */
const params = Astro.url.searchParams;
const tipo = params.get('tipo') === 'equipo' ? 'equipo' : 'jugador';
const a = params.get('a');
const b = params.get('b');
const q = (params.get('q') ?? '').trim();

const SLUG = /^[a-z0-9-]{2,80}$/;
const ruta = tipo === 'equipo' ? 'team' : 'player';

/*
 * Un slug que cambió no puede vaciar la comparación: se reintenta una vez con el nuevo, que el API
 * manda en el 404. Es el mismo enlace viejo que en la ficha se redirige.
 */
async function traer(slug: string | null): Promise<PlayerView | TeamView | null> {
  if (!slug || !SLUG.test(slug)) return null;
  try {
    return await api<PlayerView | TeamView>(`/views/${ruta}/${slug}`);
  } catch (error) {
    if (!(error instanceof ApiError)) throw error;
    const mudado = error.body?.movedTo;
    if (!mudado || !SLUG.test(mudado)) return null;
    return await api<PlayerView | TeamView>(`/views/${ruta}/${mudado}`).catch(() => null);
  }
}

/* Los dos lados y la búsqueda del segundo, todo en paralelo: ninguno depende del otro. */
const [uno, dos, candidatos] = await Promise.all([
  traer(a),
  traer(b),
  q.length >= 2
    ? api<{ results: SearchHit[] }>(`/search?q=${encodeURIComponent(q)}`)
        .then((r) => r.results.filter((hit) => hit.type === (tipo === 'equipo' ? 'team' : 'player')))
        .catch(() => [] as SearchHit[])
    : Promise.resolve([] as SearchHit[]),
]);

cachear(Astro.response, tipo === 'equipo' ? 'equipo' : 'jugador');

const nombreDe = (vista: PlayerView | TeamView | null): string | null =>
  vista === null ? null : 'player' in vista ? vista.player.name : vista.team.name;

const titulo =
  uno && dos
    ? `${nombreDe(uno)} vs ${nombreDe(dos)}`
    : tipo === 'equipo'
      ? 'Comparar equipos'
      : 'Comparar jugadores';
---

<Base
  title={`${titulo} | Athena`}
  description="Compará dos jugadores o dos equipos con sus números de la temporada."
  noindex={!uno || !dos}
  width="bleed"
  liveBar={false}
>
  <section class="w-full border-b border-board-edge bg-board">
    <Container width="wide">
      <div class="flex flex-wrap items-center gap-x-4 gap-y-2 py-4">
        <h1 class="font-display text-2xl font-semibold uppercase leading-none text-chalk sm:text-3xl">
          {titulo}
        </h1>
        <div class="flex items-center gap-1 rounded-lg bg-chalk/10 p-1">
          {
            (['jugador', 'equipo'] as const).map((clave) => (
              <a
                href={clave === tipo ? Astro.url.pathname + Astro.url.search : `/comparar?tipo=${clave}`}
                aria-current={clave === tipo ? 'true' : undefined}
                class:list={[
                  'rounded-md px-2.5 py-1 text-2xs font-medium capitalize transition-colors',
                  clave === tipo ? 'bg-chalk text-board' : 'text-chalk-dim hover:text-chalk',
                ]}
              >
                {clave === 'equipo' ? 'Equipos' : 'Jugadores'}
              </a>
            ))
          }
        </div>
      </div>
    </Container>
  </section>

  <Container width="wide" class="py-5">
    {
      uno && dos ? (
        <TarjetaComparacion tipo={tipo} uno={uno} dos={dos} slugA={a as string} slugB={b as string} />
      ) : (
        <div class="mx-auto max-w-[42rem]">
          <!--
            Un lado elegido y el otro por elegir: el formulario busca con el mismo motor del sitio y
            cada resultado es el enlace que completa la comparación.
          -->
          {
            uno && (
              <p class="mb-3 flex items-center gap-2 rounded-lg border border-border bg-surface p-3 text-sm">
                <Icon name="check" size={14} class="shrink-0 text-primary-ink" />
                <span>
                  <strong class="font-medium">{nombreDe(uno)}</strong> ya está elegido. Buscá con
                  quién compararlo.
                </span>
              </p>
            )
          }

          <form method="get" action="/comparar" class="grid gap-2">
            <input type="hidden" name="tipo" value={tipo} />
            {uno && <input type="hidden" name="a" value={a} />}
            <label class="relative flex items-center">
              <Icon name="buscar" size={16} class="absolute left-3 text-ink-muted" />
              <input
                type="search"
                name="q"
                value={q}
                autofocus
                placeholder={tipo === 'equipo' ? 'Buscar un equipo' : 'Buscar un jugador'}
                aria-label={tipo === 'equipo' ? 'Buscar un equipo' : 'Buscar un jugador'}
                class="w-full rounded-md border border-border bg-surface py-2 pl-9 pr-3 text-sm outline-none transition-colors focus:border-primary-ink"
              />
            </label>
            <button
              type="submit"
              class="cursor-pointer justify-self-start rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-contrast transition-opacity hover:opacity-90"
            >
              Buscar
            </button>
          </form>

          {
            q.length >= 2 && (
              <ul class="mt-4 grid gap-0.5">
                {candidatos.length === 0 && (
                  <li class="text-sm text-ink-muted">Sin resultados para “{q}”.</li>
                )}
                {candidatos.map((hit) => (
                  <li>
                    <a
                      href={
                        uno
                          ? `/comparar?tipo=${tipo}&a=${a}&b=${hit.slug}`
                          : `/comparar?tipo=${tipo}&a=${hit.slug}`
                      }
                      class="flex items-center gap-3 rounded-lg border border-border bg-surface p-2.5 transition-colors hover:border-primary-ink"
                    >
                      {hit.imageUrl ? (
                        <img
                          src={hit.imageUrl}
                          alt=""
                          width="28"
                          height="28"
                          loading="lazy"
                          class="size-7 shrink-0 rounded-full bg-canvas-subtle object-cover"
                        />
                      ) : (
                        <span class="grid size-7 shrink-0 place-items-center rounded-full bg-canvas-subtle">
                          <Icon name="usuario" size={13} class="text-ink-muted" />
                        </span>
                      )}
                      <span class="min-w-0 flex-1">
                        <span class="block truncate text-sm">{hit.name}</span>
                        {hit.subtitle && (
                          <span class="block truncate text-2xs text-ink-muted">
                            {paisEnEspanol(hit.subtitle)}
                          </span>
                        )}
                      </span>
                      <Icon name="chevron-derecha" size={14} class="shrink-0 text-ink-muted" />
                    </a>
                  </li>
                ))}
              </ul>
            )
          }

          {
            !uno && q.length < 2 && (
              <p class="mt-4 text-sm text-ink-muted">
                Elegí dos {tipo === 'equipo' ? 'equipos' : 'jugadores'} y sus números quedan uno al
                lado del otro. También se llega desde cualquier perfil, con el botón de comparar.
              </p>
            )
          }
        </div>
      )
    }
  </Container>
</Base>
