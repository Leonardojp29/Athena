---
import Base from '../layouts/Base.astro';
---

<Base title="Página no encontrada | Athena" description="La página que buscas no existe." noindex>
  <div class="text-center py-20">
    <h1 class="font-display text-4xl font-semibold uppercase mb-2">404</h1>
    <p class="text-ink-muted mb-6">Esta página no existe o el contenido ya no está disponible.</p>
    <a href="/" class="text-primary-ink hover:underline">Volver a los partidos de hoy</a>
  </div>
</Base>
