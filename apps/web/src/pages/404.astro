---
import Base from '../layouts/Base.astro';
import NoEncontrado from '../components/NoEncontrado.astro';

/*
 * Esta página es el 404, así que responde 404 siempre —también cuando otra ruta la dibuja acá
 * mismo con `Astro.rewrite`—. Antes esas rutas desviaban con un 302 a una página que contestaba
 * 200: para un buscador eso no es "no existe", es "existe y está vacía", y la URL muerta se queda
 * en el índice gastando rastreo.
 */
Astro.response.status = 404;
Astro.response.headers.set('cache-control', 'public, s-maxage=300');
---

<Base
  title="Página no encontrada | Athena"
  description="La página que buscas no existe."
  noindex
  liveBar={false}
>
  <NoEncontrado />
</Base>
