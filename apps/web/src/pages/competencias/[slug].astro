---
import Base from '../../layouts/Base.astro';
import Card from '../../components/Card.astro';
import Container from '../../components/layout/Container.astro';
import FavoriteButton from '../../components/FavoriteButton.astro';
import MatchRow from '../../components/MatchRow.astro';
import StandingsTable from '../../components/StandingsTable.astro';
import { api, type FavoriteEntity, ApiError, type CompetitionView } from '../../lib/api';
import { getSession } from '../../lib/supabase';
import { paisEnEspanol } from '../../lib/paises';

const { slug } = Astro.params;
let view: CompetitionView;
try {
  view = await api<CompetitionView>(`/views/competition/${slug}`);
} catch (error) {
  if (error instanceof ApiError && error.status === 404) return Astro.redirect('/404');
  throw error;
}

const { competition, season, standingGroups, recent, upcoming } = view;
const seasonLabel = competition.format === 'league' && competition.country !== null && !['Peru', 'Brazil', 'Argentina'].includes(competition.country)
  ? `${season.year}-${String(season.year + 1).slice(2)}`
  : String(season.year);

const session = await getSession(Astro);
let following = false;
if (session?.accessToken) {
  try {
    const favorites = await api<FavoriteEntity[]>('/me/favorites', session.accessToken);
    following = favorites.some((f) => f.entityType === 'competition' && f.entityId === competition.id);
  } catch {
    following = false;
  }
}

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SportsOrganization',
  name: competition.name,
  sport: 'Soccer',
  ...(competition.logoUrl ? { logo: competition.logoUrl } : {}),
};
---

<Base
  title={`${competition.name} ${seasonLabel} — Tabla de posiciones y partidos | Athena`}
  description={`Tabla de posiciones, resultados y próximos partidos de ${competition.name} temporada ${seasonLabel}.`}
  ogImage={competition.logoUrl}
  jsonLd={jsonLd}
  width="bleed"
  liveBar={false}
>
  <section class="w-full border-b border-board-edge bg-board">
    <Container width="wide">
      <div class="flex items-center gap-4 py-6">
        {competition.logoUrl && (
          <span class="grid size-14 shrink-0 place-items-center rounded-lg bg-chalk/10">
            <img src={competition.logoUrl} alt="" width="36" height="36" />
          </span>
        )}
        <div class="min-w-0">
          <h1 class="font-display text-3xl font-semibold uppercase text-chalk sm:text-4xl">
            {competition.name}
          </h1>
          <p class="text-sm text-chalk-dim">
            {paisEnEspanol(competition.country) ?? 'Internacional'} · Temporada {seasonLabel}
          </p>
        </div>

        <div class="ml-auto shrink-0">
          <FavoriteButton
            entityType="competition"
            entityId={competition.id}
            following={following}
            signedIn={session !== null}
            label="competencia"
            onBoard
          />
        </div>
      </div>
    </Container>
  </section>

  <Container width="wide" class="py-6">

  <div class="grid lg:grid-cols-[1fr_380px] gap-4 items-start">
    <div class="grid gap-4">
      {standingGroups.length > 0 ? (
        <Card title="Tabla de posiciones">
          <div class="grid gap-6">
            {standingGroups.map((group) => <StandingsTable rows={group.rows} label={group.label} />)}
          </div>
        </Card>
      ) : (
        <Card><p class="text-sm text-ink-muted">La tabla estará disponible cuando arranque la competencia.</p></Card>
      )}
    </div>

    <div class="grid gap-4">
      <Card title="Próximos partidos">
        {upcoming.length > 0 ? (
          <div class="divide-y divide-border/40">
            {upcoming.map((match) => <MatchRow match={match} showDate />)}
          </div>
        ) : (
          <p class="text-sm text-ink-muted">Sin partidos programados por ahora.</p>
        )}
      </Card>
      <Card title="Últimos resultados">
        {recent.length > 0 ? (
          <div class="divide-y divide-border/40">
            {recent.map((match) => <MatchRow match={match} showDate />)}
          </div>
        ) : (
          <p class="text-sm text-ink-muted">Aún no hay resultados esta temporada.</p>
        )}
      </Card>
    </div>
  </div>
  </Container>
</Base>
