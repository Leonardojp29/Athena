---
import EscudoTorneo from '../../components/EscudoTorneo.astro';
import Base from '../../layouts/Base.astro';
import AvisoFavoritos from '../../components/AvisoFavoritos.astro';
import BotonFavorito from '../../components/BotonFavorito.astro';
import Card from '../../components/Card.astro';
import Container from '../../components/layout/Container.astro';
import CountryFlag from '../../components/CountryFlag.astro';
import ListaPartidosCompacta from '../../components/home/ListaPartidosCompacta.astro';
import SelectorFase from '../../components/SelectorFase.astro';
import StandingsTable from '../../components/StandingsTable.astro';
import OnceDeLaFecha from '../../components/home/OnceDeLaFecha.astro';
import TablaLideres from '../../components/TablaLideres.astro';
import { api, ApiError, type CompetitionView } from '../../lib/api';
import { getSession } from '../../lib/supabase';
import { nombreFase, paisEnEspanol } from '../../lib/paises';

const { slug } = Astro.params;

/* Los dos pedidos arrancan juntos: la sesión no depende de la competencia. */
const pedidoVista = api<CompetitionView>(`/views/competition/${slug}`);
const pedidoSesion = getSession(Astro);

let view: CompetitionView;
try {
  view = await pedidoVista;
} catch (error) {
  if (error instanceof ApiError && error.status === 404) return Astro.redirect('/404');
  throw error;
}
const session = await pedidoSesion;

const { competition, season, standingGroups, recent, upcoming, scorers, assisters, once } = view;
const seasonLabel =
  competition.format === 'league' &&
  competition.country !== null &&
  !['Peru', 'Brazil', 'Argentina'].includes(competition.country)
    ? `${season.year}-${String(season.year + 1).slice(2)}`
    : String(season.year);

/*
 * La fase en juego viene primera del API y es la que se abre. Antes se mostraban todas las tablas
 * una debajo de la otra con su etiqueta en gris chico, así que la Liga 1 abría con el Apertura
 * —cerrado en mayo— y quien miraba creía estar viendo el Clausura.
 */
const fasePedida = Astro.url.searchParams.get('tabla');
const grupo = standingGroups.find((g) => g.label === fasePedida) ?? standingGroups[0];

/* "Clausura - 4" → "Clausura · fecha 4". */
const jornada = (() => {
  if (!view.round) return null;
  const corte = view.round.lastIndexOf(' - ');
  if (corte === -1) return nombreFase(view.round);
  const cola = view.round.slice(corte + 3).trim();
  return /^\d+$/.test(cola)
    ? `${nombreFase(view.round.slice(0, corte))} · fecha ${cola}`
    : nombreFase(view.round);
})();

const pais = paisEnEspanol(competition.country);

/* Sin goleadores —una copa que nunca pasó por /players— la grilla vuelve a dos columnas: la del
   medio vacía dejaba un hueco de 400px en la mitad de la página. */
const hayLideres = scorers.length > 0 || assisters.length > 0;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SportsOrganization',
  name: competition.name,
  sport: 'Soccer',
  ...(competition.logoUrl ? { logo: competition.logoUrl } : {}),
};
---

<Base
  title={`${competition.name} ${seasonLabel} — Tabla de posiciones y partidos | Athena`}
  description={`Tabla de posiciones, resultados y próximos partidos de ${competition.name} temporada ${seasonLabel}.`}
  ogImage={competition.logoUrl}
  jsonLd={jsonLd}
  width="bleed"
  liveBar={false}
>
  <section class="w-full border-b border-board-edge bg-board">
    <Container width="wide">
      <div class="flex flex-wrap items-center gap-x-4 gap-y-3 py-6">
        <EscudoTorneo url={competition.logoUrl} size={38} class="!rounded-lg !p-2" />
        <div class="min-w-0 flex-1">
          <h1 class="font-display text-3xl font-semibold uppercase leading-none text-chalk sm:text-4xl">
            {competition.name}
          </h1>
          <p class="mt-1.5 flex flex-wrap items-center gap-x-2 text-sm text-chalk-dim">
            <span class="flex items-center gap-1.5">
              <CountryFlag url={competition.flagUrl} name={pais} size={16} />
              {pais ?? 'Internacional'}
            </span>
            <span class="text-chalk/25">·</span>
            <span>Temporada {seasonLabel}</span>
            {
              jornada && (
                <>
                  <span class="text-chalk/25">·</span>
                  <span class="font-medium text-chalk">{jornada}</span>
                </>
              )
            }
          </p>
        </div>

        <BotonFavorito
          tipo="liga"
          id={competition.id}
          slug={competition.slug}
          nombre={competition.name}
          logoUrl={competition.logoUrl}
          pais={pais}
          banderaUrl={competition.flagUrl}
          variante="boton"
          conCuenta={session !== null}
          onBoard
          class="shrink-0"
        />
      </div>
    </Container>
  </section>

  <!--
    Tres zonas, y en pantallas anchas las tres en fila: tabla, los que deciden y los partidos. En
    una sola columna la tabla se estiraba hasta 1200px para poner nueve números, con un hueco en el
    medio entre el nombre del equipo y las cifras.
  -->
  <Container width="wide" class="py-5">
    <div
      class:list={[
        'grid items-start gap-4 lg:grid-cols-[minmax(0,1fr)_23rem]',
        hayLideres ? '2xl:grid-cols-[minmax(0,1fr)_25rem_23rem]' : '',
      ]}
    >
      <div class="grid gap-4 lg:col-start-1 lg:row-start-1">
        {
          grupo ? (
            <section class="rounded-xl border border-border bg-surface">
              <header class="flex flex-wrap items-center justify-between gap-2 border-b border-border p-3">
                <h2 class="font-display text-base font-semibold uppercase">
                  Tabla de posiciones
                  {standingGroups.length === 1 && grupo.label && (
                    <span class="ml-1 font-sans text-2xs font-medium normal-case text-ink-muted">
                      {nombreFase(grupo.label)}
                    </span>
                  )}
                </h2>
                <SelectorFase
                  grupos={standingGroups}
                  activo={grupo.label}
                  href={(label) => `/competencias/${competition.slug}?tabla=${encodeURIComponent(label)}`}
                />
              </header>
              <div class="p-3">
                <StandingsTable rows={grupo.rows} />
              </div>
            </section>
          ) : (
            <Card>
              <p class="text-sm text-ink-muted">
                La tabla estará disponible cuando arranque la competencia.
              </p>
            </Card>
          )
        }

      </div>

      {
        hayLideres && (
          <section class="rounded-xl border border-border bg-surface lg:col-start-1 lg:row-start-2 2xl:col-start-2 2xl:row-start-1">
            <header class="flex items-center gap-2 border-b border-border p-3">
              <h2 class="font-display text-base font-semibold uppercase">Los que deciden</h2>
              <span class="text-2xs text-ink-muted">temporada {seasonLabel}</span>
            </header>
            <div class="grid gap-x-6 gap-y-4 p-3 sm:grid-cols-2 2xl:grid-cols-1">
              <TablaLideres titulo="Goleadores" lideres={scorers} metrica="goals" filas={8} />
              <TablaLideres titulo="Asistencias" lideres={assisters} metrica="assists" filas={8} />
            </div>
          </section>
        )
      }

      <!--
        Los partidos van con los equipos apilados: en un riel de 23rem, enfrentados, los nombres se
        cortaban en "Sport Huanc…" y "Club Deporti…".
      -->
      <div
        class:list={[
          'grid gap-4 lg:col-start-2 lg:row-span-2 lg:row-start-1',
          hayLideres ? '2xl:col-start-3 2xl:row-span-1' : '',
        ]}
      >
        <section class="rounded-xl border border-border bg-surface p-3">
          <ListaPartidosCompacta
            titulo="Próximos partidos"
            icono="reloj"
            partidos={upcoming.slice(0, 7)}
            vacio="Sin partidos programados por ahora."
          />
        </section>
        <section class="rounded-xl border border-border bg-surface p-3">
          <ListaPartidosCompacta
            titulo="Últimos resultados"
            icono="cancha"
            partidos={recent.slice(0, 7)}
            vacio="Aún no hay resultados esta temporada."
          />
        </section>
        {
          once && (
            <OnceDeLaFecha once={once} logoUrl={competition.logoUrl} nombreLiga={competition.name} />
          )
        }
        <AvisoFavoritos />
      </div>
    </div>
  </Container>
</Base>
