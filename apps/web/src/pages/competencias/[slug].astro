---
import EscudoTorneo from '../../components/EscudoTorneo.astro';
import Base from '../../layouts/Base.astro';
import AvisoFavoritos from '../../components/AvisoFavoritos.astro';
import BotonFavorito from '../../components/BotonFavorito.astro';
import Card from '../../components/Card.astro';
import Container from '../../components/layout/Container.astro';
import CountryFlag from '../../components/CountryFlag.astro';
import BloqueGrupos from '../../components/competencia/BloqueGrupos.astro';
import Cuadro from '../../components/competencia/Cuadro.astro';
import ListaPartidosCompacta from '../../components/home/ListaPartidosCompacta.astro';
import OnceDelTorneo from '../../components/competencia/OnceDelTorneo.astro';
import SelectorFase from '../../components/SelectorFase.astro';
import SelectorTemporada from '../../components/competencia/SelectorTemporada.astro';
import StandingsTable from '../../components/StandingsTable.astro';
import OnceDeLaFecha from '../../components/home/OnceDeLaFecha.astro';
import TablaLideres from '../../components/TablaLideres.astro';
import { api, ApiError, type CompetitionView } from '../../lib/api';
import { paletaCompetencia } from '../../lib/coloresCompetencia';
import { getSession } from '../../lib/supabase';
import { nombreFase, paisEnEspanol } from '../../lib/paises';
import { etiquetaDeRonda } from '../../lib/rondas';

const { slug } = Astro.params;

/* El archivo pide la misma vista con otro año; sin el parámetro, la temporada vigente. */
const anioPedido = Astro.url.searchParams.get('temporada');
const temporadaPedida = /^\d{4}$/.test(anioPedido ?? '') ? anioPedido : null;

/* Los dos pedidos arrancan juntos: la sesión no depende de la competencia. */
const pedidoVista = api<CompetitionView>(
  `/views/competition/${slug}${temporadaPedida ? `?temporada=${temporadaPedida}` : ''}`,
);
const pedidoSesion = getSession(Astro);

let view: CompetitionView;
try {
  view = await pedidoVista;
} catch (error) {
  if (error instanceof ApiError && error.status === 404) return Astro.redirect('/404');
  throw error;
}
const session = await pedidoSesion;

const {
  competition,
  season,
  standingGroups,
  recent,
  upcoming,
  scorers,
  assisters,
  once,
  etapas,
  onceDelTorneo,
  seasons,
} = view;

/* Una copa trae etapas; una liga, solo su tabla. */
const esCopa = etapas.length > 0;
const hayGrupos = etapas.some((f) => f.etapa === 'grupos');

const TITULO_ETAPA: Record<string, string> = {
  final: 'Camino al título',
  previa: 'Fase previa',
  grupos: 'Fase de grupos',
};

/* Los paneles de la copa: el partido y el equipo se abren acá mismo, sin salir de la competencia. */
const enlacePartido = (id: string) => `/competencias/${competition.slug}?partido=${id}`;
const enlaceEquipoCopa = (slugEquipo: string) =>
  `/competencias/${competition.slug}?equipo=${slugEquipo}`;

const etiquetaTemporada = (year: number) =>
  competition.format === 'league' &&
  competition.country !== null &&
  !['Peru', 'Brazil', 'Argentina'].includes(competition.country)
    ? `${year}-${String(year + 1).slice(2)}`
    : String(year);
const seasonLabel = etiquetaTemporada(season.year);

/*
 * La copa internacional tiene identidad propia —y la Libertadores no se ve como una fecha de liga—,
 * así que la cabecera toma sus colores y el cuadro los usa como acento. Una liga no entra acá: la
 * paleta devuelve null y la página se ve como siempre.
 */
const paleta = paletaCompetencia(competition.slug);
/*
 * A color pleno, no como lavado que se funde con la pizarra: la mitad derecha desvanecida hacía
 * que la Libertadores pareciera una liga con el título pintado. El degradado se oscurece hacia la
 * izquierda, que es donde apoya el texto.
 */
const cabecera = paleta
  ? [
      `radial-gradient(110% 190% at 100% -40%, ${paleta.acento.suave(0.38)}, transparent 55%)`,
      `linear-gradient(115deg, color-mix(in oklab, ${paleta.base.base} 68%, #06060a) 0%, ${paleta.base.base} 82%)`,
    ].join(',')
  : null;

/*
 * La fase en juego viene primera del API y es la que se abre. Antes se mostraban todas las tablas
 * una debajo de la otra con su etiqueta en gris chico, así que la Liga 1 abría con el Apertura
 * —cerrado en mayo— y quien miraba creía estar viendo el Clausura.
 */
const fasePedida = Astro.url.searchParams.get('tabla');
const grupo = standingGroups.find((g) => g.label === fasePedida) ?? standingGroups[0];
const enlaceFase = (label: string) => {
  const params = new URLSearchParams({ tabla: label });
  if (temporadaPedida) params.set('temporada', temporadaPedida);
  return `/competencias/${competition.slug}?${params}`;
};

/*
 * La jornada ya viene traducida del API —"Octavos de final", "Fase de grupos · fecha 6"— porque el
 * vocabulario del proveedor es cosa del dominio y no de cada vista. Para una liga, que no pasa por
 * las reglas de copa, queda el nombre de la fase.
 */
const jornada = view.roundLabel ?? etiquetaDeRonda(view.round);

const pais = paisEnEspanol(competition.country);

/* Sin goleadores —una copa que nunca pasó por /players— la grilla vuelve a dos columnas: la del
   medio vacía dejaba un hueco de 400px en la mitad de la página. */
const hayLideres = scorers.length > 0 || assisters.length > 0;

/*
 * En una copa el once que importa es el del torneo, no el de la última fecha: responde "quién fue
 * este torneo" y además evita dos canchas en el mismo riel, que era exactamente lo que sobraba.
 */
const onceDelTorneoVisible = esCopa ? onceDelTorneo : null;

/*
 * Los ocho grupos de una copa se muestran juntos y compactos. Con el selector de fases se veía un
 * grupo de cuatro equipos estirado en mil píxeles y el resto de la columna vacía; así se lee la
 * fase entera de un golpe, que es lo que se quiere saber en una copa.
 */
const gruposJuntos = esCopa && standingGroups.length > 2;
const onceDeLaFechaVisible = onceDelTorneoVisible ? null : once;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SportsOrganization',
  name: competition.name,
  sport: 'Soccer',
  ...(competition.logoUrl ? { logo: competition.logoUrl } : {}),
};
---

<Base
  title={`${competition.name} ${seasonLabel} — Tabla de posiciones y partidos | Athena`}
  description={`Tabla de posiciones, resultados y próximos partidos de ${competition.name} temporada ${seasonLabel}.`}
  ogImage={competition.logoUrl}
  jsonLd={jsonLd}
  width="bleed"
  liveBar={false}
>
  <section
    class="relative w-full overflow-hidden border-b border-board-edge bg-board"
    style={cabecera ? `background-image:${cabecera}` : undefined}
  >
    <!-- El trofeo gigante de fondo: se sabe en qué copa se está sin leer el título. -->
    {
      paleta && competition.logoUrl && (
        <img
          src={competition.logoUrl}
          alt=""
          width="280"
          height="280"
          aria-hidden="true"
          class="pointer-events-none absolute -top-14 right-6 hidden size-72 opacity-15 md:block"
          style="mask-image:linear-gradient(115deg, transparent 25%, black 85%);filter:saturate(0) brightness(3)"
        />
      )
    }
    <Container width="wide" class="relative">
      <div class="flex flex-wrap items-center gap-x-5 gap-y-3 py-6">
        <EscudoTorneo
          url={competition.logoUrl}
          size={paleta ? 56 : 38}
          class={paleta ? '!rounded-xl !p-2.5 shadow-card' : '!rounded-lg !p-2'}
        />
        <div class="min-w-0 flex-1">
          {
            paleta && (
              <p
                class="mb-1 text-[10px] font-semibold uppercase tracking-label"
                style={`color:${paleta.acento.base}`}
              >
                {paleta.tono}
              </p>
            )
          }
          <h1
            class:list={[
              'font-display font-semibold uppercase leading-none text-chalk',
              paleta ? 'text-3xl sm:text-5xl' : 'text-3xl sm:text-4xl',
            ]}
          >
            {competition.name}
          </h1>
          <p class="mt-1.5 flex flex-wrap items-center gap-x-2 text-sm text-chalk-dim">
            <span class="flex items-center gap-1.5">
              <CountryFlag url={competition.flagUrl} name={pais} size={16} />
              {pais ?? 'Internacional'}
            </span>
            <span class="text-chalk/25">·</span>
            <span>Temporada {seasonLabel}</span>
            {
              jornada && (
                <>
                  <span class="text-chalk/25">·</span>
                  <span class="font-medium text-chalk">{jornada}</span>
                </>
              )
            }
          </p>
        </div>

        <BotonFavorito
          tipo="liga"
          id={competition.id}
          slug={competition.slug}
          nombre={competition.name}
          logoUrl={competition.logoUrl}
          pais={pais}
          banderaUrl={competition.flagUrl}
          variante="boton"
          conCuenta={session !== null}
          onBoard
          class="shrink-0"
        />
      </div>

      <!-- El archivo, pegado a la cabecera: es una propiedad de la competencia, no de la tabla. -->
      <SelectorTemporada
        temporadas={seasons}
        activa={season.year}
        slug={competition.slug}
        etiqueta={etiquetaTemporada}
        onBoard
        class="-mt-1 pb-4"
      />
    </Container>
  </section>

  <!--
    Tres zonas, y en pantallas anchas las tres en fila: tabla, los que deciden y los partidos. En
    una sola columna la tabla se estiraba hasta 1200px para poner nueve números, con un hueco en el
    medio entre el nombre del equipo y las cifras. En una copa, el color del torneo baja con la
    página como lavado: la identidad no se queda en la cabecera.
  -->
  <div
    class="w-full"
    style={paleta ? `background:linear-gradient(180deg, ${paleta.base.suave(0.1)}, transparent 44rem)` : undefined}
  >
  <Container width="wide" class="py-5">
    <div
      class:list={[
        'grid items-start gap-4 lg:grid-cols-[minmax(0,1fr)_23rem]',
        hayLideres ? '2xl:grid-cols-[minmax(0,1fr)_25rem_23rem]' : '',
      ]}
    >
      <div class="grid gap-4 lg:col-start-1 lg:row-start-1">
        <!--
          Las etapas en el orden que manda el API: primero la que se está jugando. Mientras van los
          octavos manda el cuadro; cuando arranca la fase de grupos de la temporada siguiente, manda
          la fase de grupos y el cuadro dice que todavía no está definido.
        -->
        {
          etapas.map((fase) =>
            fase.etapa === 'grupos' ? (
              <BloqueGrupos
                grupos={standingGroups}
                abierto={grupo}
                juntos={gruposJuntos}
                enJuego={fase.enJuego}
                hrefFase={enlaceFase}
                hrefEquipo={enlaceEquipoCopa}
              />
            ) : fase.rondas.length > 0 ? (
              <Cuadro
                rondas={fase.rondas}
                paleta={paleta}
                rondaActual={view.round}
                titulo={TITULO_ETAPA[fase.etapa] as string}
                hrefPartido={enlacePartido}
                hrefEquipo={enlaceEquipoCopa}
              />
            ) : (
              <Card>
                <p class="text-sm text-ink-muted">
                  El cuadro se define cuando termine la fase de grupos.
                </p>
              </Card>
            ),
          )
        }

        {
          !esCopa &&
            (grupo ? (
              <section class="rounded-xl border border-border bg-surface">
                <header class="flex flex-wrap items-center justify-between gap-2 border-b border-border p-3">
                  <h2 class="font-display text-base font-semibold uppercase">
                    Tabla de posiciones
                    {standingGroups.length === 1 && grupo.label && (
                      <span class="ml-1 font-sans text-2xs font-medium normal-case text-ink-muted">
                        {nombreFase(grupo.label)}
                      </span>
                    )}
                  </h2>
                  <SelectorFase grupos={standingGroups} activo={grupo.label} href={enlaceFase} />
                </header>
                <div class="p-3">
                  <StandingsTable rows={grupo.rows} />
                </div>
              </section>
            ) : (
              <Card>
                <p class="text-sm text-ink-muted">
                  La tabla estará disponible cuando arranque la competencia.
                </p>
              </Card>
            ))
        }
      </div>

      {
        hayLideres && (
          <section class="rounded-xl border border-border bg-surface lg:col-start-1 lg:row-start-2 2xl:col-start-2 2xl:row-start-1">
            <header class="flex items-center gap-2 border-b border-border p-3">
              <h2 class="font-display text-base font-semibold uppercase">Los que deciden</h2>
              <span class="text-2xs text-ink-muted">temporada {seasonLabel}</span>
            </header>
            <div class="grid gap-x-6 gap-y-4 p-3 sm:grid-cols-2 2xl:grid-cols-1">
              <TablaLideres titulo="Goleadores" lideres={scorers} metrica="goals" filas={8} />
              <TablaLideres titulo="Asistencias" lideres={assisters} metrica="assists" filas={8} />
            </div>
          </section>
        )
      }

      <!--
        Los partidos van con los equipos apilados: en un riel de 23rem, enfrentados, los nombres se
        cortaban en "Sport Huanc…" y "Club Deporti…".
      -->
      <div
        class:list={[
          'grid gap-4 lg:col-start-2 lg:row-span-2 lg:row-start-1',
          hayLideres ? '2xl:col-start-3 2xl:row-span-1' : '',
        ]}
      >
        {
          onceDelTorneoVisible && (
            <OnceDelTorneo
              once={onceDelTorneoVisible}
              paleta={paleta}
              temporada={seasonLabel}
            />
          )
        }
        <section class="rounded-xl border border-border bg-surface p-3">
          <ListaPartidosCompacta
            titulo="Próximos partidos"
            icono="reloj"
            partidos={upcoming.slice(0, 7)}
            vacio="Sin partidos programados por ahora."
          />
        </section>
        <section class="rounded-xl border border-border bg-surface p-3">
          <ListaPartidosCompacta
            titulo="Últimos resultados"
            icono="cancha"
            partidos={recent.slice(0, 7)}
            vacio="Aún no hay resultados esta temporada."
          />
        </section>
        {
          onceDeLaFechaVisible && (
            <OnceDeLaFecha
              once={onceDeLaFechaVisible}
              logoUrl={competition.logoUrl}
              nombreLiga={competition.name}
            />
          )
        }
        <AvisoFavoritos />
      </div>
    </div>
  </Container>
  </div>
</Base>
