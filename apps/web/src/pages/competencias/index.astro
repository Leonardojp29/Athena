---
import Icon from '../../components/Icon.astro';
import Base from '../../layouts/Base.astro';
import { getNavGroups } from '../../lib/nav';
import { paisEnEspanol } from '../../lib/paises';

const groups = await getNavGroups();
const total = groups.reduce((n, g) => n + g.competitions.length, 0);
---

<Base
  title="Competencias | Athena"
  description="Las competencias que Athena sigue: tablas, partidos y análisis por liga y copa."
  width="wide"
  liveBar={false}
>
  <header class="pb-6">
    <h1 class="font-display text-3xl font-semibold uppercase">Competencias</h1>
    <p class="mt-1 text-sm text-ink-muted">
      {total} torneos con tabla, calendario y análisis al día.
    </p>
  </header>

  <div class="grid gap-8">
    {
      groups.map((group) => (
        <section>
          <div class="mb-3 flex items-center gap-3">
            <h2 class="font-display text-lg font-semibold uppercase">{group.label}</h2>
            <span class="h-px flex-1 bg-border"></span>
            <span class="tabular text-2xs text-ink-muted">{group.competitions.length}</span>
          </div>

          <ul class="grid gap-2 sm:grid-cols-2 lg:grid-cols-3 2xl:grid-cols-4">
            {group.competitions.map((competition) => (
              <li>
                <a
                  href={`/competencias/${competition.slug}`}
                  class="group flex items-center gap-3 rounded-lg border border-border bg-surface p-3 transition-colors hover:border-border-strong hover:bg-canvas-subtle"
                >
                  <span class="flex size-10 shrink-0 items-center justify-center rounded-md bg-canvas-subtle">
                    {competition.logoUrl ? (
                      <img src={competition.logoUrl} alt="" width="26" height="26" loading="lazy" />
                    ) : (
                      <Icon name="estadio" size={18} class="text-ink-muted" />
                    )}
                  </span>
                  <span class="min-w-0">
                    <span class="block truncate font-medium">{competition.name}</span>
                    <span class="block truncate text-2xs text-ink-muted">
                      {paisEnEspanol(competition.country) ?? 'Internacional'}
                    </span>
                  </span>
                  <Icon
                    name="chevron-derecha"
                    size={16}
                    class="ml-auto shrink-0 text-ink-muted transition-transform group-hover:translate-x-0.5"
                  />
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</Base>
