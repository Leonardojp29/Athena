---
import Base from '../../layouts/Base.astro';
import { cachear } from '../../lib/cache';
import Container from '../../components/layout/Container.astro';
import ContinentIcon from '../../components/ContinentIcon.astro';
import Icon from '../../components/Icon.astro';
import TarjetaDeCompetencias from '../../components/competencia/TarjetaDeCompetencias.astro';
import { getNavTree, todasLasCompetencias } from '../../lib/nav';
import { paisEnEspanol } from '../../lib/paises';
import { migas } from '../../lib/seo';
import RielDeAnuncios from '../../components/anuncios/RielDeAnuncios.astro';

/*
 * El índice de competencias.
 *
 * Iba a `width="wide"` —mil novecientos veinte— mientras el resto del sitio topa en mil seiscientos,
 * así que en una pantalla grande era la única página pegada a los bordes. Ahora respira igual que
 * las demás.
 *
 * La cabecera dice de qué tamaño es el catálogo con cifras y no con una frase, y debajo va un
 * índice de continentes que salta a su sección: con doce países y seis continentes, bajar buscando
 * el suyo era el trabajo que esta página le pedía al lector.
 */
const arbol = await getNavTree();

cachear(Astro.response, 'catalogo');
const total = todasLasCompetencias(arbol).length;
const paises = arbol.clubes.reduce(
  (n, c) => n + c.countries.filter((p) => p.code !== null).length,
  0,
);
const torneosDeSelecciones = arbol.selecciones.reduce((n, c) => n + c.competitions.length, 0);

const cuantosEn = (continente: (typeof arbol.clubes)[number]) =>
  continente.competitions.length +
  continente.countries.reduce((n, p) => n + p.competitions.length, 0);

const torneos = (n: number) => `${n} ${n === 1 ? 'torneo' : 'torneos'}`;

const CIFRAS = [
  { valor: total, rotulo: total === 1 ? 'torneo' : 'torneos' },
  { valor: paises, rotulo: paises === 1 ? 'país' : 'países' },
  { valor: torneosDeSelecciones, rotulo: 'de selecciones' },
].filter((c) => c.valor > 0);

/* El ancla de cada sección, para el índice de arriba. */
const anclaDe = (clave: string) => `continente-${clave}`;
---

<Base
  title="Competencias | Athena"
  description="Todas las competencias que Athena sigue, por continente y país: tablas, calendario y análisis."
  jsonLd={migas([{ nombre: 'Competencias', ruta: '/competencias' }], Astro.site, new URL('/competencias', Astro.site).toString())}
  width="bleed"
  liveBar={false}
>
  <Container width="content" class="py-6 sm:py-8">
    <header class="border-b border-border pb-6">
      <h1 class="font-display text-4xl font-semibold uppercase leading-none tracking-label sm:text-5xl">
        Competencias
      </h1>
      <p class="mt-3 max-w-prose text-pretty text-sm leading-relaxed text-ink-muted">
        Todo lo que Athena sigue, con tabla, calendario y análisis al día.
      </p>

      <!-- Una lista y no un `<dl>`: la cifra y su rótulo se leen juntos, y un `<dl>` no admite
           texto suelto entre sus términos. -->
      <ul class="mt-5 flex flex-wrap items-end gap-x-8 gap-y-3">
        {
          CIFRAS.map((cifra) => (
            <li class="flex items-baseline gap-2">
              <span class="font-display text-3xl font-semibold tabular leading-none text-primary-ink">
                {cifra.valor}
              </span>
              <span class="text-2xs uppercase tracking-label text-ink-muted">{cifra.rotulo}</span>
            </li>
          ))
        }
      </ul>
    </header>

    <!-- El salto directo al continente: doce países no se recorren, se eligen. -->
    <nav class="flex flex-wrap gap-2 py-5" aria-label="Ir a un continente">
      {
        arbol.clubes.map((continente) => (
          <a
            href={`#${anclaDe(continente.continent)}`}
            class="flex items-center gap-2 rounded-full border border-border px-3 py-1.5 text-2xs font-medium uppercase tracking-label text-ink-muted transition-colors duration-200 hover:border-primary-ink hover:bg-canvas-subtle hover:text-ink"
          >
            <ContinentIcon name={continente.continent} size={14} />
            {continente.label}
            <span class="tabular text-ink-muted">{cuantosEn(continente)}</span>
          </a>
        ))
      }
      {
        torneosDeSelecciones > 0 && (
          <a
            href="#selecciones"
            class="flex items-center gap-2 rounded-full border border-border px-3 py-1.5 text-2xs font-medium uppercase tracking-label text-ink-muted transition-colors duration-200 hover:border-primary-ink hover:bg-canvas-subtle hover:text-ink"
          >
            <Icon name="bandera" size={14} />
            Selecciones
            <span class="tabular text-ink-muted">{torneosDeSelecciones}</span>
          </a>
        )
      }
    </nav>

    <div class="grid items-start gap-7 3xl:grid-cols-[minmax(0,1fr)_19rem]">
      <div class="grid min-w-0 gap-12">
        {
          arbol.clubes.map((continente) => (
            <section id={anclaDe(continente.continent)} class="scroll-mt-24">
              <div class="mb-5 flex items-center gap-3">
                <span class="grid size-9 shrink-0 place-items-center rounded-lg bg-primary text-primary-contrast">
                  <ContinentIcon name={continente.continent} size={20} />
                </span>
                <h2 class="font-display text-2xl font-semibold uppercase leading-none tracking-label">
                  {continente.label}
                </h2>
                <span class="h-px flex-1 bg-border" />
                <span class="tabular text-2xs uppercase tracking-label text-ink-muted">
                  {torneos(cuantosEn(continente))}
                </span>
              </div>

              <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
                {/*
                  Las copas de la confederación primero: la Libertadores es fútbol sudamericano y
                  antes no aparecía en este índice, aunque estuviera contada en el total de arriba.
                */}
                {continente.competitions.length > 0 && (
                  <TarjetaDeCompetencias
                    titulo={`Copas de ${continente.label}`}
                    logoUrl={continente.competitions[0]?.logoUrl ?? null}
                    competitions={continente.competitions}
                  />
                )}
                {continente.countries.map((pais) => (
                  <TarjetaDeCompetencias
                    titulo={paisEnEspanol(pais.name) ?? 'Internacional'}
                    flagUrl={pais.flagUrl}
                    code={pais.code}
                    competitions={pais.competitions}
                  />
                ))}
              </div>
            </section>
          ))
        }

        <!-- Las selecciones, al final y agrupadas por confederación: es como se habla de ellas. -->
        {
          arbol.selecciones.length > 0 && (
            <section id="selecciones" class="scroll-mt-24">
              <div class="mb-5 flex items-center gap-3">
                <span class="grid size-9 shrink-0 place-items-center rounded-lg bg-primary text-primary-contrast">
                  <Icon name="bandera" size={20} />
                </span>
                <h2 class="font-display text-2xl font-semibold uppercase leading-none tracking-label">
                  Selecciones
                </h2>
                <span class="h-px flex-1 bg-border" />
                <span class="tabular text-2xs uppercase tracking-label text-ink-muted">
                  {torneos(torneosDeSelecciones)}
                </span>
              </div>

              <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
                {arbol.selecciones.map((confederacion) => (
                  <TarjetaDeCompetencias
                    titulo={confederacion.label}
                    logoUrl={confederacion.competitions[0]?.logoUrl ?? null}
                    competitions={confederacion.competitions}
                  />
                ))}
              </div>
            </section>
          )
        }
      </div>

      <RielDeAnuncios ubicacion="competencias-riel" />
    </div>
  </Container>
</Base>
