---
import Base from '../../layouts/Base.astro';
import ContinentIcon from '../../components/ContinentIcon.astro';
import Icon from '../../components/Icon.astro';
import TarjetaDeCompetencias from '../../components/competencia/TarjetaDeCompetencias.astro';
import { getNavTree, todasLasCompetencias } from '../../lib/nav';
import { paisEnEspanol } from '../../lib/paises';

const arbol = await getNavTree();
const total = todasLasCompetencias(arbol).length;
const paises = arbol.clubes.reduce(
  (n, c) => n + c.countries.filter((p) => p.code !== null).length,
  0,
);
const torneosDeSelecciones = arbol.selecciones.reduce((n, c) => n + c.competitions.length, 0);
---

<Base
  title="Competencias | Athena"
  description="Todas las competencias que Athena sigue, por continente y país: tablas, calendario y análisis."
  width="wide"
  liveBar={false}
>
  <header class="pb-6">
    <h1 class="font-display text-3xl font-semibold uppercase">Competencias</h1>
    <p class="mt-1 text-sm text-ink-muted">
      {total} torneos de {paises} países, con tabla, calendario y análisis al día.
      {torneosDeSelecciones > 0 && ` Y ${torneosDeSelecciones} de selecciones.`}
    </p>
  </header>

  <div class="grid gap-10">
    {
      arbol.clubes.map((continente) => (
        <section>
          <div class="mb-4 flex items-center gap-3">
            <ContinentIcon name={continente.continent} size={20} class="text-primary-ink" />
            <h2 class="font-display text-xl font-semibold uppercase">{continente.label}</h2>
            <span class="h-px flex-1 bg-border" />
            <span class="tabular text-2xs text-ink-muted">
              {continente.competitions.length +
                continente.countries.reduce((n, p) => n + p.competitions.length, 0)}
            </span>
          </div>

          <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
            {/*
              Las copas de la confederación primero: la Libertadores es fútbol sudamericano y hasta
              ahora no aparecía en este índice, aunque estuviera contada en el total de arriba.
            */}
            {continente.competitions.length > 0 && (
              <TarjetaDeCompetencias
                titulo={`Copas de ${continente.label}`}
                logoUrl={continente.competitions[0]?.logoUrl ?? null}
                competitions={continente.competitions}
              />
            )}
            {continente.countries.map((pais) => (
              <TarjetaDeCompetencias
                titulo={paisEnEspanol(pais.name) ?? 'Internacional'}
                flagUrl={pais.flagUrl}
                code={pais.code}
                competitions={pais.competitions}
              />
            ))}
          </div>
        </section>
      ))
    }

    <!-- Las selecciones, al final y agrupadas por confederación: es como se habla de ellas. -->
    {
      arbol.selecciones.length > 0 && (
        <section>
          <div class="mb-4 flex items-center gap-3">
            <Icon name="bandera" size={20} class="text-primary-ink" />
            <h2 class="font-display text-xl font-semibold uppercase">Selecciones</h2>
            <span class="h-px flex-1 bg-border" />
            <span class="tabular text-2xs text-ink-muted">{torneosDeSelecciones}</span>
          </div>

          <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
            {arbol.selecciones.map((confederacion) => (
              <TarjetaDeCompetencias
                titulo={confederacion.label}
                logoUrl={confederacion.competitions[0]?.logoUrl ?? null}
                competitions={confederacion.competitions}
              />
            ))}
          </div>
        </section>
      )
    }
  </div>
</Base>
