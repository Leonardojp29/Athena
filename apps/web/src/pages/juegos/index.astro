---
import Base from '../../layouts/Base.astro';
import { cachear } from '../../lib/cache';
import Container from '../../components/layout/Container.astro';
import Icon from '../../components/Icon.astro';
import Hueco from '../../components/anuncios/Hueco.astro';
import '../../styles/juegos.css';

/*
 * El catálogo de juegos. Es una vitrina, no un folleto.
 *
 * Cuatro tarjetas grandes y nada más: ni banda de progreso, ni módulos sueltos, ni un párrafo de
 * presentación. Lo que cuenta de qué se trata es el propio juego, y una vitrina con cuatro piezas
 * no necesita que le expliquen qué es una vitrina.
 *
 * Eran cuatro columnas de tarjetas chicas en una página que sobraba de alto: la mitad inferior
 * quedaba en blanco y ninguna tarjeta se veía como algo en lo que entrar. Ahora son dos columnas y
 * cada una ocupa lo que merece.
 *
 * Va por el servidor como el resto del sitio: el header cuenta los partidos en vivo y el middleware
 * comprime leyendo la cabecera del pedido, y ninguna de las dos cosas existe en una página
 * prerendida. Sin islas: los juegos hidratan dentro de su propia ruta, no acá.
 */

cachear(Astro.response, 'dia');

interface Juego {
  nombre: string;
  linea: string;
  icono: 'juego' | 'formacion' | 'usuario' | 'reloj';
  href?: string;
  etiqueta?: string;
}

const JUEGOS: Juego[] = [
  {
    nombre: 'Mi Leyenda',
    linea: 'Crea un futbolista y vive su carrera entera, con clubes de verdad.',
    icono: 'juego',
    href: '/juegos/mi-leyenda',
    etiqueta: '3 min',
  },
  {
    nombre: 'Adivina el XI',
    linea: 'Te damos el partido; vos ponés los once que salieron a la cancha.',
    icono: 'formacion',
    href: '/juegos/adivina-el-xi',
    etiqueta: '2-5 min',
  },
  {
    nombre: 'El Impostor',
    linea: 'Seis futbolistas, uno se coló. Veinte segundos para encontrarlo.',
    icono: 'usuario',
    href: '/juegos/el-impostor',
    etiqueta: '20 s por ronda',
  },
  {
    nombre: '60 Segundos',
    linea: 'Un minuto y todas las preguntas que puedas responder.',
    icono: 'reloj',
    href: '/juegos/60-segundos',
    etiqueta: '60 s',
  },
];
---

<Base
  title="Juegos — Athena"
  description="Juegos de fútbol dentro de Athena. Crea un futbolista, adivina el once o encuentra al impostor, siempre con datos reales."
  width="bleed"
  liveBar={false}
>
  <Container width="content" class="py-8 sm:py-10">
    <!--
      Los anuncios van en los dos márgenes y solo desde 1800 px, donde sobra ancho de verdad: por
      debajo de eso aparecerían robándole sitio a las tarjetas en lugar de ocupando el hueco.
    -->
    <div class="grid items-start gap-8 3xl:grid-cols-[19rem_minmax(0,1fr)_19rem]">
      <div class="hidden 3xl:sticky 3xl:top-20 3xl:block">
        <Hueco medida="riel" ubicacion="juegos-izquierda" />
      </div>

      <div class="min-w-0">
        <header class="pb-7">
          <p class="text-2xs font-medium uppercase tracking-label text-primary-ink">
            Con los datos reales de Athena
          </p>
          <h1
            class="mt-2 font-display text-5xl font-semibold uppercase leading-none tracking-label sm:text-6xl"
          >
            Juegos
          </h1>
        </header>

        <ul class="grid gap-4 sm:grid-cols-2 sm:gap-5">
          {
            JUEGOS.map((juego, i) => {
              const Envoltura = juego.href ? 'a' : 'div';
              return (
                <li class="animate-juego-entra" style={`--turno:${i}`}>
                  <Envoltura
                    href={juego.href}
                    aria-disabled={juego.href ? undefined : 'true'}
                    class:list={[
                      'group relative flex h-full min-h-[15rem] flex-col overflow-hidden rounded-2xl border p-6 transition-[border-color,transform] duration-300 sm:min-h-[17rem] sm:p-7',
                      juego.href
                        ? 'cursor-pointer border-border bg-surface hover:-translate-y-1 hover:border-primary-ink'
                        : 'border-dashed border-border bg-transparent',
                    ]}
                  >
                    {/*
                      El icono otra vez, enorme y casi invisible detrás: le da carácter a la tarjeta
                      sin agregar nada que haya que leer. Decorativo y sin eventos.
                    */}
                    {juego.href && (
                      <span
                        aria-hidden="true"
                        class="pointer-events-none absolute -bottom-10 -right-8 text-primary-ink/[0.06] transition-transform duration-500 group-hover:-translate-y-2 group-hover:scale-105"
                      >
                        <Icon name={juego.icono} size={170} />
                      </span>
                    )}

                    <span
                      class:list={[
                        'relative grid size-14 place-items-center rounded-xl transition-transform duration-300',
                        juego.href
                          ? 'bg-primary text-primary-contrast group-hover:scale-105'
                          : 'bg-canvas-subtle text-ink-muted',
                      ]}
                    >
                      <Icon name={juego.icono} size={26} />
                    </span>

                    <span class="relative mt-5 block min-w-0">
                      <span class="block font-display text-2xl font-semibold uppercase leading-tight tracking-label sm:text-3xl">
                        {juego.nombre}
                      </span>
                      <span class="mt-2 block max-w-[34ch] text-pretty text-sm leading-relaxed text-ink-muted">
                        {juego.linea}
                      </span>
                    </span>

                    <span class="relative mt-auto flex items-center gap-2 pt-6 text-2xs font-medium uppercase tracking-label">
                      {juego.href ? (
                        <>
                          <span class="flex items-center gap-1.5 text-primary-ink">
                            Jugar
                            <Icon
                              name="chevron-derecha"
                              size={14}
                              class="transition-transform duration-300 group-hover:translate-x-1"
                            />
                          </span>
                          <span class="text-ink-muted">· {juego.etiqueta}</span>
                        </>
                      ) : (
                        <span class="text-ink-muted">Pronto</span>
                      )}
                    </span>
                  </Envoltura>
                </li>
              );
            })
          }
        </ul>
      </div>

      <div class="hidden 3xl:sticky 3xl:top-20 3xl:block">
        <Hueco medida="riel" ubicacion="juegos-derecha" />
      </div>
    </div>
  </Container>
</Base>
