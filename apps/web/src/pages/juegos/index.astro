---
import Base from '../../layouts/Base.astro';
import { cachear } from '../../lib/cache';
import Container from '../../components/layout/Container.astro';
import Icon from '../../components/Icon.astro';
import TuCarrera from '../../components/juego/TuCarrera';
import TuRacha from '../../components/juego/TuRacha';
import '../../styles/leyenda.css';

/*
 * El catálogo de juegos. Es una vitrina, no un folleto.
 *
 * La versión anterior era un párrafo de presentación, una tarjeta gigante con tres pasos numerados y
 * cuatro números grandes: mucho texto para decir "hay un juego". Acá caben cuatro o seis juegos en
 * una sola mirada, todos del mismo tamaño, cada uno con su nombre, una línea y su estado. Lo que
 * cuenta de qué se trata es el propio juego, no esta página.
 *
 * Va por el servidor como el resto del sitio: el header cuenta los partidos en vivo y el middleware
 * comprime leyendo la cabecera del pedido, y ninguna de las dos cosas existe en una página prerendida.
 */

cachear(Astro.response, 'dia');

interface Juego {
  nombre: string;
  linea: string;
  icono: 'juego' | 'formacion' | 'usuario' | 'estrella';
  href?: string;
  etiqueta?: string;
}

const JUEGOS: Juego[] = [
  {
    nombre: 'Mi Leyenda',
    linea: 'Crea un futbolista y vive su carrera entera, con clubes de verdad.',
    icono: 'juego',
    href: '/juegos/mi-leyenda',
    etiqueta: '3 min',
  },
  {
    nombre: 'Adivina el XI',
    linea: 'Te damos el partido; vos ponés los once que salieron a la cancha.',
    icono: 'formacion',
    href: '/juegos/adivina-el-xi',
    etiqueta: '2-5 min',
  },
  {
    nombre: 'El Impostor',
    linea: 'Seis futbolistas, uno se coló. Veinte segundos para encontrarlo.',
    icono: 'usuario',
    href: '/juegos/el-impostor',
    etiqueta: '20 s por ronda',
  },
  { nombre: 'El desafío del día', linea: 'Un reto nuevo cada mañana, el mismo para todo el mundo.', icono: 'estrella' },
];
---

<Base
  title="Juegos — Athena"
  description="Juegos de fútbol dentro de Athena. Crea un futbolista, vive su carrera y quédate con la carta de toda tu vida."
  width="bleed"
  liveBar={false}
>
  <Container width="wide" class="py-6 sm:py-8">
    <header class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
      <h1 class="font-display text-3xl font-semibold uppercase leading-none tracking-label">Juegos</h1>
      <p class="text-sm text-ink-muted">Con los datos reales de Athena.</p>
    </header>

    <!-- Lo tuyo: la carrera abierta. Sale del navegador, así que se hidrata. -->
    <TuCarrera client:load />
    <TuRacha client:load />

    <ul class="mt-4 grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
      {
        JUEGOS.map((juego) => {
          const Envoltura = juego.href ? 'a' : 'div';
          return (
            <li>
              <Envoltura
                href={juego.href}
                aria-disabled={juego.href ? undefined : 'true'}
                class:list={[
                  'group flex h-full flex-col gap-3 rounded-xl border p-4 transition-[colors,transform,box-shadow] duration-200',
                  juego.href
                    ? 'cursor-pointer border-border bg-surface hover:-translate-y-0.5 hover:border-primary-ink hover:shadow-magnet'
                    : 'border-dashed border-border',
                ]}
              >
                <span
                  class:list={[
                    'grid size-10 place-items-center rounded-lg transition-transform duration-300',
                    juego.href
                      ? 'bg-primary text-primary-contrast group-hover:scale-105'
                      : 'bg-canvas-subtle text-ink-muted',
                  ]}
                >
                  <Icon name={juego.icono} size={20} />
                </span>

                <span class="min-w-0">
                  <span class="block font-display text-xl font-semibold uppercase leading-tight tracking-label">
                    {juego.nombre}
                  </span>
                  <span class="mt-1 block text-sm leading-snug text-ink-muted">{juego.linea}</span>
                </span>

                <span class="mt-auto flex items-center gap-1.5 pt-1 text-2xs font-medium uppercase tracking-label">
                  {
                    juego.href ? (
                      <>
                        <span class="text-primary-ink">Jugar</span>
                        <span class="text-ink-muted">· {juego.etiqueta}</span>
                      </>
                    ) : (
                      <span class="text-ink-muted">Pronto</span>
                    )
                  }
                </span>
              </Envoltura>
            </li>
          );
        })
      }
    </ul>
  </Container>
</Base>
