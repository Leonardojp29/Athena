---
import Base from '../../layouts/Base.astro';
import MiLeyenda from '../../components/juego/MiLeyenda';
import { api } from '../../lib/api';
import { cachear, sinCache } from '../../lib/cache';
import { aligerar } from '../../lib/mundo';
import type { Mundo } from '@athena/leyenda';
import '../../styles/leyenda.css';

/*
 * El juego a pantalla limpia: `chrome="minimal"` quita la banda de partidos y el pie, que acá compiten
 * con la carrera. El header queda —el juego vive dentro de Athena, no en un iframe— y con él la salida.
 *
 * El HTML es igual para todos —la partida vive en el navegador—, así que se guarda en el borde un día.
 * Cuando el mundo no llega, el 503 y el `no-store` evitan que el borde grabe la página de disculpa.
 */
let mundo: Mundo | null = null;
try {
  mundo = await api<Mundo>('/views/mundo');
} catch {
  mundo = null;
}

const hayMundo = mundo !== null && mundo.ligas.length > 0;
if (hayMundo) {
  cachear(Astro.response, 'juego');
} else {
  Astro.response.status = 503;
  sinCache(Astro.response);
}

const anio = new Date().getFullYear();
---

<Base
  title="Mi Leyenda — Athena"
  description="Crea un futbolista y vive su carrera entera con clubes reales: debut, goles, fichajes, prensa, retiro y la carta de toda tu vida."
  chrome="minimal"
  width="bleed"
  liveBar={false}
>
  {
    hayMundo && mundo ? (
      <MiLeyenda client:load mundo={aligerar(mundo)} anio={anio} />
    ) : (
      <div class="mx-auto max-w-md px-4 py-16 text-center">
        <h1 class="font-display text-2xl font-semibold uppercase tracking-label">Mi Leyenda</h1>
        <p class="mt-2 text-sm text-ink-muted">
          No pudimos cargar el mundo de clubes. Intenta de nuevo en un momento.
        </p>
        <a
          href="/juegos"
          class="mt-4 inline-block rounded-md border border-border-strong px-4 py-2 text-sm font-medium transition-colors hover:bg-canvas-subtle"
        >
          Volver a Juegos
        </a>
      </div>
    )
  }
</Base>
