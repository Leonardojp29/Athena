---
import EscudoTorneo from '../../components/EscudoTorneo.astro';
import RefrescoDeMarcadores from '../../components/RefrescoDeMarcadores.astro';
import { isLive } from '../../lib/format';
import Base from '../../layouts/Base.astro';
import { cachear } from '../../lib/cache';
import AvisoFavoritos from '../../components/AvisoFavoritos.astro';
import BotonFavorito from '../../components/BotonFavorito.astro';
import Card from '../../components/Card.astro';
import Container from '../../components/layout/Container.astro';
import Hueco from '../../components/anuncios/Hueco.astro';
import FichaEstadio from '../../components/team/FichaEstadio.astro';
import Icon from '../../components/Icon.astro';
import CountryFlag from '../../components/CountryFlag.astro';
import ListaPartidosCompacta from '../../components/home/ListaPartidosCompacta.astro';
import SquadGrid from '../../components/team/SquadGrid.astro';
import TablaPlantel from '../../components/team/TablaPlantel.astro';
import AltasYBajas from '../../components/mercado/AltasYBajas.astro';
import { api, ApiError, type SearchHit, type TeamView } from '../../lib/api';
import { coloresDeClub, temaEquipo } from '../../lib/color';
import { nombreFase, nombreTorneo, paisEnEspanol } from '../../lib/paises';
import { absoluta, identidad, migas, nodoCompetencia, nodoEquipo } from '../../lib/seo';

const { slug } = Astro.params;

/*
 * Los tres pedidos arrancan juntos y se esperan después: ninguno necesita el resultado de otro y
 * en serie cada uno sumaba su viaje a Supabase. Los equipos similares dependen de embeddings, así
 * que si todavía no existen la sección no se muestra.
 */
const pedidoVista = api<TeamView>(`/views/team/${slug}`);
const pedidoSimilar = api<{ results: SearchHit[] }>(`/search/similar/team/${slug}`)
  .then((r) => r.results)
  .catch(() => [] as SearchHit[]);

let view: TeamView;
try {
  view = await pedidoVista;
} catch (error) {
  if (error instanceof ApiError && error.status === 404) {
    /* El slug cambió: se redirige al nuevo en lugar de decir que no existe. */
    const mudado = error.body?.movedTo;
    return mudado ? Astro.redirect(`/equipos/${mudado}`, 301) : Astro.rewrite('/404');
  }
  throw error;
}

const { team, standings, recent, upcoming, squad, scorers, mercado } = view;

/* Con un partido suyo en juego, el marcador de esta página se mantiene solo. Sin eso, 0 KB. */
const hayEnVivo = [...recent, ...upcoming].some((m) => isLive(m.status));
cachear(Astro.response, hayEnVivo ? 'partidoEnJuego' : 'equipo');
const hoyEnLima = new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Lima' }).format(new Date());
const similar = await pedidoSimilar;

const pais = paisEnEspanol(team.country);

/*
 * La camiseta como superficie: la cabecera entera es del color del club y la tinta la decide la
 * luminancia. El lavado tiñe el resto de la página, así que estar en Alianza se nota desde
 * cualquier scroll, no solo en el título.
 */
const tema = temaEquipo(...coloresDeClub(team.slug, team.primaryColor, team.secondaryColor));

/* Las variables alimentan las clases de la cabecera; sin tema, los valores de la pizarra. */
const varsCabecera = tema
  ? `background-image:${tema.fondo};--tinta:${tema.tinta};--tinta-suave:${tema.tintaSuave};--tinta-tenue:${tema.tintaTenue};--linea:${tema.linea};--chip:${tema.chip};--fondo-solido:${tema.lavado(0.97)}`
  : '--tinta:var(--color-chalk);--tinta-suave:var(--color-chalk-dim);--tinta-tenue:color-mix(in oklab, var(--color-chalk) 30%, transparent);--linea:color-mix(in oklab, var(--color-chalk) 16%, transparent);--chip:color-mix(in oklab, var(--color-chalk) 10%, transparent);--fondo-solido:var(--color-board)';

/* El API manda la fase en juego primero: la primera fila es "cómo va hoy". */
const principal = standings[0] ?? null;

const FORMA: Record<string, { letra: string; clase: string; titulo: string }> = {
  W: { letra: 'V', clase: 'bg-primary text-primary-contrast', titulo: 'Victoria' },
  D: { letra: 'E', clase: 'bg-border-strong text-ink', titulo: 'Empate' },
  L: { letra: 'D', clase: 'bg-card-red/85 text-chalk', titulo: 'Derrota' },
};
const ultimos = (form: string | null) =>
  form === null ? [] : [...form.slice(0, 5)].reverse().flatMap((c) => FORMA[c] ?? []);

const rutaEquipo = `/equipos/${team.slug}`;
const urlEquipo = absoluta(rutaEquipo, Astro.site);
const paisDelClub = team.country ? paisEnEspanol(team.country) : null;

/* El torneo en curso: el que la tabla de la derecha muestra primero. */
const torneoActual = standings[0]?.season.competition ?? null;
const posicionActual = standings[0]?.position ?? null;

/*
 * Dos clubes "Nacional" de países distintos tenían título y descripción idénticos byte a byte. El
 * país desempata, y la posición dice algo que la plantilla sola no decía.
 */
const tituloEquipo = `${team.name}${paisDelClub ? ` (${paisDelClub})` : ''} — Partidos, resultados y posición | Athena`;
const descripcionEquipo = [
  `Resultados recientes, próximos partidos y plantel de ${team.name}`,
  paisDelClub ? ` de ${paisDelClub}` : '',
  torneoActual && posicionActual
    ? `. Va ${posicionActual}.º en ${nombreTorneo(torneoActual.name)}.`
    : '.',
].join('');

const plantel = squad.lines
  .flatMap((linea) => linea.players)
  .flatMap(({ player }) => {
    if (!player.slug) return [];
    const url = absoluta(`/jugadores/${player.slug}`, Astro.site);
    return [{ '@type': 'Person', '@id': identidad(url, 'jugador'), url, name: player.name }];
  })
  .slice(0, 40);

const jsonLd = [
  {
    ...nodoEquipo(team, Astro.site),
    ...(team.founded ? { foundingDate: String(team.founded) } : {}),
    ...(paisDelClub ? { areaServed: paisDelClub } : {}),
    ...(torneoActual ? { memberOf: nodoCompetencia(torneoActual, Astro.site) } : {}),
    /* El plantel ya viajó para dibujarse: declararlo no cuesta una consulta más. */
    ...(plantel.length > 0 ? { athlete: plantel } : {}),
    /* La dirección del estadio no se muestra —es postal y viene a medias—, pero acá sí sirve. */
    ...(team.venue
      ? {
          location: {
            '@type': 'StadiumOrArena',
            name: team.venue.name,
            ...(team.venue.capacity ? { maximumAttendeeCapacity: team.venue.capacity } : {}),
            ...(team.venue.address || team.venue.city
              ? {
                  address: {
                    '@type': 'PostalAddress',
                    ...(team.venue.address ? { streetAddress: team.venue.address } : {}),
                    ...(team.venue.city ? { addressLocality: team.venue.city } : {}),
                  },
                }
              : {}),
          },
        }
      : {}),
  },
  migas(
    torneoActual
      ? [
          { nombre: 'Competencias', ruta: '/competencias' },
          { nombre: torneoActual.name, ruta: `/competencias/${torneoActual.slug}` },
          { nombre: team.name, ruta: rutaEquipo },
        ]
      : [{ nombre: team.name, ruta: rutaEquipo }],
    Astro.site,
    urlEquipo,
  ),
];
---

<Base
  title={tituloEquipo}
  description={descripcionEquipo}
  ogImage={team.logoUrl}
  jsonLd={jsonLd}
  width="bleed"
  liveBar={false}
>
  <!--
    La cabecera carga el resumen: escudo, nombre y cómo va. Antes las cifras estaban dentro de una
    tarjeta más abajo, y había que buscar en qué puesto va el equipo que fuiste a ver.
  -->
  {tema && <span class="block h-1.5 w-full" style={`background:${tema.franja}`} aria-hidden="true" />}
  <section class="relative w-full overflow-hidden border-b-[3px] border-b-primary bg-banda" style={varsCabecera}>
    <!-- El escudo gigante de fondo, desvanecido hacia el texto: se sabe dónde se está sin leer nada. -->
    {
      team.logoUrl && (
        <img
          src={team.logoUrl}
          alt=""
          width="260"
          height="260"
          aria-hidden="true"
          fetchpriority="high"
          class="pointer-events-none absolute -top-16 right-6 hidden size-80 opacity-[0.18] md:block lg:size-96"
          style="mask-image:linear-gradient(115deg, transparent 20%, black 80%)"
        />
      )
    }
    <Container width="content" class="relative">
      <div class="flex flex-wrap items-end gap-x-6 gap-y-4 py-6">
        <div class="flex min-w-0 flex-1 items-center gap-4">
          {
            team.logoUrl && (
              <!-- El escudo casi llena la plaquita: con más aire adentro se veía un cuadrado blanco
                   con un escudo perdido en el medio. -->
              <span class="grid size-[4.5rem] shrink-0 place-items-center rounded-2xl bg-chalk p-1.5 shadow-card ring-1 ring-(--linea) sm:size-24 sm:p-2">
                <img
                  src={team.logoUrl}
                  alt={`Escudo de ${team.name}`}
                  width="80"
                  height="80"
                  fetchpriority="high"
                  class="size-full object-contain"
                />
              </span>
            )
          }
          <div class="min-w-0">
            <h1 class="font-display text-3xl font-semibold uppercase leading-none text-(--tinta) sm:text-5xl">
              {team.name}
            </h1>
            <p class="mt-2 flex flex-wrap items-center gap-x-2 text-sm text-(--tinta-suave)">
              <span class="flex items-center gap-1.5">
                <CountryFlag name={pais} size={16} />
                {pais ?? 'Internacional'}
              </span>
              {
                team.founded !== null && (
                  <>
                    <span class="text-(--tinta-tenue)">·</span>
                    <span>Fundado en {team.founded}</span>
                  </>
                )
              }
            </p>
          </div>
        </div>

        {
          principal && (
            <div class="flex flex-wrap items-end gap-x-6 gap-y-3">
              <div>
                <p class="font-display text-3xl font-semibold leading-none tabular text-(--tinta)">
                  {`${principal.position}º`}
                </p>
                <p class="mt-1 truncate text-2xs uppercase tracking-label text-(--tinta-suave)">
                  {nombreTorneo(principal.season.competition.name)}
                  {principal.groupLabel ? ` · ${nombreFase(principal.groupLabel)}` : ''}
                </p>
              </div>
              {[
                { valor: principal.points, etiqueta: 'puntos' },
                { valor: principal.played, etiqueta: 'jugados' },
                { valor: `${principal.won}-${principal.drawn}-${principal.lost}`, etiqueta: 'G-E-P' },
                {
                  valor: principal.goalsFor - principal.goalsAgainst,
                  etiqueta: 'diferencia',
                },
              ].map((cifra) => (
                <div>
                  <p class="font-display text-xl font-semibold leading-none tabular text-(--tinta)">
                    {cifra.valor}
                  </p>
                  <p class="mt-1 text-2xs uppercase tracking-label text-(--tinta-suave)">
                    {cifra.etiqueta}
                  </p>
                </div>
              ))}
              {ultimos(principal.form).length > 0 && (
                <div>
                  <span class="flex gap-0.5">
                    {ultimos(principal.form).map((r) => (
                      <span
                        class:list={[
                          'grid size-4 place-items-center rounded-[2px] text-[9px] font-bold',
                          r.clase,
                        ]}
                        title={r.titulo}
                      >
                        {r.letra}
                      </span>
                    ))}
                  </span>
                  <p class="mt-1 text-2xs uppercase tracking-label text-(--tinta-suave)">forma</p>
                </div>
              )}
            </div>
          )
        }

        <a
          href={`/comparar?tipo=equipo&a=${team.slug}`}
          class="flex shrink-0 items-center gap-1.5 whitespace-nowrap rounded-md bg-(--chip) px-2.5 py-1.5 text-2xs font-medium text-(--tinta) ring-1 ring-inset ring-(--linea) transition-opacity hover:opacity-80"
        >
          <Icon name="formacion" size={13} />
          Comparar
        </a>
        <BotonFavorito
          tipo="equipo"
          id={team.id}
          slug={team.slug}
          nombre={team.name}
          logoUrl={team.logoUrl}
          pais={pais}
          variante="boton"
          onBoard
          class="shrink-0 !border-(--linea) !text-(--tinta) hover:!border-(--tinta-suave) aria-pressed:!border-(--tinta) aria-pressed:!bg-(--chip) aria-pressed:!text-(--tinta)"
        />
      </div>
    </Container>
  </section>

  <!-- El lavado del club baja con la página: la pertenencia no se queda en la cabecera. -->
  <div class="w-full" style={tema ? `background:linear-gradient(180deg, ${tema.lavado(0.07)}, transparent 38rem)` : undefined}>
  <Container width="content" class="pt-7 pb-5">
    <div class="grid items-start gap-7 lg:grid-cols-[minmax(0,1fr)_22rem]">
      <div class="grid gap-4">
        <!--
          Los partidos van en dos columnas angostas con los equipos apilados. A media pantalla, una
          fila de partido se estiraba mil píxeles para poner dos nombres y un marcador.
        -->
        <section class="grid gap-x-5 gap-y-4 rounded-xl border border-border bg-surface p-3 sm:grid-cols-2">
          {
            upcoming.length > 0 ? (
              <ListaPartidosCompacta
                titulo="Próximos partidos"
                icono="reloj"
                partidos={upcoming.slice(0, 6)}
                destacado={team.slug}
              />
            ) : (
              <p class="text-sm text-ink-muted">Sin partidos programados.</p>
            )
          }
          {
            recent.length > 0 ? (
              <ListaPartidosCompacta
                titulo="Últimos resultados"
                icono="cancha"
                partidos={recent.slice(0, 6)}
                destacado={team.slug}
              />
            ) : (
              <p class="text-sm text-ink-muted">Aún no hay resultados registrados.</p>
            )
          }
        </section>

        {scorers.length > 0 && <TablaPlantel jugadores={scorers} />}

        <AltasYBajas altas={mercado.altas} bajas={mercado.bajas} />

        <SquadGrid squad={squad} />
      </div>

      <div class="grid gap-4">
        {
          standings.length > 0 && (
            <Card title="Torneos de la temporada">
              <ul class="grid gap-0.5">
                {standings.map((row) => (
                  <li>
                    <a
                      href={`/competencias/${row.season.competition.slug}`}
                      class="flex items-center gap-2 rounded-md px-1.5 py-1.5 transition-colors hover:bg-canvas-subtle"
                    >
                      <EscudoTorneo url={row.season.competition.logoUrl} size={17} />
                      <span class="min-w-0 flex-1">
                        <span class="block truncate text-sm">
                          {nombreTorneo(row.season.competition.name)}
                        </span>
                        {row.groupLabel && (
                          <span class="block truncate text-2xs text-ink-muted">
                            {nombreFase(row.groupLabel)}
                          </span>
                        )}
                      </span>
                      <span class="shrink-0 text-right">
                        <span class="block font-display text-base font-semibold leading-none tabular">
                          {row.position}º
                        </span>
                        <span class="block text-2xs text-ink-muted tabular">{row.points} pts</span>
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </Card>
          )
        }

        {
          similar.length > 0 && (
            <Card title="Equipos con perfil parecido">
              <ul class="grid gap-0.5">
                {similar.map((hit) => (
                  <li>
                    <a
                      href={`/equipos/${hit.slug}`}
                      class="flex items-center gap-2 rounded-md px-1.5 py-1.5 text-sm transition-colors hover:bg-canvas-subtle"
                    >
                      {hit.imageUrl && (
                        <img src={hit.imageUrl} alt="" width="20" height="20" loading="lazy" />
                      )}
                      <span class="truncate">{hit.name}</span>
                      {hit.subtitle && (
                        <span class="ml-auto shrink-0 text-2xs text-ink-muted">
                          {paisEnEspanol(hit.subtitle)}
                        </span>
                      )}
                    </a>
                  </li>
                ))}
              </ul>
            </Card>
          )
        }

        {/* Una selección no tiene casa: el estadio que manda el proveedor es donde jugó la última vez. */}
        {team.venue && !team.isNationalTeam && (
          <FichaEstadio venue={team.venue} vars={varsCabecera} />
        )}

        <AvisoFavoritos />

        <!-- Solo cuando es de verdad un costado: apilada, esta columna cae en medio del contenido. -->
        <Hueco medida="bloque" ubicacion="equipo-riel" class="mt-1 max-lg:hidden" />
      </div>
    </div>
  </Container>
  </div>
  {hayEnVivo && <RefrescoDeMarcadores dia={hoyEnLima} />}
</Base>
