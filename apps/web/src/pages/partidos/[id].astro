---
import Base from '../../layouts/Base.astro';
import Container from '../../components/layout/Container.astro';
import Icon from '../../components/Icon.astro';
import InsightCard from '../../components/InsightCard.astro';
import MatchCenter from '../../components/MatchCenter';
import Suplentes from '../../components/match/Suplentes.astro';
import MatchStatistics from '../../components/MatchStatistics.astro';
import MatchTabs, { type Tab } from '../../components/match/MatchTabs.astro';
import PlayerStatsTable from '../../components/match/PlayerStatsTable.astro';
import PitchLineups from '../../components/pitch/PitchLineups.astro';
import PlayerSheet from '../../components/pitch/PlayerSheet.astro';
import PreviewCard from '../../components/PreviewCard.astro';
import { api, ApiError, type MatchView } from '../../lib/api';
import { formatDateLong, isLive } from '../../lib/format';

const { id } = Astro.params;
let match: MatchView;
try {
  match = await api<MatchView>(`/views/match/${id}`);
} catch (error) {
  if (error instanceof ApiError && (error.status === 404 || error.status === 400))
    return Astro.redirect('/404');
  throw error;
}

const hasScore = match.homeScore !== null && match.awayScore !== null;
const title = `${match.homeTeam.name} vs ${match.awayTeam.name}${hasScore ? ` (${match.homeScore}-${match.awayScore})` : ''}`;

// isla viva solo si el partido está en juego o arranca dentro de 3 horas
const startsSoon =
  match.status === 'scheduled' &&
  new Date(match.kickoffUtc).getTime() - Date.now() < 3 * 3600_000 &&
  new Date(match.kickoffUtc).getTime() - Date.now() > -4 * 3600_000;
const live = isLive(match.status) || startsSoon;

const hayAlineaciones = match.lineups.length > 0;
const hayEstadisticas = match.statistics.length > 0 || match.playerStatistics.length > 0;
const analisis = match.insight ?? match.preview;

const TABS: Tab[] = [
  { id: 'resumen', label: 'Resumen' },
  { id: 'alineaciones', label: 'Alineaciones', disabled: !hayAlineaciones },
  { id: 'estadisticas', label: 'Estadísticas', disabled: !hayEstadisticas },
  { id: 'analisis', label: 'Análisis', disabled: analisis === null },
];

const pedida = Astro.url.searchParams.get('vista') ?? 'resumen';
const vista = TABS.find((t) => t.id === pedida && !t.disabled) ? pedida : 'resumen';
const baseUrl = `/partidos/${match.id}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SportsEvent',
  name: title,
  sport: 'Soccer',
  startDate: match.kickoffUtc,
  homeTeam: { '@type': 'SportsTeam', name: match.homeTeam.name },
  awayTeam: { '@type': 'SportsTeam', name: match.awayTeam.name },
  ...(match.venue ? { location: { '@type': 'Place', name: match.venue.name } } : {}),
};
---

<Base
  title={`${title} — ${match.season.competition.name} | Athena`}
  description={`${title}: marcador${live ? ' en vivo' : ''}, alineaciones, rendimiento por jugador y análisis del partido de ${match.season.competition.name}.`}
  jsonLd={jsonLd}
  width="bleed"
  liveBar={false}
>
  <!-- El marcador a sangre sobre la pizarra: vive fuera de las pestañas porque nunca cambia de sección. -->
  <section class="w-full border-b border-board-edge bg-board">
    <Container width="wide">
      <div class="flex flex-wrap items-center justify-between gap-2 pt-4 text-2xs text-chalk-dim">
        <a
          href={`/competencias/${match.season.competition.slug}`}
          class="flex items-center gap-1.5 transition-colors hover:text-primary"
        >
          {match.season.competition.logoUrl && (
            <img src={match.season.competition.logoUrl} alt="" width="14" height="14" />
          )}
          {match.season.competition.name}
          {match.round && <span>· {match.round}</span>}
        </a>
        <span class="flex items-center gap-3">
          <span class="flex items-center gap-1.5">
            <Icon name="reloj" size={12} />
            <span class="first-letter:uppercase">{formatDateLong(match.kickoffUtc)}</span>
          </span>
          {match.venue && (
            <span class="flex items-center gap-1.5">
              <Icon name="estadio" size={12} />
              {match.venue.name}
              {match.venue.city && <span>· {match.venue.city}</span>}
            </span>
          )}
        </span>
      </div>

      {
        live ? (
          <MatchCenter client:load initial={match} live part="hero" />
        ) : (
          <MatchCenter initial={match} live={false} part="hero" />
        )
      }
    </Container>
  </section>

  <Container width="wide" class="pt-3">
    <h1 class="sr-only">{title}</h1>
    <MatchTabs tabs={TABS} active={vista} baseUrl={baseUrl} />

    <!--
      En la vista de alineaciones la cancha define su propio ancho (la altura la limita), así
      que la columna se ajusta a ella y el par se centra. Con `1fr` quedaba un hueco muerto de
      200px a la izquierda de la cancha.
    -->
    <div
      class:list={[
        'mt-4 grid items-start gap-4',
        vista === 'alineaciones'
          ? 'lg:grid-cols-[auto_20rem] lg:justify-center'
          : 'lg:grid-cols-[minmax(0,1fr)_20rem]',
      ]}
    >
      <div class="grid min-w-0 gap-4">
        {
          vista === 'resumen' && (
            <section>
              <h2 class="mb-2 font-display text-base font-semibold uppercase">Minuto a minuto</h2>
              {live ? (
                <MatchCenter client:load initial={match} live part="timeline" />
              ) : (
                <MatchCenter initial={match} live={false} part="timeline" />
              )}
            </section>
          )
        }

        {
          vista === 'alineaciones' && (
            <PitchLineups
              lineups={match.lineups}
              playerStatistics={match.playerStatistics}
              homeTeam={match.homeTeam}
              awayTeam={match.awayTeam}
            />
          )
        }

        {
          vista === 'estadisticas' && (
            <div class="grid gap-4 2xl:grid-cols-[22rem_minmax(0,1fr)] 2xl:items-start">
              <MatchStatistics
                statistics={match.statistics}
                homeTeam={match.homeTeam}
                awayTeam={match.awayTeam}
              />
              {match.playerStatistics.length > 0 ? (
                <section>
                  <h2 class="mb-2 font-display text-base font-semibold uppercase">
                    Rendimiento individual
                  </h2>
                  <PlayerStatsTable
                    playerStatistics={match.playerStatistics}
                    homeTeam={match.homeTeam}
                    awayTeam={match.awayTeam}
                  />
                </section>
              ) : (
                <p class="rounded-lg border border-border bg-surface p-4 text-sm text-ink-muted">
                  Todavía no tenemos el rendimiento individual de este partido.
                </p>
              )}
            </div>
          )
        }

        {
          vista === 'analisis' && (
            <>
              {match.insight && <InsightCard insight={match.insight} />}
              {!match.insight && match.preview && <PreviewCard preview={match.preview} />}
            </>
          )
        }
      </div>

      <!-- El riel: el análisis es la tesis del producto, no puede vivir al final de la página. -->
      <aside class="grid gap-3 lg:sticky lg:top-20">
        {
          /* El banco vive en el riel: debajo de la cancha empujaba la vista fuera de pantalla. */
          vista === 'alineaciones' && (
            <Suplentes
              lineups={match.lineups}
              homeTeam={match.homeTeam}
              awayTeam={match.awayTeam}
            />
          )
        }
        {
          analisis ? (
            <section class="rounded-lg border border-data/25 bg-surface p-4">
              <p class="mb-2 flex items-center gap-1.5 text-2xs font-medium tracking-label text-data-ink uppercase">
                <Icon name="destello" size={13} />
                Análisis Athena
              </p>
              <p class="text-sm font-semibold leading-snug">{analisis.titular}</p>
              <ul class="mt-3 grid gap-1.5">
                {('claves' in analisis ? analisis.claves : analisis.aSeguir)
                  .slice(0, 3)
                  .map((item) => (
                    <li class="flex gap-2 text-2xs text-ink-muted">
                      <Icon name="vineta" size={12} class="mt-0.5 shrink-0 text-data-ink" />
                      <span>{item}</span>
                    </li>
                  ))}
              </ul>
              {vista !== 'analisis' && (
                <a
                  href={`${baseUrl}?vista=analisis`}
                  class="mt-3 flex items-center gap-1 text-2xs text-primary-ink hover:underline"
                >
                  Leer el análisis con su evidencia
                  <Icon name="chevron-derecha" size={12} />
                </a>
              )}
            </section>
          ) : (
            <section class="rounded-lg border border-border bg-surface p-4">
              <p class="text-sm text-ink-muted">
                El análisis de este partido se genera cuando termina.
              </p>
            </section>
          )
        }

        <section class="rounded-lg border border-border bg-surface p-4">
          <h2 class="mb-2 text-2xs font-medium tracking-label text-ink-muted uppercase">
            Datos del partido
          </h2>
          <dl class="grid gap-1.5 text-sm">
            <div class="flex justify-between gap-3">
              <dt class="text-ink-muted">Competencia</dt>
              <dd class="text-right">
                <a
                  href={`/competencias/${match.season.competition.slug}`}
                  class="hover:text-primary-ink hover:underline"
                >
                  {match.season.competition.name}
                </a>
              </dd>
            </div>
            <div class="flex justify-between gap-3">
              <dt class="text-ink-muted">Temporada</dt>
              <dd class="tabular">{match.season.year}</dd>
            </div>
            {match.round && (
              <div class="flex justify-between gap-3">
                <dt class="text-ink-muted">Jornada</dt>
                <dd class="text-right">{match.round}</dd>
              </div>
            )}
            {match.venue && (
              <>
                <div class="flex justify-between gap-3">
                  <dt class="text-ink-muted">Estadio</dt>
                  <dd class="text-right">{match.venue.name}</dd>
                </div>
                {match.venue.capacity !== null && (
                  <div class="flex justify-between gap-3">
                    <dt class="text-ink-muted">Capacidad</dt>
                    <dd class="tabular">{match.venue.capacity.toLocaleString('es-PE')}</dd>
                  </div>
                )}
              </>
            )}
          </dl>
        </section>
      </aside>
    </div>
  </Container>

  <PlayerSheet />
</Base>
