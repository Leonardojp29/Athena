---
import Base from '../layouts/Base.astro';
import { cachear } from '../lib/cache';
import BarraLateral from '../components/home/BarraLateral.astro';
import Container from '../components/layout/Container.astro';
import Hero from '../components/home/Hero.astro';
import Icon from '../components/Icon.astro';
import MatchGeography from '../components/home/MatchGeography.astro';
import MatchRow from '../components/MatchRow.astro';
import LideresDelMundo from '../components/home/LideresDelMundo.astro';
import OnceDeLaFecha from '../components/home/OnceDeLaFecha.astro';
import AlineacionDelEquipo from '../components/home/AlineacionDelEquipo.astro';
import PlayerSheet from '../components/pitch/PlayerSheet.astro';
import TablaDelRiel from '../components/home/TablaDelRiel.astro';
import VistaEquipo from '../components/home/VistaEquipo.astro';
import VistaJugador from '../components/home/VistaJugador.astro';
import VistaLiga from '../components/home/VistaLiga.astro';
import {
  api,
  type CompetitionView,
  type HomeView,
  type PlayerView,
  type TeamView,
  type TopPerformers,
} from '../lib/api';
import { isLive } from '../lib/format';
import { getHomeView } from '../lib/live';
import RefrescoDeMarcadores from '../components/RefrescoDeMarcadores.astro';
import { getNavTree, todasLasCompetencias } from '../lib/nav';
import { sitioYOrganizacion } from '../lib/seo';
import { paisEnEspanol } from '../lib/paises';
import Hueco from '../components/anuncios/Hueco.astro';

/*
 * Todo en paralelo. En serie, cada vista sumaba su viaje a Supabase y la home tardaba siete
 * segundos; ninguna de estas depende del resultado de las otras.
 */
/* La región del riel viaja en la URL: el enlace es compartible y no cuesta hidratar nada. */
const REGIONES = new Set(['sudamerica', 'europa', 'norteamerica', 'asia', 'africa', 'mundial']);
const regionPedida = Astro.url.searchParams.get('region');
const region = regionPedida && REGIONES.has(regionPedida) ? regionPedida : 'sudamerica';

/*
 * Las tres regiones del riel viajan juntas para que cambiar de continente no recargue la página.
 * Son tres pedidos en vez de uno, pero el API los sirve cacheados y salen en la misma tanda.
 */
const REGIONES_DEL_RIEL = ['sudamerica', 'europa', 'norteamerica'] as const;
const vacia = (continente: string): TopPerformers => ({
  continent: continente,
  scorers: [],
  date: '',
  esDeHoy: true,
  players: [],
});

const [homeView, catalogo, ...mejores] = await Promise.all([
  getHomeView(),
  getNavTree(),
  ...REGIONES_DEL_RIEL.map((continente) =>
    api<TopPerformers>(`/views/top-performers?continente=${continente}`).catch(() =>
      vacia(continente),
    ),
  ),
]);

const home = homeView ?? ({ live: 0, sections: [], geography: [] } satisfies HomeView);

/*
 * La selección va en la URL —`?pais=` o `?liga=`— y no en estado hidratado: el enlace es
 * compartible, el botón atrás funciona, la página sigue casi sin JavaScript y las transiciones
 * de vista animan el cambio solas.
 */
const ligaPedida = Astro.url.searchParams.get('liga');
const ligasValidas = new Set(todasLasCompetencias(catalogo).map((c) => c.slug));
const liga = ligaPedida && ligasValidas.has(ligaPedida) ? ligaPedida : null;

/*
 * El país se valida contra el catálogo, no contra los partidos de hoy: un país sin partidos hoy
 * existe igual y la página tiene qué decirle —"sin partidos hoy en este país"—. Validando contra la
 * geografía del día, el enlace de la barra lateral caía en la lista completa sin explicar nada.
 */
const paisPedido = Astro.url.searchParams.get('pais');
const codigos = new Set(
  catalogo.clubes.flatMap((c) => c.countries.map((p) => p.code ?? 'internacional')),
);
const abierto =
  Astro.url.searchParams.has('equipo') || Astro.url.searchParams.has('jugador');
const pais = !liga && !abierto && paisPedido && codigos.has(paisPedido) ? paisPedido : null;

const SLUG = /^[a-z0-9-]{2,80}$/;
const equipoPedido = Astro.url.searchParams.get('equipo');
const equipo = !liga && equipoPedido && SLUG.test(equipoPedido) ? equipoPedido : null;
const jugadorPedido = Astro.url.searchParams.get('jugador');
const jugador = !liga && !equipo && jugadorPedido && SLUG.test(jugadorPedido) ? jugadorPedido : null;

/*
 * La liga, el equipo o el jugador elegidos se abren en el mismo contenedor. Si el pedido falla se
 * cae a la lista del día: un slug viejo compartido por ahí no puede dejar la home en blanco.
 */
let vistaLiga: CompetitionView | null = null;
let vistaEquipo: TeamView | null = null;
let vistaJugador: PlayerView | null = null;
if (liga) {
  vistaLiga = await api<CompetitionView>(`/views/competition/${liga}`).catch(() => null);
} else if (equipo) {
  vistaEquipo = await api<TeamView>(`/views/team/${equipo}`).catch(() => null);
} else if (jugador) {
  vistaJugador = await api<PlayerView>(`/views/player/${jugador}`).catch(() => null);
}

/*
 * Con una entidad abierta, la home muestra exactamente lo que muestra la página de esa entidad. El
 * canónico se lo cede: dos direcciones con el mismo contenido compiten entre sí, y la que tiene el
 * título, la descripción y los datos estructurados propios es la otra.
 */
const canonical = vistaLiga
  ? new URL(`/competencias/${liga}`, Astro.site).toString()
  : vistaEquipo
    ? new URL(`/equipos/${equipo}`, Astro.site).toString()
    : vistaJugador
      ? new URL(`/jugadores/${jugador}`, Astro.site).toString()
      : null;

/* La fase de la tabla viaja en la URL para que el enlace sea compartible. */
const fase = Astro.url.searchParams.get('tabla');

/* Y qué pestaña del riel de la copa: el cuadro o los grupos. */
const vistaRiel = Astro.url.searchParams.get('vista');

/* Y la fecha elegida en la tarjeta de alineaciones: el id del partido que arranca visible. */
const fechaPedida = Astro.url.searchParams.get('fecha');
const fecha = fechaPedida && /^[0-9a-f-]{36}$/.test(fechaPedida) ? fechaPedida : null;

/* La bandera y el país de la liga abierta salen del catálogo: la vista de competencia no los trae. */
const paisDeLaLiga = liga
  ? (catalogo.clubes.flatMap((c) => c.countries).find((p) => p.competitions.some((t) => t.slug === liga)) ??
    null)
  : null;

const geografia = pais
  ? home.geography
      .map((c) => ({
        ...c,
        countries: c.countries.filter((p) => (p.code ?? 'internacional') === pais),
      }))
      .filter((c) => c.countries.length > 0)
  : home.geography;

const nombrePais = pais
  ? (paisEnEspanol(
      catalogo.clubes.flatMap((c) => c.countries).find((p) => (p.code ?? 'internacional') === pais)?.name ??
        null,
    ) ?? 'Internacional')
  : null;

const todos = home.sections.flatMap((s) => s.matches);
/*
 * Con algo en juego la home se mantiene sola: sin esto el minuto y el marcador se quedaban en el
 * momento en que se abrió la pestaña, que en una página de "qué se juega hoy" es un dato viejo
 * disfrazado de dato. Sin partidos en vivo no se manda ni un byte de JavaScript.
 */
const hayEnVivo = todos.some((m) => isLive(m.status));
const hoyEnLima = new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Lima' }).format(new Date());

cachear(Astro.response, 'home');
---

<Base
  title="Athena — Partidos de hoy y marcadores en vivo"
  description="Sigue los partidos de hoy en las principales ligas del mundo: marcadores en vivo, alineaciones sobre la cancha, tablas y análisis con evidencia."
  canonical={canonical}
  jsonLd={sitioYOrganizacion(Astro.site)}
  width="bleed"
  liveBar={false}
>
  <Hero live={todos} total={todos.length} />

  <Container width="content" class="pt-7 pb-5">
    <div
      class="grid gap-7 lg:grid-cols-[16rem_minmax(0,1fr)] xl:grid-cols-[16rem_minmax(0,52rem)_24rem] xl:justify-center"
    >
      <!--
        En móvil los partidos van primero: nadie baja ocho países para llegar a lo que vino a ver.
      -->
      <!-- En móvil el catálogo va último: primero lo que se vino a ver, después dónde ir. -->
      <aside
        data-riel
        class="order-3 lg:order-none lg:sticky lg:top-20 lg:max-h-[calc(100dvh-6rem)] lg:self-start lg:overflow-y-auto lg:pr-1"
      >
        <BarraLateral
          catalogo={catalogo.clubes}
          selecciones={catalogo.selecciones}
          geography={home.geography}
          paisActivo={pais}
          ligaActiva={liga}
          equipoActivo={equipo}
        />
      </aside>

      <div class="order-1 min-w-0 lg:order-none">

        {
          vistaLiga ? (
            <VistaLiga
              view={vistaLiga}
              banderaUrl={paisDeLaLiga?.flagUrl ?? null}
            />
          ) : vistaEquipo ? (
            <VistaEquipo view={vistaEquipo} />
          ) : vistaJugador ? (
            <VistaJugador view={vistaJugador} />
          ) : (
            <>
              <div class="mb-3 flex items-center gap-3">
                <h2 class="border-l-[3px] border-primary pl-3 font-display text-lg font-semibold uppercase tracking-tight">
                  {nombrePais ? `Hoy en ${nombrePais}` : 'Hoy'}
                </h2>
                {pais && (
                  <a href="/" class="text-2xs text-primary-ink hover:underline">
                    ver todos
                  </a>
                )}

                <!--
                  El filtro de en vivo no pide nada: las filas ya saben si están en juego, así que
                  alcanza con esconder las demás. Aparece solo cuando hay algo que filtrar, y se
                  apaga solo cuando el último partido termina.
                -->
                <button
                  type="button"
                  id="solo-vivo"
                  hidden
                  aria-pressed="false"
                  class="flex shrink-0 cursor-pointer items-center gap-1.5 rounded-full border border-border px-2.5 py-1 text-2xs font-medium text-ink-muted transition-colors hover:border-border-strong hover:text-ink aria-pressed:border-live aria-pressed:bg-live/12 aria-pressed:text-live-ink"
                >
                  <span class="size-1.5 rounded-full bg-live" />
                  Solo en vivo
                </button>

                <span class="h-px flex-1 bg-border" />
                <a
                  href="/partidos"
                  class="flex shrink-0 items-center gap-1 text-2xs text-primary-ink hover:underline"
                >
                  Calendario
                  <Icon name="chevron-derecha" size={12} />
                </a>
              </div>

              {geografia.length === 0 ? (
                <div class="rounded-lg border border-border bg-surface p-8 text-center">
                  <Icon name="cancha" size={30} class="mx-auto text-ink-muted" />
                  <p class="mt-3 text-sm text-ink-muted">
                    {pais
                      ? 'Sin partidos hoy en este país.'
                      : 'No hay partidos programados en las próximas horas.'}
                  </p>
                  <a
                    href={pais ? '/' : '/competencias'}
                    class="mt-3 inline-block text-sm text-primary-ink hover:underline"
                  >
                    {pais ? 'Ver todos los países' : 'Explorar las competencias'}
                  </a>
                </div>
              ) : (
                <MatchGeography
                  geography={geografia}
                  filtrado={pais !== null}
                  hrefEquipo={(slug: string) => `/?equipo=${slug}`}
                  hrefLiga={(slug: string) => `/?liga=${slug}`}
                />
              )}
            </>
          )
        }
      </div>

      <!--
        El riel guarda el "cómo va": con una liga abierta, su tabla y debajo el once de la fecha.
        "Lo mejor del día" de todo el mundo no dice nada cuando estás dentro de una liga, así que
        se reemplaza, no se suma.

        Entre 1024 y 1279px el riel cae en la primera columna de la segunda fila —16rem— y la cancha
        del once se dibujaba de 256px: ahí ocupa las dos columnas y reparte sus tarjetas en dos.
      -->
      <aside
        class="order-2 grid gap-4 lg:order-none lg:col-span-2 lg:grid-cols-2 lg:items-start xl:sticky xl:top-20 xl:col-span-1 xl:grid-cols-1 xl:self-start"
      >
        {vistaLiga && <TablaDelRiel view={vistaLiga} fase={fase} vista={vistaRiel} />}
        {
          vistaLiga?.once && (
            <OnceDeLaFecha
              once={vistaLiga.once}
              logoUrl={vistaLiga.competition.logoUrl}
              nombreLiga={vistaLiga.competition.name}
            />
          )
        }
        {
          vistaEquipo && vistaEquipo.lineups.length > 0 && (
            <AlineacionDelEquipo
              alineaciones={vistaEquipo.lineups}
              equipo={vistaEquipo.team}
              fechaPedida={fecha}
            />
          )
        }
        {
          !vistaLiga && !vistaEquipo && (
            <LideresDelMundo
              tops={mejores}
              activa={region}
              href={(continente: string) => `/?region=${continente}`}
              hrefJugador={(slug: string) => `/?jugador=${slug}`}
            />
          )
        }

        <Hueco medida="bloque" ubicacion="home-riel" class="xl:mt-1" />
      </aside>
    </div>
  </Container>

  <!-- La ficha del jugador: solo se monta cuando hay una cancha que la abra. -->
  {(vistaLiga?.once || (vistaEquipo?.lineups.length ?? 0) > 0) && <PlayerSheet />}

  <!-- Y el reloj de los marcadores, solo si hay algo en juego. -->
  {hayEnVivo && <RefrescoDeMarcadores dia={hoyEnLima} />}
</Base>
<script>
  /*
   * Mostrar solo lo que está en juego.
   *
   * No cuesta un pedido: cada fila ya viene marcada con `data-en-vivo` y el refresco de marcadores
   * la mantiene al día, así que el filtro solo esconde. Los grupos que se quedan sin partido visible
   * se esconden también, porque un país vacío con su bandera es peor que ningún país.
   */
  const boton = document.getElementById('solo-vivo');
  const geografia = document.querySelector<HTMLElement>('[data-geografia]');

  if (boton && geografia) {
    const vivos = () => geografia.querySelectorAll('[data-partido][data-en-vivo]').length;

    const aplicar = (soloVivo: boolean) => {
      for (const fila of geografia.querySelectorAll<HTMLElement>('[data-partido]')) {
        fila.hidden = soloVivo && !fila.hasAttribute('data-en-vivo');
      }
      for (const nivel of ['[data-competencia]', '[data-pais]', 'details']) {
        for (const grupo of geografia.querySelectorAll<HTMLElement>(nivel)) {
          const quedan = grupo.querySelectorAll('[data-partido]:not([hidden])').length;
          grupo.hidden = soloVivo && quedan === 0;
          if (soloVivo && quedan > 0 && grupo instanceof HTMLDetailsElement) grupo.open = true;
        }
      }
      boton.setAttribute('aria-pressed', String(soloVivo));
    };

    const revisar = () => {
      boton.hidden = vivos() === 0;
      if (boton.hidden && boton.getAttribute('aria-pressed') === 'true') aplicar(false);
    };

    boton.addEventListener('click', () =>
      aplicar(boton.getAttribute('aria-pressed') !== 'true'),
    );

    revisar();
    /* El refresco de marcadores reescribe el estado de cada fila; el filtro lo sigue. */
    new MutationObserver(revisar).observe(geografia, {
      subtree: true,
      attributes: true,
      attributeFilter: ['data-en-vivo'],
    });
  }
</script>

