---
import Base from '../layouts/Base.astro';
import BarraLateral from '../components/home/BarraLateral.astro';
import Container from '../components/layout/Container.astro';
import Hero from '../components/home/Hero.astro';
import Icon from '../components/Icon.astro';
import MatchGeography from '../components/home/MatchGeography.astro';
import MatchRow from '../components/MatchRow.astro';
import MejoresDelDia from '../components/home/MejoresDelDia.astro';
import VistaEquipo from '../components/home/VistaEquipo.astro';
import VistaLiga from '../components/home/VistaLiga.astro';
import {
  api,
  ApiError,
  type CompetitionView,
  type HomeView,
  type PersonalFeed,
  type TeamView,
  type TopPerformers,
} from '../lib/api';
import { getHomeView } from '../lib/live';
import { getNavTree, todasLasCompetencias } from '../lib/nav';
import { getSession } from '../lib/supabase';
import { paisEnEspanol } from '../lib/paises';

/*
 * Todo en paralelo. En serie, cada vista sumaba su viaje a Supabase y la home tardaba siete
 * segundos; ninguna de estas depende del resultado de las otras.
 */
const session = await getSession(Astro);
const [homeView, catalogo, mejores, feed] = await Promise.all([
  getHomeView(),
  getNavTree(),
  api<TopPerformers>('/views/top-performers').catch(
    () => ({ date: '', esDeHoy: true, players: [] }) satisfies TopPerformers,
  ),
  session?.accessToken
    ? api<PersonalFeed>('/me/feed', session.accessToken).catch(() => null)
    : Promise.resolve(null),
]);

const home = homeView ?? ({ live: 0, sections: [], geography: [] } satisfies HomeView);

/*
 * La selección va en la URL —`?pais=` o `?liga=`— y no en estado hidratado: el enlace es
 * compartible, el botón atrás funciona, la página sigue casi sin JavaScript y las transiciones
 * de vista animan el cambio solas.
 */
const ligaPedida = Astro.url.searchParams.get('liga');
const ligasValidas = new Set(todasLasCompetencias(catalogo).map((c) => c.slug));
const liga = ligaPedida && ligasValidas.has(ligaPedida) ? ligaPedida : null;

const paisPedido = Astro.url.searchParams.get('pais');
const codigos = new Set(
  home.geography.flatMap((c) => c.countries.map((p) => p.code ?? 'internacional')),
);
const pais =
  !liga && !Astro.url.searchParams.get('equipo') && paisPedido && codigos.has(paisPedido)
    ? paisPedido
    : null;

const equipoPedido = Astro.url.searchParams.get('equipo');
const equipo = !liga && equipoPedido && /^[a-z0-9-]{2,80}$/.test(equipoPedido) ? equipoPedido : null;

/*
 * La liga o el equipo elegidos se abren en el mismo contenedor. Si el pedido falla se cae a la
 * lista del día: un slug viejo compartido por ahí no puede dejar la home en blanco.
 */
let vistaLiga: CompetitionView | null = null;
let vistaEquipo: TeamView | null = null;
if (liga) {
  try {
    vistaLiga = await api<CompetitionView>(`/views/competition/${liga}`);
  } catch (error) {
    if (!(error instanceof ApiError)) throw error;
    vistaLiga = null;
  }
} else if (equipo) {
  try {
    vistaEquipo = await api<TeamView>(`/views/team/${equipo}`);
  } catch (error) {
    if (!(error instanceof ApiError)) throw error;
    vistaEquipo = null;
  }
}

/* La fase de la tabla viaja en la URL para que el enlace sea compartible. */
const fase = Astro.url.searchParams.get('tabla');

/* La bandera y el país de la liga abierta salen del catálogo: la vista de competencia no los trae. */
const paisDeLaLiga = liga
  ? (catalogo.flatMap((c) => c.countries).find((p) => p.competitions.some((t) => t.slug === liga)) ??
    null)
  : null;

const geografia = pais
  ? home.geography
      .map((c) => ({
        ...c,
        countries: c.countries.filter((p) => (p.code ?? 'internacional') === pais),
      }))
      .filter((c) => c.countries.length > 0)
  : home.geography;

const nombrePais = pais
  ? (paisEnEspanol(
      home.geography.flatMap((c) => c.countries).find((p) => (p.code ?? 'internacional') === pais)
        ?.name ?? null,
    ) ?? 'Internacional')
  : null;

const todos = home.sections.flatMap((s) => s.matches);
const showFeed =
  feed?.hasFavorites &&
  (feed.live.length > 0 || feed.upcoming.length > 0 || feed.recent.length > 0);

const destacado = feed?.insights[0]
  ? { titular: feed.insights[0].titular, matchId: feed.insights[0].matchId }
  : null;
---

<Base
  title="Athena — Partidos de hoy y marcadores en vivo"
  description="Sigue los partidos de hoy en las principales ligas del mundo: marcadores en vivo, alineaciones sobre la cancha, tablas y análisis con evidencia."
  width="bleed"
  liveBar={false}
>
  <Hero live={todos} total={todos.length} destacado={destacado} />

  <Container width="wide" class="py-5">
    <div
      class="grid gap-5 lg:grid-cols-[16rem_minmax(0,1fr)] xl:grid-cols-[16rem_minmax(0,52rem)_24rem] xl:justify-center"
    >
      <!--
        En móvil los partidos van primero: nadie baja ocho países para llegar a lo que vino a ver.
      -->
      <aside
        data-riel
        class="order-2 lg:order-none lg:sticky lg:top-16 lg:max-h-[calc(100dvh-5rem)] lg:self-start lg:overflow-y-auto lg:pr-1"
      >
        <BarraLateral
          catalogo={catalogo}
          geography={home.geography}
          paisActivo={pais}
          ligaActiva={liga}
          equipoActivo={equipo}
          conCuenta={session !== null}
        />
      </aside>

      <div class="order-1 min-w-0 lg:order-none">
        {
          showFeed && feed && (
            <section class="mb-5">
              <h2 class="mb-2 font-display text-base font-semibold uppercase">Lo que sigues</h2>
              <div class="rounded-lg border border-border bg-surface p-1">
                {[...feed.live, ...feed.upcoming, ...feed.recent].slice(0, 5).map((match) => (
                  <MatchRow match={match} showDate hrefEquipo={(slug) => `/?equipo=${slug}`} />
                ))}
              </div>
            </section>
          )
        }

        {
          vistaLiga ? (
            <VistaLiga
              view={vistaLiga}
              banderaUrl={paisDeLaLiga?.flagUrl ?? null}
              fase={fase}
              conCuenta={session !== null}
            />
          ) : vistaEquipo ? (
            <VistaEquipo view={vistaEquipo} conCuenta={session !== null} />
          ) : (
            <>
              <div class="mb-3 flex items-center gap-3">
                <h2 class="font-display text-base font-semibold uppercase">
                  {nombrePais ? `Hoy en ${nombrePais}` : 'Hoy'}
                </h2>
                {pais && (
                  <a href="/" class="text-2xs text-primary-ink hover:underline">
                    ver todos
                  </a>
                )}
                <span class="h-px flex-1 bg-border" />
                <a
                  href="/partidos"
                  class="flex shrink-0 items-center gap-1 text-2xs text-primary-ink hover:underline"
                >
                  Calendario
                  <Icon name="chevron-derecha" size={12} />
                </a>
              </div>

              {geografia.length === 0 ? (
                <div class="rounded-lg border border-border bg-surface p-8 text-center">
                  <Icon name="cancha" size={30} class="mx-auto text-ink-muted" />
                  <p class="mt-3 text-sm text-ink-muted">
                    {pais
                      ? 'Sin partidos hoy en este país.'
                      : 'No hay partidos programados en las próximas horas.'}
                  </p>
                  <a
                    href={pais ? '/' : '/competencias'}
                    class="mt-3 inline-block text-sm text-primary-ink hover:underline"
                  >
                    {pais ? 'Ver todos los países' : 'Explorar las competencias'}
                  </a>
                </div>
              ) : (
                <MatchGeography
                  geography={geografia}
                  filtrado={pais !== null}
                  hrefEquipo={(slug) => `/?equipo=${slug}`}
                />
              )}
            </>
          )
        }
      </div>

      <aside class="order-3 grid gap-4 lg:order-none xl:sticky xl:top-20 xl:self-start">
        <MejoresDelDia top={mejores} />

        {
          session === null && (
            <section class="rounded-lg border border-primary/25 bg-surface p-3">
              <p class="text-sm font-medium">Armá tu propio inicio</p>
              <p class="mt-1 text-2xs text-ink-muted">
                Seguí equipos y competencias y sus partidos aparecen arriba, con el análisis de
                cada uno. Con cuenta, tus favoritos te siguen a cualquier dispositivo.
              </p>
              <a
                href="/entrar"
                class="mt-2.5 flex items-center justify-center gap-1 rounded-md bg-primary px-3 py-1.5 text-2xs font-medium text-primary-contrast transition-opacity hover:opacity-90"
              >
                Crear cuenta
              </a>
            </section>
          )
        }
      </aside>
    </div>
  </Container>
</Base>
