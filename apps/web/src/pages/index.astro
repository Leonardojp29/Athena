---
import '@athena/tokens/css';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Athena — la plataforma que transforma datos de fútbol en conocimiento." />
    <title>Athena — Football Intelligence</title>
  </head>
  <body>
    <main>
      <h1>Athena</h1>
      <p>Football Intelligence Platform</p>
      <p class="muted">Fase 0 — fundaciones. El producto llega en la Fase 2.</p>
    </main>
  </body>
</html>

<style>
  body {
    margin: 0;
    min-height: 100vh;
    display: grid;
    place-items: center;
    background: var(--color-bg);
    color: var(--color-text);
    font-family: var(--font-sans);
  }
  main {
    text-align: center;
  }
  h1 {
    font-size: var(--text-4xl);
    letter-spacing: -0.02em;
    margin-bottom: var(--space-2);
    color: var(--color-primary);
  }
  .muted {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }
</style>
