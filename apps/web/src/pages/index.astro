---
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import MatchRow from '../components/MatchRow.astro';
import { api, type HomeView } from '../lib/api';

const home = await api<HomeView>('/views/home');
---

<Base
  title="Athena — Partidos de hoy y marcadores en vivo"
  description="Sigue los partidos de hoy en las principales ligas de Europa y Sudamérica: marcadores en vivo, tablas y resultados."
>
  <h1 class="text-2xl font-bold tracking-tight mb-1">Partidos de hoy</h1>
  <p class="text-sm text-ink-muted mb-6">
    {home.live > 0 ? `${home.live} en juego ahora` : 'Las principales ligas de Europa y Sudamérica'}
  </p>

  {home.sections.length === 0 ? (
    <Card>
      <p class="text-ink-muted text-sm">No hay partidos programados en las próximas horas. Vuelve mañana o explora las competencias.</p>
    </Card>
  ) : (
    <div class="grid gap-4">
      {home.sections.map(({ competition, matches }) => (
        <Card>
          <a href={`/competencias/${competition.slug}`} class="flex items-center gap-2 mb-2 hover:text-primary transition-colors">
            {competition.logoUrl && <img src={competition.logoUrl} alt="" width="20" height="20" loading="lazy" />}
            <h2 class="text-base font-semibold">{competition.name}</h2>
          </a>
          <div class="divide-y divide-border/40">
            {matches.map((match) => <MatchRow match={match} showDate />)}
          </div>
        </Card>
      ))}
    </div>
  )}
</Base>
