---
/*
 * La dirección vieja de la calculadora.
 *
 * Se mudó a `/calculadora-liga-1`, que es como la busca la gente y lo que dice el botón del header.
 * Esta queda para siempre con un 301: la tarjeta de predicción circula por WhatsApp con la URL
 * vieja adentro, y un enlace compartido no puede morir porque nosotros renombramos una ruta.
 */
const destino = new URL('/calculadora-liga-1', Astro.url);
destino.search = Astro.url.search;
return Astro.redirect(destino.pathname + destino.search, 301);
