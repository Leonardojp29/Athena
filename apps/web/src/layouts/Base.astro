---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import Logo from '../components/brand/Logo.astro';
import { getSession } from '../lib/supabase';

interface Props {
  title: string;
  description: string;
  ogImage?: string | null;
  jsonLd?: Record<string, unknown> | null;
  noindex?: boolean;
}

const { title, description, ogImage = null, jsonLd = null, noindex = false } = Astro.props;
const session = await getSession(Astro);
const canonical = new URL(Astro.url.pathname, Astro.site);

const NAV = [
  { label: 'Premier League', href: '/competencias/premier-league' },
  { label: 'LaLiga', href: '/competencias/la-liga' },
  { label: 'Champions', href: '/competencias/uefa-champions-league' },
  { label: 'Libertadores', href: '/competencias/conmebol-libertadores' },
  { label: 'Liga 1', href: '/competencias/primera-division' },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0A0A0C" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#FFFFFF" media="(prefers-color-scheme: light)" />
    <link rel="preload" href="/fonts/oswald-latin-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/archivo-latin-var.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Athena" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <script is:inline>
      const stored = localStorage.getItem('theme');
      const dark = stored ? stored === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
      if (dark) document.documentElement.dataset.theme = 'dark';
    </script>
  </head>
  <body class="min-h-screen">
    <!--
      THESIS: Athena explica el fútbol sobre la pizarra donde el fútbol siempre se explicó.
        Rechaza la lista de tarjetas oscuras con punto verde que envía toda app de resultados.
      OWN-WORLD: slate de pizarra como superficie, líneas de tiza para la cancha, marcador lima
        para la acción y cian para lo que dice la IA; los jugadores son imanes con dorsal que se
        levantan del tablero. Borde de tiza en lo plano, sombra real solo en lo que es objeto.
      STORY: el hincha llega por un resultado, ve el partido dibujado, toca un imán y entiende
        qué hizo ese jugador; el análisis está anotado al costado con flechas a lo que menciona.
      FIRST VIEWPORT: pizarra a sangre; marcador condensado arriba al centro, cancha con los 22
        imanes bajo él, anotaciones de la IA en el riel derecho apuntando a la jugada.
      FORM: pizarra del técnico, candidato 4 de 7 por resonancia; seed d9ac50d8.
      FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
    -->
    <header class="border-b border-border bg-surface/80 backdrop-blur sticky top-0 z-10">
      <div class="mx-auto max-w-6xl px-4 h-14 flex items-center gap-6">
        <a href="/" aria-label="Athena — inicio" class="text-ink hover:text-primary-ink transition-colors shrink-0">
          <Logo size={26} />
        </a>
        <nav class="hidden md:flex gap-4 text-sm text-ink-muted overflow-x-auto">
          {NAV.map((item) => (
            <a href={item.href} class="hover:text-ink whitespace-nowrap transition-colors">{item.label}</a>
          ))}
        </nav>
        <form method="get" action="/buscar" class="ml-auto flex items-center gap-3">
          <input
            type="search"
            name="q"
            placeholder="Buscar…"
            aria-label="Buscar equipos, jugadores o competencias"
            class="w-28 sm:w-44 bg-canvas-subtle border border-border rounded-md px-2 py-1 text-sm outline-none focus:border-primary-ink focus:w-44 sm:focus:w-56 transition-all"
          />
          <button
            id="theme-toggle"
            type="button"
            class="text-ink-muted hover:text-ink text-sm cursor-pointer"
            aria-label="Cambiar tema"
          ><Icon name="tema" size={18} /></button>
        </form>

        {session ? (
          <form method="post" action="/salir" class="shrink-0">
            <button
              type="submit"
              class="text-sm text-ink-muted hover:text-ink transition-colors cursor-pointer"
              title={session.user.email ?? 'Salir'}
            >Salir</button>
          </form>
        ) : (
          <a href="/entrar" class="text-sm text-ink-muted hover:text-ink transition-colors shrink-0">
            Entrar
          </a>
        )}
      </div>
    </header>

    <main class="mx-auto max-w-6xl px-4 py-6">
      <slot />
    </main>

    <footer class="border-t border-border mt-12">
      <div class="mx-auto max-w-6xl px-4 py-6 text-sm text-ink-muted flex flex-wrap gap-2 justify-between">
        <span>Athena — inteligencia futbolística</span>
        <span>Datos: API-Football</span>
      </div>
    </footer>

    <script is:inline>
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const root = document.documentElement;
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next === 'dark' ? 'dark' : '';
        if (next === 'light') delete root.dataset.theme;
        localStorage.setItem('theme', next);
      });
    </script>
  </body>
</html>
