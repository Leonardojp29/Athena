---
import '../styles/global.css';
import Container from '../components/layout/Container.astro';
import LiveBar from '../components/layout/LiveBar.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import SiteHeader from '../components/layout/SiteHeader.astro';
import ProgresoNavegacion from '../components/layout/ProgresoNavegacion.astro';
import SkipLink from '../components/layout/SkipLink.astro';
import type { Nodo } from '../lib/seo';

interface Props {
  title: string;
  description: string;
  ogImage?: string | null;
  /* La imagen es un rectángulo 1200×630 y no un escudo cuadrado: manda tarjeta grande. */
  ogImageAncha?: boolean;
  ogType?: 'website' | 'article' | 'profile';
  jsonLd?: Nodo | Nodo[] | null;
  /**
   * El canónico, cuando los parámetros de la URL sí cambian el contenido. Por omisión es la ruta
   * sola: la mayoría de los parámetros del sitio eligen una pestaña o un orden y no otra página.
   */
  canonical?: string | null;
  noindex?: boolean;
  chrome?: 'full' | 'minimal';
  liveBar?: boolean;
  /* `bleed` deja que la página componga sus propias secciones a sangre. */
  width?: 'wide' | 'content' | 'prose' | 'bleed';
}

const {
  title,
  description,
  ogImage = null,
  ogImageAncha = false,
  ogType = 'website',
  jsonLd = null,
  canonical: canonicaPedida = null,
  noindex = false,
  chrome = 'full',
  liveBar = true,
  width = 'content',
} = Astro.props;

const canonical = canonicaPedida ?? new URL(Astro.url.pathname, Astro.site).toString();

/*
 * Toda página comparte algo: sin imagen propia va la portada de la marca. Un enlace sin vista
 * previa en WhatsApp parece roto, y la mitad de las rutas no tenía ninguna.
 */
const PORTADA = new URL('/og.png', Astro.site).toString();
const imagen = ogImage ?? PORTADA;
const tarjetaAncha = ogImage ? ogImageAncha : true;

/*
 * `noindex, follow`: que no la guarde, pero que sí siga los enlaces. Sin `follow` una página de
 * resultados internos se vuelve un callejón sin salida para el rastreo.
 */
const robots = noindex ? 'noindex, follow' : 'max-image-preview:large';

const grafo = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
/*
 * `</script` dentro del nombre de un club cerraría la etiqueta y el resto del JSON se pintaría como
 * texto. No ha pasado; que no pueda pasar cuesta una línea.
 */
const datosEstructurados =
  grafo.length > 0
    ? JSON.stringify({ '@context': 'https://schema.org', '@graph': grafo }).replace(
        /<\//g,
        '<\\/',
      )
    : null;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#FFFFFF" />
    <link rel="preload" href="/fonts/oswald-latin-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/archivo-latin-var.woff2" as="font" type="font/woff2" crossorigin />
    <!-- De acá sale el escudo o la foto más grande de casi toda página: el saludo va adelantado. -->
    <link rel="preconnect" href="https://media.api-sports.io" crossorigin />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={robots} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Athena" />
    <meta property="og:locale" content="es_PE" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imagen} />
    <meta property="og:image:alt" content={title} />
    {
      imagen === PORTADA && (
        <>
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
        </>
      )
    }
    <meta name="twitter:card" content={tarjetaAncha ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imagen} />
    {datosEstructurados && <script type="application/ld+json" set:html={datosEstructurados} />}
    <!--
      El tema antes de pintar, para que la primera imagen ya sea la que el visitante eligió.

      El color de la barra del navegador sale de acá y no de dos metas por `prefers-color-scheme`:
      esas contradecían al tema elegido a mano.
    -->
    <script is:inline>
      window.aplicarAspecto = () => {
        const raiz = document.documentElement;
        const tema = localStorage.getItem('theme');
        const oscuro = tema ? tema === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        if (oscuro) raiz.dataset.theme = 'dark';
        else delete raiz.dataset.theme;

        /* Literales y no la variable: esto corre antes de que exista la hoja de estilos. */
        document
          .querySelector('meta[name="theme-color"]')
          ?.setAttribute('content', oscuro ? '#0B0B0D' : '#FBFAF8');
      };
      window.aplicarAspecto();
    </script>
  </head>
  <body class="flex min-h-screen flex-col">
    <!--
      THESIS: Athena explica el fútbol sobre la pizarra donde el fútbol siempre se explicó.
        Rechaza la lista de tarjetas oscuras con punto verde que envía toda app de resultados.
      OWN-WORLD: slate de pizarra como superficie, la cancha TRAZADA —el gesto del entrenador,
        no una textura de tiza imitada—, marcador lima para la acción y cian para lo que dice la
        IA; los jugadores son imanes con dorsal que se levantan del tablero. Filo de un píxel en
        lo plano, sombra real solo en lo que es objeto.
      STORY: el hincha llega por un resultado, ve el partido dibujado, toca un imán y entiende
        qué hizo ese jugador; el análisis está anotado al costado con flechas a lo que menciona.
      FIRST VIEWPORT: pizarra a sangre; marcador condensado arriba al centro, cancha con los 22
        imanes bajo él, anotaciones de la IA en el riel derecho apuntando a la jugada.
      FORM: pizarra del técnico, candidato 4 de 7 por resonancia; seed d9ac50d8.
      FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
    -->
    <ProgresoNavegacion />
    <SkipLink />
    <SiteHeader contador={chrome === 'full'} />
    {chrome === 'full' && liveBar && <LiveBar />}

    <main id="contenido" class="flex-1 pb-5">
      {
        width === 'bleed' ? (
          <slot />
        ) : (
          <Container width={width} class="py-6">
            <slot />
          </Container>
        )
      }
    </main>

    {chrome === 'full' && <SiteFooter />}

    <script is:inline>
      const alternar = (clave, valores) => {
        const actual = localStorage.getItem(clave);
        localStorage.setItem(clave, actual === valores[0] ? valores[1] : valores[0]);
        window.aplicarAspecto();
      };

      document
        .getElementById('theme-toggle')
        ?.addEventListener('click', () => alternar('theme', ['dark', 'light']));
    </script>
  </body>
</html>
