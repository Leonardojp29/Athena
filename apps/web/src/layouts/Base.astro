---
import '../styles/global.css';
import Container from '../components/layout/Container.astro';
import LiveBar from '../components/layout/LiveBar.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import SiteHeader from '../components/layout/SiteHeader.astro';
import ProgresoNavegacion from '../components/layout/ProgresoNavegacion.astro';
import SkipLink from '../components/layout/SkipLink.astro';

interface Props {
  title: string;
  description: string;
  ogImage?: string | null;
  jsonLd?: Record<string, unknown> | null;
  noindex?: boolean;
  chrome?: 'full' | 'minimal';
  liveBar?: boolean;
  /* `bleed` deja que la página componga sus propias secciones a sangre. */
  width?: 'wide' | 'content' | 'prose' | 'bleed';
}

const {
  title,
  description,
  ogImage = null,
  jsonLd = null,
  noindex = false,
  chrome = 'full',
  liveBar = true,
  width = 'content',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#FFFFFF" />
    <link rel="preload" href="/fonts/oswald-latin-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/archivo-latin-var.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Athena" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <!--
      Tema y paleta antes de pintar, para que la primera imagen ya sea la que el visitante eligió.

      La barra del navegador y el favicon salen de acá y no de dos metas por `prefers-color-scheme`:
      esas contradecían al tema elegido a mano, y un SVG externo no puede leer el DOM.
    -->
    <script is:inline>
      window.aplicarAspecto = () => {
        const raiz = document.documentElement;
        const tema = localStorage.getItem('theme');
        const oscuro = tema ? tema === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        if (oscuro) raiz.dataset.theme = 'dark';
        else delete raiz.dataset.theme;

        const verde = localStorage.getItem('paleta') === 'verde';
        if (verde) raiz.dataset.paleta = 'verde';
        else delete raiz.dataset.paleta;

        document
          .querySelector('link[rel="icon"]')
          ?.setAttribute('href', verde ? '/favicon-verde.svg' : '/favicon.svg');

        /* Literales y no la variable: esto corre antes de que la hoja de estilos exista, y el papel
           es el mismo en las dos paletas porque los neutros no las siguen. */
        document
          .querySelector('meta[name="theme-color"]')
          ?.setAttribute('content', oscuro ? '#0B0B0D' : '#FBFAF8');
      };
      window.aplicarAspecto();
    </script>
  </head>
  <body class="flex min-h-screen flex-col">
    <!--
      THESIS: Athena explica el fútbol sobre la pizarra donde el fútbol siempre se explicó.
        Rechaza la lista de tarjetas oscuras con punto verde que envía toda app de resultados.
      OWN-WORLD: slate de pizarra como superficie, la cancha TRAZADA —el gesto del entrenador,
        no una textura de tiza imitada—, marcador lima para la acción y cian para lo que dice la
        IA; los jugadores son imanes con dorsal que se levantan del tablero. Filo de un píxel en
        lo plano, sombra real solo en lo que es objeto.
      STORY: el hincha llega por un resultado, ve el partido dibujado, toca un imán y entiende
        qué hizo ese jugador; el análisis está anotado al costado con flechas a lo que menciona.
      FIRST VIEWPORT: pizarra a sangre; marcador condensado arriba al centro, cancha con los 22
        imanes bajo él, anotaciones de la IA en el riel derecho apuntando a la jugada.
      FORM: pizarra del técnico, candidato 4 de 7 por resonancia; seed d9ac50d8.
      FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
    -->
    <ProgresoNavegacion />
    <SkipLink />
    <SiteHeader contador={chrome === 'full'} />
    {chrome === 'full' && liveBar && <LiveBar />}

    <main id="contenido" class="flex-1 pb-5">
      {
        width === 'bleed' ? (
          <slot />
        ) : (
          <Container width={width} class="py-6">
            <slot />
          </Container>
        )
      }
    </main>

    {chrome === 'full' && <SiteFooter />}

    <script is:inline>
      const alternar = (clave, valores) => {
        const actual = localStorage.getItem(clave);
        localStorage.setItem(clave, actual === valores[0] ? valores[1] : valores[0]);
        window.aplicarAspecto();
      };

      document
        .getElementById('theme-toggle')
        ?.addEventListener('click', () => alternar('theme', ['dark', 'light']));
      document
        .getElementById('paleta-toggle')
        ?.addEventListener('click', () => alternar('paleta', ['verde', 'azul']));
    </script>
  </body>
</html>
