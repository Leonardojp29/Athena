{
  "name": "@athena/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --watch --experimental-strip-types src/main.api.ts",
    "start:api": "node --env-file-if-exists=../../.env dist/main.api.js",
    "start:worker": "node --env-file-if-exists=../../.env dist/main.worker.js",
    "sync:bootstrap": "node --env-file-if-exists=../../.env dist/scripts/sync-bootstrap.js",
    "ai:bootstrap": "node --env-file-if-exists=../../.env dist/scripts/ai-bootstrap.js",
    "backfill:matches": "node --env-file-if-exists=../../.env dist/scripts/backfill-match-detail.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src && pnpm run arch",
    "test": "vitest run",
    "arch": "depcruise src --config .dependency-cruiser.cjs"
  },
  "dependencies": {
    "@athena/database": "workspace:*",
    "@athena/domain": "workspace:*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@sentry/node": "^10.69.0",
    "bullmq": "^5.40.0",
    "ioredis": "^5.5.0",
    "jose": "^6.2.8",
    "openai": "^7.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@athena/config": "workspace:*",
    "@types/node": "^22.13.0",
    "dependency-cruiser": "^18.1.1",
    "eslint": "^9.20.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
