# ─────────────────────────────────────────────────────────────────────────────
# Athena · API
#
# Este archivo es exactamente lo que necesita el proyecto del API: se abre, se copia entero
# y se pega en Vercel → Settings → Environment Variables → Import .env.
# Lo que no está acá, este proyecto no lo lee.
#
# No se commitea (lo cubre `.gitignore`). El mapa versionado está en `.env.example`.
# Para sobrescribir algo solo en tu equipo, crea `.env.local`: gana sobre este.
# ─────────────────────────────────────────────────────────────────────────────

# --- Base de datos (Supabase) ---
# La agrupada (6543, pgbouncer) la usa la app; la directa (5432), las migraciones.
DATABASE_URL=
DIRECT_URL=

# --- API-Football ---
# Cabecera x-apisports-key. La cuenta es compartida: el presupuesto se calcula
# con el `remaining` real que devuelve el proveedor, no con el límite del plan.
API_FOOTBALL_KEY=
# Techo propio de pedidos por minuto (por omisión 700, el plan admite ~900).
# API_FOOTBALL_RATE_PER_MINUTE=700

# --- El latido ---
# Con este secreto pg_cron dispara los endpoints internos del sync. Tiene que ser
# el MISMO que está dentro de `cron.schedule` en Supabase, o el latido da 401.
CRON_SECRET=

# --- Desde dónde se aceptan pedidos del navegador (CORS) ---
# En Vercel: la URL real de la web, sin barra final.
WEB_ORIGIN=http://localhost:4321

# --- Puerto local. En Vercel lo pone la plataforma. ---
PORT=3001

# --- OpenAI: análisis de partido y embeddings de búsqueda (opcional) ---
# Sin esto el sitio funciona; lo que no hay es análisis generado.
# OPENAI_API_KEY=
# OPENAI_DAILY_TOKEN_CAP=200000

# --- Observabilidad (opcional) ---
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1

# --- De dónde salen los datos y las imágenes (opcional) ---
# Solo se cambian para apuntar a un proxy propio, a un CDN intermedio o a un doble de pruebas.
# API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
# MEDIA_URL=https://media.api-sports.io

# --- Orígenes de desarrollo que CORS acepta además de WEB_ORIGIN (opcional) ---
# WEB_ORIGIN_LOCAL=http://localhost:4321,http://127.0.0.1:4321

# --- Modelos de OpenAI (opcional) ---
# Se cambian para probar otro modelo sin tocar el código.
# OPENAI_INSIGHT_MODEL=gpt-5.4-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Tamaño de los lotes del worker (opcional) ---
# Se bajan si el host tiene poca memoria o la base va justa.
# LOTE_DE_DRENADO=8
# CIERRE_LOTE=20
