# ============================================================
# Athena — environment variables
# Copy to .env and fill in. NEVER commit .env.
# ============================================================

# --- Supabase (project settings -> API / Database) ---
# Pooled connection (port 6543, pgbouncer) — used by the app
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (port 5432) — used by prisma migrate
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_ANON_KEY=""
# Server-side only. Never expose to the frontend.
SUPABASE_SERVICE_ROLE_KEY=""
# La web (Astro) solo puede leer variables con prefijo PUBLIC_
PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
PUBLIC_SUPABASE_ANON_KEY=""

# --- Redis (docker compose up in infra/) ---
REDIS_URL="redis://localhost:6379"
# La cola de trabajos vive en otra base para que limpiar la caché no borre trabajos pendientes.
# Sin esta variable se usa la base 1 de REDIS_URL, que es lo correcto en desarrollo.
REDIS_QUEUE_URL=""

# --- API-Football (direct channel, Mega plan) ---
# Header: x-apisports-key | Base: https://v3.football.api-sports.io
API_FOOTBALL_KEY=""

# --- OpenAI (insight generation + embeddings) ---
OPENAI_API_KEY=""
# Tope propio de gasto: al alcanzarlo los jobs de IA fallan a propósito
OPENAI_DAILY_TOKEN_CAP="2000000"
# Modelos (opcionales; hay defaults razonables)
OPENAI_INSIGHT_MODEL="gpt-5.4-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# --- Apps ---
PORT=3001                       # NestJS API
PUBLIC_API_URL="http://localhost:3001"
WEB_ORIGIN="http://localhost:4321"   # CORS del API
PUBLIC_SITE_URL="http://localhost:4321"

# --- Observability (Fase 1) ---
SENTRY_DSN=""

# --- Analytics (Fase 2) ---
PUBLIC_POSTHOG_KEY=""
PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
