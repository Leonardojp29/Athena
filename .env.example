# ============================================================
# Athena — environment variables
# Copy to .env and fill in. NEVER commit .env.
# ============================================================

# --- Supabase (project settings -> Database) ---
# Pooled connection (port 6543, pgbouncer) — used by the app
# `connection_limit` acota cuántas de las consultas paralelas de una vista salen a la vez: sin él
# Prisma abre ~3 por proceso, que en una función de un vCPU son tres. Medido: con los índices puestos
# la diferencia queda dentro del ruido, pero en producción evita que once consultas se hagan cola.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10&pool_timeout=20"
# Direct connection (port 5432) — used by prisma migrate
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
# La web (Astro) solo puede leer variables con prefijo PUBLIC_
PUBLIC_PUBLIC_
# --- Redis (docker compose up in infra/) ---

# --- API-Football (direct channel, Mega plan) ---
# Header: x-apisports-key | Base: https://v3.football.api-sports.io
# El secreto con el que pg_cron (Supabase) dispara los endpoints internos del sync.
CRON_SECRET=
API_FOOTBALL_KEY=""

# --- OpenAI (insight generation + embeddings) ---
OPENAI_API_KEY=""
# Tope propio de gasto: al alcanzarlo los jobs de IA fallan a propósito
OPENAI_DAILY_TOKEN_CAP="2000000"
# Modelos (opcionales; hay defaults razonables)
OPENAI_INSIGHT_MODEL="gpt-5.4-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# --- Apps ---
PORT=3001                       # NestJS API
PUBLIC_API_URL="http://localhost:3001"
WEB_ORIGIN="http://localhost:4321"   # CORS del API
PUBLIC_SITE_URL="http://localhost:4321"

# --- Observability (Fase 1) ---
SENTRY_DSN=""

# --- Analytics (Fase 2) ---
PUBLIC_POSTHOG_KEY=""
PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
