# ============================================================
# Athena — environment variables
# Copy to .env and fill in. NEVER commit .env.
# ============================================================

# --- Supabase (project settings -> API / Database) ---
# Pooled connection (port 6543, pgbouncer) — used by the app
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (port 5432) — used by prisma migrate
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_ANON_KEY=""
# Server-side only. Never expose to the frontend.
SUPABASE_SERVICE_ROLE_KEY=""

# --- Redis (docker compose up in infra/) ---
REDIS_URL="redis://localhost:6379"

# --- API-Football (direct channel, Mega plan) ---
# Header: x-apisports-key | Base: https://v3.football.api-sports.io
API_FOOTBALL_KEY=""

# --- OpenAI (insight generation + embeddings) ---
OPENAI_API_KEY=""

# --- Apps ---
PORT=3001                       # NestJS API
PUBLIC_API_URL="http://localhost:3001"

# --- Observability (Fase 1) ---
SENTRY_DSN=""

# --- Analytics (Fase 2) ---
PUBLIC_POSTHOG_KEY=""
PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
