// Athena — first cut of the domain schema (Fase 0).
// Designed from football concepts, never from provider payloads (ADR-001).
// Supabase: DATABASE_URL points at the pooled connection (6543),
// DIRECT_URL at the direct one (5432) for migrations.

// Las extensiones (vector, pg_trgm) se crean en la migración SQL, no aquí:
// declararlas haría que Prisma trate las extensiones propias de Supabase como drift.
// relationJoins: sin esto Prisma resuelve cada relación con una consulta aparte, y contra
// Supabase cada ida y vuelta cuesta cerca de 0,8 s. La vista de partido pasa de tres viajes a uno.
generator client {
  provider        = "prisma-client-js"
  // Vercel corre sobre Amazon Linux: sin este binario, Prisma no arranca en producción.
  binaryTargets   = ["native", "rhel-openssl-3.0.x"]
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- provider independence ----------

/// Maps Athena UUIDs to provider ids. The ONLY place provider ids exist.
model ExternalReference {
  id          String   @id @default(uuid()) @db.Uuid
  entityType  String   @map("entity_type") // player | team | competition | season | match | venue | coach
  entityId    String   @map("entity_id") @db.Uuid
  provider    String // 'api-football'
  providerRef String   @map("provider_ref")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([provider, entityType, providerRef])
  @@unique([provider, entityType, entityId])
  @@index([entityType, entityId])
  @@map("external_references")
}

// ---------- core entities ----------

model Competition {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  slug        String   @unique
  country     String?
  /// ISO del país, tal como lo publica el proveedor: PE, GB-ENG. Null en los internacionales.
  countryCode String?  @map("country_code")
  /// La publica el proveedor; no se construye a mano.
  flagUrl     String?  @map("flag_url")
  /// sudamerica | europa | norteamerica | africa | asia | mundial. Lo decide el catálogo.
  continent   String?
  format      String // league | cup
  /// clubs | national. Lo decide el catálogo: el proveedor no distingue un Mundial de una Champions.
  scope       String   @default("clubs")
  logoUrl     String?  @map("logo_url")
  seasons     Season[]
  isActive    Boolean  @default(false) @map("is_active") // toggles sync scope by data, not code

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("competitions")
}

model Season {
  id               String                   @id @default(uuid()) @db.Uuid
  competition      Competition              @relation(fields: [competitionId], references: [id])
  competitionId    String                   @map("competition_id") @db.Uuid
  year             Int // start year: 2025 = 2025-26
  startDate        DateTime?                @map("start_date") @db.Date
  endDate          DateTime?                @map("end_date") @db.Date
  isCurrent        Boolean                  @default(false) @map("is_current")
  matches          Match[]
  standings        Standing[]
  playerStatistics PlayerSeasonStatistics[]
  /// Qué publica el proveedor de esta temporada: eventos, alineaciones, estadísticas, notas.
  cobertura        Json?

  @@unique([competitionId, year])
  @@map("seasons")
}

model Standing {
  id           String   @id @default(uuid()) @db.Uuid
  season       Season   @relation(fields: [seasonId], references: [id])
  seasonId     String   @map("season_id") @db.Uuid
  team         Team     @relation(fields: [teamId], references: [id])
  teamId       String   @map("team_id") @db.Uuid
  groupLabel   String   @default("") @map("group_label")
  position     Int
  points       Int
  played       Int
  won          Int
  drawn        Int
  lost         Int
  goalsFor     Int      @map("goals_for")
  goalsAgainst Int      @map("goals_against")
  form         String?
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([seasonId, groupLabel, teamId])
  @@index([seasonId, groupLabel, position])
  @@map("standings")
}

model Venue {
  id       String  @id @default(uuid()) @db.Uuid
  name     String
  city     String?
  country  String?
  capacity Int?
  /// Los tres siguientes solo llegan por el endpoint de equipos; el de partidos manda el estadio pelado.
  imageUrl String? @map("image_url")
  surface  String?
  address  String?
  teams    Team[]
  matches  Match[]

  @@map("venues")
}

model Team {
  id             String  @id @default(uuid()) @db.Uuid
  name           String
  shortName      String? @map("short_name")
  slug           String  @unique
  country        String?
  founded        Int?
  isNationalTeam Boolean @default(false) @map("is_national_team")
  logoUrl        String? @map("logo_url")
  /// Hex sin almohadilla, como los publica el proveedor en las alineaciones.
  primaryColor   String? @map("primary_color")
  secondaryColor String? @map("secondary_color")
  venue          Venue?  @relation(fields: [venueId], references: [id])
  venueId        String? @map("venue_id") @db.Uuid
  /// Partidos suyos que seguimos. Ordena la búsqueda: el texto solo no distingue Boca Juniors de Boca Unidos.
  relevancia     Int     @default(0)

  homeMatches Match[]           @relation("home_team")
  awayMatches Match[]           @relation("away_team")
  events      MatchEvent[]
  standings   Standing[]
  statistics  MatchStatistics[]
  lineups     MatchLineup[]

  playerMatchStatistics  MatchPlayerStatistics[]
  playerSeasonStatistics PlayerSeasonStatistics[]
  squadMemberships       SquadMembership[]
  altas                  Transfer[]               @relation("fichaje_entra")
  bajas                  Transfer[]               @relation("fichaje_sale")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  retosComoObjetivo RetoDelOnce[] @relation("reto_objetivo")

  @@index([relevancia(sort: Desc)])
  @@map("teams")
}

model Player {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  fullName    String?   @map("full_name")
  slug        String    @unique
  birthDate   DateTime? @map("birth_date") @db.Date
  nationality String?
  heightCm    Int?      @map("height_cm")
  position    String? // goalkeeper | defender | midfielder | attacker
  photoUrl    String?   @map("photo_url")

  events           MatchEvent[]             @relation("event_player")
  relatedEvents    MatchEvent[]             @relation("event_related_player")
  matchStatistics  MatchPlayerStatistics[]
  seasonStatistics PlayerSeasonStatistics[]
  squadMemberships SquadMembership[]
  trofeos          PlayerTrophy[]
  fichajes         Transfer[]
  titularEnRetos   TitularDelReto[]

  /**
   * Cuándo se le preguntó el palmarés al proveedor, que no es lo mismo que tener títulos.
   */
  palmaresRevisadoEn DateTime? @map("palmares_revisado_en") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([name])
  @@map("players")
}

/// Rendimiento de un jugador en un partido: solo las columnas que la ficha muestra
/// y por las que se ordena. Una métrica nueva se re-pide al proveedor, no se acumula.
model MatchPlayerStatistics {
  id       String @id @default(uuid()) @db.Uuid
  match    Match  @relation(fields: [matchId], references: [id])
  matchId  String @map("match_id") @db.Uuid
  team     Team   @relation(fields: [teamId], references: [id])
  teamId   String @map("team_id") @db.Uuid
  player   Player @relation(fields: [playerId], references: [id])
  playerId String @map("player_id") @db.Uuid

  shirtNumber     Int?     @map("shirt_number")
  position        String?
  isStarter       Boolean  @default(false) @map("is_starter")
  minutesPlayed   Int?     @map("minutes_played")
  rating          Decimal? @db.Decimal(3, 1)
  captain         Boolean  @default(false)
  goals           Int?
  goalsConceded   Int?     @map("goals_conceded")
  assists         Int?
  saves           Int?
  shotsTotal      Int?     @map("shots_total")
  shotsOnTarget   Int?     @map("shots_on_target")
  passesTotal     Int?     @map("passes_total")
  passesKey       Int?     @map("passes_key")
  passesAccurate  Int?     @map("passes_accurate")
  tacklesTotal    Int?     @map("tackles_total")
  interceptions   Int?
  duelsTotal      Int?     @map("duels_total")
  duelsWon        Int?     @map("duels_won")
  dribblesTotal   Int?     @map("dribbles_total")
  dribblesSuccess Int?     @map("dribbles_success")
  foulsCommitted  Int?     @map("fouls_committed")
  foulsDrawn      Int?     @map("fouls_drawn")
  yellowCards     Int?     @map("yellow_cards")
  redCards        Int?     @map("red_cards")
  penaltyScored   Int?     @map("penalty_scored")
  penaltyMissed   Int?     @map("penalty_missed")
  penaltySaved    Int?     @map("penalty_saved")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([matchId, playerId])
  @@index([playerId, matchId])
  @@index([matchId, teamId])
  @@index([teamId, matchId])
  @@index([rating(sort: Desc), minutesPlayed(sort: Desc)], map: "match_player_statistics_rating_idx")
  @@map("match_player_statistics")
}

/// Acumulados de un jugador en una temporada y un club. Llega junto a la bio en
/// /players?league&season, así que el perfil no cuesta un request por jugador.
model PlayerSeasonStatistics {
  id       String @id @default(uuid()) @db.Uuid
  player   Player @relation(fields: [playerId], references: [id])
  playerId String @map("player_id") @db.Uuid
  season   Season @relation(fields: [seasonId], references: [id])
  seasonId String @map("season_id") @db.Uuid
  team     Team   @relation(fields: [teamId], references: [id])
  teamId   String @map("team_id") @db.Uuid

  appearances           Int?     @map("appearances")
  lineups               Int?
  minutesPlayed         Int?     @map("minutes_played")
  rating                Decimal? @db.Decimal(4, 2)
  goals                 Int?
  assists               Int?
  shotsTotal            Int?     @map("shots_total")
  shotsOnTarget         Int?     @map("shots_on_target")
  passesTotal           Int?     @map("passes_total")
  passesKey             Int?     @map("passes_key")
  passesAccuracyPercent Int?     @map("passes_accuracy_percent")
  duelsWon              Int?     @map("duels_won")
  dribblesSuccess       Int?     @map("dribbles_success")
  yellowCards           Int?     @map("yellow_cards")
  redCards              Int?     @map("red_cards")
  penaltyScored         Int?     @map("penalty_scored")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@unique([playerId, seasonId, teamId])
  @@index([seasonId, teamId])
  @@map("player_season_statistics")
}

/// Pertenencia a una plantilla. El dorsal vive acá y no en el jugador porque pertenece
/// al par club-campaña: el mismo futbolista cambia de número al cambiar de club.
model SquadMembership {
  id          String   @id @default(uuid()) @db.Uuid
  team        Team     @relation(fields: [teamId], references: [id])
  teamId      String   @map("team_id") @db.Uuid
  player      Player   @relation(fields: [playerId], references: [id])
  playerId    String   @map("player_id") @db.Uuid
  year        Int
  shirtNumber Int?     @map("shirt_number")
  position    String?
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([teamId, playerId, year])
  @@index([playerId, year])
  @@map("squad_memberships")
}

model Match {
  id             String   @id @default(uuid()) @db.Uuid
  season         Season   @relation(fields: [seasonId], references: [id])
  seasonId       String   @map("season_id") @db.Uuid
  round          String?
  homeTeam       Team     @relation("home_team", fields: [homeTeamId], references: [id])
  homeTeamId     String   @map("home_team_id") @db.Uuid
  awayTeam       Team     @relation("away_team", fields: [awayTeamId], references: [id])
  awayTeamId     String   @map("away_team_id") @db.Uuid
  kickoffUtc     DateTime @map("kickoff_utc")
  status         String // scheduled | in_play | paused | finished | postponed | suspended | cancelled | abandoned | awarded
  statusDetail   String?  @map("status_detail") // provider-granular: 1H, HT, ET, PEN...
  elapsedMinutes Int?     @map("elapsed_minutes")
  homeScore      Int?     @map("home_score")
  awayScore      Int?     @map("away_score")
  venue          Venue?   @relation(fields: [venueId], references: [id])
  venueId        String?  @map("venue_id") @db.Uuid

  events           MatchEvent[]
  statistics       MatchStatistics[]
  lineups          MatchLineup[]
  playerStatistics MatchPlayerStatistics[]
  sync             MatchSync?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([seasonId, kickoffUtc])
  @@index([status, kickoffUtc])
  @@index([homeTeamId, kickoffUtc(sort: Desc)])
  @@index([awayTeamId, kickoffUtc(sort: Desc)])
  @@map("matches")
}

/// Qué facetas de un partido ya llegaron y cuándo volver a preguntar por las que faltan.
model MatchSync {
  match                Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  matchId              String    @id @map("match_id") @db.Uuid
  eventosCompleto      Boolean   @default(false) @map("eventos_completo")
  alineacionesCompleto Boolean   @default(false) @map("alineaciones_completo")
  estadisticasCompleto Boolean   @default(false) @map("estadisticas_completo")
  jugadoresCompleto    Boolean   @default(false) @map("jugadores_completo")
  analisisCompleto     Boolean   @default(false) @map("analisis_completo")
  intentos             Int       @default(0)
  proximoIntento       DateTime  @default(now()) @map("proximo_intento")
  ultimoIntento        DateTime? @map("ultimo_intento")
  ultimoError          String?   @map("ultimo_error")
  cobertura            Json?
  cerradoEn            DateTime? @map("cerrado_en")
  creadoEn             DateTime  @default(now()) @map("creado_en")
  actualizadoEn        DateTime  @updatedAt @map("actualizado_en")

  @@index([proximoIntento])
  @@map("match_sync")
}

/// Estadísticas por equipo de un partido: solo los campos que el producto usa.
model MatchStatistics {
  id                String   @id @default(uuid()) @db.Uuid
  match             Match    @relation(fields: [matchId], references: [id])
  matchId           String   @map("match_id") @db.Uuid
  team              Team     @relation(fields: [teamId], references: [id])
  teamId            String   @map("team_id") @db.Uuid
  possessionPercent Int?     @map("possession_percent")
  shotsTotal        Int?     @map("shots_total")
  shotsOnGoal       Int?     @map("shots_on_goal")
  shotsOffGoal      Int?     @map("shots_off_goal")
  shotsBlocked      Int?     @map("shots_blocked")
  corners           Int?
  offsides          Int?
  fouls             Int?
  yellowCards       Int?     @map("yellow_cards")
  redCards          Int?     @map("red_cards")
  goalkeeperSaves   Int?     @map("goalkeeper_saves")
  passesTotal       Int?     @map("passes_total")
  passesAccurate    Int?     @map("passes_accurate")
  passesPercent     Int?     @map("passes_percent")
  expectedGoals     Decimal? @map("expected_goals") @db.Decimal(5, 2)
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@unique([matchId, teamId])
  @@map("match_statistics")
}

/// Alineación por equipo. Los once y el banco viven como JSONB porque siempre se
/// leen como unidad; el id del jugador va resuelto cuando existe en Athena.
model MatchLineup {
  id             String   @id @default(uuid()) @db.Uuid
  match          Match    @relation(fields: [matchId], references: [id])
  matchId        String   @map("match_id") @db.Uuid
  team           Team     @relation(fields: [teamId], references: [id])
  teamId         String   @map("team_id") @db.Uuid
  formation      String?
  coachName      String?  @map("coach_name")
  startXi        Json     @map("start_xi")
  substitutes    Json
  /// La camiseta de ese partido: de la moda de los partidos de local sale el color del club.
  kitColor       String?  @map("kit_color")
  kitNumberColor String?  @map("kit_number_color")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([matchId, teamId])
  @@index([teamId, kitColor])
  @@map("match_lineups")
}

model MatchEvent {
  id              String  @id @default(uuid()) @db.Uuid
  match           Match   @relation(fields: [matchId], references: [id])
  matchId         String  @map("match_id") @db.Uuid
  kind            String // goal | own_goal | penalty_goal | missed_penalty | yellow_card | red_card | substitution | var
  minute          Int
  extraMinute     Int?    @map("extra_minute")
  team            Team    @relation(fields: [teamId], references: [id])
  teamId          String  @map("team_id") @db.Uuid
  player          Player? @relation("event_player", fields: [playerId], references: [id])
  playerId        String? @map("player_id") @db.Uuid
  relatedPlayer   Player? @relation("event_related_player", fields: [relatedPlayerId], references: [id])
  relatedPlayerId String? @map("related_player_id") @db.Uuid
  detail          Json?

  @@index([matchId, minute])
  @@index([playerId])
  @@map("match_events")
}

// ---------- knowledge plane ----------

/// Append-only log of meaningful happenings. Feeds timelines, derivation
/// pipelines (MATCH_FINISHED -> stats -> insights) and AI reasoning.
/// Append-only + outbox: processedAt marca los eventos ya convertidos en trabajo derivado.
model DomainEvent {
  id          String    @id @default(uuid()) @db.Uuid
  kind        String // MATCH_FINISHED | PLAYER_TRANSFER | MANAGER_CHANGE | ...
  subjectType String    @map("subject_type")
  subjectId   String    @map("subject_id") @db.Uuid
  occurredAt  DateTime  @map("occurred_at")
  payload     Json
  processedAt DateTime? @map("processed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([subjectType, subjectId, occurredAt])
  @@index([kind, occurredAt])
  @@index([processedAt])
  @@map("domain_events")
}

/// Vectores para búsqueda semántica y similitud. `content` guarda el texto
/// exacto que se embebió (procedencia), `model` permite reindexar sin borrar.
model Embedding {
  id         String                       @id @default(uuid()) @db.Uuid
  entityType String                       @map("entity_type")
  entityId   String                       @map("entity_id") @db.Uuid
  model      String
  content    String
  vector     Unsupported("halfvec(1536)")
  updatedAt  DateTime                     @updatedAt @map("updated_at")

  @@unique([entityType, entityId, model])
  @@map("embeddings")
}

/// AI-generated narratives. Never shown without their evidence (provenance).
model Insight {
  id            String    @id @default(uuid()) @db.Uuid
  subjectType   String    @map("subject_type")
  subjectId     String    @map("subject_id") @db.Uuid
  kind          String // match_preview | post_match_analysis | player_trend | ...
  narrative     String
  evidence      Json
  model         String
  promptVersion String    @map("prompt_version")
  lang          String    @default("es")
  generatedAt   DateTime  @default(now()) @map("generated_at")
  expiresAt     DateTime? @map("expires_at")

  @@index([subjectType, subjectId, kind])
  @@map("insights")
}

/// Lightweight graph: played_for, coached_by, similar_to, rival_of...
model EntityRelationship {
  id        String    @id @default(uuid()) @db.Uuid
  fromType  String    @map("from_type")
  fromId    String    @map("from_id") @db.Uuid
  relation  String
  toType    String    @map("to_type")
  toId      String    @map("to_id") @db.Uuid
  validFrom DateTime? @map("valid_from") @db.Date
  validTo   DateTime? @map("valid_to") @db.Date
  metadata  Json?

  @@unique([fromType, fromId, relation, toType, toId], map: "entity_relationships_edge_key")
  @@index([fromType, fromId, relation])
  @@index([toType, toId, relation])
  @@map("entity_relationships")
}

// ---------- platform ----------

/// Toggle features without deploying (ARCHITECT_REVIEW point 5).
model FeatureFlag {
  id             String   @id @default(uuid()) @db.Uuid
  key            String   @unique
  enabled        Boolean  @default(false)
  rolloutPercent Int      @default(100) @map("rollout_percent")
  audience       Json?
  description    String?
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("feature_flags")
}

/// Recurring sync cadence lives in data, not code (ARCHITECT_REVIEW point 10).
model SyncSchedule {
  id        String    @id @default(uuid()) @db.Uuid
  jobKind   String    @unique @map("job_kind") // sync:reference | sync:fixtures | ...
  cron      String
  enabled   Boolean   @default(true)
  lastRunAt DateTime? @map("last_run_at")
  metadata  Json?

  @@map("sync_schedules")
}

/// El slug viejo de un jugador o un equipo, para redirigir en lugar de dar 404.
///
/// Un futbolista nacido de una alineación abreviada queda como "j-alarcon" hasta que llega su nombre
/// completo, y las selecciones se guardaron con el nombre inglés del proveedor. Cambiar el slug sin
/// dejar rastro rompe cualquier enlace ya compartido.
model SlugAlias {
  entityType String   @map("entity_type")
  slug       String
  entityId   String   @map("entity_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  @@id([entityType, slug])
  @@index([entityType, entityId])
  @@map("slug_aliases")
}

/// Una tarea pendiente del sync: lo que antes era un job de BullMQ.
///
/// Vive en Postgres porque el despliegue es serverless: no hay proceso escuchando una cola, hay un
/// tic por minuto (pg_cron → endpoint) que toma lo pendiente con SKIP LOCKED y lo ejecuta.
model Tarea {
  id           BigInt    @id @default(autoincrement())
  tipo         String
  datos        Json      @default("{}")
  prioridad    Int       @default(5)
  correDespues DateTime  @default(now()) @map("corre_despues")
  intentos     Int       @default(0)
  tomadaHasta  DateTime? @map("tomada_hasta")
  ultimoError  String?   @map("ultimo_error")
  creadaEn     DateTime  @default(now()) @map("creada_en")

  /**
   * Una fila viva es trabajo pendiente: encolar dos veces lo mismo no es dos trabajos.
   */
  @@unique([tipo, datos], map: "tarea_unica")
  @@index([prioridad, correDespues, id])
  @@map("tareas")
}

/// Vistas ya calculadas, para que una instancia fría no vuelva a componerlas desde cero.
model VistaCache {
  clave       String   @id
  cuerpo      Json
  frescaHasta DateTime @map("fresca_hasta")
  venceEn     DateTime @map("vence_en")
  calculadaEn DateTime @default(now()) @map("calculada_en")

  @@index([venceEn])
  @@map("vistas_cache")
}

/// Estado compartido chico entre procesos: cuotas y marcas de espera. Antes vivía en Redis.
model Kv {
  clave   String    @id
  numero  BigInt?
  venceEn DateTime? @map("vence_en")

  @@map("kv")
}

/// Un título del palmarés de un futbolista.
///
/// El proveedor manda el nombre del torneo y no su id, así que la competencia vive acá como texto y
/// no como una llave a `competitions`: "CONMEBOL Sudamericana" es todo lo que llega. Y el 45% de las
/// filas viene sin temporada —medido sobre datos reales—, por eso el año es opcional.
///
/// Se reemplaza entero por jugador en cada sincronización, igual que los eventos de un partido: un
/// palmarés es corto y cambia una vez al año, así que no vale la pena reconciliar fila por fila.
model PlayerTrophy {
  id       BigInt @id @default(autoincrement())
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId String @map("player_id") @db.Uuid

  competencia String
  pais        String?
  /// "2023" o "2023/2024" tal como lo escribe el proveedor; null cuando no lo sabe.
  temporada   String?
  /// campeon | subcampeon
  puesto      String

  actualizadoEn DateTime @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  /// La ficha pide el palmarés de un jugador ordenado por temporada, y nada más.
  @@index([playerId, temporada(sort: Desc)])
  @@map("player_trophies")
}

/// Un movimiento de mercado.
///
/// El club puede no existir en Athena —la mayoría de los pases cruzan a ligas que no cubrimos—, así
/// que el nombre se guarda siempre y la llave al equipo solo cuando se la puede resolver. Sin eso,
/// la mitad de los fichajes de Alianza serían filas mudas.
model Transfer {
  id       BigInt @id @default(autoincrement())
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId String @map("player_id") @db.Uuid

  /// El proveedor nunca manda hora, y un fichaje no la tiene.
  fecha DateTime @db.Date

  entraA       Team?   @relation("fichaje_entra", fields: [entraATeamId], references: [id])
  entraATeamId String? @map("entra_a_team_id") @db.Uuid
  /// Null cuando el futbolista quedó sin club: el proveedor pone ahí su propio nombre.
  entraANombre String? @map("entra_a_nombre")
  saleDe       Team?   @relation("fichaje_sale", fields: [saleDeTeamId], references: [id])
  saleDeTeamId String? @map("sale_de_team_id") @db.Uuid
  /// Null cuando llegó sin contrato, por el mismo motivo.
  saleDeNombre String? @map("sale_de_nombre")

  /// traspaso | prestamo | vuelve-de-prestamo | libre | desconocido
  clase String
  /// Lo que costó, cuando el proveedor lo escribió; tal cual lo mandó, con su moneda.
  monto String?

  actualizadoEn DateTime @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  /// Un mismo pase no se puede cargar dos veces aunque llegue por dos equipos distintos.
  @@unique([playerId, fecha, entraANombre, saleDeNombre], map: "fichaje_unico")
  /// Las dos preguntas de la vista de equipo: a quién trajo y a quién dejó ir, lo más nuevo arriba.
  @@index([entraATeamId, fecha(sort: Desc)])
  @@index([saleDeTeamId, fecha(sort: Desc)])
  @@index([playerId, fecha(sort: Desc)])
  @@map("transfers")
}

/// Un reto de Adivina el XI: un partido real y el once que hay que reconstruir.
model RetoDelOnce {
  id         BigInt @id @default(autoincrement())
  /// La misma clave del catálogo en código: 'int-dificil-12'. Es la que usa el juego.
  clave      String @unique
  /// internacional | peruano
  catalogo   String
  /// facil | normal | dificil
  dificultad String

  /// El fixture de API-Football, para poder rehacer el reto sin volver a buscarlo.
  fixtureRef String @map("fixture_ref")

  competencia        String
  competenciaLogoUrl String?  @map("competencia_logo_url")
  /// Lo que lee el hincha: '2018/19' o '2022'.
  temporada          String
  fase               String?
  jugadoEn           DateTime @map("jugado_en") @db.Date

  objetivoNombre    String  @map("objetivo_nombre")
  objetivoEscudoUrl String? @map("objetivo_escudo_url")
  /// Null cuando el equipo no es una entidad de Athena; el reto se juega igual.
  objetivo          Team?   @relation("reto_objetivo", fields: [objetivoTeamId], references: [id])
  objetivoTeamId    String? @map("objetivo_team_id") @db.Uuid

  rivalNombre    String  @map("rival_nombre")
  rivalEscudoUrl String? @map("rival_escudo_url")

  /// Si el equipo objetivo jugó de local, para escribir el marcador en el orden del acta.
  deLocal       Boolean @map("de_local")
  golesObjetivo Int     @map("goles_objetivo")
  golesRival    Int     @map("goles_rival")
  /// 'ganó 4-2 en penales', 'en prórroga'. Contexto que el marcador solo no cuenta.
  nota          String?

  formacion String
  /// Verdadero cuando la disposición se escribió a mano porque el proveedor no la publica.
  aMano     Boolean @default(false) @map("a_mano")

  titulares     TitularDelReto[]
  actualizadoEn DateTime         @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  /// El sorteo filtra por las dos cosas a la vez y nunca por una sola.
  @@index([catalogo, dificultad])
  @@map("retos_del_once")
}

/// Un titular del reto, con la casilla en la que se dibuja.
model TitularDelReto {
  id       BigInt      @id @default(autoincrement())
  reto     RetoDelOnce @relation(fields: [retoId], references: [id], onDelete: Cascade)
  retoId   BigInt      @map("reto_id")
  player   Player      @relation(fields: [playerId], references: [id])
  playerId String      @map("player_id") @db.Uuid

  /// 'fila:columna' desde el arco propio, como las numera el proveedor.
  grid   String
  /// G | D | M | F, cuando el proveedor lo dice.
  puesto String?
  dorsal Int?

  /// El mismo futbolista no puede ocupar dos casillas del mismo once.
  @@unique([retoId, playerId], map: "titular_unico")
  @@map("titulares_del_reto")
}
